    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "e763fa81e3c3eb8d21be10134e703e79a462f05e34acf730822a68540e5a81fc",
      "text": "In 17 days, you will travel through 4 South American countries and see several very different parts of the continent. The journey begins in Santiago, then heads south through Chile to Puerto Natales and Torres del Paine. From Chilean Patagonia, the route continues into Argentina, to El Calafate, the Perito Moreno Glacier and Buenos Aires.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw3txem9-amanda",
        "model": "GPT-6",
        "wordAbsenceReason": "The Word overview describes the whole four-country journey, not this compact RU introduction tracing the initial Santiago–Puerto Natales–Torres del Paine–El Calafate–Buenos Aires sequence; translate the current RU lead, corroborated by Word days 1–8."
      }
    },
    {

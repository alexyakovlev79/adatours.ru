---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import DestinationBand from '../../components/editorial/DestinationBand.astro';

const tours = (await getCollection('tours', ({ data }) =>
  data.locale === 'ru' && !['draft', 'archived'].includes(data.status)
)).sort((a, b) => (b.data.priority ?? 0) - (a.data.priority ?? 0));
---

<BaseLayout
  title="Туры по Бразилии и Латинской Америке"
  description="Индивидуальные, VIP и multi-country маршруты Ada Tours по Бразилии, Аргентине, Перу и другим странам Латинской Америки."
>
  <Hero
    eyebrow="Туры"
    title="Путешествия по Латинской Америке"
    intro="Готовые маршруты Ada Tours можно взять за основу и изменить под ваши даты, длительность, отели и состав программы."
    image="/media/prototype/rio-panorama.jpg"
  />

  <EditorialStatement
    eyebrow="Выберите основу"
    text="От короткой поездки по Бразилии до большого маршрута по нескольким странам. Каждый вариант можно доработать под вас."
  />

  {tours.map((tour, index) => (
    <DestinationBand
      eyebrow={[tour.data.durationDays ? `${tour.data.durationDays} дней` : '', tour.data.format ?? ''].filter(Boolean).join(' · ')}
      title={tour.data.title}
      text={tour.data.lead}
      image={tour.data.hero?.src}
      href={`/tury/${tour.data.slug}/`}
      align={index % 2 === 1 ? 'right' : 'left'}
    />
  ))}
</BaseLayout>

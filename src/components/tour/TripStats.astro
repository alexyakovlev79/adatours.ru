---
interface Stat {
  value: string;
  label: string;
}
interface Props { stats: Stat[]; }
const { stats } = Astro.props;
---

<section class="stats">
  <div class="stats__inner" data-count={stats.length} style={`--stats-count: ${stats.length}`}>
    {stats.map((stat) => (
      <div class:list={['stat', { 'stat--long': stat.value.length > 9 }]}>
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .stats {
    padding-block: clamp(24px, 2.5vw, 40px);
    background: var(--color-bg);
  }

  .stats__inner {
    display: grid;
    grid-template-columns: repeat(var(--stats-count, 4), minmax(0, 1fr));
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .stat {
    min-width: 0;
    min-height: 180px;
    padding: 38px 30px;
  }

  .stat + .stat {
    border-left: 1px solid var(--color-line);
  }

  .stat strong {
    display: block;
    max-width: 100%;
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3vw, 4.8rem);
    font-weight: 500;
    line-height: .95;
    letter-spacing: -.04em;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .stat--long strong {
    font-size: clamp(1.8rem, 2.5vw, 3.3rem);
  }

  /*
   * Three-column rows stop growing at --container-max, so long values must not
   * keep scaling with the viewport after their cells have stopped getting wider.
   */
  @media (min-width: 761px) {
    .stats__inner[data-count="3"] .stat--long strong {
      font-size: clamp(1.8rem, 1.85vw, 2rem);
      overflow-wrap: normal;
      word-break: normal;
      hyphens: none;
    }
  }

  .stat span {
    font-size: .8rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stats__inner[data-count="2"] {
    max-width: 980px;
  }

  .stats__inner[data-count="2"] .stat {
    min-height: 0;
    padding: 38px 40px 42px;
    text-align: center;
  }

  .stats__inner[data-count="2"] .stat strong {
    overflow-wrap: normal;
    hyphens: none;
    white-space: nowrap;
  }

  .stats__inner[data-count="2"] .stat span {
    display: block;
    margin-top: 2px;
    text-align: center;
  }

  .stats__inner[data-count="2"] .stat + .stat {
    border-left-color: color-mix(in srgb, var(--color-line) 72%, transparent);
  }

  @media (max-width: 760px) {
    .stats {
      padding-block: 18px;
    }

    .stats__inner {
      position: relative;
      grid-template-columns: repeat(2, minmax(0,1fr));
    }

    .stats__inner::before,
    .stats__inner::after {
      content: '';
      position: absolute;
      z-index: 1;
      background: var(--color-line);
      pointer-events: none;
    }

    .stats__inner::before {
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
      transform: translateX(-.5px);
    }

    .stats__inner::after {
      top: 50%;
      right: 0;
      left: 0;
      height: 1px;
      transform: translateY(-.5px);
    }

    .stat,
    .stat + .stat {
      min-height: 130px;
      padding: 26px 18px;
      border: 0;
    }

    .stat--long strong {
      font-size: clamp(1.65rem, 7vw, 2.15rem);
    }

    .stats__inner[data-count="2"] {
      display: block;
    }

    .stats__inner[data-count="2"]::before,
    .stats__inner[data-count="2"]::after {
      display: none;
    }

    .stats__inner[data-count="2"] .stat,
    .stats__inner[data-count="2"] .stat + .stat {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 22px;
      align-items: center;
      min-height: 0;
      padding: 24px 0;
      border: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .stats__inner[data-count="2"] .stat:last-child {
      border-bottom: 0;
    }

    .stats__inner[data-count="2"] .stat strong,
    .stats__inner[data-count="2"] .stat--long strong {
      margin: 0;
      font-size: clamp(1.9rem, 8.5vw, 2.55rem);
      line-height: 1;
      white-space: nowrap;
    }

    .stats__inner[data-count="2"] .stat span {
      margin-top: 0;
      text-align: right;
      white-space: nowrap;
    }
  }
</style>

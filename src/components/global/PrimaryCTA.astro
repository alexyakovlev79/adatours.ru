---
import { withBase } from '../../lib/paths';

interface Props {
  href?: string;
  label?: string;
  variant?: 'gold' | 'light' | 'ghost' | 'dark';
}

const {
  href = '/contacts/',
  label = 'Оставить заявку',
  variant = 'gold',
} = Astro.props;

const normalizedLabel = label.trim().toLocaleLowerCase('ru');
const opensLeadModal = href === '/contacts/' || normalizedLabel === 'оставить заявку';
const resolvedHref = opensLeadModal ? '#request' : withBase(href);
---

<a
  class:list={['cta', `cta--${variant}`]}
  href={resolvedHref}
  data-lead-modal={opensLeadModal ? 'true' : undefined}
>
  <span>{label}</span>
  <span aria-hidden="true">↗</span>
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-width: 210px;
    padding: 16px 20px;
    border: 1px solid var(--cta-border);
    border-radius: var(--radius-cta);
    background: var(--cta-fill-light);
    color: var(--color-ink-deep);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background 220ms var(--ease-out),
      color 220ms var(--ease-out),
      border-color 220ms var(--ease-out);
  }

  /* All CTA variants share a neutral translucent surface and turquoise rim. */
  .cta:hover {
    border-color: var(--cta-border-hover);
    background: var(--cta-fill-light-hover);
  }

  .cta--dark {
    color: var(--color-bg);
    background: var(--cta-fill-dark);
  }

  .cta--dark:hover {
    background: var(--cta-fill-dark-hover);
  }

  /* Photographic banners and the transparent header need white lettering. */
  :global(.hero) .cta,
  :global(.band) .cta,
  :global(.band-card) .cta,
  :global(.story) .cta,
  :global(.proof) .cta,
  :global(.site-header--light:not(.is-scrolled):not(.is-open)) .cta,
  :global(.site-header.is-open) .cta,
  :global(.mobile-menu) .cta {
    color: var(--color-bg);
    background: var(--cta-fill-photo);
    text-shadow: 0 1px 3px rgb(0 0 0 / 60%);
  }

  :global(.hero) .cta:hover,
  :global(.band) .cta:hover,
  :global(.band-card) .cta:hover,
  :global(.story) .cta:hover,
  :global(.proof) .cta:hover,
  :global(.site-header--light:not(.is-scrolled):not(.is-open)) .cta:hover,
  :global(.site-header.is-open) .cta:hover,
  :global(.mobile-menu) .cta:hover {
    background: var(--cta-fill-photo-hover);
  }
</style>

      },
      "text": "10.11 · Lima: From Miraflores to the Historic Centre"
    },
    {
      "blockId": "tour:itinerary_text:5a8704e80dc128a8",
      "field": "itinerary.text",
      "sourceTextSha256": "384a1fadb752e69302970cfc5f3b218f47dd63046e629d9242a231cbd0ec60cd",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261107-eab366ae-e542-49a4-8e67-bf54cf3f8a2d",
        "model": "ChatGPT"
      },
      "text": "Breakfast at the hotel. Explore Lima with an English-speaking guide. See Miraflores and Parque del Amor, view Huaca Huallamarca from the outside, and visit the main square and Santo Domingo Monastery. Visit Lima Cathedral or, if it is closed, the MALI museum."
    }

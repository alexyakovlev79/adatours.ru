---
interface Stat {
  value: string;
  label: string;
}
interface Props { stats: Stat[]; }
const { stats } = Astro.props;
---

<section class="stats">
  <div class="stats__inner">
    {stats.map((stat) => (
      <div class:list={['stat', { 'stat--long': stat.value.length > 9 }]}>
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .stats {
    padding-block: clamp(24px, 2.5vw, 40px);
    background: var(--color-bg);
  }

  .stats__inner {
    display: grid;
    grid-template-columns: repeat(var(--stats-count, 4), minmax(0, 1fr));
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .stat {
    min-width: 0;
    min-height: 180px;
    padding: 38px 30px;
  }

  .stat + .stat {
    border-left: 1px solid var(--color-line);
  }

  .stat strong {
    display: block;
    max-width: 100%;
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3vw, 4.8rem);
    font-weight: 500;
    line-height: .95;
    letter-spacing: -.04em;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .stat--long strong {
    font-size: clamp(1.8rem, 2.5vw, 3.3rem);
  }

  .stat span {
    font-size: .8rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .stats {
      padding-block: 18px;
    }

    .stats__inner {
      grid-template-columns: repeat(2, minmax(0,1fr));
    }

    .stat {
      min-height: 130px;
      padding: 26px 18px;
      border: 0;
    }

    .stat + .stat {
      border-left: 0;
    }

    .stat:nth-child(even) {
      border-left: 1px solid var(--color-line);
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
    }

    .stat--long strong {
      font-size: clamp(1.65rem, 7vw, 2.15rem);
    }
  }
</style>

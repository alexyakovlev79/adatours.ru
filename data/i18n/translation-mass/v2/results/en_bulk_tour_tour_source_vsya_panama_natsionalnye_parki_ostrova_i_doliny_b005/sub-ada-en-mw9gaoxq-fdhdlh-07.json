    {
      "blockId": "tour:itinerary_text:4b5ff9b4a37f43cc",
      "field": "itinerary.text",
      "sourceTextSha256": "52579b2427a043974b0e76bfd58a20faf9e955d97e44c9f3fdb599976ef701b6",

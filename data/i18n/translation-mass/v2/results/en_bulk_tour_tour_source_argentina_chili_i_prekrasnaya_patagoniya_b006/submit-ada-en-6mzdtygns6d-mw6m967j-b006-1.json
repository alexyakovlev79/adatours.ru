    {
      "blockId": "tour:itinerary_text:ec46e3209ab74818",
      "field": "itinerary.text",
      "sourceTextSha256": "4f215cdf27922f292a6ca54b6515d6923f282823429903a5203fb8fe49c6adbc",
      "text": "This full-day group excursion takes you out in 4x4 vehicles.\n\nIn the morning, you follow Route 3 across the Fuegian mountain range and up to Garibaldi Pass. From the viewpoint, you can see Lakes Escondido and Fagnano.\n\nBeyond the pass, you leave the main road and take old logging tracks. The 4x4 vehicles can tackle stretches of forest, mud and rock that regular vehicles cannot reach.\n\nLake Fagnano stands out for its size and open views. The route then continues around the area to an inland road that leads to Lake Escondido. The lake is smaller and surrounded by forest and mountains. This day lets you explore a more active side of Tierra del Fuego, away from the usual roads. The drive is part of the fun as the 4x4 follows old forest tracks that keep changing from rock to mud and back again.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-6mzdtygns6d-mw6m967j",
        "model": "GPT-6.1 Sol"
      }
    },

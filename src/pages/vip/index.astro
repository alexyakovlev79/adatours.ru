---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import EditorialProof from '../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
---

<BaseLayout
  title="VIP и Luxury путешествия по Бразилии и Латинской Америке"
  description="Индивидуальные VIP и luxury маршруты по Бразилии и Латинской Америке с персональной сборкой программы."
>
  <Hero
    eyebrow="VIP / Luxury"
    title="Путешествие, устроенное вокруг вас"
    intro="Персональный маршрут, приватные трансферы, тщательно подобранное размещение и свободный график. Детали берет на себя Ada Tours."
    image="/media/prototype/rio-night.jpg"
    ctaLabel="Собрать VIP-маршрут"
  />

  <EditorialStatement
    eyebrow="Private travel"
    text="Приватность, свободное время и возможность менять планы по ходу поездки."
  />

  <EditorialProof
    eyebrow="Бразилия"
    title="Бразилия в частном формате"
    text="Рио, Игуасу и побережье соединяем с частными трансферами, хорошими гидами, подходящими отелями и временем для себя."
    image="/media/prototype/iguazu.jpg"
    facts={[
      'Индивидуальная логистика',
      'Частные гиды и трансферы',
      'Подбор размещения под маршрут',
      'Дополнительные активности под запрос',
    ]}
  />

  <EditorialProof
    eyebrow="Персонализация"
    title="Свободное время тоже часть программы"
    text="Поздний завтрак, смена планов, свободный вечер или целый день без расписания иногда становятся лучшей частью поездки."
    image="/media/prototype/patagonia.jpg"
    reverse
  />

  <ProcessSteps
    eyebrow="Как собирается VIP-маршрут"
    title="Собираем поездку вокруг ваших привычек"
    steps={[
      { title: 'Пожелания', text: 'Интересы, привычки, приватность и обязательные условия.' },
      { title: 'Маршрут', text: 'Выбираем места, которым действительно стоит отдать время.' },
      { title: 'Детали', text: 'Размещение, транспорт, гиды, рестораны и активности.' },
      { title: 'Свобода', text: 'Оставляем в программе место для отдыха и изменений.' },
    ]}
    dark
  />

  <LeadForm title="Собрать индивидуальный VIP-маршрут" entityId="vip" />
</BaseLayout>

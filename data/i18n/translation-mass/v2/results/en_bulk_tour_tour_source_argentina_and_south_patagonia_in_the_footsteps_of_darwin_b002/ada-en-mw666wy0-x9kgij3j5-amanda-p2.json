    {
      "blockId": "tour:included:251984c0939ac67a",
      "field": "included",
      "sourceTextSha256": "f2861267a7447d84ca4bd6a4ca20bb1b58803206ea5dbc83bc1d8c6fe8bb2eaa",
      "text": "\tMendoza City: Two (2) nights in a 3*** hotel, double or triple room with breakfast. Half board and drinks not included.",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1HgcuwMUxK68f-s5379kXSQKF_OX9Y-Sx",
        "documentSha256": "7d0e77f248460d4856acd78ba4810982df618bae5589ea04f99e893251613982",
        "paragraphs": [
          {
            "ref": "word/document.xml#p0121",
            "textSha256": "d96a7a9849b04b0415300969c15eb78c28d92727d5e9053276443197d3e212c8"

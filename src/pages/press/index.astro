---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import AboutNav from '../../components/commercial/AboutNav.astro';
import AuthoritySection from '../../components/authority/AuthoritySection.astro';
import AuthoritySourceList from '../../components/authority/AuthoritySourceList.astro';
import AuthorityFaq from '../../components/authority/AuthorityFaq.astro';
import AuthorityClosing from '../../components/authority/AuthorityClosing.astro';
import AuthoritySearchRecord from '../../components/authority/AuthoritySearchRecord.astro';
import { authorityPage } from '../../lib/i18n/authority-pages.mjs';
import { sharedUiLocale } from '../../lib/i18n/shared-ui-locale.mjs';
import { getAuthorityPageSources, getAuthorityExhibitionSources } from '../../lib/entity-authority.mjs';

const page = authorityPage('press');
const isEnglish = sharedUiLocale() === 'en';
const sources = getAuthorityPageSources(page.path);
const exhibitionSources = getAuthorityExhibitionSources(page.path);
const breadcrumbs = [
  { label: 'Главная', href: '/' },
  { label: 'О нас', href: '/about/' },
  { label: page.breadcrumbLabel, href: page.path },
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonical={page.path}
  image={page.heroImage}
  leadTitle={page.leadTitle}
  leadEntityId={page.leadEntityId}
  breadcrumbs={breadcrumbs}
>
  <Hero
    eyebrow={page.eyebrow}
    title={page.h1}
    intro={page.lead}
    image={page.heroImage}
    ctaLabel={page.heroCta.label}
    ctaHref={page.heroCta.href}
    compact
    compactCta
    mobilePhotoLead
    imagePositionMobile="75% center"
    mediaStatus="approved"
  />
  <AboutNav active="press" />
  <AuthoritySearchRecord title={page.h1} summary={page.description} subtitle={page.searchSubtitle}
    aliases={[...page.searchAliases, ...sources.map((source) => source.publisher.name)]} image={page.heroImage} />

  <AuthoritySection section={page.sections[0]} />
  <AuthoritySourceList
    id="publications"
    eyebrow={page.sourcesEyebrow}
    title={page.sourcesHeading}
    intro={page.sourcesIntro}
    sources={sources}
    entries={page.sourceEntries}
  />
  <AuthoritySourceList
    id="ratings"
    eyebrow={isEnglish ? "Choosing a tour organizer" : "Выбор организатора путешествия"}
    title={isEnglish ? "Rankings and practical comparisons" : "Рейтинги и практические разборы"}
    intro={isEnglish ? "Authored comparisons on Sostav, TenChat and DTF, prepared as part of Ada Tours' promotion through GAEO. Each publication focuses on a different type of trip and its selection criteria." : "Авторские сравнения на Sostav, TenChat и DTF, подготовленные в рамках продвижения Ada Tours через GAEO. В каждой публикации — свой сценарий поездки и критерии выбора."}
    sources={sources}
    entries={page.rankingEntries}
  />
  <AuthoritySourceList
    id="research"
    eyebrow="Index Research"
    title={isEnglish ? "Research and comparisons of travel companies" : "Исследования и сравнения туристических компаний"}
    intro={isEnglish ? "Research produced by a project associated with GAEO. Ada Tours is included in the comparison sets; each study provides its methodology, sources and open data." : "Материалы исследовательского проекта, связанного с GAEO. Ada Tours входит в выборки; методика, источники и открытые данные доступны на страницах исследований."}
    sources={sources}
    entries={page.researchEntries}
  />
  <AuthoritySourceList
    id="case-publications"
    eyebrow={isEnglish ? "Website development and promotion" : "Работа над сайтом и продвижением"}
    title={isEnglish ? "Ada Tours development case studies" : "Кейсы о развитии Ada Tours"}
    intro={isEnglish ? "Case studies from our contractor GAEO about developing the website and improving Ada Tours' presence in AI-generated answers." : "Публикации нашего подрядчика GAEO о разработке сайта и результатах продвижения компании в ответах нейросетей."}
    sources={sources}
    entries={page.caseEntries}
  />
  <AuthoritySourceList
    id="exhibitions"
    eyebrow={isEnglish ? "Travel trade exhibitions" : "Профессиональные выставки"}
    title={isEnglish ? "Ada Tours in international trade-show directories" : "Ada Tours в каталогах международных выставок"}
    intro={isEnglish ? "Exhibitor profiles, official directories and documentary evidence. Future events are identified as scheduled." : "Профили участников, официальные списки и документальные подтверждения. Будущие выставки отмечены как запланированные."}
    sources={exhibitionSources}
    entries={page.exhibitionEntries}
  />
  <AuthoritySection section={page.sections[1]} />
  <AuthoritySection section={page.sections[2]} />
  <AuthorityFaq title={page.faqHeading} items={page.faq} />
  <AuthorityClosing content={page.finalCta} />
</BaseLayout>

  "blocks": [
    {
      "blockId": "tour:note:72a9065ee196c3b6",
      "field": "note",
      "sourceTextSha256": "da12e7a639b539b6f400c03e4cd3418ef564ec1890a35264828f0f0736254c5c",
      "text": "Price per person: $15,500 based on two people sharing a double room, or $18,600 in a single room.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-113a0f7cb039-mwa5n0tf-qk0eyn5ma27",
        "model": "ChatGPT"
      }
    },
    {
      "blockId": "tour:note:64be61e929ea9b21",
      "field": "note",
      "sourceTextSha256": "08b121c407dfb05cd5880517297fb6e4be26c611d5397ef118578532e1b9a27a",
      "text": "At Iguazú, Parque das Aves costs an additional $50 per person and the Macuco Safari costs an additional $130 per person.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-113a0f7cb039-mwa5n0tf-qk0eyn5ma27",
        "model": "ChatGPT"
      }
    },
    {
      "blockId": "tour:note:43e2992a2ac2cb44",
      "field": "note",
      "sourceTextSha256": "f8b83e61401a8a305163b0263d742ed85ed40e082b66752b2c954d9e1725b493",
      "text": "A visit to the Maipo Valley wineries with a tasting costs an additional $230 per person, with a minimum of 2 participants.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-113a0f7cb039-mwa5n0tf-qk0eyn5ma27",
        "model": "ChatGPT"
      }
    },
    {
      "blockId": "tour:note:ed60bdfa392e6ebe",
      "field": "note",
      "sourceTextSha256": "968a2cb17815800e476ffce2344cd9c859bbd471b3d345d5a1129891cb42fef4",
      "text": "An English-language night-time astronomy tour in the Atacama costs an additional $180 per person. Availability depends on the lunar calendar and is confirmed when you book.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-113a0f7cb039-mwa5n0tf-qk0eyn5ma27",
        "model": "ChatGPT"
      }
    },
    {
      "blockId": "tour:note:3510765f12ca766c",
      "field": "note",
      "sourceTextSha256": "945879b3ad64fef730a8c88b06e77f2c211bcb2acc3875bb57e2dba3c3e976ed",
      "text": "One of two Galápagos outings is included: North Seymour and Bachas, or South Plaza and Punta Carrión. We confirm which one after you book. Only one of the two is included.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-113a0f7cb039-mwa5n0tf-qk0eyn5ma27",
        "model": "ChatGPT"
      }
    },
    {
      "blockId": "tour:note:a03830eddfa985db",
      "field": "note",
      "sourceTextSha256": "2622575b097437ce7fdac3810d3ce4469f70ed6023845cd91d03b129ab1d558a",
      "text": "Altitude sickness is possible in the Bolivian highlands. The itinerary includes time to acclimatise in San Pedro de Atacama.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-113a0f7cb039-mwa5n0tf-qk0eyn5ma27",
        "model": "ChatGPT"
      }
    },
    {
      "blockId": "tour:note:bdc672e6f77d748a",
      "field": "note",
      "sourceTextSha256": "ec8aeb21d1a47992d141192ae4c793c4cae43d6e9d4f153e39b91b3776ba7264",
      "text": "Bogotá’s Gold Museum is closed on Mondays. The Casa de Moneda and the Botero Collection are closed on Tuesdays.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-113a0f7cb039-mwa5n0tf-qk0eyn5ma27",
        "model": "ChatGPT"
      }
    },
    {
      "blockId": "tour:note:58bf41d62e687496",
      "field": "note",
      "sourceTextSha256": "af93fd0b1637cc141c5cf4bd9207f8480e762d9f11a7c6b64a909a528ef10c95",
      "text": "Hotels may be replaced with others in the same category.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-113a0f7cb039-mwa5n0tf-qk0eyn5ma27",
        "model": "ChatGPT"
      }
    }
  ]

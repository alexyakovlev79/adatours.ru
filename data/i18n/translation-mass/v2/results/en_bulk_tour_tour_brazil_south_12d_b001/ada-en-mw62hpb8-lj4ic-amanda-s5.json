      "sourceTextSha256": "37cf580cf6a5b3276b145c5ea9736e41367ecdaf2ca8491c7775f31496f70e25",
      "text": "Southern Brazil in 12 Days: Rio, Iguazu, Gramado, the Canyons and Florianópolis",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw62hpb8-lj4ic-amanda",
        "model": "ChatGPT",
        "wordAbsenceReason": "The selected Word title describes a 13-day winery edition; it has no title for the 12-day route published in RU."
      }
    },
    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "aa8823cbc65ca30bba81b6be181afc8508bc87456404f9b2c6c37a07f7dfcc07",
      "text": "Travel through southern Brazil from Rio de Janeiro and Iguazu Falls to the European-style town of Gramado, the canyons near Praia Grande and the beaches of Florianópolis. You’ll take in Rio’s best-known views, walk through tropical forest, ride a boat to the falls, step onto a glass platform over a valley and fly over a canyon in a hot-air balloon.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw62hpb8-lj4ic-amanda",
        "model": "ChatGPT",
        "wordAbsenceReason": "The selected Word spreads the sights across daily entries and has no matching introduction for the 12-day itinerary without the winery night."
      }
    },

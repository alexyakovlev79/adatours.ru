      "sourceTextSha256": "3c7af8574042952a3fdf54ae900a00d03190dc0d883e19716b97313f14beca18",
      "text": "Merida – Chichen Itza (130 km) – Cenote – Cancun/Riviera Maya (220–280 km)",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1NxdGb-AAzfs475TFliH1HR4SZCs03cmP",
        "documentSha256": "a5e020a85be2435f8d493d7dd2d99c44a87c95641302ff2b6737ff03aec74652",

---
import { withBase } from '../../lib/paths';

interface Stat {
  value: string;
  label: string;
  href?: string;
  kind?: 'format';
}
interface Props {
  stats: Stat[];
  variant?: 'default' | 'excursion';
}
const { stats, variant = 'default' } = Astro.props;

// Discretionary Russian syllable breaks also work without a browser dictionary.
// Soft hyphens are visible only when the word wraps at that position.
const formatSyllables: Record<string, string> = {
  'активный': 'ак\u00adтив\u00adный',
  'авиакруиз': 'авиа\u00adкру\u00adиз',
  'гастротур': 'гас\u00adтро\u00adтур',
  'групповой': 'груп\u00adпо\u00adвой',
  'дайвинг': 'дай\u00adвинг',
  'деловой': 'де\u00adло\u00adвой',
  'двоих': 'дво\u00adих',
  'инсентив': 'ин\u00adсен\u00adтив',
  'паломничество': 'па\u00adломн\u00adи\u00adчест\u00adво',
  'обзорный': 'об\u00adзор\u00adный',
  'регулярный': 'ре\u00adгу\u00adляр\u00adный',
  'рыбалка': 'ры\u00adбал\u00adка',
  'свадебный': 'сва\u00adдеб\u00adный',
  'смешанный': 'сме\u00adшан\u00adный',
  'трансферы': 'транс\u00adфе\u00adры',
  'частный': 'част\u00adный',
  'человек': 'че\u00adло\u00adвек',
  'экскурсии': 'экс\u00adкур\u00adсии',
  'экспедиция': 'экс\u00adпе\u00adди\u00adция',
};
const syllabifyFormat = (value: string) => value.replace(/[а-яё]+/giu, (word) => {
  const broken = formatSyllables[word.toLocaleLowerCase('ru')];
  if (!broken) return word;
  return word[0] + broken.slice(1);
});
---

<section class="stats" data-variant={variant} data-count={stats.length}>
  <div class="stats__inner" data-count={stats.length} style={`--stats-count: ${stats.length}`}>
    {stats.map((stat) => (
      <div class:list={['stat', { 'stat--format': stat.kind === 'format' }]}>
        <strong aria-label={stat.kind === 'format' ? stat.value : undefined}>
          {stat.href
            ? <a href={withBase(stat.href)}>{stat.value}</a>
            : stat.kind === 'format' ? syllabifyFormat(stat.value) : stat.value}
        </strong>
        <span>{stat.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .stats {
    padding-block: clamp(24px, 2.5vw, 40px);
    background: var(--color-bg);
  }

  .stats__inner {
    --stat-value-size: clamp(1.8rem, 2.5vw, 3.3rem);
    display: grid;
    grid-template-columns: repeat(var(--stats-count, 4), minmax(0, 1fr));
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .stat {
    min-width: 0;
    min-height: 180px;
    padding: 38px 24px;
  }

  .stat + .stat {
    border-left: 1px solid var(--color-line);
  }

  .stat strong {
    display: block;
    max-width: 100%;
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-size: var(--stat-value-size);
    font-weight: 500;
    line-height: .95;
    letter-spacing: -.04em;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  /*
   * Three-column rows stop growing at --container-max, so long values must not
   * keep scaling with the viewport after their cells have stopped getting wider.
   */
  @media (min-width: 761px) {
    .stats__inner[data-count="3"] {
      --stat-value-size: clamp(1.8rem, 1.85vw, 2rem);
    }

    .stats__inner[data-count="3"] .stat strong {
      display: flex;
      align-items: flex-end;
      min-height: clamp(2.09rem, 2.85vw, 4.56rem);
    }
  }

  .stat strong a:hover {
    text-decoration: underline;
    text-underline-offset: .15em;
  }

  .stat span {
    font-size: .8rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stats__inner[data-count="1"] {
    max-width: 620px;
  }

  .stats__inner[data-count="1"] .stat {
    min-height: 0;
    padding: 38px 40px 42px;
    text-align: center;
  }

  .stats__inner[data-count="1"] .stat strong {
    overflow-wrap: normal;
    hyphens: none;
  }

  .stats__inner[data-count="1"] .stat span {
    display: block;
    margin-top: 2px;
    text-align: center;
  }

  .stats__inner[data-count="2"] {
    max-width: 980px;
  }

  .stats__inner[data-count="2"] .stat {
    min-height: 0;
    padding: 38px 40px 42px;
    text-align: center;
  }

  .stats__inner[data-count="2"] .stat strong {
    overflow-wrap: normal;
    hyphens: none;
    white-space: nowrap;
  }

  .stats__inner[data-count="2"] .stat span {
    display: block;
    margin-top: 2px;
    text-align: center;
  }

  .stats__inner[data-count="2"] .stat + .stat {
    border-left-color: color-mix(in srgb, var(--color-line) 72%, transparent);
  }

  @media (max-width: 760px) {
    .stats {
      padding-block: 18px;
    }

    /* Compact the crossed 2x2 grid without changing 1-2 fact layouts. */
    .stats[data-variant="default"][data-count="3"],
    .stats[data-variant="default"][data-count="4"] {
      padding-block: 10px;
    }

    .stats__inner {
      --stat-value-size: clamp(1.65rem, 7vw, 2rem);
      position: relative;
      grid-template-columns: repeat(2, minmax(0,1fr));
    }

    .stats__inner[data-count="3"],
    .stats__inner[data-count="4"] {
      grid-auto-rows: 1fr;
    }

    .stats__inner::before,
    .stats__inner::after {
      content: '';
      position: absolute;
      z-index: 1;
      background: var(--color-line);
      pointer-events: none;
    }

    .stats__inner::before {
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
      transform: translateX(-.5px);
    }

    .stats__inner::after {
      top: 50%;
      right: 0;
      left: 0;
      height: 1px;
      transform: translateY(-.5px);
    }

    .stat,
    .stat + .stat {
      min-height: 130px;
      padding: 26px 12px;
      border: 0;
    }

    .stats[data-variant="default"] .stats__inner[data-count="3"] .stat,
    .stats[data-variant="default"] .stats__inner[data-count="4"] .stat {
      min-height: 96px;
      padding: 10px 12px;
    }

    .stats__inner[data-count="3"] .stat strong,
    .stats__inner[data-count="4"] .stat strong {
      display: flex;
      min-height: 1.2em;
      margin-bottom: 6px;
      align-items: flex-end;
    }

    .stats__inner[data-count="1"] {
      display: block;
    }

    .stats__inner[data-count="1"]::before,
    .stats__inner[data-count="1"]::after {
      display: none;
    }

    .stats__inner[data-count="1"] .stat {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 22px;
      align-items: center;
      min-height: 0;
      padding: 24px 0;
      border: 0;
    }

    .stats__inner[data-count="1"] .stat strong {
      margin: 0;
      font-size: clamp(1.9rem, 8.5vw, 2.55rem);
      line-height: 1;
    }

    .stats__inner[data-count="1"] .stat span {
      margin-top: 0;
      text-align: right;
      white-space: nowrap;
    }

    .stats__inner[data-count="2"] {
      display: block;
    }

    .stats__inner[data-count="2"]::before,
    .stats__inner[data-count="2"]::after {
      display: none;
    }

    .stats__inner[data-count="2"] .stat,
    .stats__inner[data-count="2"] .stat + .stat {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 22px;
      align-items: center;
      min-height: 0;
      padding: 24px 0;
      border: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .stats__inner[data-count="2"] .stat:last-child {
      border-bottom: 0;
    }

    .stats__inner[data-count="2"] .stat strong {
      margin: 0;
      font-size: clamp(1.9rem, 8.5vw, 2.55rem);
      line-height: 1;
      white-space: nowrap;
    }

    .stats__inner[data-count="2"] .stat span {
      margin-top: 0;
      text-align: right;
      white-space: nowrap;
    }

    .stats[data-variant="excursion"] .stats__inner[data-count="2"] .stat {
      text-align: left;
    }

    .stats[data-variant="excursion"] .stats__inner[data-count="2"] .stat strong {
      font-size: clamp(1.35rem, 5.6vw, 1.65rem);
      line-height: 1.08;
      text-align: left;
      white-space: normal;
      overflow-wrap: normal;
      hyphens: none;
    }

    /* Two tour metrics belong to one compact row; excursion stats stay stacked. */
    .stats[data-variant="default"] .stats__inner[data-count="2"] {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats[data-variant="default"] .stats__inner[data-count="2"]::before {
      display: block;
      top: 12px;
      bottom: 12px;
    }

    .stats[data-variant="default"] .stats__inner[data-count="2"]::after {
      display: none;
    }

    .stats[data-variant="default"] .stats__inner[data-count="2"] .stat {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      min-height: 120px;
      padding: 22px 8px;
      border: 0;
      text-align: center;
    }

    .stats[data-variant="default"] .stats__inner[data-count="2"] .stat strong {
      margin: 0;
      font-size: clamp(2.5rem, 11vw, 3rem);
      line-height: 1;
    }

    .stats[data-variant="default"] .stats__inner[data-count="2"] .stat span {
      margin: 0;
      font-size: clamp(.68rem, 2.75vw, .8rem);
      line-height: 1.3;
      letter-spacing: .045em;
      text-align: center;
      white-space: normal;
      text-wrap: balance;
    }
  }
  /* Values share one scale; labels start on the same line in each grid row. */
  .stats[data-variant="default"] .stats__inner[data-count="3"] .stat,
  .stats[data-variant="default"] .stats__inner[data-count="4"] .stat {
    display: grid;
    grid-template-rows: minmax(min-content, 1fr) auto;
    align-items: end;
  }

  .stats[data-variant="default"] .stats__inner[data-count="3"] .stat span,
  .stats[data-variant="default"] .stats__inner[data-count="4"] .stat span {
    display: block;
    min-height: 2.6em;
    line-height: 1.3;
    align-self: end;
  }

  .stats[data-variant="default"] .stat--format strong {
    overflow-wrap: normal;
    hyphens: auto;
    white-space: normal;
    text-wrap: balance;
  }
  /* Excursion facts lead directly into the compact geography and interest links. */
  .stats[data-variant="excursion"] {
    padding-block: clamp(18px, 2vw, 28px) 0;
  }
  .stats[data-variant="excursion"] .stat,
  .stats[data-variant="excursion"] .stats__inner[data-count] .stat {
    min-height: 0;
    padding: 18px 24px;
  }
  .stats[data-variant="excursion"] .stat strong {
    line-height: 1.08;
    white-space: normal;
  }
  @media (max-width: 760px) {
    .stats[data-variant="excursion"] { padding-block: 12px 0; }

    .stats[data-variant="excursion"] .stats__inner[data-count] {
      display: block;
      max-width: none;
    }

    .stats[data-variant="excursion"] .stats__inner::before,
    .stats[data-variant="excursion"] .stats__inner::after {
      display: none;
    }

    .stats[data-variant="excursion"] .stats__inner[data-count] .stat {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto;
      align-items: center;
      gap: 12px;
      min-height: 0;
      padding: 14px 0;
      border: 0;
      border-bottom: 1px solid var(--color-line);
      text-align: left;
    }

    /* EntityLinks provides the one shared rule below the final fact. */
    .stats[data-variant="excursion"] .stats__inner[data-count] .stat:last-child {
      border-bottom: 0;
    }

    .stats[data-variant="excursion"] .stats__inner[data-count] .stat strong {
      display: block;
      min-height: 0;
      margin: 0;
      font-size: clamp(1.35rem, 5.6vw, 1.65rem);
      line-height: 1.08;
      text-align: left;
      white-space: normal;
      overflow-wrap: normal;
      hyphens: none;
    }

    .stats[data-variant="excursion"] .stats__inner[data-count] .stat span {
      display: block;
      min-height: 0;
      margin: 0;
      font-size: .68rem;
      line-height: 1.3;
      letter-spacing: .04em;
      text-align: right;
      white-space: nowrap;
    }
  }
</style>

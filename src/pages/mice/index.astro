---
import { getCollection } from 'astro:content';
import { isActiveEntity } from '../../lib/archive.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import EditorialProof from '../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import DestinationBand from '../../components/editorial/DestinationBand.astro';
import MiceNav from '../../components/commercial/MiceNav.astro';
import CommercialDetails from '../../components/commercial/CommercialDetails.astro';
import DmcFaq from '../../components/commercial/DmcFaq.astro';
import { ORG } from '../../data/organization/ada-tours';

const caseOrder = [
  'case_mice_corporate_group_rio_angra_2026',
  'case_mice_business_delegation_sao_paulo_2026',
];

const caseById = new Map(
  (await getCollection('cases', ({ data }) => data.locale === 'ru' && isActiveEntity(data)))
    .map((entry) => [entry.data.id, entry])
);
const miceCases = caseOrder.map((id) => caseById.get(id)).filter(Boolean);
---

<BaseLayout
  leadTitle="Рассчитать MICE или корпоративную поездку"
  leadEntityId="mice"
  title="MICE и корпоративные поездки для бизнеса по Бразилии и Латинской (Южной) Америке с принимающим русскоязычным туроператором Ada Tours"
  description="Ada Tours организует MICE: деловые поездки на конференции, форумы, саммиты, семинары, выставки, ярмарки, переговоры и презентации. Корпоративные группы и бизнес-делегации: транспорт, размещение, площадки, питание, переводчиков и программу на месте."
>
  <Hero
    eyebrow="MICE · Бразилия и Латинская Америка"
    title="Корпоративная поездка, где все сходится по времени"
    intro="Встречи, трансферы, площадки, питание, экскурсии и вечерняя программа работают как одна система. Ada Tours собирает ее и координирует на месте."
    image="/media/catalog/tury/hero-enhanced-20260930.webp"
    ctaHref="#request"
    ctaLabel="Обсудить группу"
  />

  <MiceNav active="overview" />

  <DestinationBand
    eyebrow="B2B-программы"
    title="Посмотрите, как может быть устроена поездка вашей группы"
    text="Подробные программы по дням: транспорт, сопровождение, питание и экскурсии. Выберите основу для расчета под ваше рабочее расписание."
    image="/media/countries/panama/featureBands-1-enhanced-20261002.webp"
    href="/mice/programmes/"
  />

  <EditorialStatement
    eyebrow="MICE на месте"
    text="Главная задача начинается там, где пересекаются десятки деталей: группа должна вовремя приехать, разместиться, попасть на встречу или площадку, поесть, продолжить программу и спокойно пережить изменения расписания."
  />

  <FactStrip
    wideFirst
    facts={[
      { value: ORG.service.groups.miceVip.display, label: ORG.service.groups.miceVip.label },
      { value: ORG.service.groups.largeEvents.display, label: ORG.service.groups.largeEvents.label },
      { value: String(ORG.service.languages.length), label: 'языков коммуникации' },
      { value: 'Рио-де-Жанейро', label: 'база локальной команды Ada Tours' },
    ]}
  />

  <EditorialProof
    eyebrow="Одна программа"
    title="От аэропорта до финального мероприятия"
    text="Ada Tours связывает размещение, транспорт, гидов, переводчиков, площадки, рестораны, экскурсии и события в одну рабочую последовательность. Если меняется один пункт, команда перестраивает связанные части программы."
    image="/media/home/rio-night-enhanced-20260930.webp"
    facts={[
      'Корпоративные и incentive-поездки',
      'Деловые делегации и визиты к партнерам',
      'Групповой транспорт и сопровождение',
      'Площадки, питание и вечерние мероприятия',
      'Программа до и после деловой части',
    ]}
  />

  <EditorialStatement
    eyebrow="Реальные проекты"
    text="В MICE лучше всего говорят выполненные программы. Ниже два проекта Ada Tours 2026 года: корпоративная группа на 30 человек и делегация 8 человек с деловыми визитами и переводом."
  />

  {miceCases.map((item, index) => (
    <DestinationBand
      eyebrow={item.data.segment}
      title={item.data.title}
      text={[item.data.groupSize, item.data.cities.join(' · ')].filter(Boolean).join(' · ')}
      image={item.data.hero?.src}
      href={`/cases/${item.data.slug}/`}
      align={index % 2 === 1 ? 'right' : 'left'}
    />
  ))}

  <CommercialDetails
    id="mice-estimate"
    eyebrow="Подготовка коммерческого предложения"
    title="Какие детали определяют расчет MICE-поездки"
    intro="Маршрут и смета зависят от дат, состава группы и обязательных мероприятий. В примерах программ показаны разные сочетания деловой и экскурсионной частей."
    rows={[
      { title: 'Участники и расписание', text: 'Количество гостей, график прилета и вылета, обязательные встречи, конференции, вечерние мероприятия и участники, свободные от деловой части.' },
      { title: 'Транспорт и размещение', text: 'Маршруты между аэропортами, отелями и площадками; вместимость транспорта; часы работы водителей и координаторов; категория и расположение отелей.' },
      { title: 'Площадки и программа', text: 'Время аренды, питание, переводчики, гиды и экскурсии. Доступность конкретных площадок и подрядчиков уточняется перед подтверждением.' },
      { title: 'Стоимость', text: 'Расчет привязан к датам, составу услуг и условиям поставщиков. В предложении нужно отдельно выделить включенные услуги и позиции, ожидающие подтверждения.', href: '/mice/programmes/', linkLabel: 'Посмотреть примеры B2B-программ' },
    ]}
  />

  <ProcessSteps
    eyebrow="Как строим MICE"
    title="Сначала обязательная часть, затем вся программа вокруг нее"
    steps={[
      { title: 'Бриф', text: 'Формат поездки, количество участников, даты, обязательные встречи и требования к сервису.' },
      { title: 'Каркас', text: 'Размещение, транспорт, площадки и реальные интервалы между точками.' },
      { title: 'Программа', text: 'Питание, экскурсии, события и свободное время встраиваются без конфликта с обязательной частью.' },
      { title: 'На месте', text: 'Локальная команда ведет подрядчиков, расписание и изменения по ходу поездки.' },
    ]}
    dark
  />
  <DmcFaq
    title="Вопросы о корпоративных поездках"
    items={[
      { question: 'Можно ли совместить конференцию с экскурсионной программой?', answer: 'Да, такие варианты есть в B2B-программах Ada Tours. Для каждой группы отдельно согласуются обязательные встречи, свободное время и участие гостей в экскурсиях, чтобы события не накладывались друг на друга.' },
      { question: 'От чего зависит стоимость MICE-поездки?', answer: 'От дат, количества участников, категории размещения, маршрута, транспорта, площадок, питания, переводчиков и дополнительных услуг. Точный состав расчета согласуется для проекта.' },
      { question: 'Чем выполненный кейс отличается от примера программы?', answer: 'Кейсы показывают работу Ada Tours с конкретными группами. B2B-программы представляют маршруты для обсуждения и адаптации под новый запрос; они сами по себе не подтверждают проведение поездки.' },
      { question: 'Когда можно считать площадку или услугу забронированной?', answer: 'Статус каждой важной позиции уточняется при подготовке предложения. Предварительный маршрут и окончательно подтвержденное бронирование необходимо различать.' },
    ]}
  />
</BaseLayout>


    {
      "blockId": "tour:itinerary_text:25152ad0c634f823",
      "field": "itinerary.text",
      "sourceTextSha256": "e3bfb74987b635bdc09dd89bccecdbb9f0a310bc1815a12026e6c9b5800b08a9",
      "text": "A private tour of the Argentine side of Iguazú, crossing the Tancredo Neves Bridge. Walking routes and walkways bring you close to the cascades, including the Devil’s Throat. Optional private access before the park opens and a helicopter tour over the falls; permits, the departure location and availability must be confirmed in advance. Then transfer to the airport and fly by private jet to Buenos Aires, approximately 1 hour 45 minutes. Begin exploring the capital in the Recoleta district. Overnight at Four Seasons Hotel Buenos Aires, Mansion-View Room. Breakfast is included in the accommodation (BB).",
      "provenance": {
        "kind": "ai_translation",
        "model": "ChatGPT",
        "runId": "ada-en-20261104-mw1ownhg-0a870a9f",
        "wordAbsenceReason": "The verified Word 2027 supplies the private excursion, flight duration, Recoleta and hotel/BB details in separate paragraphs, but has no exact counterpart to the current RU safety/availability caveat on optional early access and helicopter operations. Translate the complete current RU block, preserving that caveat and the hotel/flight facts rather than copying the less-qualified Word optional claim.",
        "wordSource": {
          "fileId": "1mOARKNZLOOQPZyTGrV3uBkY-3ghv2rI9",

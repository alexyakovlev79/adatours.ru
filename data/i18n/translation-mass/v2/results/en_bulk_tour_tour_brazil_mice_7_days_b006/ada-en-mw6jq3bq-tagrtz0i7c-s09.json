      "sourceTextSha256": "25c6586a1d4a1e1936bb6c06455c208035612c9ea9ab7f372286d6daa9df6507",
      "text": "Foz do Iguaçu",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6jq3bq-tagrtz0i7c",
        "model": "GPT-6.1"
      }
    },
    {
      "blockId": "tour:contentBlock_text:c666cdc4c6bf6ee6",
      "field": "contentBlock.text",
      "sourceTextSha256": "cd869377366d37d16ea43902f7dc9e3508bc58097459f3f5dd9e29dc73d24034",
      "text": "We arrange a transfer with a driver from your hotel in São Paulo to the airport. After your flight to Foz do Iguaçu, an English-speaking guide will meet your group. On the way to the hotel, we’ll visit Macuco Safari and the Bird Park. Admission tickets are included.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6jq3bq-tagrtz0i7c",
        "model": "GPT-6.1"
      }
    },
    {
      "blockId": "tour:contentBlock_text:f83c39f78b4482a1",
      "field": "contentBlock.text",
      "sourceTextSha256": "2305ab9057d25e4f2cff5d69ddd7f9c32027101499401b6af7efd23c4ac57d1a",
      "text": "We include Macuco Safari in the Iguaçu programme. You’ll ride through the rainforest, walk to the river landing and take a boat to the waterfalls. We arrange an English-speaking guide as part of the day’s itinerary.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6jq3bq-tagrtz0i7c",
        "model": "GPT-6.1"
      }
    },
    {
      "blockId": "tour:contentBlock_text:b62952b1d3031bb4",
      "field": "contentBlock.text",
      "sourceTextSha256": "ddc5fc5434681f4be4269fb5796584db7a385a62fb405587128378aecf5a06d6",
      "text": "We arrange a visit to the [Bird Park](/brazil/place/parque-das-aves/) with an English-speaking guide on the way to the hotel. Admission is included.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6jq3bq-tagrtz0i7c",
        "model": "GPT-6.1"
      }
    },
    {
      "blockId": "tour:contentBlock_text:9f1f9bd5dbc899eb",
      "field": "contentBlock.text",
      "sourceTextSha256": "5e8418e3d0c684c509ccbbe811a3e371ab477a584c3f83a0daa9f946b6e10b8e",
      "text": "Join us for lunch at Cocar. In the evening, we arrange dinner at Tia Santa with transfers and an English-speaking escort.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6jq3bq-tagrtz0i7c",
        "model": "GPT-6.1"
      }
    },
    {
      "blockId": "tour:media_alt:80f90264d4f1c0d3",

    {
      "blockId": "tour:itinerary_text:61f9611f9ede6e03",
      "field": "itinerary.text",
      "sourceTextSha256": "e1817ee959498019c94a77d4201e6d8b8072168d87aefe67a14ddffde98eb4c9",
      "text": "Transfer to the airport and fly to Puerto Montt. On arrival, transfer to Puerto Varas, on the shore of Lake Llanquihue.\n\nPuerto Varas is considered one of southern Chile's most scenic towns. The well-defined cone of Osorno Volcano rises beyond the lake, forming one of the country's most recognisable panoramas.\n\nChile's Lake District is known for its green forests, volcanic landscapes, clear lakes and mountain valleys. German settlers contributed to the region's growth in the 19th century, and distinctive architectural features, traditions and culinary heritage from that period are still found here.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-translator-20261110-mw9trnme-si5iwi",
        "model": "GPT-6.1 Sol"
      }
    }

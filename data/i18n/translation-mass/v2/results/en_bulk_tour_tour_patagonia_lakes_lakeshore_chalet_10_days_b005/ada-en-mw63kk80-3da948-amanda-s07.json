    {
      "blockId": "tour:itinerary_text:5a4836cca1208c95",
      "field": "itinerary.text",
      "sourceTextSha256": "9eb853a257ce0f65c04cda569fb64fd8a792027f0b7f4e61fba92d23d9eeccbb",

      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "19ae2b691f28e4fa04901236bc260b4718b5ae8399fc84669441f3142cf9fdd7",
      "text": "Spend 19 days travelling through Brazil, Argentina, Chile, Bolivia and Peru. Welcome the New Year on Copacabana Beach in Rio de Janeiro, then see Iguazu Falls from both sides, visit Buenos Aires and Santiago, cross the Atacama Desert and the Bolivian Altiplano in 4x4 jeeps, travel across the Uyuni Salt Flat, and continue to Lake Titicaca, Cusco and Machu Picchu before finishing in Lima.",
      "provenance": {
        "kind": "ai_translation",
        "model": "ChatGPT",
        "runId": "ada-en-9457ab67-20261104",
        "wordAbsenceReason": "The verified Word has a route list in paragraph6 and individual programme days but no equivalent combined lead paragraph. Translated the current RU summary; all listed destinations and activities are covered by Word paragraphs28–168."
      }
    },

    {
      "blockId": "tour:itinerary_text:ec46e3209ab74818",
      "field": "itinerary.text",
      "sourceTextSha256": "f1ff3271f2e73fc47ae81f0d742a3499084e0a7223b6c6d5732d9252f7f4a3bd",
      "text": "After breakfast, visit Joya de Cerén, a UNESCO World Heritage Site known as the ‘Pompeii of Central America’. Volcanic ash buried the village and preserved evidence of everyday life in pre-Columbian times.\n\nNext, visit the ruins of the ancient Maya city of San Andrés and continue to Suchitoto, a town with cobbled streets and colonial architecture.\n\nAfter lunch, take a boat trip on Lake Suchitlán. Pelicans, herons and storks are among the birds that live here.\n\nOvernight at Hotel El Tejado. Meals: breakfast.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-work-mw8vsjy6-afdp41bp",
        "model": "GPT-6"
      }
    },

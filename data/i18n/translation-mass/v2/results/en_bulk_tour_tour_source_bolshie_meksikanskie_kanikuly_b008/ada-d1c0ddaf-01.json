    {
      "blockId": "tour:itinerary_text:b9ad3e14216c2f08",
      "field": "itinerary.text",
      "sourceTextSha256": "4d1f5dcba2d9ca8e04931df3d4fdd98ff998793e7e6d1a8a2ed6ff021fc8e4c8",
      "text": "After breakfast, depart for the center of the Yucatan Peninsula to see its main attraction – Chichen Itza. This ancient city is one of the New Seven Wonders of the World and a UNESCO World Heritage Site. You will see the Pyramid of Kukulkan, the Temple of the Warriors, the largest ballcourt in the world for the Pok-ta-Pok game, the Temple of the Jaguars, the Observatory, and other structures, all impressive in scale.\n\nNext, enjoy a swim in a crystal-clear cenote, a natural karst sinkhole, where you can experience the healing properties of underground waters.\n\nTransfer to Cancun/Riviera Maya. Check-in at your hotel according to your reservation.",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1NxdGb-AAzfs475TFliH1HR4SZCs03cmP",
        "documentSha256": "a5e020a85be2435f8d493d7dd2d99c44a87c95641302ff2b6737ff03aec74652",

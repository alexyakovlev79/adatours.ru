---
import { withBase } from '../../lib/paths';
import { nextMultiCountryOptions } from '../../lib/multi-country-combinations.mjs';

import { getMultiCountryCatalog } from '../../lib/multi-country-catalog.ts';
import { multiCountryPickerOptions, multiCountryCatalogPath } from '../../lib/multi-country-catalog.mjs';
import CatalogFilterMenu from './CatalogFilterMenu.astro';

interface CountryOption { slug: string; name: string; }
interface Props { selected?: string[]; themeId?: string; }
const { selected = [], themeId } = Astro.props;
const index = await getMultiCountryCatalog();
const { countries, combinations, interests, allInterestsHref } = multiCountryPickerOptions(index, selected, themeId);
const themeSlug = interests.find((option) => option.id === themeId)?.slug;
const countryBySlug = new Map(countries.map((country) => [country.slug, country]));
const nextOptions = (prefix: string[]): CountryOption[] =>
  nextMultiCountryOptions(combinations, prefix)
    .map((slug) => countryBySlug.get(slug)).filter((country): country is CountryOption => Boolean(country));
const steps = [0, 1, 2, 3].map((index) => ({
  index,
  options: index === 0 ? countries : selected.length >= index
    ? nextOptions(selected.slice(0, index)) : [],
  value: selected[index] ?? '',
}));
const descriptions = ['Первая страна', 'Вторая страна', 'Третья страна', 'Четвертая страна'];
---

<section
  class="mc-picker container"
  aria-label="Выбор сочетания стран"
  data-multi-country-picker
  data-root-href={withBase('/multi-country/')}
  data-countries={JSON.stringify(countries)}
  data-combinations={JSON.stringify(combinations.map((row) => row.slugs.join('_')))}
  data-selected={JSON.stringify(selected)}
  data-theme={themeSlug ?? ''}
  data-interest-options={JSON.stringify(interests.map((option) => ({ id: option.id, countries: option.countries })))}
  data-current-root-href={withBase(multiCountryCatalogPath([], themeSlug))}
>
  <div class="mc-picker__intro">
    <p class="eyebrow">Страны маршрута</p>
    <h3>Выберите сочетание стран</h3>
  </div>
  <div class="mc-picker__fields">
    {steps.map((step) => (
      <div
        class="mc-picker__field"
        data-mc-field={step.index}
        hidden={step.index > 0 && !(selected[step.index - 1] && step.options.length > 0)}
      >
        <label class="mc-picker__visually-hidden" for={'mc-country-' + (step.index + 1)}>{descriptions[step.index]}</label>
        <div class="mc-picker__control">
          <div class="mc-picker__select-wrap">
            <select class={step.value ? undefined : 'mc-picker__select--placeholder'} id={'mc-country-' + (step.index + 1)} data-mc-select={step.index} autocomplete="off">
              <option value="">{descriptions[step.index]}</option>
              {step.options.map((country) => (
                <option value={country.slug} selected={step.value === country.slug}>{country.name}</option>
              ))}
            </select>
            <span class="mc-picker__placeholder-text" aria-hidden="true">{descriptions[step.index]}</span>
            <svg class="mc-picker__select-arrow" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
              <path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </div>
          {step.index > 0 && (
            <button
              type="button"
              class="mc-picker__remove"
              data-mc-remove={step.index}
              aria-label={'Убрать выбранную страну: ' + descriptions[step.index]}
              hidden={!step.value}
            ><span aria-hidden="true">×</span></button>
          )}
        </div>
      </div>
    ))}
  </div>
  <div class="mc-picker__interest">
    <CatalogFilterMenu label="Интерес" placeholder="Выбрать интерес" selected={themeId}
      options={interests} reset="Все интересы" resetHref={allInterestsHref} context="multi-country" />
  </div>
    <a class="mc-picker__reset" href={withBase('/multi-country/')} data-mc-reset hidden={!selected.length && !themeId}>
      <span>Сбросить и показать</span>
      <span>все мультистрановые туры</span>
    </a>

</section>

<script>
  import '../../scripts/multi-country-selector';
</script>

<style>
  .mc-picker { padding-block: 0 38px; scroll-margin-top: 100px; }
  .mc-picker__interest { width: min(100%, 560px); margin-top: 24px; }
  .mc-picker__reset[hidden] { display: none; }
  .mc-picker__intro { max-width: 700px; }
  .mc-picker__intro .eyebrow { margin-bottom: 8px; }
  .mc-picker__intro h3 {
    margin: 0 0 22px;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.6rem);
    font-weight: 500;
    line-height: 1.15;
  }
  /* Country controls stay on one row wherever their natural minimum widths fit.
     Smaller screens wrap to 2 columns or to a single full-width control. */
  .mc-picker__fields {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    width: 100%;
    max-width: 1120px;
  }
  .mc-picker__field {
    display: flex;
    flex: 1 1 230px;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    max-width: 340px;
  }
  .mc-picker__field[hidden] { display: none; }
  .mc-picker__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .mc-picker__control { display: flex; align-items: center; gap: 10px; }
  .mc-picker__select-wrap { position: relative; flex: 1 1 auto; min-width: 0; }
  /* Same 20px chevron and 18px right inset as TourFilters. */
  .mc-picker__select-arrow {
    display: block;
    position: absolute;
    top: 50%;
    right: 18px;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-ink);
  }
  .mc-picker__field select {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 52px;
    border: 1px solid #aaa7a1;
    border-radius: 2px;
    padding: 10px 52px 10px 16px;
    appearance: none;
    -webkit-appearance: none;
    background: var(--color-bg);
    color: var(--color-ink);
    font: inherit;
    font-size: 1.1rem;
    cursor: pointer;
  }
  /* Keep the native option list dark. A pale placeholder is painted only
     over the closed, empty control, so the dropdown never inherits its color. */
  .mc-picker__placeholder-text {
    display: none;
    position: absolute;
    top: 50%;
    left: 16px;
    max-width: calc(100% - 70px);
    transform: translateY(-50%);
    overflow: hidden;
    padding: 4px 8px 4px 0;
    background: var(--color-bg);
    color: color-mix(in srgb, var(--color-ink) 55%, var(--color-bg));
    font: inherit;
    font-size: 1.1rem;
    line-height: 1.5;
    white-space: nowrap;
    text-overflow: ellipsis;
    pointer-events: none;
  }
  .mc-picker__field select.mc-picker__select--placeholder + .mc-picker__placeholder-text {
    display: block;
  }
  .mc-picker__field select option { color: var(--color-ink); }
  .mc-picker__field select option[value=""] {
    color: color-mix(in srgb, var(--color-ink) 55%, var(--color-bg));
  }
  .mc-picker__field select:focus-visible { outline: 2px solid var(--color-gold-deep); outline-offset: 3px; }
  .mc-picker__remove {
    display: flex;
    flex: 0 0 44px;
    width: 44px;
    height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    background: var(--color-bg);
    font: inherit;
    font-size: 1.65rem;
    line-height: 1;
    cursor: pointer;
  }
  .mc-picker__remove[hidden] { display: none; }
  .mc-picker__remove:hover { border-color: var(--color-gold-deep); }
  .mc-picker__remove:focus-visible { outline: 2px solid var(--color-gold-deep); outline-offset: 3px; }
  .mc-picker__reset {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    max-width: 100%;
    margin-top: 18px;
    padding: 12px 20px;
    border: 1px solid var(--cta-border);
    border-radius: var(--radius-cta);
    color: var(--color-ink);
    background: var(--cta-fill-light);
    font-family: var(--font-display);
    font-size: .93rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease;
  }
  .mc-picker__reset > span { white-space: nowrap; }
  .mc-picker__reset:hover {
    border-color: var(--cta-border-hover);
    background: var(--cta-fill-light-hover);
  }
  .mc-picker__reset:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 3px; }
  @media (max-width: 600px) {
    .mc-picker { padding-bottom: 30px; }
    .mc-picker__field select { font-size: 1rem; }
    .mc-picker__placeholder-text { font-size: 1rem; }
    .mc-picker__reset { width: min(100%, 480px); font-size: .9rem; }
  }
</style>

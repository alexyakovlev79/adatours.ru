      },
      "text": "6–18 March 2027"
    },
    {
      "blockId": "tour:note:bbdb60f108a1170a",
      "field": "note",
      "sourceTextSha256": "3225d42a5e39e71893861d137a54622a7221e5e8a8e6fc17cc5394aba31e05a5",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-20261107-2qs2lbapgi9",
        "model": "gpt-6.1-sol"
      },
      "text": "The expedition runs from 6 to 18 March 2027 and lasts 13 days and 12 nights."
    },
    {
      "blockId": "tour:note:9bc43ab1c752b5be",
      "field": "note",
      "sourceTextSha256": "ce9ad39bca4819a9e49b840a4e46bb2edab1e2d8cc19e8edd6077bb3a19dc697",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-20261107-2qs2lbapgi9",
        "model": "gpt-6.1-sol"
      },
      "text": "Days 4–10 follow a single expedition programme. The exact sites, days for landings and crossing of the Antarctic Circle depend on weather, ice and sea conditions."
    },
    {
      "blockId": "tour:note:de1fe64ed04c2a4e",
      "field": "note",
      "sourceTextSha256": "83571b43198936f21c7f350524fdc26e4d37a77e8fab44f407e29f519dde294e",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-20261107-2qs2lbapgi9",
        "model": "gpt-6.1-sol"
      },
      "text": "Wildlife sightings and views of the southern lights depend on natural conditions."
    },
    {
      "blockId": "tour:note:7a572e45e0a1f413",
      "field": "note",
      "sourceTextSha256": "19ef6eda9cf7804e46c5509075acceddca67d89efa337aeade00b54f7044bbc7",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-20261107-2qs2lbapgi9",
        "model": "gpt-6.1-sol"
      },
      "text": "The currency, ship, cabin availability, meals, language of expedition support, included services, additional costs and diving conditions are confirmed before booking."
    }
  ]

---
import { createHash } from 'node:crypto';
import { isActiveEntity, isArchivedEntity } from '../lib/archive.mjs';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CountryLayout from '../layouts/CountryLayout.astro';
import DestinationLayout from '../layouts/DestinationLayout.astro';
import TourLayout from '../layouts/TourLayout.astro';
import ExcursionLayout from '../layouts/ExcursionLayout.astro';
import EntityCatalogLayout from '../layouts/EntityCatalogLayout.astro';
import RedirectLayout from '../layouts/RedirectLayout.astro';
import {
  aliasesForEntity, assertUniqueRoutePaths, countryPath, countryRoute, destinationCountryPath, destinationPath, destinationRoute,
  excursionBreadcrumbs, excursionCountryPath, excursionDestinationPath, excursionGeography, excursionPath,
  mainTourCountries, optionalTourDestinationPath, pageAliases, routeCountries, tourCountryPath, tourDestinationPath, tourExcursionPath, tourPath,
  type BreadcrumbItem, type CountryRoute, type DestinationRoute,
} from '../lib/routes';
import { excursionDestinationIds } from '../lib/destination-links.mjs';
import { buildExcursionTourCounts, compareExcursionsByPopularity, excursionIdsForTour } from '../lib/excursion-popularity';
import { buildDestinationTourCounts, compareDestinationsByPopularity } from '../lib/destination-popularity';
import { tourHasMainCountry, tourHasMainDestination, tourHasOptionalDestination } from '../lib/tour-relations';
import { paginateCatalog, type CatalogPagination } from '../lib/catalog-pagination';

type DetailProps =
  | { mode: 'detail'; kind: 'country'; entry: CollectionEntry<'countries'> }
  | { mode: 'detail'; kind: 'destination'; entry: CollectionEntry<'destinations'> }
  | { mode: 'detail'; kind: 'tour'; entry: CollectionEntry<'tours'> }
  | { mode: 'detail'; kind: 'excursion'; entry: CollectionEntry<'excursions'> };
type CatalogInput = {
  mode: 'catalog'; kind: 'tour' | 'excursion' | 'destination';
  entries: Array<CollectionEntry<'tours'> | CollectionEntry<'excursions'> | CollectionEntry<'destinations'>>;
  canonical: string; title: string; description: string; breadcrumbs: BreadcrumbItem[]; hero?: string;
  variant?: 'global-tours' | 'global-places' | 'global-excursions';
};
type CatalogProps = CatalogInput & { pagination: CatalogPagination; catalogVersion: string };
type RedirectProps = { mode: 'redirect'; to: string; title: string };
type Props = DetailProps | CatalogProps | RedirectProps;

export async function getStaticPaths() {
  const [countries, destinations, allTours, allExcursions] = await Promise.all([
    getCollection('countries', ({ data }) => data.locale === 'ru' && isActiveEntity(data)),
    getCollection('destinations', ({ data }) => data.locale === 'ru' && isActiveEntity(data)),
    getCollection('tours', ({ data }) => data.locale === 'ru' && (data.status !== 'draft' || isArchivedEntity(data))),
    getCollection('excursions', ({ data }) => data.locale === 'ru' && (data.status !== 'draft' || isArchivedEntity(data))),
  ]);
  const tours = allTours.filter(isActiveEntity);
  const excursions = allExcursions.filter(isActiveEntity);
  const excursionTourCounts = buildExcursionTourCounts(tours);
  const destinationTourCounts = buildDestinationTourCounts(tours);
  // Preserve the existing global tour order; nested catalogues retain priority + title.
  const globalTours = [...tours].sort((a, b) => (b.data.priority ?? 0) - (a.data.priority ?? 0));
  destinations.sort(compareDestinationsByPopularity(destinationTourCounts));
  tours.sort((a, b) => (b.data.priority ?? 0) - (a.data.priority ?? 0) || a.data.title.localeCompare(b.data.title, 'ru'));
  excursions.sort(compareExcursionsByPopularity(excursionTourCounts));
  const tourExcursions = new Map(tours.map((tour) => [tour.data.id, excursionIdsForTour(tour)]));

  const routes: Array<{ params: { path: string }; props: Props }> = [];
  const addRaw = (path: string, props: Props) => routes.push({ params: { path: path.replace(/^\/|\/$/g, '') }, props });
  const add = (path: string, props: DetailProps | CatalogInput | RedirectProps) => {
    if (props.mode !== 'catalog') return addRaw(path, props);
    // Every catalogue, including a new relation catalogue, uses the same static pagination.
    const catalogVersion = createHash('sha256').update(JSON.stringify(props.entries.map((entry) => entry.data.id))).digest('hex').slice(0, 20);
    for (const page of paginateCatalog(props.entries, path)) {
      addRaw(page.pagination.canonical, {
        ...props,
        entries: page.entries,
        canonical: page.pagination.canonical,
        pagination: page.pagination,
        catalogVersion,
      });
    }
  };

  add('/tours/', {
    mode: 'catalog', kind: 'tour', entries: globalTours, canonical: '/tours/', variant: 'global-tours',
    title: 'Туры по Бразилии и Латинской Америке',
    description: 'Индивидуальные, VIP и multi-country маршруты Ada Tours по Бразилии, Аргентине, Перу и другим странам Латинской Америки.',
    breadcrumbs: [{ label: 'Туры', href: '/tours/' }],
    hero: '/media/catalog/tury/hero-enhanced-20260930.webp',
  });
  const activeCountryIds = new Set(countries.map((country) => country.data.id));
  add('/places/', {
    mode: 'catalog', kind: 'destination', entries: destinations.filter((place) => activeCountryIds.has(place.data.countryId)),
    canonical: '/places/', variant: 'global-places',
    title: 'Места Латинской Америки | Ada Tours',
    description: 'Рио-де-Жанейро, Игуасу, Амазония, Пантанал, Буэнос-Айрес, Патагония, Мендоса, Лима, Куско и Мачу-Пикчу в структуре маршрутов Ada Tours.',
    breadcrumbs: [{ label: 'Направления', href: '/places/' }],
    hero: '/media/home/patagonia-enhanced-20260930.webp',
  });
  add('/excursions/', {
    mode: 'catalog', kind: 'excursion', entries: excursions, canonical: '/excursions/', variant: 'global-excursions',
    title: 'Экскурсии в Бразилии и Латинской Америке',
    description: 'Экскурсии Ada Tours по городам и природным территориям Латинской Америки: частные и групповые программы с прямой заявкой принимающему туроператору.',
    breadcrumbs: [{ label: 'Экскурсии', href: '/excursions/' }],
  });

  for (const entry of countries) {
    const canonical = countryPath(entry.data);
    add(canonical, { mode: 'detail', kind: 'country', entry });
    for (const alias of aliasesForEntity('country', entry.data, canonical)) add(alias, { mode: 'redirect', to: canonical, title: entry.data.name });
  }
  for (const entry of destinations) {
    const canonical = destinationPath(entry.data);
    add(canonical, { mode: 'detail', kind: 'destination', entry });
    for (const alias of aliasesForEntity('destination', entry.data, canonical)) add(alias, { mode: 'redirect', to: canonical, title: entry.data.name });

    const country = countryRoute(entry.data.countryId);
    const breadcrumbs: BreadcrumbItem[] = [
      { label: 'Направления', href: '/places/' },
      { label: country.name, href: destinationCountryPath(country) },
      { label: entry.data.name, href: canonical },
    ];
    const mainTours = tours.filter((tour) => tourHasMainDestination(tour.data, entry.data.id));
    if (mainTours.length) {
      const catalogPath = tourDestinationPath(entry.data);
      add(catalogPath, {
        mode: 'catalog', kind: 'tour', entries: mainTours, canonical: catalogPath,
        title: `${entry.data.name}: все туры`,
        description: `Туры Ada Tours, в основной маршрут которых входит ${entry.data.name}.`,
        breadcrumbs: [...breadcrumbs, { label: 'Туры', href: catalogPath }],
        hero: '/media/catalog/tury/hero-enhanced-20260930.webp',
      });
    }
    const optionalTours = tours.filter((tour) => tourHasOptionalDestination(tour.data, entry.data.id));
    if (optionalTours.length) {
      const catalogPath = optionalTourDestinationPath(entry.data);
      add(catalogPath, {
        mode: 'catalog', kind: 'tour', entries: optionalTours, canonical: catalogPath,
        title: `${entry.data.name}: туры с дополнительным посещением`,
        description: `Маршруты Ada Tours, к которым можно добавить посещение места: ${entry.data.name}.`,
        breadcrumbs: [...breadcrumbs, { label: 'Можно добавить', href: catalogPath }],
        hero: '/media/catalog/tury/hero-enhanced-20260930.webp',
      });
    }
  }
  for (const entry of allTours) {
    const canonical = tourPath(entry.data);
    add(canonical, { mode: 'detail', kind: 'tour', entry });
    for (const alias of aliasesForEntity('tour', entry.data, canonical)) add(alias, { mode: 'redirect', to: canonical, title: entry.data.title });
  }

  const excursionCountries = new Map<string, { country: CountryRoute; entries: CollectionEntry<'excursions'>[] }>();
  const excursionDestinations = new Map<string, { country: CountryRoute; destination: DestinationRoute; entries: CollectionEntry<'excursions'>[] }>();
  for (const entry of allExcursions) {
    const canonical = excursionPath(entry.data);
    add(canonical, { mode: 'detail', kind: 'excursion', entry });
    for (const alias of aliasesForEntity('excursion', entry.data, canonical)) add(alias, { mode: 'redirect', to: canonical, title: entry.data.title });
    if (isArchivedEntity(entry)) continue; // Keep page and aliases, exclude every catalogue membership.
    const relatedTours = tours.filter((tour) => tourExcursions.get(tour.data.id)?.has(entry.data.id));
    if (relatedTours.length) {
      const catalogPath = tourExcursionPath(entry.data);
      add(catalogPath, {
        mode: 'catalog', kind: 'tour', entries: relatedTours, canonical: catalogPath,
        title: `Туры с экскурсией «${entry.data.title}»`,
        description: `Все маршруты Ada Tours, в которых есть экскурсия «${entry.data.title}».`,
        breadcrumbs: [
          ...excursionBreadcrumbs(entry.data),
          { label: entry.data.title, href: canonical },
          { label: 'Туры с этой экскурсией', href: catalogPath },
        ],
        hero: '/media/catalog/tury/hero-enhanced-20260930.webp',
      });
    }
    const { country } = excursionGeography(entry.data);
    const countryGroup = excursionCountries.get(country.id) ?? { country, entries: [] };
    countryGroup.entries.push(entry);
    excursionCountries.set(country.id, countryGroup);
    for (const destinationId of excursionDestinationIds(entry.data)) {
      const destination = destinationRoute(destinationId);
      const destinationCountry = countryRoute(destination.countryId);
      const destinationGroup = excursionDestinations.get(destination.id) ?? { country: destinationCountry, destination, entries: [] };
      destinationGroup.entries.push(entry);
      excursionDestinations.set(destination.id, destinationGroup);
    }
  }

  for (const country of routeCountries) {
    const places = destinations.filter((entry) => entry.data.countryId === country.id);
    if (places.length) {
      const canonical = destinationCountryPath(country);
      add(canonical, {
        mode: 'catalog', kind: 'destination', entries: places, canonical,
        title: `Места: ${country.name}`,
        description: `Города, регионы и природные места страны: ${country.name}.`,
        breadcrumbs: [{ label: 'Направления', href: '/places/' }, { label: country.name, href: canonical }],
      });
    }
    const selectedTours = tours.filter((entry) => tourHasMainCountry(entry.data, country.id));
    if (selectedTours.length) {
      const canonical = tourCountryPath(country);
      add(canonical, {
        mode: 'catalog', kind: 'tour', entries: selectedTours, canonical,
        title: `Туры: ${country.name}`,
        description: `Маршруты Ada Tours, в которые входит ${country.name}.`,
        breadcrumbs: [{ label: 'Туры', href: '/tours/' }, { label: country.name, href: canonical }],
        hero: '/media/catalog/tury/hero-enhanced-20260930.webp',
      });
    }
  }
  const multiCountryTours = tours.filter((entry) => mainTourCountries(entry.data).length > 1);
  if (multiCountryTours.length) add('/multi-country/tour/', {
    mode: 'catalog', kind: 'tour', entries: multiCountryTours, canonical: '/multi-country/tour/',
    title: 'Туры по нескольким странам',
    description: 'Маршруты Ada Tours с путешествием по нескольким странам.',
    breadcrumbs: [{ label: 'Туры', href: '/tours/' }, { label: 'Несколько стран', href: '/multi-country/tour/' }],
    hero: '/media/catalog/tury/hero-enhanced-20260930.webp',
  });
  for (const { country, entries } of excursionCountries.values()) {
    const canonical = excursionCountryPath(country);
    add(canonical, {
      mode: 'catalog', kind: 'excursion', entries, canonical,
      title: `Экскурсии: ${country.name}`,
      description: `Экскурсии Ada Tours по стране: ${country.name}.`,
      breadcrumbs: [{ label: 'Экскурсии', href: '/excursions/' }, { label: country.name, href: canonical }],
    });
  }
  for (const { country, destination, entries } of excursionDestinations.values()) {
    const canonical = excursionDestinationPath(destination);
    add(canonical, {
      mode: 'catalog', kind: 'excursion', entries, canonical,
      title: `Экскурсии: ${destination.name}`,
      description: `Экскурсии Ada Tours: ${destination.name}, ${country.name}.`,
      breadcrumbs: [{ label: 'Экскурсии', href: '/excursions/' }, { label: country.name, href: excursionCountryPath(country) }, { label: destination.name, href: canonical }],
    });
  }
  for (const { from, to, title } of pageAliases) {
    add(from, { mode: 'redirect', to, title: title ?? 'Страница перемещена' });
  }
  return assertUniqueRoutePaths(routes);
}

const props = Astro.props;
const Content = props.mode === 'detail' ? (await render(props.entry)).Content : null;
---

{props.mode === 'redirect' ? (
  <RedirectLayout to={props.to} title={props.title} />
) : props.mode === 'catalog' ? (
  <EntityCatalogLayout {...props} />
) : Content && props.kind === 'country' ? (
  <CountryLayout entry={props.entry}><Content /></CountryLayout>
) : Content && props.kind === 'destination' ? (
  <DestinationLayout entry={props.entry}><Content /></DestinationLayout>
) : Content && props.kind === 'tour' ? (
  <TourLayout entry={props.entry}><Content /></TourLayout>
) : Content && props.kind === 'excursion' ? (
  <ExcursionLayout entry={props.entry}><Content /></ExcursionLayout>
) : null}

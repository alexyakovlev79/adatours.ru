    },
    {
      "blockId": "tour:itinerary_title:8fa505c430bf2bb8",
      "field": "itinerary.title",
      "mode": "word_span",
      "text": "Hotu Matua’s legacy",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1zUNi_nTIgTJ0v2CQiDYg3A4tsff1HaQ5",
        "revision": "2026-10-22T14:03:05.061Z",
        "documentSha256": "e8797275b1b80fec09e917a42a64128fccde97924b970f75f592f0cbcb149492",
        "paragraphs": [
          {
            "ref": "word/document.xml#p0085",
            "textSha256": "56faa7772953b2fcbd6605f8a67e688bcd4162b1c1b8ab889315b1b27fa31231"

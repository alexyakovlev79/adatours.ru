        "runId": "ada-en-20261109-ddf5eabec8e2",
        "model": "gpt-6.1-sol"
      },
      "text": "Manaus and the Amazon"
    },
    {
      "blockId": "tour:itinerary_label:6dbf81ffb5283815",
      "field": "itinerary.label",

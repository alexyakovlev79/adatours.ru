---
import AuthorityInline from './AuthorityInline.astro';
import { authorityDate, type AuthorityPartner, type AuthoritySourceCopy } from './content';

interface Props {
  id: string;
  title: string;
  eyebrow: string;
  intro?: string;
  paragraphsMarkdown?: string[];
  partners: AuthorityPartner[];
  entries: AuthoritySourceCopy[];
}
const { id, title, eyebrow, intro, paragraphsMarkdown = [], partners, entries } = Astro.props;
const copyForSource = new Map(entries.map((entry) => [entry.sourceId, entry]));
---

<section id={id} class="authority-partners section" aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="authority-partners__heading">
      <div><p class="eyebrow">{eyebrow}</p><h2 id={`${id}-title`}>{title}</h2></div>
      <div class="authority-partners__intro">
        {intro && <p>{intro}</p>}
        {paragraphsMarkdown.map((text) => <p><AuthorityInline text={text} /></p>)}
      </div>
    </header>
    <div class="authority-partners__list">
      {partners.map((partner) => (
        <article id={copyForSource.get(partner.sources[0]?.id)?.anchorId} class="authority-partners__item">
          <div class="authority-partners__identity">
            <p class="authority-partners__role">{partner.role}</p>
            <h3><a href={partner.url} target="_blank" rel="external noopener noreferrer">{partner.name}<span aria-hidden="true">↗</span></a></h3>
          </div>
          <div class="authority-partners__body">
            <p class="authority-partners__description"><AuthorityInline text={partner.description} /></p>
            <ul class="authority-partners__sources">
              {partner.sources.map((source) => {
                const copy = copyForSource.get(source.id);
                const date = authorityDate(source);
                return (
                  <li data-authority-source={source.id}>
                    <a href={source.url} target="_blank" rel="external noopener noreferrer">
                      <span>{copy?.linkLabel || source.label || source.name}</span><span aria-hidden="true">↗</span>
                    </a>
                    <span class="authority-partners__source-name" lang={source.language}>{source.name}</span>
                    <span class="authority-partners__source-meta">{source.publisher.name}{date && <> · <time datetime={date.value}>{date.label}</time></>}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .authority-partners,
  .authority-partners__item { scroll-margin-top: calc(var(--header-h) + 24px); }
  .authority-partners__heading,
  .authority-partners__item { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.25fr); gap: 24px clamp(28px, 5vw, 72px); }
  .authority-partners__heading { align-items: end; margin-bottom: 30px; }
  .eyebrow { margin: 0 0 14px; color: var(--color-brand-deep); }
  h2 { margin: 0; font-size: clamp(1.9rem, 2.6vw, 2.85rem); line-height: 1.12; }
  .authority-partners__intro p { margin: 0 0 14px; color: var(--color-text-muted); }
  .authority-partners__intro p:last-child { margin-bottom: 0; }
  .authority-partners__list { border-top: 1px solid var(--color-line); }
  .authority-partners__item { padding-block: 30px; border-bottom: 1px solid var(--color-line); }
  .authority-partners__role { margin: 0 0 12px; color: var(--color-brand-deep); font-size: .8rem; font-weight: 600; }
  h3 { margin: 0; font-size: clamp(1.5rem, 2vw, 2rem); line-height: 1.18; }
  h3 a:hover { color: var(--color-brand-deep); }
  h3 a span { display: inline-block; margin-left: 12px; font-size: 1.1rem; color: var(--color-brand-deep); }
  .authority-partners__body { min-width: 0; }
  .authority-partners__description { margin: 0 0 18px; color: var(--color-text-muted); }
  .authority-partners__sources { margin: 0; padding: 0; list-style: none; }
  .authority-partners__sources li + li { margin-top: 18px; }
  .authority-partners__sources a { display: inline-flex; align-items: baseline; gap: 10px; font-size: .9rem; font-weight: 600; color: var(--color-brand-deep); }
  .authority-partners__sources a span:first-child { text-decoration: underline; text-underline-offset: .2em; text-decoration-color: color-mix(in srgb, var(--color-brand-deep) 35%, transparent); }
  .authority-partners__sources a:hover span:first-child { text-decoration-color: currentColor; }
  .authority-partners__source-name,
  .authority-partners__source-meta { display: block; margin-top: 5px; color: var(--color-text-muted); font-size: .78rem; line-height: 1.6; }
  @media (max-width: 820px) {
    .authority-partners__heading,
    .authority-partners__item { grid-template-columns: 1fr; gap: 20px; }
    .authority-partners__item { padding-block: 26px; }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import EditorialProof from '../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
---

<BaseLayout
  title="MICE и корпоративные поездки в Латинской Америке"
  description="MICE, деловые делегации, incentive и корпоративные группы по Бразилии и Латинской Америке."
>
  <Hero
    eyebrow="MICE"
    title="Деловая поездка должна работать как один сценарий"
    intro="Перелеты, встречи, транспорт, площадки и свободное время связываются одной локальной координацией."
    image="/media/prototype/rio-panorama.jpg"
    ctaLabel="Обсудить группу"
  />

  <EditorialStatement
    eyebrow="Корпоративные группы"
    text="Встречи, транспорт и программа работают как один сценарий, которым на месте управляет одна команда."
  />

  <FactStrip
    wideFirst
    facts={[
      { value: 'Бразилия', label: 'ключевое направление MICE' },
      { value: 'Группы', label: 'корпоративные и incentive поездки' },
      { value: 'DMC', label: 'локальная координация программы' },
      { value: 'Multi', label: 'маршруты по нескольким странам' },
    ]}
  />

  <EditorialProof
    eyebrow="Деловые делегации"
    title="Встречи, визиты и городская программа в одной логистике"
    text="Между встречами важна точная логистика: аэропорт, переезды, питание, переводчики и резерв на изменения."
    image="/media/prototype/rio-night.jpg"
    facts={[
      'Трансферы и транспорт на протяжении программы',
      'Гиды и переводческое сопровождение по запросу',
      'Площадки, рестораны и вечерние активности',
      'Резервные сценарии при изменении графика',
    ]}
  />

  <ProcessSteps
    eyebrow="Организация"
    title="Сначала деловая задача, потом туристическая оболочка"
    steps={[
      { title: 'Задача', text: 'Формат, участники, обязательные встречи и ограничения по времени.' },
      { title: 'Логистика', text: 'Перелеты, транспорт, размещение и последовательность деловой программы.' },
      { title: 'Программа', text: 'Рестораны, экскурсии и мероприятия без конфликта с расписанием.' },
      { title: 'Координация', text: 'На месте одна команда держит расписание и изменения.' },
    ]}
    dark
  />

  <LeadForm title="Рассчитать MICE или деловую поездку" entityId="mice" />
</BaseLayout>

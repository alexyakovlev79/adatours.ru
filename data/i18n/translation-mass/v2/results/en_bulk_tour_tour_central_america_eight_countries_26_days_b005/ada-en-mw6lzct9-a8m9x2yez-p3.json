      },
      "text": "Arrival in Mexico City"
    },
    {
      "blockId": "tour:itinerary_text:5a4836cca1208c95",
      "field": "itinerary.text",
      "sourceTextSha256": "95de62afc99b8233728820f4e12f0f565a2c5c37f0e84c6108f96624a2f1e217",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6lzct9-a8m9x2yez",
        "model": "gpt-6.1-sol"
      },
      "text": "Your dedicated representative will meet you at Mexico City International Airport. Transfer to your hotel, check in and rest after the flight. If you feel like stretching your legs, you can take a first walk around the city on your own. Overnight in Mexico City."
    },
    {
      "blockId": "tour:itinerary_label:2141c79819815b21",

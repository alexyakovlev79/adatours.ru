---
import { themeNames } from '../../lib/interest-model.mjs';
interface Props {
  title: string;
  summary: string;
  entityType: 'country' | 'destination' | 'tour' | 'excursion';
  typeLabel: string;
  subtitle: string;
  aliases?: string[];
  geography?: string[];
  themes?: string[];
  image?: string;
  tourCount?: number;
  tourCountryCount?: number;
  tourDurationDays?: number;
}
const {
  title, summary, entityType, typeLabel, subtitle, aliases = [], geography = [], themes = [], image,
  tourCount, tourCountryCount, tourDurationDays,
} = Astro.props;
---
<section class="pagefind-record" data-pagefind-body aria-hidden="true">
  <span data-pagefind-meta="title" data-pagefind-filter="search_title">{title}</span>
  <p data-pagefind-meta="summary">{summary}</p>
  <span data-pagefind-meta="entity_type" data-pagefind-filter="entity_type">{entityType}</span>
  <span data-pagefind-meta="type_label">{typeLabel}</span>
  <span data-pagefind-meta="subtitle">{subtitle}</span>
  {typeof tourCount === 'number' && <span data-pagefind-meta="tour_count[data-tour-count]" data-tour-count={tourCount}></span>}
  {typeof tourCountryCount === 'number' && <span data-pagefind-meta="tour_country_count">{tourCountryCount}</span>}
  {typeof tourDurationDays === 'number' && <span data-pagefind-meta="tour_duration_days">{tourDurationDays}</span>}
  {aliases.length > 0 && <span data-pagefind-meta="aliases">{aliases.join(' | ')}</span>}
  {geography.length > 0 && <span data-pagefind-meta="geography">{geography.join(' | ')}</span>}
  {themes.length > 0 && <span data-pagefind-meta="themes">{[...new Set([...themeNames(themes), ...themes])].join(' | ')}</span>}
  {image && <img src={image} alt="" data-pagefind-meta="image[src]" />}
</section>
<style>
  .pagefind-record{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);clip-path:inset(50%);white-space:nowrap;border:0;pointer-events:none}
</style>

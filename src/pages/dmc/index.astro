---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import EditorialProof from '../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import DmcNav from '../../components/commercial/DmcNav.astro';
import DmcFaq from '../../components/commercial/DmcFaq.astro';
import CommercialDetails from '../../components/commercial/CommercialDetails.astro';
import DestinationBand from '../../components/editorial/DestinationBand.astro';
import { ORG } from '../../data/organization/ada-tours';
---

<BaseLayout
  leadTitle="Запросить B2B-предложение"
  leadEntityId="dmc"
  title="DMC в Бразилии и Латинской Америке | принимающий туроператор в Южной Америке Ada Tours"
  description="Ada Tours — принимающий туроператор и DMC в Бразилии: FIT, группы, VIP, MICE и multi-country программы для турагентств и туроператоров по Латинской Америке."
  image="/media/home/rio-night-enhanced-20260930.webp"
>
  <Hero
    eyebrow="DMC · B2B"
    title="DMC в Бразилии и Латинской Америке для туроператоров и турагентств"
    intro="Ada Tours как принимающий партнер собирает наземную программу: маршруты, отели, трансферы, гидов, экскурсии, MICE и multi-country поездки."
    image="/media/home/rio-night-enhanced-20260930.webp"
    ctaHref="#request"
    ctaLabel="Запросить предложение"
  />

  <DmcNav active="overview" />

  <EditorialStatement
    eyebrow="Партнерская работа"
    text="Один запрос превращается в связанную программу с маршрутом, размещением, транспортом и локальной координацией."
  />

  <FactStrip
    wideFirst
    facts={[
      { value: 'Бразилия', label: 'ключевое направление Ada Tours' },
      { value: String(ORG.service.languages.length), label: 'языков коммуникации' },
      { value: ORG.service.groups.standard.display, label: ORG.service.groups.standard.label },
      { value: ORG.service.groups.largeEvents.display, label: ORG.service.groups.largeEvents.label },
    ]}
  />

  <EditorialProof
    eyebrow="Что берем на себя"
    title="Наземная программа от аэропорта до последнего трансфера"
    text="Собираем последовательность поездки и связываем услуги так, чтобы партнер работал с одной программой, а не с набором отдельных подрядчиков."
    image="/media/home/buenos-aires-enhanced-20260930.webp"
    facts={[
      'Маршрут и наземная логистика',
      'Отели, трансферы и транспорт',
      'Гиды, экскурсии и локальная координация',
      'MICE, VIP и специальные запросы',
    ]}
  />

  <EditorialProof
    eyebrow="Форматы"
    title="От FIT до крупных групп и маршрутов по нескольким странам"
    text="Ada Tours работает с индивидуальными поездками, группами, VIP и MICE. Для multi-country программ связываем страны региона в одну последовательность."
    image="/media/home/patagonia-enhanced-20260930.webp"
    facts={[
      'FIT и индивидуальные путешествия',
      'Групповые программы',
      'VIP и сложные частные запросы',
      'MICE и деловые поездки',
      'Multi-country маршруты',
    ]}
    reverse
  />

  <EditorialProof
    eyebrow="Коммерческая работа"
    title="Роли сторон и условия конкретной поездки"
    text="Для каждого запроса определяем программу, объем местных услуг и условия сотрудничества. Тарифную модель, порядок работы с клиентом и условия подтверждения бронирований важно согласовать отдельно."
    image="/media/destinations/foz-do-iguacu/gallery-1-enhanced-20261001.webp"
    facts={[
      'Распределение задач между агентством и Ada Tours',
      'Порядок общения с гостями во время поездки',
      'Состав услуг и расчет для выбранных дат',
      'Письменные условия подтверждения и изменений',
    ]}
  />

  <DestinationBand
    eyebrow="Выполненный кейс · 2026"
    title="Корпоративная группа из 30 человек: Рио и Ангра-дус-Рейш"
    text="Автобусы, гиды, катамаран, питание, экскурсии и вечернее мероприятие в единой программе."
    image="/media/destinations/angra-dos-reis/hero-enhanced-20261001.webp"
    href="/cases/corporate-group-rio-angra-2026/"
  />

  <CommercialDetails
    id="dmc-coverage"
    eyebrow="Подтвержденный опыт и примеры"
    title="Что можно оценить до первого запроса"
    rows={[
      { title: 'Выполненные проекты', text: 'Два опубликованных NDA-кейса в Бразилии показывают работу с корпоративной группой из 30 гостей и делегацией из 8 человек.', href: '/cases/', linkLabel: 'Посмотреть кейсы Ada Tours' },
      { title: 'B2B-программы', text: 'Предложения по Панаме, Бразилии и аграрной Аргентине содержат подробные дни, варианты транспорта, сопровождения и экскурсий. Это примеры возможных маршрутов, а не отчеты о состоявшихся поездках.', href: '/mice/programmes/', linkLabel: 'Изучить программы по дням' },
      { title: 'Условия партнерства', text: 'Перед подтверждением поездки отдельно согласуются коммерческая модель, документы, общение с клиентом, объем операционной помощи и правила изменений.', href: '/dmc/terms/', linkLabel: 'Условия B2B-работы' },
    ]}
  />

  <ProcessSteps
    eyebrow="Как строится запрос"
    title="От первого письма до исполнения программы"
    steps={[
      { title: 'Бриф', text: 'Даты, география, состав группы, бюджет и обязательные элементы.' },
      { title: 'Маршрут', text: 'Связываем города, перелеты, трансферы, размещение и программу.' },
      { title: 'Предложение', text: 'Фиксируем состав услуг и расчет после проверки доступности.' },
      { title: 'На месте', text: 'Локальная команда координирует подрядчиков и изменения по ходу поездки.' },
    ]}
    dark
  />

  <DmcFaq
    title="DMC в Бразилии: коротко о работе"
    items={[
      {
        question: 'Что входит в DMC-обслуживание Ada Tours?',
        answer: 'Маршрут, размещение, трансферы и транспорт, гиды, экскурсии и локальная координация. Для MICE и VIP состав услуг дополняется под конкретный запрос.',
      },
      {
        question: 'С какими форматами поездок работает Ada Tours?',
        answer: 'FIT, групповые программы, VIP, MICE и multi-country маршруты по Бразилии и другим странам Латинской Америки.',
      },
      {
        question: 'Какая география у DMC Ada Tours?',
        answer: 'Ключевое направление — Бразилия. Также Ada Tours собирает программы по Аргентине, Перу и другим странам Латинской Америки.',
      },
      {
        question: 'На каких языках можно вести B2B-запрос?',
        answer: `Ada Tours обрабатывает заявки на ${ORG.service.languages.length} языках: ${ORG.service.languages.join(', ')}.`,
      },
    ]}
  />
</BaseLayout>

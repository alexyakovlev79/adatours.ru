      "sourceTextSha256": "aabb3be0d69a9a56e62f7a2fb27cead3f27accf2c3962b0f839b8e31f39501c1",
      "text": "Brazilian Side of Iguaçu Falls, Macuco Safari, Bird Park and Helicopter",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-mw9larkh-8ge0qr1dl",
        "model": "GPT-6.1-sol"

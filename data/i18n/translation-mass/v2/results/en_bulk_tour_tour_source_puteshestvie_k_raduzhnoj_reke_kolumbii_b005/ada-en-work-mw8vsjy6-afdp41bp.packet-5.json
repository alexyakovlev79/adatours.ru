      "field": "itinerary.text",
      "sourceTextSha256": "7068e9efaf8abb5d3e36e67d19bd1f90dfa5ef8eed79840c49eb0c77ce4c6a73",
      "text": "After breakfast, transfer to El Dorado International Airport. The charter flight to La Macarena is included in the tour price. You’ll be met at the airport on arrival.\n\nBefore the nature visits begin, you’ll attend a briefing with conservation officials, who determine which areas of Sierra de la Macarena National Park are open to visitors that day.\n\nAfter the briefing, transfer to your hotel, check in and take some time to rest.\n\nLunch in town and dinner in the evening are included.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-work-mw8vsjy6-afdp41bp",
        "model": "GPT-6"
      }
    },

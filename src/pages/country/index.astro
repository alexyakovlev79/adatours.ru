---
import { isActiveEntity } from '../../lib/archive.mjs';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { countryPath } from '../../lib/routes';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import DestinationBand from '../../components/editorial/DestinationBand.astro';
import { buildCountryTourCounts, compareCountriesByPopularity } from '../../lib/country-popularity';

const tours = await getCollection('tours', ({ data }) =>
  data.locale === 'ru' && isActiveEntity(data)
);

const countryTourCounts = buildCountryTourCounts(tours);

const countries = (await getCollection('countries', ({ data }) =>
  data.locale === 'ru' && isActiveEntity(data)
)).sort(compareCountriesByPopularity(countryTourCounts));

const countryAlignments = new Map([
  ['kuba', 'left'],
  ['meksika', 'right'],
  ['nikaragua', 'left'],
  ['panama', 'right'],
]);
---

<BaseLayout
  title="Страны Латинской Америки | Путешествия с Ada Tours"
  description="Бразилия, Аргентина, Перу и другие направления Латинской Америки. Страны, города, маршруты и тематические поездки с локальной координацией Ada Tours."
>
  <Hero
    eyebrow="Страны"
    title="Латинская Америка на ваших условиях"
    intro="Бразилия, Аргентина, Перу и другие страны региона. Выберите направление, а мы соберем поездку вокруг ваших дат, интересов и времени."
    image="/media/home/patagonia-enhanced-20260930.webp"
  />

  <EditorialStatement
    eyebrow="С чего начать"
    text="Одна страна или несколько. Большие города, океан, джунгли, винные долины и Патагония могут стать частями одной поездки."
  />

  {countries.map((country, index) => (
    <DestinationBand
      title={country.data.name}
      text={country.data.summary}
      image={country.data.hero?.src}
      imageTextAlign={country.data.imageTextAlign}
      href={countryPath(country.data)}
      align={countryAlignments.get(country.data.slug) ?? (index % 2 === 1 ? 'right' : 'left')}
    />
  ))}
</BaseLayout>

---
import { buildInterestIndex, countLabel } from '../../lib/interest-model.mjs';
import { getCollection } from 'astro:content';
import { interestTourCount } from '../../lib/interest-copy.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { themePath } from '../../lib/routes';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import DestinationBand from '../../components/editorial/DestinationBand.astro';

const [entries, tours] = await Promise.all([getCollection('themes'), getCollection('tours')]);
const themes = buildInterestIndex(entries, tours);

---

<BaseLayout
  title="Тематические туры по интересам в Бразилию и Латинскую Америку | Ada Tours"
  description="13 тематических интересов: природа и животные, культура и история, круизы и экспедиции, события и праздники, приключения, пляжи, гастрономия, рыбалка, дайвинг, мото-туры, семейные поездки, SPA и романтика Южной Америки."
>
  <Hero
    eyebrow="По интересам"
    title="Начните с того, ради чего едете"
    intro="Животные, древние города, океан, экспедиция, праздник или путешествие вдвоем. Мы подберем географию и программу под ваш интерес."
    image="/media/pages/po-interesam/hero-enhanced-20261001.webp"
  />

  <EditorialStatement
    eyebrow={countLabel(themes.length, ['интерес', 'интереса', 'интересов'])}
    text="Одна тема может задать всю поездку или стать ее лучшей частью."
  />

  <div data-interest-index>
  {themes.map(({ entry: theme, tourCount }, index) => (
    <div data-interest-index-item={theme.data.id} data-interest-tour-count={tourCount}>
    <DestinationBand
      eyebrow={interestTourCount(theme.data.id, tourCount)}
      title={theme.data.name}
      text={theme.data.summary}
      image={theme.data.hero?.src}
      imageTextAlign={theme.data.imageTextAlign}
      href={themePath(theme.data)}
      align={index % 3 === 1 ? 'right' : 'left'}
    />
    </div>
  ))}
  </div>
</BaseLayout>

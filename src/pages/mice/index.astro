---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import EditorialProof from '../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
---

<BaseLayout
  title="MICE и корпоративные поездки в Латинской Америке"
  description="MICE, деловые делегации, incentive и корпоративные группы по Бразилии и Латинской Америке."
>
  <Hero
    eyebrow="MICE"
    title="Деловая поездка должна работать как один сценарий"
    intro="Перелеты, встречи, транспорт, площадки, рестораны, экскурсии и свободное время должны быть связаны одной локальной координацией."
    image="/media/prototype/rio-panorama.jpg"
    ctaLabel="Обсудить группу"
  />

  <EditorialStatement
    eyebrow="Корпоративные группы"
    text="MICE-страница Ada Tours не должна выглядеть отдельным корпоративным сайтом. Та же крупная фотография и editorial-подача, но больше фактов, процесса и доказательств."
  />

  <FactStrip
    facts={[
      { value: 'Brazil', label: 'ключевой MICE-рынок Ada Tours' },
      { value: 'Groups', label: 'корпоративные и incentive поездки' },
      { value: 'DMC', label: 'локальная координация программы' },
      { value: '24/7', label: 'формулировку поддержки подтвердить до production' },
    ]}
  />

  <EditorialProof
    eyebrow="Деловые делегации"
    title="Встречи, визиты и городская программа в одной логистике"
    text="Для деловой поездки критично не только расписание встреч, но и время между ними: аэропорт, переезды, питание, переводчики, вечерняя программа и резерв на изменения."
    image="/media/prototype/rio-night.jpg"
    facts={[
      'Трансферы и транспорт на протяжении программы',
      'Гиды и переводческое сопровождение по запросу',
      'Площадки, рестораны и вечерние активности',
      'Резервные сценарии при изменении графика',
    ]}
  />

  <ProcessSteps
    eyebrow="Организация"
    title="Сначала деловая задача, потом туристическая оболочка"
    steps={[
      { title: 'Задача', text: 'Фиксируем формат поездки, количество участников, обязательные встречи и ограничения по времени.' },
      { title: 'Логистика', text: 'Строим перелеты, транспорт, районы размещения и последовательность деловой программы.' },
      { title: 'Experience', text: 'Добавляем рестораны, экскурсии, мероприятия и свободное время без конфликта с основным расписанием.' },
      { title: 'Координация', text: 'На месте одна команда держит расписание и изменения в связке с организатором.' },
    ]}
    dark
  />

  <LeadForm title="Рассчитать MICE или деловую поездку" entityId="mice" />
</BaseLayout>

      "sourceTextSha256": "f9c947da895eae642a36ea59857065ce7d72e5b9cc5a782e96ac44fe70d208b4",
      "text": "Yaxhá to San Ignacio, Belize",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-mw9larkh-8ge0qr1dl",
        "model": "GPT-6.1-sol"

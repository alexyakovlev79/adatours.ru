      "text": "Rábida Island and Caleta Tortuga Negra",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "170muBAtzfAXqU5AFTrAF4r5ASocWo6Zo",
        "documentSha256": "9087ba3b9168653a1b1d2f14224ffe39152a8fb6bdf24b152043a9f8c051798c",
        "paragraphs": [
          {
            "ref": "word/media/image1.png#day6",
            "textSha256": "1a145c99b14046c082243ad7703085d847bad6eb91cc22fb9a0ed9f8833e5465"

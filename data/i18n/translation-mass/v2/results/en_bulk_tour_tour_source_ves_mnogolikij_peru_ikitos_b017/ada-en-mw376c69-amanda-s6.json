      "text": "Iquitos and the Amazon",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1HUcx7Nusxl1dJaVomfCcgBTtYnOz96rw",
        "documentSha256": "a973488b59572d34dcc1d29cd7c3bb53c73753f99b7f2595a89ed4bb1cdb1002",
        "paragraphs": [
          {
            "ref": "word/document.xml:p[123]",

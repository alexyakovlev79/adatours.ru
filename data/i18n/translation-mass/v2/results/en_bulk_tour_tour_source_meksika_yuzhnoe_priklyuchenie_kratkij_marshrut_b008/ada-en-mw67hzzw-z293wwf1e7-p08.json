    {
      "blockId": "tour:itinerary_text:b9ad3e14216c2f08",
      "field": "itinerary.text",
      "sourceTextSha256": "615ed9c36d47f388a6ef997e543c31b2983ddacbd3b70aedeb543e43039e2665",

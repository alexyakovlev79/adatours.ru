---
import { isActiveEntity } from '../../lib/archive.mjs';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import DestinationBand from '../../components/editorial/DestinationBand.astro';
import AboutNav from '../../components/commercial/AboutNav.astro';

const cases = (await getCollection('cases', ({ data }) =>
  data.locale === 'ru' && isActiveEntity(data)
)).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---

<BaseLayout
  title="Кейсы Ada Tours: группы, делегации и сложные маршруты"
  description="Выполненные поездки Ada Tours: корпоративные группы и делегации в Бразилии, индивидуальный маршрут по Перу и Боливии. Задачи, логистика и работа команды."
  image="/media/home/rio-night-enhanced-20260930.webp"
>
  <Hero
    eyebrow="Кейсы"
    title="Кейсы Ada Tours: группы, делегации и сложные маршруты"
    intro="Корпоративная группа в Рио и Ангре, деловая делегация в Сан-Паулу и Кампинасе, индивидуальная поездка по Перу и Боливии. Рассказываем, как были устроены маршруты, транспорт и сопровождение."
    image="/media/home/rio-night-enhanced-20260930.webp"
  />

  <AboutNav active="cases" />

  <EditorialStatement
    eyebrow="Работа на месте"
    text="У каждой поездки своя задача: собрать группу на катамаране, успеть на переговоры или связать Амазонию, Мачу-Пикчу и Уюни. В кейсах показаны решения команды и детали обслуживания."
  />

  {cases.map((item, index) => (
    <DestinationBand
      eyebrow={item.data.segment}
      title={item.data.title}
      text={item.data.summary ?? [item.data.groupSize, item.data.duration, item.data.cities.join(' · ')].filter(Boolean).join(' · ')}
      image={item.data.hero?.src}
      href={`/cases/${item.data.slug}/`}
      align={index % 2 === 1 ? 'right' : 'left'}
    />
  ))}
</BaseLayout>


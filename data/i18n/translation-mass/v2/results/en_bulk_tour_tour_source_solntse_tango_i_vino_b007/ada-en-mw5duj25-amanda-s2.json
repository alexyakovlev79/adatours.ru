    {
      "blockId": "tour:itinerary_text:2e780f63f4172747",
      "field": "itinerary.text",
      "sourceTextSha256": "3d05c27653ac70a6f17991528f4364291bee3b88aa315569e683508c1fa02869",
      "text": "Breakfast. City tour (3 hours) with an English-speaking guide, discovering a capital of elegant architecture, museums, galleries and theatres: the old district of La Boca; historic San Telmo, with its bars, restaurants and antiques market on Plaza Dorrego; Plaza de Mayo, the heart of the city, with the Casa Rosada, the presidential palace associated with Eva Perón; the 67-metre Obelisk, symbol of the city, on Avenida 9 de Julio, one of the widest avenues in the world; elegant Recoleta, with its famous cemetery and the colonial-style church of El Pilar; and modern Puerto Madero and the Lezama and 3 de Febrero parks.",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1DMIc4Lqk8YLPIAI6ApWDyg-EBSRf3zSe",

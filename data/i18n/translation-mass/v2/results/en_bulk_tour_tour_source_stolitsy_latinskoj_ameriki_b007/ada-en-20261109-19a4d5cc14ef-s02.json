    {
      "blockId": "tour:itinerary_text:b9ad3e14216c2f08",
      "field": "itinerary.text",
      "sourceTextSha256": "c6658f5cc0cf097e10f95c62bd4be185173618d124a9464f8d6c4dda46359129",
      "text": "After breakfast, set out on a full-day tour of a traditional Argentine ranch.\n\nThe programme introduces gaucho customs, rural life on the Pampas and local folklore. The day features equestrian shows, dancing and music. Traditional Argentine meat dishes are served at lunch.\n\nFor Argentines, the Pampas evoke both the landscape and the culture of the horsemen who lived and worked on these vast plains. At the ranch, you can see how those traditions have become a modern show, with horseback riding, music, dancing and demonstrations of how gauchos handle horses and cattle.\n\nThe tour runs from approximately 10:00 to 17:00. Meals: breakfast and lunch.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-19a4d5cc14ef",
        "model": "ChatGPT Codex"
      }
    },

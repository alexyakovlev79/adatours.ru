      },
      "text": "Victoria Island: clear water, tall trees and mountains in the distance"
    },
    {
      "blockId": "tour:itinerary_title:02b05f9c4c806e6e",
      "field": "itinerary.title",
      "sourceTextSha256": "95d88166bc3a7cb8dec4f026b5e6097efa05d15e1bafb27940fbae82d2610202",
      "provenance": {

    {
      "blockId": "tour:itinerary_text:2e780f63f4172747",
      "field": "itinerary.text",
      "sourceTextSha256": "b30a7f2f18a520168600872da13c41d2a70a0c0ac71c35d7d7738735aef916b0",
      "text": "After breakfast, ride through the Pantanal’s open floodplains and shallow waters on horseback. Return to the lodge for lunch.\n\nIn the afternoon, follow the Rondon Trail to the 13-metre Jabiru Tower. If conditions are favourable, you may see a jabiru stork’s nest. Details of the riding and walking programme are given in the excursion below.\n\nReturn to Araras Eco Lodge for dinner and your final, third night in the Pantanal.\n\nMeals: breakfast, lunch and dinner.",
      "provenance": {
        "kind": "ai_translation",
        "model": "ChatGPT",
        "runId": "ada-en-5d56534e4493",
        "wordAbsenceReason": "Word paragraph 51 gives the full horseback and Rondon Trail excursion, not this current short RU day wrapper with an excursion-below pointer and an explicit third-night count. Translate the current wrapper without duplicating the separate excursion; 13-metre tower, meals and three-night stay are corroborated by paragraphs 51 and 63–64."
      }
    },

---
import AuthoritySpeaker from '../authority/AuthoritySpeaker.astro';
import { stageFiveText } from '../../lib/i18n/stage-five-copy.mjs';
interface Props { title?: string; text?: string; }
const { title = 'Обсудите задачу с командой, которая работает на месте', text = 'Ada Tours работает из Рио-де-Жанейро. Основатель компании Анна Аванесова знакомит партнеров с направлениями и практикой организации поездок на [вебинарах для турагентств](/webinars/). Пришлите вашу задачу: команда свяжет пожелания гостей с маршрутом и условиями местных поставщиков.' } = Astro.props;
---
<AuthoritySpeaker
  section={{ id: 'commercial-expert', eyebrow: stageFiveText('Экспертиза Ada Tours'), heading: stageFiveText(title), paragraphsMarkdown: [stageFiveText(text)] }}
  speaker={{ name: stageFiveText('Анна Аванесова'), role: stageFiveText('Основатель и руководитель Ada Tours'), photo: '/media/people/anna-avanesova/photo-enhanced-20261022-v2.webp', photoAlt: stageFiveText('Анна Аванесова, основатель Ada Tours'), href: '/team/anna-avanesova/', linkLabel: stageFiveText('Опыт и выступления Анны') }}
/>

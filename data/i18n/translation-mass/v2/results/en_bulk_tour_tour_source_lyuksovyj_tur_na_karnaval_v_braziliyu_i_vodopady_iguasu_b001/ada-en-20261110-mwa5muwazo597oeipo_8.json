      },
      "text": "8-Day Brazil Tour: Rio Carnival and Iguazu Falls"
    },
    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "d78a55f672d41ae37e272b069fd3a22ca503bdc342f73db34e8ab340c066932d",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261110-mwa5muwazo597oeipo",
        "model": "GPT-6.1"
      },
      "text": "This premium itinerary combines Carnival in Rio de Janeiro with Iguazu Falls. In Rio, stay at Copacabana Palace and attend the Carnival Ball and the Champions Parade from a private box at the Sambadrome. The program also includes private tours, a helicopter flight and visits to Corcovado and Sugarloaf Mountain. Continue to Belmond das Cataratas at Iguazu Falls, visit both the Brazilian and Argentine sides of the falls and take a private Macuco Safari boat ride."

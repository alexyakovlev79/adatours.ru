    {
      "blockId": "tour:itinerary_text:b04d5d61d358e759",
      "field": "itinerary.text",
      "sourceTextSha256": "d9a6b3598c0fe7fa57b2a245ad158be8e10ff4839780df3ab202db0a5882c5ec",
      "text": "Days 5–6 · Bigi Pan, in western Suriname near the Atlantic coast, is a vast coastal lagoon and mangrove wetland, a paradise for birdwatchers, home to well over a hundred bird species, including the famous scarlet ibis, herons, kingfishers and many migratory birds. After a 3-hour drive along the coast and countryside to the Nickerie River, continue by boat into the wetlands; its name means “big lake” in Sranan Tongo. Watch birds in the mangroves, spot caimans at night and enjoy a mud bath if you wish. Night 5 in an overwater lodge on the lagoon with all meals; night 6 back at your hotel in Paramaribo.",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1v4Kg0c01iPGjpPGM6jFrRnyVCcSfRV-F",

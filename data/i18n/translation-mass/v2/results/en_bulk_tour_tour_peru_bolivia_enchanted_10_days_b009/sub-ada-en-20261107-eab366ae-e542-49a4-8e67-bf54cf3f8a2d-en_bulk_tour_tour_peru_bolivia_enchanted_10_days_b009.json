        "model": "ChatGPT"
      },
      "text": "The shared group tour runs with a minimum of two participants on the listed 2027 departure dates."
    },
    {
      "blockId": "tour:note:9a9e56930919054a",
      "field": "note",
      "sourceTextSha256": "8f5e5938a203904d87d310a841dfd84191c4a245e3173cd62d23d5f900dbb2bb",

    {
      "blockId": "tour:itinerary_text:569e72e117968fcc",
      "field": "itinerary.text",
      "sourceTextSha256": "a8790df37082a4d398373f63e6fca5a02eb6b789dba0685199486c94f705abcb",
      "text": "The best adventures in one day: a canopy tour and rappelling through the Río Blanco Canyon, tubing on the Río Negro (class II rapids), horseback riding, then relaxing in volcano-heated thermal waters, steam and mud baths. Your guide gives instructions for every activity and ensures your safety, with unbeatable views of the river, canyons and wildlife. Note: tubing requires a minimum age of 8 and a minimum height of 1.40 m. Overnight at Hacienda Guachipelín. (B)",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1pKs6gG3JSDjkEIQt_H_n6ktc0pmyvl57",
        "documentSha256": "22a955d9713aa4fc095afbcb7f033721711ee4096fb57c2746b6d8fe8e5e7e3f",

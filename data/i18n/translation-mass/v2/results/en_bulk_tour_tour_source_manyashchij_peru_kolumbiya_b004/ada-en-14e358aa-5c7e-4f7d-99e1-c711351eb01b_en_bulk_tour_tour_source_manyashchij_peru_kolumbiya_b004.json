        "model": "gpt-6.1-sol"
      },
      "text": "Trip to Barú Island on day 13, if booked as an optional extra."
    },
    {
      "blockId": "tour:note:7273202bd58ef807",
      "field": "note",
      "sourceTextSha256": "aa0f517a69bb6125a62d76fac63158be14b2160fe554ff21bdc819b78bf2bf7f",
      "provenance": {

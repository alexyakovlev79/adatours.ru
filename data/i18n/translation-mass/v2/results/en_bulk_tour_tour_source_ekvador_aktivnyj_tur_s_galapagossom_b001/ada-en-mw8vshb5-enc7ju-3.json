      "text": "17-Day Ecuador and Galápagos Islands Adventure Tour"
    },
    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "9866bf47bf8b0effbb56950832f555630d1cbb6eaf150181f30eb86459c07ce0",

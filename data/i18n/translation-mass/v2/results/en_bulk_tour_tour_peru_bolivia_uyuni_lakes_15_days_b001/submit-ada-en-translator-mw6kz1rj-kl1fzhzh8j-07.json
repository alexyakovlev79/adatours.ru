      "text": "Peru and Bolivia: Uyuni and the Lakes of the Altiplano",
      "provenance": {
        "kind": "ai_translation",
        "model": "GPT-6.1 Sol",
        "runId": "ada-en-translator-mw6kz1rj-kl1fzhzh8j"

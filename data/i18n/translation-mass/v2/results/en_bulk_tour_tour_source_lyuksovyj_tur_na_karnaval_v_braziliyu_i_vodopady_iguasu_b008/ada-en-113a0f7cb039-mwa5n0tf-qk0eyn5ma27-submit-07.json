    },
    {
      "blockId": "tour:itinerary_text:2e780f63f4172747",
      "field": "itinerary.text",
      "sourceTextSha256": "be680518b298a1dabaf6f84bcb13f17be70b1239cdb5ccc46f4468caed355f25",
      "text": "After breakfast, cross the border with your English-speaking guide.\n\nOn the Argentine side, the trails get closer to the water than they do on the Brazilian side.\n\nWalkways pass over the river and alongside individual cascades.\n\nAlong the way, look for tropical plants, orchids, butterflies and birds.\n\nThe ecological train takes you to the start of the trail to the Devil’s Throat.\n\nFrom there, you’ll walk along long boardwalks above the wide, calm river.\n\nAt the final viewing platform, the water plunges into a curtain of white mist.\n\nThe roar of the falls is so loud that it’s hard to talk nearby.\n\nReturn to the hotel after the tour.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-113a0f7cb039-mwa5n0tf-qk0eyn5ma27",
        "model": "ChatGPT"
      }
    },

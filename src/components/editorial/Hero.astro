---
import PrimaryCTA from '../global/PrimaryCTA.astro';
import { withBase } from '../../lib/paths';
import InlineMarkdown from '../global/InlineMarkdown.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  image?: string;
  imageTextAlign?: 'left' | 'right';
  ctaHref?: string;
  ctaLabel?: string;
  compact?: boolean;
  tour?: boolean;
  meta?: string;
  mediaStatus?: 'approved' | 'needs_replacement' | 'replaced';
  replacementReason?: string;
}

const {
  eyebrow,
  title,
  intro,
  image,
  imageTextAlign,
  ctaHref = '/contacts/',
  ctaLabel = 'Оставить заявку',
  compact = false,
  tour = false,
  meta,
  mediaStatus,
  replacementReason,
} = Astro.props;

const resolvedImage = image ? withBase(image) : undefined;

---

<section
  class:list={['hero', { 'hero--compact': compact, 'hero--image': image, 'hero--tour': tour }]}
  data-image-text-align={imageTextAlign}
  data-media-status={mediaStatus ?? (image ? 'legacy' : undefined)}
  data-replacement-reason={replacementReason}
>
  {resolvedImage && (
    <img
      class="hero__media"
      src={resolvedImage}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      referrerpolicy="no-referrer"
    />
  )}
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <div class="hero__head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {meta && <p class="hero__meta">{meta}</p>}
    </div>
    <h1>{title}</h1>
    <div class="hero__bottom">
      {intro && <p><InlineMarkdown text={intro} /></p>}
      <PrimaryCTA href={ctaHref} label={ctaLabel} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: var(--hero-height);
    overflow: hidden;
    color: var(--color-bg);
    background:
      radial-gradient(circle at 75% 15%, rgba(242, 204, 103, .22), transparent 32%),
      linear-gradient(135deg, #33342f 0%, var(--color-ink-deep) 62%);
    isolation: isolate;
  }

  .hero--compact {
    min-height: min(84svh, 820px);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(15, 16, 14, .18) 0%,
      rgba(15, 16, 14, .18) 35%,
      rgba(15, 16, 14, .66) 100%
    );
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: min(calc(100% - (var(--gutter) * 2)), 1440px);
    margin-inline: auto;
    padding: calc(var(--header-h) + 72px) 0 clamp(48px, 7vw, 96px);
  }

  .hero__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .hero__meta {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 1180px;
    margin: 12px 0 clamp(36px, 5vw, 70px);
  }

  .hero__bottom {
    display: grid;
    grid-template-columns: minmax(0, 650px) auto;
    align-items: end;
    justify-content: space-between;
    gap: 48px;
  }

  .hero__bottom p {
    max-width: 650px;
    margin: 0;
    color: rgba(255,255,255,.84);
    font-size: var(--text-lg);
  }

  @media (max-width: 720px) {
    .hero__content {
      padding-bottom: 34px;
    }

    .hero__head {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .hero__bottom {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .hero[data-image-text-align] .hero__content {
    align-items: var(--image-text-flex);
    text-align: var(--image-text-align);
  }

  .hero[data-image-text-align] .hero__head {
    width: min(100%, 1180px);
    flex-wrap: wrap;
    align-items: var(--image-text-flex);
    justify-content: var(--image-text-flex);
  }

  .hero[data-image-text-align] .hero__bottom {
    width: min(100%, 650px);
    grid-template-columns: minmax(0, 1fr);
    justify-items: var(--image-text-inline);
    gap: 28px;
  }

  /* Tour-detail hero: an editorial title group centered within the photograph. */
  .hero--tour .hero__overlay {
    background:
      linear-gradient(90deg, rgb(10 20 24 / 43%) 0%, rgb(10 20 24 / 19%) 60%, transparent 100%),
      linear-gradient(180deg, rgb(15 16 14 / 12%) 0%, rgb(15 16 14 / 10%) 38%, rgb(15 16 14 / 39%) 100%);
  }

  .hero--tour[data-image-text-align="right"] .hero__overlay {
    background:
      linear-gradient(270deg, rgb(10 20 24 / 43%) 0%, rgb(10 20 24 / 19%) 60%, transparent 100%),
      linear-gradient(180deg, rgb(15 16 14 / 12%) 0%, rgb(15 16 14 / 10%) 38%, rgb(15 16 14 / 39%) 100%);
  }

  .hero--tour .hero__content {
    justify-content: center;
    padding-top: calc(var(--header-h) + clamp(64px, 10svh, 112px));
    padding-bottom: clamp(48px, 8svh, 92px);
  }

  .hero--tour .hero__head {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 12px 22px;
    margin-bottom: clamp(20px, 2.5vw, 30px);
  }

  .hero--tour .hero__head .eyebrow { margin: 0; }

  .hero--tour .hero__meta {
    padding-left: 18px;
    border-left: 1px solid rgb(255 255 255 / 55%);
    color: rgb(255 255 255 / 87%);
    white-space: nowrap;
  }

  .hero--tour h1 {
    max-width: 1000px;
    margin: 0 0 clamp(28px, 3.8vw, 48px);
    font-size: clamp(2.4rem, 4.6vw, 4.7rem);
    line-height: 1.075;
    text-wrap: balance;
  }

  .hero--tour .hero__bottom {
    display: flex;
    width: 100%;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0;
  }

  .hero--tour .hero__bottom :global(.cta) {
    flex: 0 0 auto;
    width: 238px;
    min-width: 0;
    max-width: 100%;
  }

  .hero--tour[data-image-text-align] .hero__head {
    justify-content: var(--image-text-flex);
  }

  .hero--tour[data-image-text-align] .hero__bottom {
    display: flex;
    width: 100%;
    justify-content: var(--image-text-flex);
  }

  @media (max-width: 720px) {
    .hero--tour .hero__content {
      padding-top: calc(var(--header-h) + clamp(58px, 9svh, 90px));
      padding-bottom: clamp(42px, 7svh, 64px);
    }

    .hero--tour .hero__head {
      flex-direction: row;
      align-items: center;
      gap: 10px 14px;
      margin-bottom: 20px;
    }

    .hero--tour .hero__meta { padding-left: 14px; }

    .hero--tour h1 {
      max-width: 100%;
      margin-bottom: 28px;
      font-size: clamp(2.2rem, 9.5vw, 2.75rem);
      line-height: 1.08;
    }

    .hero--tour .hero__overlay,
    .hero--tour[data-image-text-align="right"] .hero__overlay {
      background:
        linear-gradient(90deg, rgb(10 20 24 / 30%), rgb(10 20 24 / 15%)),
        linear-gradient(180deg, rgb(15 16 14 / 9%) 0%, rgb(15 16 14 / 36%) 48%, rgb(15 16 14 / 29%) 100%);
    }
  }
</style>

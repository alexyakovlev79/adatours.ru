    {
      "blockId": "tour:contentBlock_text:c2054d51e90c48dc",
      "field": "contentBlock.text",
      "sourceTextSha256": "a19de0a40ff5e1f85ce2e839030c4cb67e35f9bea75cbef575605691f895247d",
      "text": "Breakfast at the hotel.\nTransfer to the airport for your flight to the Galápagos Islands.\nOn arrival at Baltra Airport, your guide will meet you, help with your luggage, and accompany you to the bus. It’s a 10-minute drive to the Itabaca Channel, which separates Baltra from Santa Cruz Island.\nThe crossing to Santa Cruz by motorboat takes five minutes. From there, a private vehicle takes you across the island to your hotel in Puerto Ayora, about a 45-minute drive. Along the way, you’ll see the landscape change from red, rocky terrain in the north to the green, wildlife-rich highlands and south.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw8xm7mg-7cp5ig",
        "model": "GPT-6"
      }
    },
    {
      "blockId": "tour:contentBlock_text:03b11b5175736f94",
      "field": "contentBlock.text",
      "sourceTextSha256": "b1ffa98195ae11e537263cdb6baa637d87513d9214e59e6f206e0cc9ff028480",
      "text": "Transfer to the hotel.\nAfter a welcome reception, check in to your room and take some time to rest.\nYou’ll then have free time to explore the port town of Puerto Ayora, with its many souvenir shops, restaurants, and waterfront promenade.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw8xm7mg-7cp5ig",
        "model": "GPT-6"
      }
    },
    {
      "blockId": "tour:media_alt:73134094ec69f956",
      "field": "media.alt",
      "sourceTextSha256": "713eea7e3834200d01610388104f120377d064981ecbae94f04203291ee3d7cf",
      "text": "A wooden boat and motorboats in Puerto Ayora’s turquoise harbor near the town waterfront in Ecuador",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw8xm7mg-7cp5ig",
        "model": "GPT-6"
      }
    },

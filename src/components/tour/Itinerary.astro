---
import { isActiveEntity, activeReplacementId } from '../../lib/archive.mjs';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths';
import { excursionPath } from '../../lib/routes';
import InlineMarkdown from '../global/InlineMarkdown.astro';

interface MediaItem {
  src: string;
  alt?: string;
  status?: 'approved' | 'needs_replacement' | 'replaced';
  replacementReason?: string;
  intendedSlot?: string;
}

type ContentBlock =
  | { type: 'text'; text: string }
  | { type: 'section'; title: string; text: string }
  | { type: 'excursion'; excursionRef: string };

interface Day {
  day?: number;
  label?: string;
  title?: string;
  places?: string[];
  text?: string;
  excursionRef?: string;
  contentBlocks?: ContentBlock[];
  image?: string | MediaItem;
  images?: MediaItem[];
  subsections?: Array<{
    title: string;
    text: string;
  }>;
}
interface Props { days: Day[]; }
const { days } = Astro.props;

const pluralRu = (value: number, one: string, few: string, many: string) => {
  const n = Math.abs(value) % 100;
  const n1 = n % 10;
  if (n >= 11 && n <= 19) return many;
  if (n1 === 1) return one;
  if (n1 >= 2 && n1 <= 4) return few;
  return many;
};

// Some itinerary cards cover several days (for example, days 3–6), so the
// journey length is the highest numbered day, not the number of cards.
const itineraryDayCount = days.reduce(
  (maxDay, day) => typeof day.day === 'number' ? Math.max(maxDay, day.day) : maxDay,
  0,
);
const itineraryDayLabel = pluralRu(itineraryDayCount, 'день', 'дня', 'дней');

const resolveDayImage = (image: Day['image']) => {
  if (!image) return null;
  if (typeof image === 'string') return { src: image, alt: '', status: undefined };
  return image;
};

const referencedExcursionIds = new Set<string>();
const addReference = (id: string) => { const activeId = activeReplacementId(id); if (activeId) referencedExcursionIds.add(activeId); };
for (const day of days) {
  if (day.excursionRef) addReference(day.excursionRef);
  for (const block of day.contentBlocks ?? []) {
    if (block.type === 'excursion') addReference(block.excursionRef);
  }
}

const excursionEntries = referencedExcursionIds.size > 0
  ? await getCollection(
      'excursions',
      ({ data }) => data.locale === 'ru' && data.status !== 'draft' && referencedExcursionIds.has(data.id),
    )
  : [];

const excursionById = new Map(excursionEntries.map((entry) => [entry.data.id, entry]));
const missingExcursionIds = [...referencedExcursionIds].filter((id) => !excursionById.has(id));

if (missingExcursionIds.length > 0) {
  throw new Error(
    `Itinerary references missing excursion entities: ${missingExcursionIds.join(', ')}`,
  );
}

const resolveExcursion = (id?: string) => {
  if (!id) return null;
  const activeId = activeReplacementId(id);
  const entry = activeId ? excursionById.get(activeId) : undefined;
  if (!entry || !isActiveEntity(entry)) return null;

  return {
    id: entry.data.id,
    title: entry.data.title,
    href: excursionPath(entry.data),
    lead: entry.data.lead,
    bodyHtml: stripDuplicateLeadingHeading(entry.rendered?.html ?? '', entry.data.title),
    hero: entry.data.hero,
    imageTextAlign: entry.data.imageTextAlign,
  };
};

const splitParagraphs = (text: string) =>
  text.split(/\n\s*\n/).map((paragraph) => paragraph.trim()).filter(Boolean);

const normalizeHeadingText = (value: string) =>
  value
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/gi, ' ')
    .replace(/&amp;/gi, '&')
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/&laquo;/gi, '«')
    .replace(/&raquo;/gi, '»')
    .toLocaleLowerCase('ru')
    .replace(/ё/g, 'е')
    .replace(/[^a-zа-я0-9]+/gi, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const stripDuplicateLeadingHeading = (html: string, title: string) => {
  const match = html.match(/^\s*<h([1-6])(?:\s[^>]*)?>([\s\S]*?)<\/h\1>\s*/i);
  if (!match) return html;
  return normalizeHeadingText(match[2]) === normalizeHeadingText(title)
    ? html.slice(match[0].length)
    : html;
};

const resolvedDays = days.filter((day) => !day.excursionRef || activeReplacementId(day.excursionRef) || day.text?.trim()).map((day) => {
  const excursion = resolveExcursion(day.excursionRef);
  const localImage = resolveDayImage(day.image);
  const dayImages = excursion?.hero
    ? [excursion.hero]
    : day.images?.length
      ? day.images
      : localImage
        ? [localImage]
        : [];

  const contentBlocks = (day.contentBlocks ?? []).map((block) =>
    block.type === 'excursion'
      ? { ...block, excursion: resolveExcursion(block.excursionRef) }
      : block
  );

  return {
    ...day,
    resolvedTitle: excursion?.title ?? day.title ?? '',
    excursion,
    dayImages,
    contentBlocks,
  };
});
---

<section class="itinerary section">
  <div class="container itinerary__container">
    <div class="itinerary__heading">
      <p class="eyebrow">Маршрут</p>
      <h2>{itineraryDayCount} {itineraryDayLabel} путешествия</h2>
    </div>

    <div class="itinerary__days">
      {resolvedDays.map((day) => {
        const visibleImage = day.dayImages.length > 0;
        return (
        <article
          class:list={['day-card', { 'day-card--image': visibleImage }]}
          data-excursion-ref={day.excursion?.id}
          data-image-text-align={day.excursion?.imageTextAlign}
          data-itinerary-image-count={day.dayImages.length}
        >
          <details class="day">
            <summary>
              <span class="day__number">{typeof day.day === 'number' ? String(day.day).padStart(2, '0') : ''}</span>
              <span class="day__title">{day.resolvedTitle}</span>
              <span class="day__toggle" aria-hidden="true">+</span>
            </summary>
            <div class="day__content">
              <div>
                {day.places && day.places.length > 0 && <p class="day__places">{day.places.join(' · ')}</p>}

                {day.excursion ? (
                  <>
                    {day.excursion.bodyHtml
                      ? <div class="excursion-embed__body" set:html={day.excursion.bodyHtml} />
                      : <p><InlineMarkdown text={day.excursion.lead} /></p>}
                    <p><a class="day__excursion-link" href={withBase(day.excursion.href)}>Подробнее об экскурсии</a></p>
                  </>
                ) : day.contentBlocks.length > 0 ? (
                  day.contentBlocks.map((block) => {
                    if (block.type === 'text') {
                      return (
                        <div class="day__content-block">
                          {splitParagraphs(block.text).map((paragraph) => (
                            <p><InlineMarkdown text={paragraph} /></p>
                          ))}
                        </div>
                      );
                    }

                    if (block.type === 'section') {
                      return (
                        <section class="day__content-block day__content-block--section">
                          <h3>{block.title}</h3>
                          {splitParagraphs(block.text).map((paragraph) => (
                            <p><InlineMarkdown text={paragraph} /></p>
                          ))}
                        </section>
                      );
                    }

                    const excursion = block.excursion;
                    if (!excursion) return null;

                    return (
                      <section
                        class="day__embedded-excursion"
                        data-excursion-ref={excursion.id}
                        data-image-text-align={excursion.imageTextAlign}
                      >
                        <h3><a class="day__excursion-link" href={withBase(excursion.href)}>{excursion.title}</a></h3>
                        {excursion.bodyHtml
                          ? <div class="excursion-embed__body" set:html={excursion.bodyHtml} />
                          : <p><InlineMarkdown text={excursion.lead} /></p>
                        }
                        {excursion.hero && (
                          <div class="day__embedded-excursion__media">
                            <img
                              src={withBase(excursion.hero.src)}
                              alt={excursion.hero.alt ?? excursion.title}
                              loading="lazy"
                              data-media-status={excursion.hero.status ?? 'legacy'}
                              data-replacement-reason={excursion.hero.replacementReason}
                            />
                          </div>
                        )}
                      </section>
                    );
                  })
                ) : (
                  <>
                    <p><InlineMarkdown text={day.text ?? ''} /></p>
                    {day.subsections?.map((subsection) => (
                      <section class="day__subsection">
                        <h3>{subsection.title}</h3>
                        {splitParagraphs(subsection.text).map((paragraph) => (
                          <p><InlineMarkdown text={paragraph} /></p>
                        ))}
                      </section>
                    ))}
                  </>
                )}
              </div>
            </div>
          </details>

          {visibleImage && (
            <div class="day__media">
              {day.dayImages.map((item) => (
                <img
                  src={withBase(item.src)}
                  alt={item.alt ?? ''}
                  loading="lazy"
                  data-media-status={item.status ?? 'legacy'}
                  data-replacement-reason={item.replacementReason}
                />
              ))}
            </div>
          )}
        </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  const desktop = window.matchMedia('(min-width: 1100px)');

  document.querySelectorAll<HTMLDetailsElement>('.itinerary .day-card:not(.day-card--image) > .day').forEach((day) => {
    const summary = day.querySelector<HTMLElement>('summary');
    if (!summary) return;

    let mobileOpen = day.open;
    let desktopStatic = false;

    const syncLayout = () => {
      if (desktopStatic === desktop.matches) return;
      desktopStatic = desktop.matches;

      if (desktopStatic) {
        // Keep the mobile accordion state while desktop uses a static text card.
        mobileOpen = day.open;
        day.open = true;
        day.setAttribute('data-desktop-static', '');
        summary.setAttribute('tabindex', '-1');
        summary.setAttribute('aria-disabled', 'true');
      } else {
        day.removeAttribute('data-desktop-static');
        day.open = mobileOpen;
        summary.removeAttribute('tabindex');
        summary.removeAttribute('aria-disabled');
      }
    };

    summary.addEventListener('click', (event) => {
      if (desktop.matches) event.preventDefault();
    });

    day.addEventListener('toggle', () => {
      if (desktop.matches && !day.open) day.open = true;
    });

    desktop.addEventListener('change', syncLayout);
    syncLayout();
  });

  const itineraryDays = document.querySelector<HTMLElement>('.itinerary .itinerary__days');
  const itineraryCards = itineraryDays
    ? Array.from(itineraryDays.querySelectorAll<HTMLElement>(':scope > .day-card'))
    : [];

  const desktopPhotoMax = 660;
  const mediaGap = 16;
  const collapsedMediaGap = 18;
  const expandedMediaGap = 40;
  const cardBottomGap = 18;

  const imageCount = (card: HTMLElement) =>
    Number.parseInt(card.dataset.itineraryImageCount ?? '0', 10) || 0;

  const summaryHeight = (card: HTMLElement) =>
    card.querySelector<HTMLElement>(':scope > .day > summary')?.getBoundingClientRect().height ?? 0;

  const measureExpandedDetailsHeight = (card: HTMLElement) => {
    if (!itineraryDays) return 0;

    const clone = card.cloneNode(true) as HTMLElement;
    const width = card.getBoundingClientRect().width;
    clone.removeAttribute('data-row-coordinated');
    clone.style.removeProperty('--itinerary-row-height');
    clone.style.removeProperty('--itinerary-row-media-height');
    clone.style.position = 'absolute';
    clone.style.visibility = 'hidden';
    clone.style.pointerEvents = 'none';
    clone.style.width = width + 'px';
    clone.style.height = 'auto';
    clone.style.minHeight = '0';
    clone.style.maxHeight = 'none';
    clone.style.inset = '0 auto auto 0';
    clone.style.zIndex = '-1';

    const details = clone.querySelector<HTMLDetailsElement>(':scope > .day');
    const media = clone.querySelector<HTMLElement>(':scope > .day__media');
    media?.remove();
    if (!details) return 0;

    details.open = true;
    itineraryDays.appendChild(clone);
    const height = details.getBoundingClientRect().height;
    clone.remove();
    return height;
  };

  const clearRowSizing = (card: HTMLElement) => {
    card.removeAttribute('data-row-coordinated');
    card.style.removeProperty('--itinerary-row-height');
    card.style.removeProperty('--itinerary-row-media-height');
  };

  const syncMultiImageRows = () => {
    itineraryCards.forEach(clearRowSizing);

    itineraryCards.forEach((card) => {
      if (!desktop.matches || imageCount(card) === 0) {
        card.style.removeProperty('--itinerary-collapsed-media-height');
        return;
      }

      const cardWidth = card.getBoundingClientRect().width;
      if (cardWidth <= 0) return;

      const collapsedMediaHeight = Math.min(cardWidth * 9 / 16, desktopPhotoMax);
      card.style.setProperty(
        '--itinerary-collapsed-media-height',
        collapsedMediaHeight + 'px',
      );
    });

    if (!desktop.matches || !itineraryDays) return;

    for (let index = 0; index < itineraryCards.length; index += 2) {
      const pair = itineraryCards.slice(index, index + 2);
      const counts = pair.map(imageCount);
      if (counts.some((count) => count === 0)) continue;

      const maxCount = Math.max(...counts);
      if (maxCount <= 1) continue;

      const rowSlots = Math.min(...counts);
      const governingCards = pair.filter((card) => imageCount(card) === rowSlots);
      const anyOpen = pair.some(
        (card) => card.querySelector<HTMLDetailsElement>(':scope > .day')?.open,
      );

      const cardWidth = Math.min(...pair.map((card) => card.getBoundingClientRect().width));
      if (cardWidth <= 0) continue;

      const onePhotoHeight = Math.min(cardWidth * 9 / 16, desktopPhotoMax);
      const rowMediaHeight =
        rowSlots * onePhotoHeight + Math.max(0, rowSlots - 1) * mediaGap;

      const governingDetailsHeight = anyOpen
        ? Math.max(...governingCards.map(measureExpandedDetailsHeight))
        : Math.max(...governingCards.map(summaryHeight));

      const mediaTopGap = anyOpen ? expandedMediaGap : collapsedMediaGap;
      const rowHeight = Math.ceil(
        governingDetailsHeight + mediaTopGap + rowMediaHeight + cardBottomGap,
      );

      pair.forEach((card) => {
        card.setAttribute('data-row-coordinated', '');
        card.style.setProperty('--itinerary-row-height', rowHeight + 'px');
        card.style.setProperty('--itinerary-row-media-height', rowMediaHeight + 'px');
      });
    }
  };

  type ViewportAnchor = {
    element: HTMLElement;
    top: number;
  };

  let rowSyncFrame = 0;
  let viewportAnchor: ViewportAnchor | null = null;
  let viewportAnchorFrames = 0;

  const restoreViewportAnchor = () => {
    if (!viewportAnchor || !desktop.matches) return;
    const delta = viewportAnchor.element.getBoundingClientRect().top - viewportAnchor.top;
    if (Math.abs(delta) > 0.5) window.scrollBy(0, delta);
  };

  const scheduleRowSync = (anchor?: ViewportAnchor) => {
    if (anchor) {
      viewportAnchor = anchor;
      viewportAnchorFrames = 4;
    }

    window.cancelAnimationFrame(rowSyncFrame);

    const run = () => {
      syncMultiImageRows();
      restoreViewportAnchor();

      if (viewportAnchor && viewportAnchorFrames > 1) {
        viewportAnchorFrames -= 1;
        rowSyncFrame = window.requestAnimationFrame(run);
      } else {
        viewportAnchor = null;
        viewportAnchorFrames = 0;
      }
    };

    rowSyncFrame = window.requestAnimationFrame(run);
  };

  itineraryCards.forEach((card, cardIndex) => {
    const day = card.querySelector<HTMLDetailsElement>(':scope > .day');
    const summary = day?.querySelector<HTMLElement>(':scope > summary');
    if (!day || !summary) return;

    day.addEventListener('toggle', () => scheduleRowSync());

    summary.addEventListener('click', (event) => {
      if (!desktop.matches || !card.classList.contains('day-card--image')) return;

      event.preventDefault();

      const pairStart = Math.floor(cardIndex / 2) * 2;
      const pair = itineraryCards.slice(pairStart, pairStart + 2);
      const pairIsInteractive =
        pair.length === 2 && pair.every((item) => item.classList.contains('day-card--image'));
      const targets = pairIsInteractive ? pair : [card];
      const targetOpen = !day.open;
      const anchor = {
        element: summary,
        top: summary.getBoundingClientRect().top,
      };

      targets.forEach((targetCard) => {
        const targetDay = targetCard.querySelector<HTMLDetailsElement>(':scope > .day');
        if (targetDay) targetDay.open = targetOpen;
      });

      scheduleRowSync(anchor);
    });
  });

  desktop.addEventListener('change', () => scheduleRowSync());
  window.addEventListener('resize', () => scheduleRowSync());
  scheduleRowSync();
</script>

<style>
  .itinerary {
    color: var(--color-bg);
    background: var(--color-ink-deep);
    /* The pricing section starts directly after the final itinerary row. */
    padding-bottom: 0;
  }

  @media (min-width: 1100px) {
    .itinerary {
      overflow-anchor: none;
    }

    .itinerary__container {
      width: 100%;
      max-width: none;
      margin-inline: 0;
      padding-inline: 24px;
    }
  }

  .itinerary__heading {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    align-items: start;
    margin-bottom: clamp(40px, 6vw, 80px);
  }

  .itinerary__heading h2 {
    margin: 0;
  }

  .itinerary__days {
    border-top: 0;
  }

  .day-card {
    border-bottom: 0;
  }

  .day {
    border: 0;
  }

  .day summary {
    display: grid;
    grid-template-columns: 80px 1fr 44px;
    gap: 20px;
    align-items: center;
    min-height: 126px;
    cursor: pointer;
    list-style: none;
  }

  .day summary::-webkit-details-marker {
    display: none;
  }

  .day__number {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: .9rem;
    letter-spacing: .08em;
  }

  .day__title {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.1rem + 1vw, 2.3rem);
    line-height: 1.1;
  }

  .day__toggle {
    justify-self: end;
    font-size: 2rem;
    font-weight: 200;
    transition: transform 220ms var(--ease-out);
  }

  .day[open] .day__toggle {
    transform: rotate(45deg);
  }

  .day__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    padding: 0 0 54px 100px;
  }

  .day__content p {
    margin-top: 0;
    color: rgba(255,255,255,.74);
  }

  .day__places {
    color: var(--color-gold) !important;
    font-size: .78rem !important;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .day__excursion-link {
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .day__subsection {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,.16);
  }

  .day__subsection h3 {
    margin: 0 0 14px;
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1rem + .45vw, 1.45rem);
    line-height: 1.2;
  }

  .day__subsection p:last-child {
    margin-bottom: 0;
  }

  .day__content-block + .day__content-block,
  .day__content-block + .day__embedded-excursion,
  .day__embedded-excursion + .day__content-block,
  .day__embedded-excursion + .day__embedded-excursion {
    margin-top: 28px;
  }

  .day__content-block--section h3,
  .day__embedded-excursion h3 {
    margin: 0 0 14px;
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1rem + .45vw, 1.45rem);
    line-height: 1.2;
  }

  .day__embedded-excursion :global(.excursion-embed__body p) {
    margin-top: 0;
    color: rgba(255,255,255,.74);
  }

  .day__embedded-excursion :global(.excursion-embed__body p:last-child) {
    margin-bottom: 0;
  }

  .day__embedded-excursion__media {
    margin-top: 20px;
    overflow: hidden;
  }

  .day__embedded-excursion__media img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .day__media {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 8px;
  }

  .day__content img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /*
   * DESKTOP ITINERARY LAYOUT INVARIANT
   * ----------------------------------
   * The itinerary is a two-column grid on desktop. Media bottoms align per row.
   * If a row contains different photo counts, the smaller count governs the row's
   * maximum media capacity. Equal multi-photo counts reserve that many full photo
   * slots. The card with more photos divides the shared capacity between them.
   *
   * Keep itinerary media as a sibling of <details> so the outer .day-card can
   * coordinate the row. Mobile remains single-column and preserves source aspect
   * ratios; none of the desktop row sizing rules apply there.
   */

  @media (min-width: 1100px) {
    .itinerary__days {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }

    .day-card {
      display: flex;
      flex-direction: column;
      min-height: 100%;
      padding-bottom: 18px;
    }

    .day__content {
      padding: 0;
    }

    .day[data-desktop-static] summary {
      cursor: default;
    }

    .day[data-desktop-static] .day__toggle {
      display: none;
    }

    .day-card--image .day__content {
      padding-bottom: 0;
    }

    .day__media {
      display: grid;
      grid-auto-rows: minmax(0, 1fr);
      width: 100%;
      overflow: hidden;
    }

    .day[open] + .day__media {
      flex: 1 1 320px;
      /*
       * Opening a card must never make its media block shorter than the same
       * card's collapsed 16:9 media. Otherwise the whole grid row can shrink
       * and the next pair of days jumps upward when content is revealed.
       */
      min-height: calc(var(--itinerary-collapsed-media-height, 260px) + 40px);
      max-height: 700px;
      margin-top: auto;
      padding-top: 40px;
      aspect-ratio: auto;
    }

    .day:not([open]) + .day__media {
      flex: 0 0 auto;
      min-height: 0;
      max-height: none;
      margin-top: 18px;
      padding-top: 0;
      aspect-ratio: 16 / 9;
    }

    /*
     * Rows containing multiple itinerary photographs use a shared media budget.
     * Different counts are governed by the card with fewer photographs; equal
     * counts reserve one full desktop photo slot for every photograph.
     */
    .day-card[data-row-coordinated] {
      height: var(--itinerary-row-height);
      min-height: var(--itinerary-row-height);
      max-height: var(--itinerary-row-height);
    }

    .day-card[data-row-coordinated] .day[open] + .day__media,
    .day-card[data-row-coordinated] .day:not([open]) + .day__media {
      min-height: 0;
      margin-top: auto;
      aspect-ratio: auto;
    }

    .day-card[data-row-coordinated] .day[open] + .day__media {
      flex: 1 1 calc(var(--itinerary-row-media-height) + 40px);
      max-height: calc(var(--itinerary-row-media-height) + 40px);
      padding-top: 40px;
    }

    .day-card[data-row-coordinated] .day:not([open]) + .day__media {
      flex: 1 1 var(--itinerary-row-media-height);
      max-height: var(--itinerary-row-media-height);
      padding-top: 0;
    }

    .day__media img {
      display: block;
      width: 100%;
      height: 100%;

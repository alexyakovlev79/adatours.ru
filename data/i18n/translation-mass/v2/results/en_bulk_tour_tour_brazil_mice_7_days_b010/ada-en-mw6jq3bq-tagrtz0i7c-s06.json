      "sourceTextSha256": "f2d8007c43e0fad10b5d1b64bc838a8b27c3af1fa1bfe7d5cf852eb01e082032",
      "text": "Rio de Janeiro",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6jq3bq-tagrtz0i7c",
        "model": "GPT-6.1"
      }
    },
    {
      "blockId": "tour:contentBlock_text:7794c274b700eac5",
      "field": "contentBlock.text",
      "sourceTextSha256": "8a82932ede7b85cbb3f33731f5f8f67d6f4e59fefafb651285ac8ba8377580c9",
      "text": "We arrange transfers with a driver to and from the conference at Windsor Oceânico. For participants who are free from business meetings, we offer an optional full-day tour of Rio. We’ll agree on the timing and who will join when planning the trip.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6jq3bq-tagrtz0i7c",
        "model": "GPT-6.1"
      }
    },
    {
      "blockId": "tour:contentBlock_text:df6c3c20348cb8c4",
      "field": "contentBlock.text",
      "sourceTextSha256": "9b215bc482f082a32cfaace601a0d25109156d1284b7e506a72040d421524856",
      "text": "Join us for a full-day group tour of Rio de Janeiro with visits to [Corcovado](/brazil/place/corcovado-christ-the-redeemer/) and [Sugarloaf Mountain](/brazil/place/sugarloaf-mountain/). An English-speaking guide leads the tour. Admission tickets and lunch are included in the tour package.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6jq3bq-tagrtz0i7c",
        "model": "GPT-6.1"
      }
    },
    {
      "blockId": "tour:contentBlock_text:231a615fba574301",
      "field": "contentBlock.text",
      "sourceTextSha256": "c35db631e6b323685aac0238d0567da00b43e7f88d97156bc6b8074fc2ca6ce4",
      "text": "In the evening, we arrange a buffet dinner at Carretão Lido. Transfers and escort services are included.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6jq3bq-tagrtz0i7c",
        "model": "GPT-6.1"
      }
    },

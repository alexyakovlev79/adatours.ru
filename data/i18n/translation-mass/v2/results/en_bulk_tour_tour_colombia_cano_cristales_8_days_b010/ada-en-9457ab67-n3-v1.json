    {
      "blockId": "tour:itinerary_text:2e780f63f4172747",
      "field": "itinerary.text",
      "sourceTextSha256": "c742fe7bfc7c8f6341b42dcc21429cedec964457f074889bb9ba9b03cae58b95",
      "text": "Before dawn, a peaceful canoe journey about an hour upriver on the Guayabero as first light reaches the jungle, then drift back with the current; with luck, you may spot pink river dolphins, known locally as “toninas”. Watch for birds and other animals along the way. Breakfast at the lodge, a last canoe ride to La Macarena and the flight back to Bogotá; depending on the schedule, time for a final lunch. Private transfer to the hotel. Pack your belongings after breakfast at La Manigua and transfer to the airport in La Macarena. Private transport, accommodation in Bogotá and a local medical assistance card are included; dinner is not included. Overnight in Bogotá.",
      "provenance": {
        "kind": "ai_translation",
        "model": "ChatGPT",
        "runId": "ada-en-9457ab67-20261104",
        "wordAbsenceReason": "The current RU Day 7 has details absent from Word paragraph 87: bird/animal watching, packing, airport transfer and the explicit accommodation, medical-card and dinner conditions. Preserved paragraph 87's English wording and translated those additional RU details; not claimed as word_exact."
      }
    },

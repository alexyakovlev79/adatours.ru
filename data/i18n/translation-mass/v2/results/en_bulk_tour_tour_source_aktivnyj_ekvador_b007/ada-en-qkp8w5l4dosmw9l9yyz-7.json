    {
      "blockId": "tour:itinerary_text:b9ad3e14216c2f08",
      "field": "itinerary.text",
      "sourceTextSha256": "e36aa31c4667cb5cc155818d5c0edb63fcf6b7375c9d0efbd1b9a5bc48e13019",
      "text": "After breakfast, the day’s activities begin at 09:00. First you will be fitted with equipment, then travel by private vehicle for about 20 minutes to the Río Blanco area.\n\nYour guide will explain abseiling techniques and safety procedures. You will practise on dry land before entering the canyon, then walk uphill for about 20 minutes to the start of the route.\n\nThe programme includes three abseils down different waterfalls. Near the end of the route, you can slide down a natural waterslide as part of the activity.\n\nIn the afternoon, visit Pailón del Diablo, a waterfall about 80 m high and one of the best known in the Baños area.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-qkp8w5l4dosmw9l9yyz",
        "model": "GPT-6"
      }
    },

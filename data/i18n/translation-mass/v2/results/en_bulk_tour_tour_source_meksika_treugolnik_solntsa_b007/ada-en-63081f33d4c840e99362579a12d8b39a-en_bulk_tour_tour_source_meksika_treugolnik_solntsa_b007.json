      "text": "Free day in Acapulco"
    },
    {
      "blockId": "tour:itinerary_text:2e780f63f4172747",
      "field": "itinerary.text",
      "sourceTextSha256": "b60ed747790cc9d1051b008a193124ca36ebe4c11a676f6700e8af8404498b9f",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-63081f33d4c840e99362579a12d8b39a",
        "model": "gpt-6.1-sol"
      },
      "text": "After breakfast, the day is yours, with no scheduled excursions.\n\nSpend it at the beach or by the sea, or simply take time to relax before heading home."

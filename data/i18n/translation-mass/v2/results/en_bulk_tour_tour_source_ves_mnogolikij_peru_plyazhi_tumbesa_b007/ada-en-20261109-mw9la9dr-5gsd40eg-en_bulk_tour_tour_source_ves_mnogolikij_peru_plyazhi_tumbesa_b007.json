      "text": "Cusco – Puno"
    },
    {
      "blockId": "tour:itinerary_label:0c404703943620bd",
      "field": "itinerary.label",
      "sourceTextSha256": "95814ac59c8ef680defd784726c8cf6bf807b0fe40575d2e38e2841e7cd5eed7",
      "provenance": {

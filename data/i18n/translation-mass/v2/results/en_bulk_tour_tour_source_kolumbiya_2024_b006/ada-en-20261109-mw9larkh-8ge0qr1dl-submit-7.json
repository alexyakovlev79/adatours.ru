      "text": "Bogotá to Pereira and El Ocaso Coffee Farm",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-mw9larkh-8ge0qr1dl",
        "model": "GPT-6.1-sol"

---
import InlineMarkdown from '../global/InlineMarkdown.astro';
interface Props {
  included: string[];
  notIncluded: string[];
  notes?: string[];
}
const { included, notIncluded, notes = [] } = Astro.props;
---

<section class="included section">
  <div class="container">
    <p class="eyebrow">Условия программы</p>
    <div class="included__grid">
      <div class="included__column included__column--included">
        <h2>Включено</h2>
        <ul>
          {included.map((item) => <li><InlineMarkdown text={item} /></li>)}
        </ul>
      </div>
      <div class="included__column included__column--extra">
        <h2>Оплачивается отдельно</h2>
        <ul>
          {notIncluded.map((item) => <li><InlineMarkdown text={item} /></li>)}
        </ul>
      </div>
    </div>

    {notes.length > 0 && (
      <div class="included__notes">
        <h3>Важные условия</h3>
        <ul>
          {notes.map((item) => <li><InlineMarkdown text={item} /></li>)}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .included {
    background: var(--color-bg);
  }

  .included__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(52px,8vw,120px);
    margin-top: 18px;
  }

  .included h2 {
    margin: 18px 0 28px;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 2.7vw, 3.25rem);
    line-height: 1.08;
    font-weight: 400;
  }

  .included__column--extra h2 {
    white-space: nowrap;
  }

  .included ul {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .included li {
    position: relative;
    padding: 17px 0 17px 28px;
    border-bottom: 1px solid var(--color-line);
    font-size: .98rem;
  }

  .included li:last-child {
    border-bottom: 0;
  }

  .included li::before {
    position: absolute;
    left: 0;
    color: var(--color-gold-deep);
    font-family: var(--font-display);
  }

  .included__column--included li::before {
    content: '+';
    font-size: .9rem;
  }

  .included__column--extra li::before {
    content: '−';
    font-size: 1rem;
  }

  .included__notes {
    margin-top: clamp(44px, 6vw, 76px);
    max-width: 980px;
  }

  .included__notes h3 {
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2vw, 2.2rem);
  }

  .included__notes ul {
    border-top: 1px solid var(--color-line);
  }

  .included__notes li {
    padding-left: 0;
  }

  .included__notes li::before {
    content: none;
  }

  @media (max-width: 760px) {
    .included__grid {
      grid-template-columns: 1fr;
    }

    .included__column--extra h2 {
      font-size: clamp(2.2rem, 10vw, 3.25rem);
      white-space: normal;
    }
  }
</style>

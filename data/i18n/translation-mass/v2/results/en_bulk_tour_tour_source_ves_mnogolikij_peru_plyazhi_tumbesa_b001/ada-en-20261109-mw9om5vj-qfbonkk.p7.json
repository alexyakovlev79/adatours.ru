      "text": "Peru in All Its Variety and the Beaches of Tumbes"
    },
    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "cbc83d1c4dd4fc3aac4acfd13aa75e157b35917ac5137db989297a45226fa216",

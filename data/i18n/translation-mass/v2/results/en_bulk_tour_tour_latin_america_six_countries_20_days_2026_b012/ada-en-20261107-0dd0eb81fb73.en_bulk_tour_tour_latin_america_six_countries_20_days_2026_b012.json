    {
      "blockId": "tour:contentBlock_text:2a22f0edea0dd043",
      "field": "contentBlock.text",
      "sourceTextSha256": "c0d4084e6d8965895023a8e7046be99b2b1d39143ab727c9b0d6599e03cfd931",
      "text": "Join a group sightseeing tour of Santiago with an English-speaking guide. Start in the city centre at the square by La Moneda Palace, a designated historic monument. The palace was built in 1799, in the final years of Spanish rule, to house the royal mint. Its design is traditionally Neoclassical. In the mid-19th century, the palace became the seat of the Chilean government, a role it has served ever since. Continue to Plaza de Armas, Santiago’s central square and the place where the city began. Around the square are the Palace of the Governors of Chile, Santiago City Hall, the Central Post Office, the Royal Audiencia building and the Metropolitan Cathedral. Then climb Santa Lucía Hill for a panoramic view across the city. Visit the modern districts of Vitacura, Las Condes and Providencia, follow the Mapocho River and see the grand architecture along Santiago’s main avenues.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261107-0dd0eb81fb73",
        "model": "GPT-6.1"
      }
    },
    {
      "blockId": "tour:contentBlock_text:cf4924aaaa668628",
      "field": "contentBlock.text",
      "sourceTextSha256": "7c72eb97bee89e975965eef0c1883709879ea14dead32b6d1a01a0a124a545a5",
      "text": "For an additional charge, you can visit wineries in the Maipo Valley and enjoy a tasting. The cost is USD 230 per person, with a minimum of two participants.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261107-0dd0eb81fb73",

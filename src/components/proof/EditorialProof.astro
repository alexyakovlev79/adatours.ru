---
import { withBase } from '../../lib/paths';

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  image: string;
  facts?: string[];
  reverse?: boolean;
}
const { eyebrow, title, text, image, facts = [], reverse = false } = Astro.props;
---

<section class:list={['proof section', { 'proof--reverse': reverse }]}>
  <div class="proof__media">
    <img src={withBase(image)} alt="" loading="lazy" />
  </div>
  <div class="proof__copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p>{text}</p>
    {facts.length > 0 && (
      <ul>
        {facts.map((fact) => <li>{fact}</li>)}
      </ul>
    )}
  </div>
</section>

<style>
  .proof {
    display: grid;
    grid-template-columns: minmax(0,1.1fr) minmax(360px,.9fr);
    gap: clamp(48px,8vw,120px);
    align-items: center;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .proof--reverse {
    grid-template-columns: minmax(360px,.9fr) minmax(0,1.1fr);
  }

  .proof--reverse .proof__media {
    order: 2;
  }

  .proof__media img {
    width: 100%;
    min-height: clamp(480px,56vw,760px);
    object-fit: cover;
  }

  .proof h2 {
    margin: 12px 0 24px;
  }

  .proof__copy > p:last-of-type {
    color: rgba(26,26,26,.7);
  }

  .proof ul {
    margin: 38px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .proof li {
    padding: 15px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: .92rem;
  }

  @media (max-width: 820px) {
    .proof,
    .proof--reverse {
      grid-template-columns: 1fr;
    }

    .proof--reverse .proof__media {
      order: initial;
    }
  }
</style>

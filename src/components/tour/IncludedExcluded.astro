---
interface Props {
  included: string[];
  notIncluded: string[];
}
const { included, notIncluded } = Astro.props;
---

<section class="included section">
  <div class="container">
    <p class="eyebrow">Условия программы</p>
    <div class="included__grid">
      <div class="included__column included__column--included">
        <h2>Включено</h2>
        <ul>
          {included.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="included__column included__column--extra">
        <h2>Оплачивается отдельно</h2>
        <ul>
          {notIncluded.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .included {
    background: var(--color-bg);
  }

  .included__grid {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: clamp(52px,8vw,120px);
    margin-top: 18px;
  }

  .included h2 {
    margin: 18px 0 28px;
    font-size: clamp(2.35rem,3.5vw,4.4rem);
  }

  .included ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .included li {
    position: relative;
    padding: 17px 0 17px 28px;
    border-bottom: 1px solid var(--color-line);
    font-size: .98rem;
  }

  .included li:last-child {
    border-bottom: 0;
  }

  .included li::before {
    position: absolute;
    left: 0;
    color: var(--color-gold-deep);
    font-family: var(--font-display);
  }

  .included__column--included li::before {
    content: '✓';
    font-size: .9rem;
  }

  .included__column--extra li::before {
    content: '•';
    font-size: 1rem;
  }

  @media (max-width: 760px) {
    .included__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import StoryPair from '../../components/editorial/StoryPair.astro';
import DestinationBand from '../../components/editorial/DestinationBand.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
---

<BaseLayout
  title="MICE и деловые поездки в Бразилию и Латинскую Америку"
  description="Ada Tours организует MICE, incentive, корпоративные группы и деловые поездки в Бразилии и Латинской Америке."
>
  <Hero
    eyebrow="MICE · Brazil & Latin America"
    title="Деловая поездка, в которой все части работают вместе"
    intro="Транспорт, размещение, встречи, площадки, сопровождающие и программа вне деловой части собираются как одна локальная операция."
    image="https://brasiltours.ru/image/cache/countries/brazil/new-pics/raphael-nogueira-espuilpsruw-1920-1920x1080.webp"
    ctaLabel="Обсудить группу"
  />

  <FactStrip
    dark
    facts={[
      { value: '40–50', label: 'человек', note: 'обычный масштаб групп в практике Ada Tours' },
      { value: '200–500', label: 'участников', note: 'масштаб отдельных событий и крупных групп' },
      { value: '№1', label: 'Бразилия', note: 'ключевая страна Ada Tours для MICE' },
      { value: '1', label: 'локальный координатор', note: 'единая точка сборки наземной части программы' },
    ]}
  />

  <EditorialStatement
    eyebrow="MICE"
    text="Сложность начинается не с экскурсии, а в стыках: аэропорт, автобус, отель, встреча, площадка, переводчик, ужин и следующий выезд должны работать по одному таймингу."
  />

  <StoryPair
    eyebrow="Рио-де-Жанейро"
    title="Деловая программа не обязана заканчиваться переговорной"
    text="Рио позволяет сочетать встречи и корпоративную часть с панорамными площадками, гастрономией, морскими прогулками и индивидуальными активностями для небольших VIP-групп."
    image="/media/prototype/rio-panorama.jpg"
  />

  <DestinationBand
    eyebrow="Деловые делегации"
    title="От встреч до отраслевой программы"
    text="Поездка может включать переговоры, посещения компаний и поставщиков, транспорт между городами, переводчиков и отдельную культурную часть."
    href="/mice/delovye-delegacii/"
    image="/media/prototype/buenos-aires.jpg"
    align="right"
  />

  <ProcessSteps
    title="Сначала задача группы, потом маршрут"
    steps={[
      { title: 'Бриф', text: 'Фиксируем даты, состав группы, деловую задачу, города и обязательные точки.' },
      { title: 'Логистика', text: 'Собираем отели, транспорт, встречи, площадки и резерв времени между ними.' },
      { title: 'Программа', text: 'Добавляем экскурсии, рестораны и активности так, чтобы они не ломали деловую часть.' },
      { title: 'На месте', text: 'Координируем наземную часть программы и корректируем ее при изменениях.' },
    ]}
  />

  <LeadForm title="Рассчитать MICE или деловую группу" entityId="mice" />
</BaseLayout>

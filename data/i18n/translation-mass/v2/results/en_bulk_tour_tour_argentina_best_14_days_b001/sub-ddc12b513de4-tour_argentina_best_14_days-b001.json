      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "623ddb2aa9c9e023de66a968a7f4d3ce9f1a93678ae25cff5d5d322f79a0f02a",
      "text": "Buenos Aires and tango, the Perito Moreno Glacier, the forests of Tierra del Fuego, the lakes of Bariloche and Iguazú Falls on both sides of the border. In 14 days, the route connects the capital, southern Patagonia and the northern cascades. The programme includes 13 nights in 4-star hotels with breakfast, private transfers and guided excursions.",
      "provenance": {
        "kind": "ai_translation",
        "model": "GPT-6",
        "runId": "ada-en-20261104-ddc12b513de4",
        "wordAbsenceReason": "Word paragraph 17 and inclusion paragraphs describe these elements separately; translated the frozen RU lead rather than presenting a composite as a verbatim Word paragraph."
      }
    },

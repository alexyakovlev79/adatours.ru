      "sourceTextSha256": "33fd02e76a0591edd1f7f2b77d483b72117cc3c2d6602480db150eaa62ea4f1b",
      "text": "Puno – Colca Canyon",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1TxH9LDDzR5Bfjb0u_5CBmF_2N5kGi2ad",
        "documentSha256": "f5bcdb16d7149a4bd3f317cf9a84459111ff3c55704127c6f94c74b7323f2964",
        "paragraphs": [
          {
            "ref": "document.xml:p102",
            "textSha256": "260e936fe6def925fba525161a9af72fb33cf6c860838e28b27d933e748ef631"

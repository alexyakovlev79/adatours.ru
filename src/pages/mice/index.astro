---
import {commercialText} from '../../lib/i18n/commercial-copy.mjs';
import {sharedUiLocale} from '../../lib/i18n/shared-ui-locale.mjs';
const uiLocale=sharedUiLocale();
const tr=(value:string)=>commercialText(value,uiLocale);
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import MiceNav from '../../components/commercial/MiceNav.astro';
import CommercialDetails from '../../components/commercial/CommercialDetails.astro';
import CommercialCaseGrid from '../../components/commercial/CommercialCaseGrid.astro';
import CommercialExpert from '../../components/commercial/CommercialExpert.astro';
import CommercialSearchRecord from '../../components/commercial/CommercialSearchRecord.astro';
import DmcFaq from '../../components/commercial/DmcFaq.astro';

const hero = '/media/commercial/mice/rio-meeting-generated-20261022.webp';
const title = tr('MICE в Бразилии и Латинской Америке | Ada Tours');
const description = tr('Корпоративные поездки, incentive и деловые группы с Ada Tours: размещение, транспорт, переводчики и программа на месте. Выполненные кейсы и расчет под вашу задачу.');
---

<BaseLayout leadTitle={tr("Рассчитать MICE или корпоративную поездку")} leadEntityId="mice" title={title} description={description} image={hero}>
  <CommercialSearchRecord id="mice" title={tr("MICE и корпоративные поездки")} description={description} image={hero} keywords={['MICE', tr('МИСЕ'), tr('корпоративные поездки'), 'incentive', tr('инсентив'), tr('конференции'), tr('деловые группы')]} />
  <Hero compact compactCta mobilePhotoLead
    eyebrow={tr("Бразилия и Латинская Америка · MICE")}
    title={tr("MICE и корпоративные поездки в Латинской Америке")}
    intro={tr("Переговоры в Сан-Паулу, конференция в Буэнос-Айресе или поощрительное путешествие по Бразилии. Ada Tours собирает маршрут, размещение, транспорт и программу, а затем координирует поездку на месте.")}
    image={hero} ctaHref="#request" ctaLabel={tr("Обсудить поездку команды")} />
  <MiceNav active="overview" />

  <FactStrip facts={[
    { value: tr('30 гостей'), label: tr('в корпоративном кейсе Рио — Ангра') },
    { value: tr('8 участников'), label: tr('в кейсе делегации Сан-Паулу — Кампинас') },
    { value: tr('7 языков'), label: tr('коммуникации с командой Ada Tours') },
    { value: tr('Рио-де-Жанейро'), label: tr('офис принимающей компании') },
  ]} />

  <CommercialDetails id="mice-formats" eyebrow={tr("Какую задачу решаем")} title={tr("Рабочая программа и впечатления от страны в одной поездке")}
    intro={tr("Начинаем с цели: провести встречи, поощрить сотрудников, познакомить партнеров или принять группу на отраслевом событии. Под нее выбираем города, продолжительность и состав услуг.")}
    rows={[
      { title: tr('Конференции и конгрессы'), text: tr('Привязываем отель, трансферы, питание и экскурсии к расписанию события. Участникам рабочих сессий и сопровождающим можно собрать разные дневные программы. В [примерах MICE-маршрутов](/mice/programmes/) есть конференционная Бразилия и конгрессная поездка в Буэнос-Айрес.') },
      { title: tr('Поощрительные поездки'), text: tr('Прогулка на катамаране, водопады Игуасу, острова Ангры, ужин и знакомство с местной кухней: выбираем впечатления под интересы команды. Продумываем переезды, длительность активностей и свободное время.') },
      { title: tr('Деловые делегации'), text: tr('Для [переговоров и профессиональных визитов](/mice/business-delegations/) связываем график встреч с транспортом и переводчиками. Помогаем найти профильные организации, связаться с ними и согласовать посещение.') },
      { title: tr('Корпоративные группы'), text: tr('Собираем общую программу для гостей с разными рейсами и пожеланиями. Отдельно прорабатываем встречи в аэропорту, расселение, групповые выезды, вечернее мероприятие и возвращение в отель.') },
    ]} />

  <CommercialCaseGrid id="mice-cases" title={tr("Как это было у наших клиентов")}
    intro={tr("В этих проектах Ada Tours организовала наземное обслуживание и сопровождение групп. В кейсах показаны задача, состав работ и решения во время поездки.")}
    caseIds={['case_mice_corporate_group_rio_angra_2026', 'case_mice_business_delegation_sao_paulo_2026']}
    summaries={{
      case_mice_corporate_group_rio_angra_2026: tr('30 гостей, автобусы и гиды, 6 часов на катамаране с питанием, гала-ужин и ночной трансфер. Все части поездки собраны в общий график.'),
      case_mice_business_delegation_sao_paulo_2026: tr('8 участников, Сан-Паулу, Кампинас и Гуаружа. Транспорт на длинные рабочие дни и перевод на русском, португальском и английском сопровождали меняющееся расписание встреч.'),
    }} />

  <CommercialDetails id="mice-operations" eyebrow={tr("Работа принимающей команды")} title={tr("Что берем на себя до поездки и на месте")}
    rows={[
      { title: tr('Расписание и транспорт'), text: tr('Сопоставляем прилеты, адреса, время встреч и выездов. Подбираем автомобили или автобусы, закладываем время на посадку группы, переезды и возвращение после вечерней программы.') },
      { title: tr('Размещение и площадки'), text: tr('Подбираем отели по географии рабочих встреч, категории и составу номеров. Площадки, оборудование, питание и дополнительные услуги включаем в расчет по вашему заданию; статус каждой позиции отражаем в предложении.') },
      { title: tr('Гиды и переводчики'), text: tr('Для экскурсий подбираем гидов, для переговоров и профессиональных визитов — переводчиков под нужную языковую пару и тематику. Формат сопровождения фиксируем в программе.') },
      { title: tr('Координация и изменения'), text: tr('Назначаем контакт для подготовки и передаем контакты на время поездки. Если меняется расписание, связываемся с поставщиками и предлагаем варианты. Часы связи и порядок срочных обращений согласуем для проекта.') },
    ]} />

  <CommercialDetails id="mice-estimate" eyebrow={tr("Расчет под вашу группу")} title={tr("Пришлите цель, даты и ориентир по бюджету")}
    intro={tr("Для первого обсуждения достаточно рабочего брифа. Если часть решений еще открыта, укажите варианты: поможем сравнить их по программе и стоимости.")}
    rows={[
      { title: tr('Кто и зачем едет'), text: tr('Число участников и сопровождающих, цель поездки, отрасль, языки, обязательные встречи и желаемые впечатления. Для корпоративного заказа добавьте требования к размещению и согласованию расходов.') },
      { title: tr('Когда и по какому маршруту'), text: tr('Даты или диапазон, предполагаемые рейсы, города, продолжительность и события с фиксированным временем. В [каталоге программ](/mice/programmes/) можно выбрать отправную точку для маршрута.') },
      { title: tr('Что войдет в предложение'), text: tr('Маршрут, включенные и исключенные услуги, расчет, исходные допущения и условия бронирования. Отдельно обозначаем позиции, которые ждут подтверждения поставщика или принимающей организации.') },
      { title: tr('Если вы представляете агентство'), text: tr('Работаем с нетто-тарифом для вашей наценки или подходящей комиссионной моделью. Сохраняем коммерческую роль партнера и готовим согласованные материалы под его брендом. Подробнее — в [условиях сотрудничества](/dmc/terms/).') },
    ]} />

  <ProcessSteps eyebrow={tr("От идеи до поездки")} title={tr("Четыре этапа подготовки")} steps={[
    { title: tr('Задача'), text: tr('Обсуждаем цели группы, даты, обязательные события и бюджет.') },
    { title: tr('Предложение'), text: tr('Собираем маршрут и смету, проверяем доступность, согласуем правки.') },
    { title: tr('Подтверждение'), text: tr('Письменно фиксируем услуги, стоимость и условия бронирования.') },
    { title: tr('Поездка'), text: tr('Координируем подрядчиков и расписание, держим связь с организатором.') },
  ]} />

  <CommercialExpert text={tr("Анна Аванесова руководит Ada Tours из Рио-де-Жанейро. Команда работает с корпоративными группами, делегациями и сложными маршрутами по региону. В разделе [партнеров](/partners/) собраны профессиональные профили компании, а на [вебинарах](/webinars/) можно познакомиться с подходом к направлениям до первого запроса.")} />

  <DmcFaq title={tr("Что обсудить перед корпоративной поездкой")} items={[
    { question: tr('Можно ли совместить конференцию и поощрительную программу?'), answer: tr('Да. Рабочие сессии становятся опорными точками расписания, а экскурсии, ужины и выезды размещаем в свободные часы. Для сопровождающих можно подготовить отдельную программу. Продолжительность и состав услуг рассчитываем под вашу группу.') },
    { question: tr('Работаете ли вы с небольшими делегациями?'), answer: tr('Да. Принимаем запросы от небольших делегаций до корпоративных групп. В опубликованном [деловом кейсе](/cases/business-delegation-sao-paulo-campinas-2026/) участвовали 8 человек; состав транспорта и сопровождения подбирали под их рабочий график.') },
    { question: tr('За сколько времени отправлять запрос?'), answer: tr('Присылайте его, как только известны цель и предполагаемые даты. Профессиональные визиты, крупные группы и поездки во время событий требуют больше времени на согласование. После первого обсуждения определим последовательность подготовки и сроки решений.') },
    { question: tr('Когда отель, площадка или другая услуга считаются подтвержденными?'), answer: tr('После письменного подтверждения, в котором зафиксированы соответствующая услуга и условия бронирования. В предложении показываем срок его действия и статус позиций. До подтверждения поставщика доступность и стоимость могут меняться.') },
    { question: tr('Что происходит, если меняется число участников или дата поездки?'), answer: tr('Пересчитываем затронутые услуги. При уменьшении группы стоимость на человека может вырасти; перенос дат зависит от новой доступности. Применимые расходы, возвраты и правила изменений указаны в условиях конкретного бронирования.') },
    { question: tr('Можно ли заказать поездку через свое агентство?'), answer: tr('Да. Ada Tours выступает принимающим партнером, а агентство сохраняет коммерческое общение с заказчиком. Тарифы, документы и контакты с участниками согласуем в рамках [агентской работы](/dmc/travel-agencies/).') },
  ]} />
</BaseLayout>

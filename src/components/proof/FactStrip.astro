---
interface Fact { value: string; label: string; note?: string; }
interface Props { facts: Fact[]; dark?: boolean; }
const { facts, dark = false } = Astro.props;
---

<section class:list={['fact-strip', { 'fact-strip--dark': dark }]}>
  <div class="fact-strip__inner">
    {facts.map((fact) => (
      <div class="fact">
        <strong>{fact.value}</strong>
        <span>{fact.label}</span>
        {fact.note && <small>{fact.note}</small>}
      </div>
    ))}
  </div>
</section>

<style>
  .fact-strip {
    background: var(--color-gold);
    color: var(--color-ink-deep);
  }

  .fact-strip--dark {
    color: var(--color-bg);
    background: var(--color-ink-deep);
  }

  .fact-strip__inner {
    display: grid;
    grid-template-columns: repeat(var(--facts, 4), minmax(0, 1fr));
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .fact {
    min-height: 220px;
    padding: 44px 28px;
    border-inline-start: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  }

  .fact:last-child {
    border-inline-end: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  }

  .fact strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 4.5vw, 6.5rem);
    font-weight: 500;
    line-height: .9;
    letter-spacing: -.045em;
  }

  .fact span {
    display: block;
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .fact small {
    display: block;
    max-width: 260px;
    margin-top: 10px;
    opacity: .62;
    font-size: .78rem;
    line-height: 1.5;
  }

  @media (max-width: 800px) {
    .fact-strip__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fact {
      min-height: 165px;
      padding: 30px 18px;
      border-bottom: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    }
  }
</style>

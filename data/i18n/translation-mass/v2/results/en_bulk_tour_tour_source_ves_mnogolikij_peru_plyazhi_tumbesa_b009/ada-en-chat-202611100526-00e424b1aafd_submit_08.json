      },
      "text": "Puno: a boat and huts on a reed island"
    },
    {
      "blockId": "tour:itinerary_title:ab3fd6cac362f6b0",
      "field": "itinerary.title",
      "sourceTextSha256": "8c04ed1848874e3e80bdcea42cf19f6351d78d8f18009137a72af231229a5383",

      "field": "media.hover",
      "sourceTextSha256": "9238cc504024946b776ea46d5790f2205f8bec921212736f34d16090307cd913",
      "text": "Isla del Sol: calm water, sparse vegetation and reflections of the sky",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-qkp8w5l4dosmw9l9yyz",
        "model": "GPT-6"
      }
    },
    {

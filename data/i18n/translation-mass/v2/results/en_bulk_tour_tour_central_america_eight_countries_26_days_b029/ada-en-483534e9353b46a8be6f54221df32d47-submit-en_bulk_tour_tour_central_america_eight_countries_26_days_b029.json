    {
      "blockId": "tour:itinerary_text:4ca9f73ac7e369bf",
      "field": "itinerary.text",
      "sourceTextSha256": "409ce2198d09113ee879ff08558eff5486de27f360aefb47b332ad43dd449257",
      "text": "Leave early for Tortuguero, with breakfast en route. The route passes the forested slopes of Braulio Carrillo National Park. Visit a banana plantation before reaching the Caño Blanco pier, then continue by boat along the Parismina River and Tortuguero's natural canals to your hotel. After lunch, walk into Tortuguero village, with an optional visit to the Green Turtle Museum, then return to the hotel. Museum admission arrangements and ticket payment are confirmed separately.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-483534e9353b46a8be6f54221df32d47",
        "model": "GPT-6.1 Sol"
      }
    }

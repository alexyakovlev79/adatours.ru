---
import { withBase } from '../../lib/paths';

interface Props {
  name: string;
  role: string;
  photo?: { src: string; alt?: string };
  expertise?: string[];
  href?: string;
  eyebrow?: string;
}

const {
  name,
  role,
  photo,
  expertise = [],
  href,
  eyebrow = 'Команда Ada Tours',
} = Astro.props;

const resolvedPhoto = photo?.src ? withBase(photo.src) : undefined;
---

<section class="person section">
  <div class="person__media">
    {resolvedPhoto ? (
      <img src={resolvedPhoto} alt={photo?.alt || name} loading="lazy" />
    ) : (
      <div class="person__placeholder" aria-hidden="true"></div>
    )}
  </div>

  <div class="person__copy">
    <p class="eyebrow">{eyebrow}</p>
    {href ? <h2><a href={withBase(href)}>{name}</a></h2> : <h2>{name}</h2>}
    <p class="person__role">{role}</p>

    <div class="person__bio">
      <slot />
    </div>

    {expertise.length > 0 && (
      <ul class="person__expertise">
        {expertise.map((item) => <li>{item}</li>)}
      </ul>
    )}

    {href && (
      <a class="person__link" href={withBase(href)}>
        Подробнее <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</section>

<style>
  .person {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(360px, 1.1fr);
    gap: clamp(48px, 8vw, 120px);
    align-items: center;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .person__media img,
  .person__placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--color-gold-soft);
  }

  .person h2 {
    margin: 12px 0 12px;
  }

  .person__role {
    margin: 0 0 34px;
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .person__bio {
    max-width: 680px;
    color: color-mix(in srgb, var(--color-ink) 78%, transparent);
  }

  .person__bio :global(p) {
    margin: 0 0 1.2em;
  }

  .person__expertise {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin: 36px 0 0;
    padding: 20px 0 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .person__expertise li {
    font-size: .82rem;
  }

  .person__link {
    display: inline-flex;
    gap: 24px;
    margin-top: 34px;
    padding-bottom: 7px;
    border-bottom: 1px solid currentColor;
    font-family: var(--font-display);
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  @media (max-width: 820px) {
    .person {
      grid-template-columns: 1fr;
    }

    .person__media {
      width: min(100%, 480px);
    }
  }
</style>

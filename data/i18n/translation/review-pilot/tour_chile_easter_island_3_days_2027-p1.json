    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "mode": "word_span",
      "text": "Easter Island is one of the most mysterious places on the planet. The Polynesian settlers who reached it more than a thousand years ago created the Rapa Nui culture, leaving behind countless traces of their genius, above all the giant Moai statues. In three days of private excursions, discover the crater of Rano Kau and the Birdman village of Orongo, the quarry of Rano Raraku, Ahu Tongariki, the beach of Anakena and the sunset platforms of Tahai.",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1zUNi_nTIgTJ0v2CQiDYg3A4tsff1HaQ5",
        "revision": "2026-10-22T14:03:05.061Z",
        "documentSha256": "e8797275b1b80fec09e917a42a64128fccde97924b970f75f592f0cbcb149492",
        "paragraphs": [
          {
            "ref": "word/document.xml#p0017",
            "textSha256": "577826526a32a962cad69b2240d5f2c8342afb1629ab74f051346b5d6f236df8"
          }
        ]
      }
    },
    {
      "blockId": "tour:itinerary_title:5cd7a3d146d31311",
      "field": "itinerary.title",
      "mode": "word_span",
      "text": "Orongo",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1zUNi_nTIgTJ0v2CQiDYg3A4tsff1HaQ5",
        "revision": "2026-10-22T14:03:05.061Z",
        "documentSha256": "e8797275b1b80fec09e917a42a64128fccde97924b970f75f592f0cbcb149492",

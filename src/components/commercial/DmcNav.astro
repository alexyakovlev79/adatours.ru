---
import { DMC_NAV_LINKS } from '../../lib/site';
import { withBase } from '../../lib/paths';

interface Props { active: (typeof DMC_NAV_LINKS)[number]['id']; }
const { active } = Astro.props;
const current = DMC_NAV_LINKS.find((link) => link.id === active) ?? DMC_NAV_LINKS[0];
---

<div class="dmc-nav-shell" data-pagefind-ignore>
  <nav class="dmc-nav" aria-label="Раздел для агентств">
    {DMC_NAV_LINKS.map((link) => (
      <a href={withBase(link.href)} aria-current={active === link.id ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
  <nav class="dmc-nav-mobile" aria-label="Раздел для агентств">
    <details>
      <summary>
        <span class="dmc-nav-mobile__current">
          <small>Для агентств · Разделы</small>
          <strong>{current.label}</strong>
        </span>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
      </summary>
      <div class="dmc-nav-mobile__links">
        {DMC_NAV_LINKS.map((link) => (
          <a href={withBase(link.href)} aria-current={active === link.id ? 'page' : undefined}>
            {link.label}
            {active === link.id && <span aria-hidden="true">✓</span>}
          </a>
        ))}
      </div>
    </details>
  </nav>
</div>

<style>
  .dmc-nav-shell { background: var(--color-bg); }
  .dmc-nav {
    display: flex;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
    padding: 0 clamp(4px, 1vw, 16px);
    justify-content: center;
    gap: clamp(30px, 5vw, 90px);
    border-bottom: 1px solid var(--color-line);
  }
  .dmc-nav a {
    position: relative;
    display: inline-flex;
    min-height: 68px;
    padding: 0 2px;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
    font-family: var(--font-display);
    font-size: .78rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: .06em;
    text-align: center;
    text-transform: uppercase;
    transition: color 180ms ease;
  }
  .dmc-nav a:hover,
  .dmc-nav a[aria-current='page'] { color: var(--color-ink); }
  .dmc-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 3px;
    background: var(--color-brand-deep);
  }
  .dmc-nav-mobile { display: none; }
  @media (max-width: 1020px) {
    .dmc-nav-shell { border-bottom: 1px solid var(--color-line); }
    .dmc-nav { display: none; }
    .dmc-nav-mobile {
      display: block;
      width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
      margin-inline: auto;
    }
    .dmc-nav-mobile summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      min-height: 74px;
      padding-block: 12px;
      cursor: pointer;
      list-style: none;
    }
    .dmc-nav-mobile summary::-webkit-details-marker { display: none; }
    .dmc-nav-mobile__current { display: grid; gap: 5px; min-width: 0; }
    .dmc-nav-mobile small {
      color: var(--color-text-muted);
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .09em;
      text-transform: uppercase;
    }
    .dmc-nav-mobile strong {
      color: var(--color-ink);
      font-family: var(--font-display);
      font-size: clamp(1.15rem, 2.8vw, 1.45rem);
      font-weight: 500;
      line-height: 1.2;
    }
    .dmc-nav-mobile svg { flex: 0 0 auto; transition: transform 180ms ease; }
    .dmc-nav-mobile details[open] summary svg { transform: rotate(180deg); }
    .dmc-nav-mobile__links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 22px;
      padding: 4px 0 20px;
      border-top: 1px solid var(--color-line);
    }
    .dmc-nav-mobile__links a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      min-height: 50px;
      padding: 11px 0;
      border-bottom: 1px solid var(--color-line);
      font-family: var(--font-display);
      font-size: clamp(.87rem, 2vw, 1rem);
      line-height: 1.25;
      color: var(--color-ink);
    }
    .dmc-nav-mobile__links a[aria-current='page'] { color: var(--color-brand-deep); font-weight: 600; }
    .dmc-nav-mobile summary:focus-visible,
    .dmc-nav-mobile__links a:focus-visible { outline: 2px solid var(--color-brand-deep); outline-offset: 3px; }
  }
  @media (max-width: 420px) {
    .dmc-nav-mobile__links { grid-template-columns: 1fr; }
    .dmc-nav-mobile summary { min-height: 68px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dmc-nav-mobile svg { transition: none; }
  }
</style>

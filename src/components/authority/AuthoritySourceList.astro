---
import AuthorityInline from './AuthorityInline.astro';
import { authorityDate, authorityLanguage, type AuthoritySource, type AuthoritySourceCopy } from './content';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  intro?: string;
  sources: AuthoritySource[];
  entries: AuthoritySourceCopy[];
}
const { id, title, eyebrow, intro, sources, entries } = Astro.props;
const sourceMap = new Map(sources.map((source) => [source.id, source]));
const items = entries.map((copy) => {
  const source = sourceMap.get(copy.sourceId);
  if (!source) throw new Error(`Authority page is missing visible source: ${copy.sourceId}`);
  return { source, copy, date: authorityDate(source), language: authorityLanguage(source.language) };
});
---

<section id={id} class="authority-sources section" aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="authority-sources__heading">
      <div>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2 id={`${id}-title`}>{title}</h2>
      </div>
      {intro && <p class="authority-sources__intro">{intro}</p>}
    </header>
    <ol class="authority-sources__list">
      {items.map(({ source, copy, date, language }) => (
        <li id={copy.anchorId} class="authority-sources__item" data-authority-source={source.id}>
          <div class="authority-sources__meta">
            <p class="authority-sources__publisher">{source.publisher.name}</p>
            {date && <time datetime={date.value}>{date.label}</time>}
            {language && <span>{language}</span>}
          </div>
          <article class="authority-sources__body">
            <p class="authority-sources__category">{copy.category}</p>
            <h3>{copy.title}</h3>
            {source.name !== copy.title && <p class="authority-sources__original" lang={source.language}>{source.name}</p>}
            <p class="authority-sources__annotation"><AuthorityInline text={copy.annotationMarkdown} /></p>
            <a class="authority-sources__link" href={source.url} target="_blank" rel="external noopener noreferrer">
              <span>{copy.linkLabel}</span><span aria-hidden="true">↗</span>
            </a>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .authority-sources,
  .authority-sources__item { scroll-margin-top: calc(var(--header-h) + 24px); }
  .authority-sources__heading {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.25fr);
    gap: 24px clamp(28px, 5vw, 72px);
    align-items: end;
    margin-bottom: 30px;
  }
  .eyebrow { margin: 0 0 14px; color: var(--color-brand-deep); }
  h2 { margin: 0; font-size: clamp(1.9rem, 2.6vw, 2.85rem); line-height: 1.12; }
  .authority-sources__intro { max-width: 680px; margin: 0; color: var(--color-text-muted); }
  .authority-sources__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-line); }
  .authority-sources__item {
    display: grid;
    grid-template-columns: minmax(160px, .35fr) minmax(0, 1fr);
    gap: 20px clamp(28px, 5vw, 72px);
    padding: 30px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .authority-sources__meta { display: flex; flex-direction: column; align-items: flex-start; gap: 7px; padding-top: 2px; }
  .authority-sources__publisher { margin: 0 0 3px; font-weight: 600; font-size: .95rem; line-height: 1.5; }
  .authority-sources__meta time,
  .authority-sources__meta > span { font-size: .82rem; line-height: 1.5; color: var(--color-text-muted); }
  .authority-sources__body { min-width: 0; max-width: 840px; }
  .authority-sources__category { margin: 0 0 10px; font-size: .75rem; font-weight: 600; color: var(--color-brand-deep); }
  h3 { margin: 0 0 12px; font-size: clamp(1.35rem, 1.65vw, 1.75rem); line-height: 1.2; text-wrap: pretty; }
  .authority-sources__original { margin: 0 0 14px; font-size: .82rem; line-height: 1.6; color: var(--color-text-muted); }
  .authority-sources__annotation { margin: 0 0 16px; color: var(--color-text-muted); }
  .authority-sources__link { display: inline-flex; align-items: baseline; gap: 10px; color: var(--color-brand-deep); font-size: .9rem; font-weight: 600; line-height: 1.5; }
  .authority-sources__link span:first-child { text-decoration: underline; text-underline-offset: .2em; text-decoration-color: color-mix(in srgb, var(--color-brand-deep) 35%, transparent); }
  .authority-sources__link:hover span:first-child { text-decoration-color: currentColor; }
  @media (max-width: 820px) {
    .authority-sources__heading { grid-template-columns: 1fr; gap: 18px; }
  }
  @media (max-width: 620px) {
    .authority-sources__item { grid-template-columns: 1fr; padding: 26px 0; gap: 15px; }
    .authority-sources__meta { flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 5px 16px; padding-top: 0; }
    .authority-sources__publisher { flex-basis: 100%; margin-bottom: 0; }
    .authority-sources__category { margin-bottom: 8px; }
  }
</style>

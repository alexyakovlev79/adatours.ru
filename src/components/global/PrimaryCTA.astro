---
import { withBase } from '../../lib/paths';

interface Props {
  href?: string;
  label?: string;
  variant?: 'gold' | 'light' | 'ghost' | 'dark';
}

const {
  href = '/contacts/',
  label = 'Оставить заявку',
  variant = 'gold',
} = Astro.props;

const normalizedLabel = label.trim().toLocaleLowerCase('ru');
const opensLeadModal = href === '/contacts/' || normalizedLabel === 'оставить заявку';
const resolvedHref = opensLeadModal ? '#request' : withBase(href);
---

<a
  class:list={['cta', `cta--${variant}`]}
  href={resolvedHref}
  data-lead-modal={opensLeadModal ? 'true' : undefined}
>
  <span>{label}</span>
  <span aria-hidden="true">↗</span>
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-width: 210px;
    padding: 16px 20px;
    border: 1px solid transparent;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background 220ms var(--ease-out),
      color 220ms var(--ease-out),
      border-color 220ms var(--ease-out);
  }

  .cta--gold {
    background: var(--color-gold);
    color: var(--color-ink-deep);
  }

  .cta--gold:hover {
    background: var(--color-gold-hover);
  }

  .cta--light {
    background: var(--color-bg);
    color: var(--color-ink);
  }

  .cta--ghost {
    border-color: currentColor;
    background: transparent;
  }

  /* Inverse primary CTA for saturated golden surfaces (e.g. tour pricing). */
  .cta--dark {
    border-color: var(--color-ink-deep);
    background: var(--color-ink-deep);
    color: var(--color-bg);
  }

  .cta--dark:hover {
    border-color: color-mix(in srgb, var(--color-ink-deep) 84%, var(--color-bg));
    background: color-mix(in srgb, var(--color-ink-deep) 84%, var(--color-bg));
  }

  .cta--dark:focus-visible {
    outline: 3px solid var(--color-ink-deep);
    outline-offset: 4px;
  }
</style>

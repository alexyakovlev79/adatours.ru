---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/editorial/Hero.astro';
import FactStrip from '../../../components/proof/FactStrip.astro';
import ProcessSteps from '../../../components/proof/ProcessSteps.astro';
import DmcNav from '../../../components/commercial/DmcNav.astro';
import DmcFaq from '../../../components/commercial/DmcFaq.astro';
import CommercialDetails from '../../../components/commercial/CommercialDetails.astro';
import CommercialCaseGrid from '../../../components/commercial/CommercialCaseGrid.astro';
import CommercialQuote from '../../../components/commercial/CommercialQuote.astro';
import CommercialExpert from '../../../components/commercial/CommercialExpert.astro';
import CommercialSearchRecord from '../../../components/commercial/CommercialSearchRecord.astro';

const title = 'DMC для турагентств: Бразилия и Латинская Америка | Ada Tours';
const description = 'Поездки для клиентов вашего агентства с Ada Tours: нетто или комиссия, документы под ваш бренд, маршруты по Латинской Америке и координация на месте.';
const heroImage = '/media/commercial/dmc/agency-planning-generated-20261022.webp';
---

<BaseLayout
  leadTitle="Запросить предложение для клиента"
  leadEntityId="dmc_for_agencies"
  title={title}
  description={description}
  image={heroImage}
>
  <Hero
    eyebrow="DMC · Партнерство с агентствами"
    title="DMC для турагентств и туроператоров"
    intro="Вы остаетесь основным коммерческим контактом своего клиента. Мы готовим маршрут и расчет, адаптируем материалы под ваш бренд и организуем обслуживание по Бразилии и Латинской Америке."
    image={heroImage}
    ctaHref="#request"
    ctaLabel="Запросить предложение"
    compact
    compactCta
    mobilePhotoLead
  />

  <DmcNav active="agencies" />

  <CommercialSearchRecord
    id="dmc-agencies-search-record"
    title={title}
    description={description}
    image={heroImage}
    typeLabel="Для агентств"
    keywords={['турагентствам', 'туроператорам', 'DMC', 'B2B', 'нетто', 'комиссия', 'бренд агентства', 'white label', 'ваучеры', 'клиент агентства', 'трансферы', 'Латинская Америка']}
  />

  <FactStrip
    facts={[
      { value: 'Нетто', label: 'или комиссионный тариф под задачу' },
      { value: 'Ваш бренд', label: 'программы и практические документы' },
      { value: 'FIT', label: 'индивидуальные поездки ваших клиентов' },
      { value: 'Группы', label: 'делегации и корпоративные программы' },
    ]}
  />

  <CommercialDetails
    id="agency-client"
    eyebrow="Клиент остается с вами"
    title="Согласуем, что увидит гость и кто принимает решения"
    rows={[
      {
        title: 'Коммерческое общение',
        text: 'Агентство ведет клиента по цене и продаже поездки. Ada Tours решает операционные вопросы в координации с партнером. Порядок согласования изменений, конфиденциальность и работу с последующими прямыми обращениями определяем между сторонами.',
      },
      {
        title: 'Программа под вашим брендом',
        text: 'Адаптируем маршруты, программы поездок и практические документы к оформлению агентства с учетом доступных инструментов. Ваучеры и подтверждения готовим в согласованном формате, сохраняя обязательные сведения о поставщиках.',
      },
      {
        title: 'Встреча и работа на маршруте',
        text: 'До приезда определяем, какое название будет на встречающей табличке и как представятся гид или водитель. Для трансферов, встреч и оперативных вопросов связываемся с гостями напрямую по согласованной схеме; агентство сохраняет свою коммерческую роль.',
      },
      {
        title: 'Связь до выезда и в поездке',
        text: 'Для группового проекта назначаем контактное лицо на этапе подготовки. Перед выездом передаем партнеру и участникам необходимые контакты. Часы доступности, порядок экстренной связи и включенные услуги фиксируем в предложении.',
        href: '/dmc/terms/',
        linkLabel: 'Как фиксируем условия сотрудничества',
      },
    ]}
  />

  <CommercialCaseGrid
    id="agency-completed-projects"
    eyebrow="Опыт в конкретных поездках"
    title="От длинного частного маршрута до рабочих визитов"
    intro="Посмотрите, как мы связываем транспорт, гидов, размещение и программу в выполненных проектах."
    caseIds={[
      'case_fit_peru_bolivia_complex_trip',
      'case_mice_business_delegation_sao_paulo_2026',
    ]}
    summaries={{
      case_fit_peru_bolivia_complex_trip: 'Перу и Боливия: амазонский лодж с дополнительным русскоязычным гидом, разные поезда к Мачу-Пикчу, отдельная доставка багажа и продолжение маршрута через границу.',
      case_mice_business_delegation_sao_paulo_2026: 'Делегация из 8 человек: поездки к поставщикам, автомобили и микроавтобусы на рабочие дни, перевод на трех языках и свободная программа между встречами.',
    }}
  />

  <CommercialQuote
    caseId="case_fit_peru_bolivia_complex_trip"
    title="Отзыв гостей о времени, организации и гидах"
  />

  <CommercialDetails
    id="agency-proposal"
    eyebrow="Что получает агентство"
    title="Материалы, с которыми можно обсуждать поездку с клиентом"
    rows={[
      {
        title: 'Маршрут и состав услуг',
        text: 'По подробному запросу готовим программу, описание включенных и не включенных услуг, предварительную смету или коммерческое предложение. Указываем исходные условия расчета и бронирования, затем вносим согласованные правки.',
      },
      {
        title: 'Нетто или комиссия',
        text: 'При нетто-тарифе агентство самостоятельно устанавливает наценку. Для подходящих проектов предлагаем комиссионный тариф. Модель определяем с самого начала и отражаем в предложении.',
        href: '/dmc/terms/',
        linkLabel: 'Расчет, оплата и изменения',
      },
      {
        title: 'Статус каждого бронирования',
        text: 'В предложении указываем срок действия расчета и отделяем предлагаемые услуги от подтвержденных. После проверки доступности фиксируем условия цены и состав заказа письменно.',
      },
      {
        title: 'Полная поездка или отдельная услуга',
        text: 'Собираем весь маршрут и принимаем отдельные запросы на размещение, трансферы, гидов и устный перевод. Для [деловых поездок](/mice/business-delegations/) готовим профессиональные визиты; прием группы подтверждается принимающей организацией.',
      },
      {
        title: 'Знакомство с направлениями',
        text: 'Используйте [вебинары Ada Tours](/webinars/) для подготовки к разговору с клиентом. Наши [профессиональные профили и партнеры](/partners/) помогут познакомиться с компанией, а [MICE-программы](/mice/programmes/) дадут примеры для корпоративного запроса.',
      },
    ]}
  />

  <ProcessSteps
    eyebrow="Первое письмо"
    title="4 части брифа для содержательного предложения"
    steps={[
      { title: 'Даты и рейсы', text: 'Даты или диапазон, длительность поездки, города прилета и вылета. Если билеты куплены, приложите расписание.' },
      { title: 'Гости и задача', text: 'Количество и состав путешественников, язык сопровождения, интересы. Для делегации добавьте цели визитов.' },
      { title: 'Маршрут', text: 'Страны и города, обязательные посещения, предпочтения по транспорту. Отметьте уже забронированные услуги.' },
      { title: 'Бюджет и формат', text: 'Ориентир бюджета, категория размещения, пожелания к программе и оформлению материалов для клиента.' },
    ]}
    dark
  />

  <CommercialExpert
    title="Познакомьтесь с Анной Аванесовой и нашей командой"
    text="Работаем с турагентствами, туроператорами, консультантами по индивидуальным путешествиям и MICE-агентствами. Расскажите, что нужно вашему клиенту: подготовим предложение с распределением задач между вами и Ada Tours."
  />

  <DmcFaq
    title="Вопросы агентств перед первым бронированием"
    items={[
      {
        question: 'Можно получить нетто-тариф и добавить свою наценку?',
        answer: 'Да. Предлагаем нетто-тариф, а для подходящих проектов — комиссионную модель. Выбранную схему указываем в предложении с самого начала. Размер вознаграждения и условия расчетов определяем для конкретного заказа.',
      },
      {
        question: 'Какие документы оформляете под брендом агентства?',
        answer: 'Программы поездок, подробные маршруты и практические документы. Формат ваучеров и подтверждений согласуем отдельно с сохранением обязательных данных поставщиков. До подготовки материалов определяем нужное оформление и доступные инструменты.',
      },
      {
        question: 'Что происходит, если турист обращается к Ada Tours напрямую?',
        answer: 'Во время поездки прямой контакт помогает организовать встречу, трансфер или решить оперативный вопрос. Основным коммерческим контактом остается агентство. Порядок обработки последующих обращений и правила конфиденциальности согласуем между сторонами.',
      },
      {
        question: 'Какой минимальный размер группы?',
        answer: 'Принимаем индивидуальные поездки, небольшие делегации и группы. Минимальный объем заказа, бюджет и срок подготовки определяем для конкретного запроса. Профессиональным программам и крупным группам требуется больше времени на согласования.',
      },
      {
        question: 'Сколько стоит первоначальная разработка программы?',
        answer: 'Стоимость разработки, минимальный объем заказа и условия бесплатного расчета согласуем до значительной подготовительной работы. В [условиях сотрудничества](/dmc/terms/) описано, что входит в предложение и как подтверждаются услуги.',
      },
      {
        question: 'Можно ли использовать ваши фотографии и тексты в наших материалах?',
        answer: 'Повторное использование возможно при наличии необходимых прав и разрешений. При подготовке программы под вашим брендом согласуем, какие конкретные фотографии, тексты и документы вы будете использовать.',
      },
      {
        question: 'Можно прислать запрос сразу на несколько стран?',
        answer: 'Да. Связываем обслуживание по странам в одну программу. В [выполненной поездке по Перу и Боливии](/cases/peru-bolivia-complex-trip/) собрали лодж, железнодорожную часть, частные переезды, переход границы и русскоязычное сопровождение.',
      },
    ]}
  />
</BaseLayout>

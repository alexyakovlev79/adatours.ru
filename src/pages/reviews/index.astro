---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import ReviewQuote from '../../components/proof/ReviewQuote.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
import { ADA_REVIEWS } from '../../data/reviews/ada-tours';

const heroImage = '/media/prototype/rio-panorama.jpg';
const reviewPageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://adatours.ru').toString();
const reviewSchemas = ADA_REVIEWS.map((review) => ({
  '@type': 'Review',
  '@id': `${reviewPageUrl}#${review.id}`,
  itemReviewed: { '@id': 'https://adatours.ru/#organization' },
  author: {
    '@type': 'Person',
    name: review.author,
  },
  reviewBody: review.text,
  inLanguage: 'ru',
  citation: review.sourceUrl,
}));
---

<BaseLayout
  title="Отзывы клиентов и партнеров Ada Tours"
  description="Отзывы туристов, турагентств и партнеров Ada Tours о маршрутах по Бразилии и Латинской Америке, группах, VIP и multi-country поездках."
  image={heroImage}
  pageSchema={reviewSchemas}
>
  <Hero
    eyebrow="Отзывы"
    title="Что говорят клиенты и партнеры"
    intro="Реальные отзывы о поездках и работе с Ada Tours. Для англоязычных отзывов рядом с переводом остается ссылка на оригинал."
    image={heroImage}
    compact
  />

  <EditorialStatement
    eyebrow="Что видно по отзывам"
    text="Чаще всего клиенты отмечают гидов и водителей, точность поездки, помощь на месте и персональный подход."
  />

  <div class="reviews">
    {ADA_REVIEWS.map((review, index) => <ReviewQuote review={review} index={index} />)}
  </div>

  <LeadForm title="Обсудить поездку или партнерство" entityId="reviews" />
</BaseLayout>

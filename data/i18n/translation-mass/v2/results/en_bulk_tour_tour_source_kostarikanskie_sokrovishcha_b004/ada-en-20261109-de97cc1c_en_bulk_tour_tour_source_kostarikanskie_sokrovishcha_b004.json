      },
      "text": "High-rise buildings amid the leafy neighborhoods of San José, with hills in the background, Costa Rica"
    },
    {
      "blockId": "tour:media_hover:099a5ad47f2a9b64",
      "field": "media.hover",
      "sourceTextSha256": "e1ca94b24e0a9df2c1ee1155522e3f8e2b312a587d0fb799985a483c80474b96",

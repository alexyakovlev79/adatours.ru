        "kind": "ai_translation",
        "runId": "ada-en-mw67hzfb-317m83qb9js-amanda",
        "model": "GPT-6.1",
        "wordAbsenceReason": "The Word introduction describes the destinations separately and has no equivalent one-week lead combining the Rio landmarks, Angra boat trip and final Paraty activities."
      }

        "kind": "ai_translation",
        "runId": "ada-en-mw5ggep7-amanda",
        "model": "gpt-6.1",
        "wordAbsenceReason": "Word day 5 covers transfers and free time but does not include the Rafain optional dinner/show, minimum 2 guests, shared transfers and separately charged drinks. Translated the complete pinned RU block, preserving these conditions without inventing a price."
      }
    },

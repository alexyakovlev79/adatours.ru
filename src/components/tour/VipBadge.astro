---
interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<span class:list={['vip-badge', { 'vip-badge--overlay': overlay }]} role="img" aria-label="VIP-тур">
  <svg viewBox="0 0 20 16" width="18" height="15" fill="none" aria-hidden="true">
    <path d="m2 4 4 3 4-5 4 5 4-3-2 9H4L2 4Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
    <path d="M5 15h10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
  </svg>
  <span aria-hidden="true">VIP</span>
</span>

<style>
  .vip-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: max-content;
    flex: 0 0 auto;
    padding: 8px 12px;
    border: 1px solid rgb(242 204 103 / 65%);
    border-radius: 6px;
    background: rgb(19 20 18 / 94%);
    color: #F2CC67;
    box-shadow: 0 2px 10px rgb(0 0 0 / 16%);
    font: 600 12px/1 var(--font-body);
    letter-spacing: .12em;
    white-space: nowrap;
    pointer-events: none;
  }
  .vip-badge svg { display: block; flex: 0 0 auto; }
  .vip-badge--overlay {
    position: absolute;
    top: clamp(16px, 2.5vw, 32px);
    left: max(var(--gutter), calc((100% - var(--container-max)) / 2));
    z-index: 3;
  }
  @media (max-width: 720px) {
    .vip-badge { padding: 7px 10px; font-size: 11px; }
    .vip-badge--overlay { top: 16px; }
  }
</style>

---
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/global.css';
import '../styles/image-text-align.css';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import CookieNotice from '../components/global/CookieNotice.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import SeoGeoSection from '../components/editorial/SeoGeoSection.astro';
import { loadSeoGeoArticle } from '../lib/seo-geo-articles';
import SearchOverlay from '../components/global/SearchOverlay.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import { SITE } from '../lib/site';
import { seoCompactTitle } from '../lib/seo-page.mjs';
import { withBase } from '../lib/paths';
import { expandBreadcrumbTrails, type BreadcrumbItem } from '../lib/routes';
import { validateSiteContent } from '../lib/content-validation';
import { pageStructuredData } from '../lib/page-schema';
import { deferImages } from '../lib/lazy-images.mjs';
import { safeJsonLd, SCHEMA_VERSION } from '../lib/structured-data.mjs';
import { privatePilotEnabled } from '../lib/i18n/pilot-html.mjs';

await validateSiteContent();

interface Props {
  leadTitle?: string;
  leadEntityId?: string;
  leadTourId?: string;
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  lang?: string;
  headerTheme?: 'light' | 'dark';
  noindex?: boolean;
  /** Closed EN-only HTML pilot; never authorizes a public translation or release. */
  privatePreview?: boolean;
  showBreadcrumbs?: boolean;
  breadcrumbsInHero?: boolean;
  hideCurrentBreadcrumbLabel?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  pageSchema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  leadTitle, leadEntityId, leadTourId,
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical, image, lang = SITE.locale,
  headerTheme = 'light', noindex = false, privatePreview = false, showBreadcrumbs = true,
  breadcrumbsInHero = false,
  hideCurrentBreadcrumbLabel = false, breadcrumbs, pageSchema,
} = Astro.props;

const canonicalUrl = canonical
  ? new URL(withBase(canonical), Astro.site ?? SITE.url).toString()
  : new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const compactTitle = privatePreview ? title : seoCompactTitle(title);
const fullTitle = compactTitle.includes('Ada Tours') ? compactTitle : `${compactTitle} | Ada Tours`;
const isPreview = import.meta.env.BASE_URL !== '/';
const faviconSvgUrl = withBase('/favicon.svg');
const favicon48Url = withBase('/favicon-48x48.png');
const favicon32Url = withBase('/favicon-32x32.png');
const favicon16Url = withBase('/favicon-16x16.png');
const faviconIcoUrl = withBase('/favicon.ico');
const appleTouchIconUrl = withBase('/apple-touch-icon.png');
// Some editorial pages provide a Hero image without BaseLayout.image.
// Use the already-rendered Hero to give these pages an Open Graph source.
const renderedBody = await Astro.slots.render('default');
const heroTag = (renderedBody.match(/<img\b[^>]*>/gi) || []).find((tag) =>
  /\bclass=["'][^"']*\bhero__media\b/i.test(tag)
);
const heroSrc = heroTag?.match(/\bsrc=["']([^"']+)["']/i)?.[1];
const ogSource = image || heroSrc || '/media/home/hero-rio-generated-20261008-v2.webp';
const ogImageUrl = new URL(withBase(ogSource), Astro.site ?? SITE.url).toString();
const robotsContent = privatePreview
  ? 'noindex,nofollow,noarchive,nosnippet'
  : (isPreview || noindex)
    ? 'noindex, nofollow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const ogLocale = lang === 'ru' ? 'ru_RU' : lang === 'en' ? 'en_US' : lang === 'cn' ? 'zh_CN' : lang;

const base = import.meta.env.BASE_URL || '/';
const normalizedBase = base.endsWith('/') ? base : `${base}/`;
let logicalPath = Astro.url.pathname;
if (normalizedBase !== '/' && logicalPath.startsWith(normalizedBase)) {
  logicalPath = `/${logicalPath.slice(normalizedBase.length)}`;
}
if (!logicalPath.startsWith('/')) logicalPath = `/${logicalPath}`;
if (privatePreview && (!privatePilotEnabled(process.env) || lang !== 'en' || !noindex ||
    !logicalPath.startsWith('/en-pilot-private/'))) {
  throw new Error('Closed EN preview requires verified nonpublic Astro build flags and private route');
}
const rootUrl = new URL(withBase('/'), Astro.site ?? SITE.url).toString();
const segments = logicalPath.split('/').filter(Boolean);
const breadcrumbLabels: Record<string, string> = {
  country: 'Страны', tours: 'Туры', excursions: 'Экскурсии', places: 'Направления',
  interests: 'По интересам', dmc: 'Для агентств', 'travel-agencies': 'Для турагентств',
  terms: 'Условия работы', mice: 'MICE', 'business-delegations': 'Деловые делегации',
  vip: 'VIP', 'multi-country': 'Multi-country', about: 'О нас', team: 'Команда',
  contacts: 'Контакты', cases: 'Кейсы', reviews: 'Отзывы', articles: 'Статьи',
  brazil: 'Бразилия', argentina: 'Аргентина', peru: 'Перу',
  'rio-de-janeiro': 'Рио-де-Жанейро', 'foz-do-iguacu': 'Игуасу', 'manaus-amazon': 'Амазония',
  pantanal: 'Пантанал', 'buenos-aires': 'Буэнос-Айрес', 'el-calafate': 'Эль-Калафате',
  mendoza: 'Мендоса', cusco: 'Куско', 'machu-picchu': 'Мачу-Пикчу', lima: 'Лима',
};
const pageTitle = title.replace(/\s*[|–—-]\s*Ada Tours.*$/i, '').trim();
// Only published, canonical first pages receive an additional SEO/GEO article.
// Articles are compiled into HTML at build time, without client-side fetching.
const seoGeoArticle = !noindex && lang === 'ru' && logicalPath !== '/' &&
  !/\/page\/[0-9]+\/?$/.test(logicalPath)
  ? await loadSeoGeoArticle(logicalPath, pageTitle)
  : null;
const ogType = /^\/(?:articles|cases)\/[^/]+\/$/.test(logicalPath)
  ? 'article'
  : /^\/team\/[^/]+\/$/.test(logicalPath) ? 'profile' : 'website';
const breadcrumbItems = [
  { name: 'Главная', url: rootUrl },
  ...segments.map((segment, index) => ({
    name: breadcrumbLabels[segment] ?? (index === segments.length - 1 ? pageTitle : segment.replace(/-/g, ' ')),
    url: new URL(withBase(`/${segments.slice(0, index + 1).join('/')}/`), Astro.site ?? SITE.url).toString(),
  })),
];
const schemaBreadcrumbTrails = breadcrumbs?.length
  ? expandBreadcrumbTrails(breadcrumbs).map((trail) => {
      const items = trail.map((item) => ({
        name: item.label, url: new URL(withBase(item.href), Astro.site ?? SITE.url).toString(),
      }));
      return items[0]?.url === rootUrl ? items : [{ name: 'Главная', url: rootUrl }, ...items];
    })
  : [breadcrumbItems];
const breadcrumbSchemas = !noindex && showBreadcrumbs && (segments.length > 0 || Boolean(breadcrumbs?.length)) ? schemaBreadcrumbTrails.map((trail, trailIndex) => ({
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumb${trailIndex ? `-${trailIndex + 1}` : ''}`,
  itemListElement: trail.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: item.url })),
})) : [];

// Render exactly once. The graph describes this same HTML, including current card slices.
// Legacy child JSON-LD is consumed and removed, preventing duplicate Person/Trip graphs.
const schema = privatePreview
  ? { metaTitle: fullTitle, metaDescription: description, html: renderedBody, graph: null }
  : await pageStructuredData({
      root: rootUrl, html: renderedBody, path: logicalPath,
      url: canonicalUrl, title: fullTitle, description, lang, image: ogImageUrl,
      breadcrumbs: breadcrumbSchemas, extra: pageSchema, seoGeoArticle,
    });
const metaTitle = schema.metaTitle;
const metaDescription = schema.metaDescription;
---
<!doctype html>
<html lang={lang} data-ada-en-pilot={privatePreview ? 'true' : undefined} data-public-release={privatePreview ? 'false' : undefined} data-ada-shell={privatePreview ? 'BaseLayout' : undefined}>
  <head>
    <!-- Google Analytics 4: Ada Tours -->
    {!privatePreview && <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FM6ZVZH2ZX"></script>}
    {!privatePreview && <script is:inline defer src={withBase('/site-analytics.js')}></script>}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    {!privatePreview && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href={faviconSvgUrl} />
    {!privatePreview && <link rel="icon" type="image/png" sizes="48x48" href={favicon48Url} />}
    {!privatePreview && <link rel="icon" type="image/png" sizes="32x32" href={favicon32Url} />}
    {!privatePreview && <link rel="icon" type="image/png" sizes="16x16" href={favicon16Url} />}
    {!privatePreview && <link rel="shortcut icon" href={faviconIcoUrl} />}
    {!privatePreview && <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />}
    <meta name="robots" content={robotsContent} />
    {privatePreview && <meta name="referrer" content="no-referrer" />}
    {privatePreview && <meta name="color-scheme" content="light" />}
    {!privatePreview && (
      <>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
      </>
    )}
    <noscript><style is:inline>img[data-lazy-src], picture[data-lazy-picture] { display: none !important; }</style></noscript>
    <meta name="theme-color" content="#fffcf8" />
    {!privatePreview && <script is:inline src={withBase('/form-config.js?v=20261022-postbox-1')}></script>}
    {!privatePreview && <script type="application/ld+json" data-schema-version={SCHEMA_VERSION} set:html={safeJsonLd(schema.graph)} />}
    <!-- Yandex.Metrika: Ada Tours, counter 113586792 -->

  </head>
  <body>
    {privatePreview ? (
      <>
        <a class="ada-preview-skip" href="#content">Skip to content</a>
        <SiteHeader theme="light" privatePreview />
        <Fragment set:html={renderedBody} />
        <SiteFooter privatePreview />
      </>
    ) : (
      <>
    <noscript><div><img src="https://mc.yandex.ru/watch/113586792" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <SiteHeader theme={headerTheme} />
    <SearchOverlay />
    {showBreadcrumbs && !breadcrumbsInHero && !noindex && segments.length > 0 && (
      <Breadcrumbs pathname={Astro.url.pathname} title={title} theme={headerTheme}
        items={breadcrumbs} hideCurrentLabel={hideCurrentBreadcrumbLabel} />
    )}
    <main>
      <Fragment set:html={deferImages(schema.html)} />
      {seoGeoArticle && <SeoGeoSection article={seoGeoArticle} />}
      <div id="request" data-lead-location="footer" data-interest-section={leadEntityId?.startsWith('theme_') ? 'cta' : undefined} data-pagefind-ignore>
        <LeadForm title={leadTitle} entityId={leadEntityId || logicalPath} tourId={leadTourId} pageUrl={canonicalUrl} locale={lang} />
      </div>
    </main>
    <script>
      import { initializeLazyImages } from '../scripts/lazy-images.mjs';
      initializeLazyImages();
    </script>
    <CookieNotice />
    <SiteFooter />
      </>
    )}
  </body>
</html>
<style>
  #request { scroll-margin-top: 100px; }
  .ada-preview-skip { position:absolute; top:0; left:12px; z-index:1000; background:white; padding:12px 18px; transform:translateY(-150%); }
  .ada-preview-skip:focus { transform:translateY(0); }
</style>

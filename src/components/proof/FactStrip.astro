---
interface Fact { value: string; label: string; }
interface Props { facts: Fact[]; dark?: boolean; wideFirst?: boolean; }
const { facts, dark = false, wideFirst = false } = Astro.props;
---

<section class:list={['fact-strip', { 'fact-strip--dark': dark, 'fact-strip--wide-first': wideFirst }]}>
  <div class="fact-strip__inner" data-count={facts.length}>
    {facts.map((fact) => (
      <div class="fact">
        <strong>{fact.value}</strong>
        <span>{fact.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .fact-strip {
    background: var(--color-bg);
  }

  .fact-strip--dark {
    color: var(--color-bg);
    background: var(--color-ink-deep);
  }

  .fact-strip__inner {
    --fact-value-size: clamp(1.8rem, 2.5vw, 3.3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .fact-strip--wide-first .fact-strip__inner {
    grid-template-columns: minmax(245px, 1.18fr) repeat(3, minmax(170px, 1fr));
  }

  .fact {
    min-width: 0;
    min-height: 180px;
    padding: 38px 28px;
  }

  .fact + .fact {
    border-left: 1px solid var(--color-line);
  }

  .fact-strip--dark .fact + .fact {
    border-color: rgba(255,255,255,.18);
  }

  .fact strong {
    display: block;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: var(--fact-value-size);
    font-weight: 500;
    line-height: .95;
    letter-spacing: -.045em;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  /*
   * Keep three-column fact rows stable once the container reaches its max width:
   * the text should not become larger while the available cell width is fixed.
   */
  @media (min-width: 681px) {
    .fact-strip__inner[data-count="3"] {
      --fact-value-size: clamp(1.8rem, 1.85vw, 2rem);
    }

    .fact-strip__inner[data-count="3"] .fact strong {
      display: flex;
      align-items: flex-end;
      min-height: clamp(2.09rem, 3.23vw, 4.56rem);
    }
  }

  @media (min-width: 901px) {
    .fact strong {
      display: flex;
      min-height: 1.9em;
      align-items: flex-end;
    }
  }

  .fact span {
    display: block;
    margin-top: 12px;
    color: var(--color-muted);
    font-size: .76rem;
    line-height: 1.35;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .fact-strip--dark .fact span {
    color: rgba(255,255,255,.56);
  }

  @media (max-width: 900px) and (min-width: 681px) {
    .fact-strip--wide-first .fact-strip__inner {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
  }

  @media (max-width: 680px) {
    .fact-strip__inner,
    .fact-strip--wide-first .fact-strip__inner {
      --fact-value-size: clamp(1.65rem, 7vw, 2rem);
      position: relative;
      grid-template-columns: repeat(2, minmax(0,1fr));
    }

    .fact-strip__inner[data-count="3"],
    .fact-strip__inner[data-count="4"] {
      grid-auto-rows: 1fr;
    }

    .fact-strip__inner::before,
    .fact-strip__inner::after {
      content: '';
      position: absolute;
      z-index: 1;
      background: var(--color-line);
      pointer-events: none;
    }

    .fact-strip__inner::before {
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
      transform: translateX(-.5px);
    }

    .fact-strip__inner::after {
      top: 50%;
      right: 0;
      left: 0;
      height: 1px;
      transform: translateY(-.5px);
    }

    .fact-strip--dark .fact-strip__inner::before,
    .fact-strip--dark .fact-strip__inner::after {
      background: rgba(255,255,255,.18);
    }

    .fact,
    .fact + .fact {
      min-height: 132px;
      padding: 26px 16px;
      border: 0;
    }

    .fact-strip__inner[data-count="3"] .fact strong,
    .fact-strip__inner[data-count="4"] .fact strong {
      display: flex;
      min-height: 1.9em;
      align-items: flex-end;
    }
  }
</style>

        "kind": "ai_translation",
        "runId": "ada-en-mw5epm7n-amanda",
        "model": "GPT-6",
        "wordAbsenceReason": "Word contains no introductory overview corresponding to this RU lead. Translate the overview using the confirmed four-day cruise in Word p34 and retaining the optional status of the lagoon visit in p96."
      }

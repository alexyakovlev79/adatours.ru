      "field": "itinerary.text",
      "sourceTextSha256": "7e7d7f44d0997c6c67a1a7e93747e6244b679bf3bcefb57798348e608e9f02c1",
      "text": "Arrive at Juan Santamaría International Airport.\n\nSan José lies in central Costa Rica, among mountains and valleys. After meeting you at the airport, we head straight to La Fortuna, a town near Arenal Volcano.\n\nLa Fortuna is known for its hot springs and the natural landscapes around Arenal. You can stay in a hotel or a villa. Accommodation at Arenal Kioro Hotel is on a bed-and-breakfast basis.\n\nTake time to rest after your flight.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw9u7ti7-p07xkxuu",
        "model": "GPT-6.1 Sol"
      }
    },

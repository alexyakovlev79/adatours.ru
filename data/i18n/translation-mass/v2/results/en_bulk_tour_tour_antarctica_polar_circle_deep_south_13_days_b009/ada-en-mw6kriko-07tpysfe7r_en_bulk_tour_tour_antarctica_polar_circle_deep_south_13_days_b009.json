      "text": "Polar history and glaciers"
    },
    {
      "blockId": "tour:itinerary_text:c3205ac1e20a266d",
      "field": "itinerary.text",
      "sourceTextSha256": "3761e73fbaf45244988139d8dbef61a925b22207070bf15b99182d2b4ef9e594",

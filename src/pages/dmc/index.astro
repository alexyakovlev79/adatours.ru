---
import {commercialText} from '../../lib/i18n/commercial-copy.mjs';
import {sharedUiLocale} from '../../lib/i18n/shared-ui-locale.mjs';
const uiLocale=sharedUiLocale();
const tr=(value:string)=>commercialText(value,uiLocale);
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import DmcNav from '../../components/commercial/DmcNav.astro';
import DmcFaq from '../../components/commercial/DmcFaq.astro';
import CommercialDetails from '../../components/commercial/CommercialDetails.astro';
import CommercialCaseGrid from '../../components/commercial/CommercialCaseGrid.astro';
import CommercialQuote from '../../components/commercial/CommercialQuote.astro';
import CommercialExpert from '../../components/commercial/CommercialExpert.astro';
import CommercialSearchRecord from '../../components/commercial/CommercialSearchRecord.astro';
import { ORG } from '../../data/organization/ada-tours';

const title = tr('DMC в Бразилии и Латинской Америке для туроператоров | Ada Tours');
const description = tr('Принимающий туроператор Ada Tours: индивидуальные поездки, группы и MICE по Латинской Америке. Маршруты, отели, транспорт и работа с клиентами агентств.');
const heroImage = '/media/home/rio-night-enhanced-20260930.webp';
---

<BaseLayout lang={uiLocale}
  leadTitle={tr("Запросить B2B-предложение")}
  leadEntityId="dmc"
  title={title}
  description={description}
  image={heroImage}
>
  <Hero
    eyebrow={tr("Принимающий туроператор · Для агентств")}
    title={tr("DMC в Бразилии и Латинской Америке")}
    intro={tr("Собираем индивидуальные поездки, группы и деловые программы: от отелей и встречи в аэропорту до путешествий по нескольким странам. Агентство ведет клиента, наша команда организует обслуживание на месте.")}
    image={heroImage}
    ctaHref="#request"
    ctaLabel={tr("Запросить предложение")}
    compact
    compactCta
    mobilePhotoLead
  />

  <DmcNav active="overview" />

  <CommercialSearchRecord
    id="dmc-search-record"
    title={title}
    description={description}
    image={heroImage}
    typeLabel={tr("Для агентств")}
    keywords={['DMC', tr('принимающий туроператор'), tr('Бразилия'), tr('Латинская Америка'), 'B2B', 'FIT', tr('нетто-тариф'), tr('группы'), 'MICE', tr('Перу'), tr('Боливия')]}
  />

  <EditorialStatement
    eyebrow={tr("Поездка в деталях")}
    text={tr("Связываем прилеты, отели, переезды и экскурсии в одну программу. Гостям передаем маршрут и контакты, партнеру — состав услуг, расчет и порядок согласования изменений.")}
  />

  <FactStrip
    facts={[
      { value: tr('Бразилия'), label: tr('основное направление, команда в Рио') },
      { value: String(ORG.service.languages.length), label: tr('языков общения с партнерами') },
      { value: 'FIT', label: tr('индивидуальные маршруты и частные группы') },
      { value: 'B2B', label: tr('работа с турагентствами и туроператорами') },
    ]}
  />

  <CommercialDetails
    id="dmc-formats"
    eyebrow={tr("Что поручить нашей команде")}
    title={tr("От поездки для пары до программы для делегации")}
    rows={[
      {
        title: tr('Индивидуальные путешествия'),
        text: tr('Подбираем размещение, транспорт, гидов и занятия под интересы гостей. Учитываем темп поездки, язык сопровождения, уже купленные авиабилеты и обязательные посещения. Для клиентов с особыми требованиями готовим [VIP-программы](/vip/).'),
      },
      {
        title: tr('Несколько стран в одном маршруте'),
        text: tr('Соединяем [Бразилию](/brazil/), [Аргентину](/argentina/), [Перу](/peru/) и другие страны региона. Согласуем переезды, встречи после прилета и продолжение обслуживания в следующей стране. В [поездке по Перу и Боливии](/cases/peru-bolivia-complex-trip/) связали амазонский лодж, поезда к Мачу-Пикчу, Титикаку и Уюни.'),
        href: '/multi-country/',
        linkLabel: tr('Маршруты по нескольким странам'),
      },
      {
        title: tr('Группы и деловые поездки'),
        text: tr('Организуем транспорт, размещение, сопровождение, питание и программу для группы. Для [MICE](/mice/) подбираем площадки и совместные активности; для [делегаций](/mice/business-delegations/) готовим профессиональные визиты, перевод и рабочие переезды.'),
      },
      {
        title: tr('Отдельные услуги'),
        text: tr('Принимаем запросы на трансферы, гидов, устный перевод и отдельное размещение. Пришлите место, даты и задачу: определим состав услуги и проверим доступность на нужное время.'),
        href: '/dmc/travel-agencies/',
        linkLabel: tr('Как работаем с агентствами'),
      },
    ]}
  />

  <CommercialCaseGrid
    id="dmc-completed-projects"
    eyebrow={tr("Выполненные поездки")}
    title={tr("Посмотрите, какие задачи мы уже решали")}
    intro={tr("В кейсах раскрываем маршрут, состав услуг и организационные детали. Они помогают оценить работу команды перед первым запросом.")}
    caseIds={[
      'case_fit_peru_bolivia_complex_trip',
      'case_mice_corporate_group_rio_angra_2026',
      'case_mice_business_delegation_sao_paulo_2026',
    ]}
    summaries={{
      case_fit_peru_bolivia_complex_trip: tr('Амазонский лодж, поезда Hiram Bingham и Vistadome, отдельная доставка багажа, переход в Боливию и русскоязычные гиды.'),
      case_mice_corporate_group_rio_angra_2026: tr('30 гостей, автобусы и гиды, катамаран, питание и вечернее мероприятие. Все услуги собраны в общее расписание.'),
      case_mice_business_delegation_sao_paulo_2026: tr('8 участников, Сан-Паулу, Кампинас и Гуаружа. Рабочие визиты, транспорт и перевод на русском, португальском и английском.'),
    }}
  />

  <CommercialQuote
    caseId="case_fit_peru_bolivia_complex_trip"
    title={tr("Что гости отметили после поездки по Перу и Боливии")}
  />

  <ProcessSteps
    eyebrow={tr("От запроса до встречи гостей")}
    title={tr("Как готовим программу")}
    steps={[
      { title: tr('Получаем бриф'), text: tr('Уточняем даты, маршрут, состав гостей, бюджет и обязательные элементы поездки.') },
      { title: tr('Готовим предложение'), text: tr('Собираем маршрут, включенные услуги, расчет и условия бронирования. Обсуждаем варианты с партнером.') },
      { title: tr('Подтверждаем услуги'), text: tr('Проверяем доступность, согласуем изменения и письменно фиксируем состав заказа и финансовые условия.') },
      { title: tr('Координируем поездку'), text: tr('Передаем контакты, связываемся с поставщиками и информируем агентство, если программа требует изменений.') },
    ]}
    dark
  />

  <CommercialDetails
    id="dmc-partnership"
    eyebrow={tr("Работа с партнером")}
    title={tr("Ваша коммерческая роль сохраняется")}
    rows={[
      {
        title: tr('Расчет для агентства'),
        text: tr('Предлагаем нетто-тариф с вашей наценкой или подходящую проекту комиссионную модель. Выбранный вариант указываем в предложении. Стоимость зависит от дат, направления, числа гостей и состава услуг.'),
        href: '/dmc/terms/',
        linkLabel: tr('Тарифы и порядок подтверждения'),
      },
      {
        title: tr('Ваш бренд и ваш клиент'),
        text: tr('Агентство остается основным коммерческим контактом. Мы адаптируем программу и практические документы под его бренд, согласуем формат ваучеров и оперативную связь с гостями.'),
        href: '/dmc/travel-agencies/',
        linkLabel: tr('Документы, бренд и общение с клиентом'),
      },
      {
        title: tr('Команда и профессиональные связи'),
        text: tr('С Ada Tours можно познакомиться через [Анну Аванесову](/team/anna-avanesova/), [профили компании и партнерские связи](/partners/). В [архиве вебинаров](/webinars/) собраны выступления о направлениях и возможностях региона.'),
      },
    ]}
  />

  <CommercialExpert
    title={tr("Команда под руководством Анны Аванесовой")}
    text={tr("Пришлите задачу ваших гостей: желаемые страны, даты, состав путешественников и требования к поездке. По подробному запросу подготовим маршрут, расчет и условия сотрудничества.")}
  />

  <DmcFaq
    title={tr("О работе с принимающей командой Ada Tours")}
    items={[
      {
        question: tr('Собираете ли вы поездки за пределами Бразилии?'),
        answer: tr('Да. Работаем с [Аргентиной](/argentina/), [Перу](/peru/) и другими странами Латинской Америки, в том числе с маршрутами через несколько стран. Состав услуг и последовательность переездов определяем по вашему запросу.'),
      },
      {
        question: tr('Можно обратиться с поездкой для одного гостя или пары?'),
        answer: tr('Да. Принимаем индивидуальные запросы, поездки небольших делегаций и групп. Пришлите даты, интересы и бюджет; объем обслуживания и условия расчета определим для этой поездки.'),
      },
      {
        question: tr('Можно заказать только трансфер, гида или отель?'),
        answer: tr('Да, принимаем и запросы на отдельные услуги. Укажите даты, место, число гостей, язык сопровождения и нужный формат. Для конкретной заявки проверим доступность и подготовим условия.'),
      },
      {
        question: tr('Что получит партнер после подробного запроса?'),
        answer: tr('Маршрут, описание включенных и не включенных услуг, расчет, исходные условия цены и основные правила бронирования. Затем дорабатываем программу по приоритетам партнера. Порядок разработки описан в [условиях сотрудничества](/dmc/terms/).'),
      },
      {
        question: tr('На каких языках можно общаться с Ada Tours?'),
        answer: tr('Языки общения с партнерами: ') + ORG.service.languages.map((language) => uiLocale==='en'?commercialText(language,uiLocale):language.toLowerCase()).join(', ') + tr('. Язык сопровождения на маршруте указываем в предложении по поездке.'),
      },
      {
        question: tr('Кто координирует изменения во время путешествия?'),
        answer: tr('Мы связываемся с поставщиками и сообщаем агентству о возможных решениях. Для группового проекта назначаем контактное лицо до выезда. Контакты на время поездки, часы доступности и порядок согласования изменений определяем в предложении.'),
      },
    ]}
  />
</BaseLayout>

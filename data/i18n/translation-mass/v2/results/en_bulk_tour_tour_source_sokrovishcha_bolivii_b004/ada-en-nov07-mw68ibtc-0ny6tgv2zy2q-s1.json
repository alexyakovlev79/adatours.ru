    {
      "blockId": "tour:itinerary_text:569e72e117968fcc",
      "field": "itinerary.text",
      "sourceTextSha256": "d8ab38bfc4881a0bb2585bc63e90eac30c12572d4d10ac57416b7af106c636df",
      "text": "8:00 am departure by private transport to Samaipata, a picturesque colonial town 120 km from the city, at an altitude of 1650 meters above sea level. Near the town is an important archaeological site known as the ceremonial and administrative center of Samaipata, Inca Fortress (El Fuerte), at 1950 meters above sea level. It is the last bastion of the Incas, an enormous mountain carved with two large grooves where zoomorphic figures sculpted in rock, water channels, stairs, and niches can be observed. Enjoy a typical lunch in the town of Samaipata. Night at Hotel El Pueblito.",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1YP08hkivzMKzfoqc41RZ0VT57EyTri1_",

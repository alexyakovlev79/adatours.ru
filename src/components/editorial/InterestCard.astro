---
import { withBase } from '../../lib/paths';
import VipBadge from '../tour/VipBadge.astro';
import { getVipTourPaths } from '../../lib/vip-catalog';
interface Props {
  entityId: string; title: string; text?: string; href: string; image?: string;
  eyebrow?: string; meta?: string; imageTextAlign?: 'left' | 'right'; large?: boolean;
}
const { entityId, title, text, href, image, eyebrow, meta, imageTextAlign = 'left', large = false } = Astro.props;
const vip = (await getVipTourPaths()).has(href);
---
<article class:list={['interest-card', { 'interest-card--large': large }]} data-interest-item={entityId}>
  <a href={withBase(href)} class="interest-card__link">
    {image && <div class="interest-card__image"><img src={withBase(image)} alt="" loading="lazy" decoding="async" />{vip && <VipBadge overlay />}</div>}
    <div class="interest-card__copy" data-text-align={imageTextAlign}>
      {eyebrow && eyebrow !== 'По интересам' && <p class="eyebrow">{eyebrow}</p>}
      <h3>{title}<span aria-hidden="true"> ↗</span></h3>
      {meta && <p class="interest-card__meta">{meta}</p>}
      {text && <p class="interest-card__text">{text}</p>}
    </div>
  </a>
</article>
<style>
  .interest-card { min-width: 0; }
  .interest-card__link { display: block; color: var(--color-ink); text-decoration: none; height: 100%; }
  .interest-card__link:focus-visible { outline: 2px solid currentColor; outline-offset: 7px; }
  .interest-card__image { position: relative; overflow: hidden; aspect-ratio: 16 / 10; background: var(--color-line); }
  .interest-card__image :global(.vip-badge--overlay) { top: 16px; left: 16px; }
  .interest-card__image img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  @media (prefers-reduced-motion: no-preference) { .interest-card__link:hover img { transform: scale(1.025); } }
  .interest-card__copy { padding-block: 22px 12px; }
  .interest-card__copy .eyebrow { margin: 0 0 10px; }
  h3 { font: 400 clamp(1.5rem, 2.35vw, 2.6rem)/1.12 var(--font-display); margin: 0; overflow-wrap: anywhere; }
  h3 span { font-size: .62em; white-space: nowrap; }
  .interest-card__meta { font-size: .83rem; line-height: 1.5; color: var(--color-muted); margin: 12px 0 0; }
  .interest-card__text { font-size: .98rem; line-height: 1.65; margin: 12px 0 0; }
  .interest-card--large { grid-column: 1 / -1; }
  .interest-card--large .interest-card__link {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(440px, 55vw, 680px);
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background: #171815;
  }
  .interest-card--large .interest-card__image { position: absolute; inset: 0; width: 100%; height: 100%; aspect-ratio: auto; z-index: -2; }
  .interest-card--large .interest-card__link::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(10,10,9,.75), rgba(10,10,9,.2) 85%); }
  .interest-card--large .interest-card__copy { min-width: 0; padding: clamp(36px, 6vw, 72px) var(--gutter); }
  .interest-card--large h3 { max-width: 920px; color: inherit; font-size: clamp(2.15rem, 4vw, 4rem); }
  .interest-card--large .interest-card__text { max-width: 700px; font-size: 1.08rem; color: rgba(255,255,255,.9); }
  .interest-card--large .interest-card__meta { color: rgba(255,255,255,.9); }
  .interest-card--large .interest-card__copy[data-text-align="right"] { text-align: right; }
  .interest-card--large .interest-card__copy[data-text-align="right"] h3,
  .interest-card--large .interest-card__copy[data-text-align="right"] .interest-card__text { margin-left: auto; }
  @media (max-width: 759px) {
    .interest-card--large .interest-card__link::before { background: linear-gradient(180deg, rgba(10,10,9,.15), rgba(10,10,9,.82)); }
  }
</style>

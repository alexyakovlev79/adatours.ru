---
import { withBase } from '../../lib/paths';
import { imageCaption } from '../../lib/image-captions.mjs';

interface MediaItem {
  src: string;
  alt?: string;
  hover?: string;
  caption?: string;
  status?: 'approved' | 'needs_replacement' | 'replaced';
  replacementReason?: string;
  intendedSlot?: string;
  sourceWidth?: number;
  sourceHeight?: number;
}

interface Props {
  items: MediaItem[];
  eyebrow?: string;
  title?: string;
  layout?: 'editorial' | 'flush' | 'orientation';
  imageTextAlign?: 'left' | 'right';
}

const {
  items = [],
  eyebrow = 'Фотографии',
  title = 'Еще несколько кадров',
  layout = 'editorial',
  imageTextAlign,
} = Astro.props;

// Media QA status is metadata, not a visibility switch.
const visibleItems = items;
const flush = layout === 'flush';
const orientation = layout === 'orientation';
---

{visibleItems.length > 0 && (
  <section class:list={['media-gallery', 'section', { 'media-gallery--flush': flush, 'media-gallery--orientation': orientation }]} data-image-text-align={imageTextAlign}>
    <div class="container">
      <div class="media-gallery__heading">
        <p class="eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
      </div>
    </div>

    <div class="media-gallery__grid">
        {visibleItems.map((item, index) => (
          <figure
            class:list={['media-gallery__item', `media-gallery__item--${index % 6}`]}
            data-media-status={item.status ?? 'legacy'}
            data-replacement-reason={item.replacementReason}
            data-mobile-panorama={
              item.sourceWidth && item.sourceHeight && item.sourceWidth * 9 > item.sourceHeight * 16
                ? "true"
                : undefined
            }
            data-orientation={
              item.sourceWidth && item.sourceHeight
                ? (item.sourceHeight > item.sourceWidth ? 'portrait' : 'landscape')
                : undefined
            }
          >
            <img width={item.sourceWidth} height={item.sourceHeight} src={withBase(item.src)} alt={imageCaption(item.src, item).alt} title={imageCaption(item.src, item).hover} loading="lazy" />
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        ))}
    </div>
  </section>
)}

<style>
  .media-gallery {
    padding-bottom: 0;
    background: var(--color-bg);
  }

  .media-gallery__heading {
    display: grid;
    grid-template-columns: minmax(160px, .42fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 78px);
    align-items: start;
    margin-bottom: var(--heading-gap);
  }

  .media-gallery__heading h2 { max-width: 860px; margin: 0; }

  /* A single edge-to-edge, zero-gutter photo wall for all gallery layouts. */
  .media-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 0;
  }

  .media-gallery__item {
    position: relative;
    grid-column: span 1;
    min-width: 0;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-line);
  }

  .media-gallery__item:nth-child(5n) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  .media-gallery__item img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  .media-gallery figcaption {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    max-width: none;
    margin: 0;
    padding: 30px clamp(18px, 3vw, 44px) 18px;
    color: #fff;
    background: linear-gradient(transparent, rgba(0,0,0,.72));
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .media-gallery[data-image-text-align] figcaption {
    text-align: var(--image-text-align);
  }

  /* Excursion/destination portraits pair up; landscape frames span the row. */
  .media-gallery--orientation .media-gallery__item[data-orientation="portrait"] {
    grid-column: span 1;
    aspect-ratio: 3 / 4;
  }
  .media-gallery--orientation .media-gallery__item[data-orientation="landscape"],
  .media-gallery--orientation .media-gallery__item:not([data-orientation]) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  @media (max-width: 760px) {
    .media-gallery__heading { grid-template-columns: 1fr; gap: 12px; }
    .media-gallery__grid { grid-template-columns: 1fr; }
    .media-gallery__item,
    .media-gallery__item:nth-child(5n) { grid-column: 1; aspect-ratio: 4 / 3; }
    .media-gallery--orientation .media-gallery__item[data-orientation="portrait"] {
      grid-column: 1;
      aspect-ratio: 4 / 5;
    }
    .media-gallery--orientation .media-gallery__item[data-orientation="landscape"],
    .media-gallery--orientation .media-gallery__item:not([data-orientation]) {
      grid-column: 1;
      aspect-ratio: 4 / 3;
    }
    .media-gallery--orientation .media-gallery__item[data-mobile-panorama="true"] {
      grid-column: 1;
      aspect-ratio: 16 / 9;
    }
    .media-gallery figcaption { padding: 24px 20px 14px; }
  }
</style>


<script>
  const classifyGalleryImages = () => {
    document.querySelectorAll('.media-gallery--orientation .media-gallery__item').forEach((item) => {
      const img = item.querySelector('img');
      if (!(img instanceof HTMLImageElement)) return;

      const applyOrientation = () => {
        if (img.hasAttribute('data-lazy-src') || !img.naturalWidth || !img.naturalHeight) return;
        item.setAttribute(
          'data-orientation',
          img.naturalHeight > img.naturalWidth ? 'portrait' : 'landscape'
        );
        if (img.naturalWidth * 9 > img.naturalHeight * 16) {
          item.setAttribute('data-mobile-panorama', 'true');
        } else {
          item.removeAttribute('data-mobile-panorama');
        }
      };

      // The inline placeholder may load before the real photo. Keep the listener
      // until the original arrives, and never classify the placeholder.
      img.addEventListener('load', applyOrientation);
      if (img.complete) applyOrientation();
    });
  };

  classifyGalleryImages();
  document.addEventListener('astro:page-load', classifyGalleryImages);
</script>

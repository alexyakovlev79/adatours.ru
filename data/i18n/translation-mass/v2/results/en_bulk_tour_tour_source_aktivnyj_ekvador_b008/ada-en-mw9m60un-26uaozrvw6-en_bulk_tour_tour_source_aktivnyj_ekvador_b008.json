      "sourceTextSha256": "93948bc56c8856388b09125057bde7c74f0b0ee5f3df904b1cc7cb38a4ca924e",
      "text": "Papallacta Hot Springs and Quito",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw9m60un-26uaozrvw6",
        "model": "GPT-6.1 Sol"

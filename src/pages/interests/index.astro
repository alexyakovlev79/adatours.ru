---
import { INTERESTS, themeRelevance, countLabel } from '../../lib/interest-model.mjs';
import { isActiveEntity } from '../../lib/archive.mjs';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { themePath } from '../../lib/routes';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import DestinationBand from '../../components/editorial/DestinationBand.astro';

const [entries, tours] = await Promise.all([getCollection('themes'), getCollection('tours')]);
const themes = INTERESTS.map((interest) => entries.find((entry) => entry.data.id === interest.id && entry.data.locale === 'ru' && isActiveEntity(entry))).filter(Boolean);
const tourCount = (id) => tours.filter((entry) => entry.data.locale === 'ru' && isActiveEntity(entry) && themeRelevance(entry, id)).length;

---

<BaseLayout
  title="Туры по интересам в Бразилию и Латинскую Америку"
  description="13 интересов: природа и животные, культура и история, круизы и экспедиции, события и праздники, приключения, пляжи, гастрономия, рыбалка, дайвинг, мото-туры, семейные поездки, SPA и романтика."
>
  <Hero
    eyebrow="По интересам"
    title="Начните с того, ради чего едете"
    intro="Животные, древние города, океан, экспедиция, праздник или путешествие вдвоем. Мы подберем географию и программу под ваш интерес."
    image="/media/pages/po-interesam/hero-enhanced-20261001.webp"
  />

  <EditorialStatement
    eyebrow={`${themes.length} интересов`}
    text="Одна тема может задать всю поездку или стать ее лучшей частью."
  />

  {themes.map((theme, index) => (
    <DestinationBand
      eyebrow={countLabel(tourCount(theme.data.id))}
      title={theme.data.name}
      text={theme.data.summary}
      image={theme.data.hero?.src}
      imageTextAlign={theme.data.imageTextAlign}
      href={themePath(theme.data)}
      align={index % 3 === 1 ? 'right' : 'left'}
    />
  ))}
</BaseLayout>

---
import { withBase } from '../../lib/paths';
import InlineMarkdown from '../global/InlineMarkdown.astro';

interface Day {
  day?: number;
  label?: string;
  title: string;
  places?: string[];
  text: string;
  image?: string | {
    src: string;
    alt?: string;
    status?: 'approved' | 'needs_replacement' | 'replaced';
    replacementReason?: string;
    intendedSlot?: string;
  };
  images?: Array<{
    src: string;
    alt?: string;
    status?: 'approved' | 'needs_replacement' | 'replaced';
    replacementReason?: string;
    intendedSlot?: string;
  }>;
  subsections?: Array<{
    title: string;
    text: string;
  }>;
}
interface Props { days: Day[]; }
const { days } = Astro.props;

const resolveDayImage = (image: Day['image']) => {
  if (!image) return null;
  if (typeof image === 'string') return { src: image, alt: '', status: undefined };
  return image;
};
---

<section class="itinerary section">
  <div class="container itinerary__container">
    <div class="itinerary__heading">
      <p class="eyebrow">Маршрут</p>
      <h2>{days.filter((day) => typeof day.day === 'number').length} дней путешествия</h2>
    </div>

    <div class="itinerary__days">
      {days.map((day) => {
        const image = resolveDayImage(day.image);
        const dayImages = day.images?.length ? day.images : (image ? [image] : []);
        // Source-linked images stay attached to the exact itinerary day.
        const visibleImage = dayImages.length > 0;
        return (
        <article class:list={['day-card', { 'day-card--image': visibleImage }]}>
          <details class="day">
            <summary>
              <span class="day__number">{typeof day.day === 'number' ? String(day.day).padStart(2, '0') : ''}</span>
              <span class="day__title">{day.title}</span>
              <span class="day__toggle" aria-hidden="true">+</span>
            </summary>
            <div class="day__content">
              <div>
                {day.places && day.places.length > 0 && <p class="day__places">{day.places.join(' · ')}</p>}
                <p><InlineMarkdown text={day.text} /></p>
                {day.subsections?.map((subsection) => (
                  <section class="day__subsection">
                    <h3>{subsection.title}</h3>
                    {subsection.text.split(/\n\s*\n/).map((paragraph) => paragraph.trim()).filter(Boolean).map((paragraph) => (
                      <p><InlineMarkdown text={paragraph} /></p>
                    ))}
                  </section>
                ))}
              </div>
            </div>
          </details>
          {visibleImage && (
            <div class="day__media">
              {dayImages.map((item) => (
                <img
                  src={withBase(item.src)}
                  alt={item.alt ?? ''}
                  loading="lazy"
                  data-media-status={item.status ?? 'legacy'}
                  data-replacement-reason={item.replacementReason}
                />
              ))}
            </div>
          )}
        </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .itinerary {
    color: var(--color-bg);
    background: var(--color-ink-deep);
  }

  @media (min-width: 1100px) {
    .itinerary__container {
      width: 100%;
      max-width: none;
      margin-inline: 0;
      padding-inline: 24px;
    }
  }

  .itinerary__heading {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    align-items: start;
    margin-bottom: clamp(40px, 6vw, 80px);
  }

  .itinerary__heading h2 {
    margin: 0;
  }

  .itinerary__days {
    border-top: 0;
  }

  .day-card {
    border-bottom: 0;
  }

  .day {
    border: 0;
  }

  .day summary {
    display: grid;
    grid-template-columns: 80px 1fr 44px;
    gap: 20px;
    align-items: center;
    min-height: 118px;
    cursor: pointer;
    list-style: none;
  }

  .day summary::-webkit-details-marker {
    display: none;
  }

  .day__number {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: .9rem;
    letter-spacing: .08em;
  }

  .day__title {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.1rem + 1vw, 2.3rem);
    line-height: 1.1;
  }

  .day__toggle {
    justify-self: end;
    font-size: 2rem;
    font-weight: 200;
    transition: transform 220ms var(--ease-out);
  }

  .day[open] .day__toggle {
    transform: rotate(45deg);
  }

  .day__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    padding: 0 0 54px 100px;
  }

  .day__content p {
    margin-top: 0;
    color: rgba(255,255,255,.74);
  }

  .day__places {
    color: var(--color-gold) !important;
    font-size: .78rem !important;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .day__subsection {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,.16);
  }

  .day__subsection h3 {
    margin: 0 0 14px;
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1rem + .45vw, 1.45rem);
    line-height: 1.2;
  }

  .day__subsection p:last-child {
    margin-bottom: 0;
  }

  .day__media {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 8px;
  }

  .day__content img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /*
   * DESKTOP ITINERARY LAYOUT INVARIANT
   * ----------------------------------
   * The itinerary is a two-column grid on desktop. For every pair of neighboring
   * cards, the BOTTOM edges of their media blocks must align. Text above the media
   * may have different lengths. A card with shorter text is allowed to use a taller
   * image so the image grows upward and fills part of the spare vertical space.
   *
   * Do NOT force equal image heights or a fixed 16:9 ratio on desktop.
   * Do NOT keep itinerary media inside <details>; it must remain a sibling of
   * <details> inside .day-card so the card itself controls row height and bottom
   * alignment. Mobile remains single-column and may keep 16:9 images.
   */

  @media (min-width: 1100px) {
    .itinerary__days {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }

    .day-card {
      display: flex;
      flex-direction: column;
      min-height: 100%;
      padding-bottom: 41px;
    }

    .day__content {
      padding: 0;
    }

    .day-card--image .day__content {
      padding-bottom: 0;
    }

    .day__media {
      display: grid;
      grid-auto-rows: minmax(0, 1fr);
      width: 100%;
      overflow: hidden;
    }

    .day[open] + .day__media {
      flex: 1 1 320px;
      min-height: 260px;
      max-height: 660px;
      margin-top: auto;
      padding-top: 40px;
      aspect-ratio: auto;
    }

    .day:not([open]) + .day__media {
      flex: 0 0 auto;
      min-height: 0;
      max-height: none;
      margin-top: 41px;
      padding-top: 0;
      aspect-ratio: 16 / 9;
    }

    .day__media img {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 0;
      aspect-ratio: auto;
      object-fit: cover;
    }
  }

  @media (max-width: 760px) {
    .itinerary__heading {
      grid-template-columns: 1fr;
    }

    .day summary {
      grid-template-columns: 44px 1fr 30px;
      min-height: 94px;
    }

    .day-card {
      padding-bottom: 14px;
    }

    .day__content {
      display: block;
      min-width: 0;
      padding: 0 0 0 64px;
    }

    .day-card:not(.day-card--image) {
      padding-bottom: 54px;
    }

    .day__content > div:first-child {
      min-width: 0;
      max-width: 100%;
      overflow-wrap: anywhere;
    }

    .day__media {
      width: 100vw;
      max-width: none;
      margin-top: 14px;
      margin-left: 0;
      margin-right: 0;
      transform: translateX(calc(-1 * var(--gutter)));
    }

    .day[open] + .day__media {
      margin-top: 28px;
    }

    .day__media img {
      width: 100%;
      max-width: none;
      aspect-ratio: 16 / 9;
    }
  }
</style>

---
import { withBase } from '../../lib/paths';
import { imageCaption } from '../../lib/image-captions.mjs';

interface MediaItem {
  src: string;
  alt?: string;
  hover?: string;
  caption?: string;
  status?: 'approved' | 'needs_replacement' | 'replaced';
  replacementReason?: string;
  intendedSlot?: string;
  sourceWidth?: number;
  sourceHeight?: number;
}

interface Props {
  items: MediaItem[];
  eyebrow?: string;
  title?: string;
  layout?: 'editorial' | 'flush' | 'orientation';
  imageTextAlign?: 'left' | 'right';
}

const {
  items = [],
  eyebrow = 'Фотографии',
  title = 'Еще несколько кадров',
  layout = 'editorial',
  imageTextAlign,
} = Astro.props;

// Media QA status is metadata, not a visibility switch.
const visibleItems = items;
const flush = layout === 'flush';
const orientation = layout === 'orientation';
---

{visibleItems.length > 0 && (
  <section class:list={['media-gallery', 'section', { 'media-gallery--flush': flush, 'media-gallery--orientation': orientation }]} data-image-text-align={imageTextAlign}>
    <div class="container">
      <div class="media-gallery__heading">
        <p class="eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
      </div>

      <div class="media-gallery__grid">
        {visibleItems.map((item, index) => (
          <figure
            class:list={['media-gallery__item', `media-gallery__item--${index % 6}`]}
            data-media-status={item.status ?? 'legacy'}
            data-replacement-reason={item.replacementReason}
            data-mobile-panorama={
              item.sourceWidth && item.sourceHeight && item.sourceWidth * 9 > item.sourceHeight * 16
                ? "true"
                : undefined
            }
            data-orientation={
              item.sourceWidth && item.sourceHeight
                ? (item.sourceHeight > item.sourceWidth ? 'portrait' : 'landscape')
                : undefined
            }
          >
            <img src={withBase(item.src)} alt={imageCaption(item.src, item).alt} title={imageCaption(item.src, item).hover} loading="lazy" />
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .media-gallery {
    background: var(--color-bg);
  }

  .media-gallery__heading {
    display: grid;
    grid-template-columns: minmax(160px, .42fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 78px);
    align-items: start;
    margin-bottom: clamp(42px, 7vw, 96px);
  }

  .media-gallery__heading h2 {
    max-width: 860px;
    margin: 0;
  }

  .media-gallery__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(18px, 2.3vw, 34px);
    align-items: start;
  }

  .media-gallery__item {
    min-width: 0;
    margin: 0;
  }

  .media-gallery__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-gallery__item--0 {
    grid-column: span 7;
  }

  .media-gallery__item--0 img {
    aspect-ratio: 4 / 3;
  }

  .media-gallery__item--1 {
    grid-column: span 5;
    margin-top: clamp(48px, 9vw, 132px);
  }

  .media-gallery__item--1 img {
    aspect-ratio: 3 / 4;
  }

  .media-gallery__item--2 {
    grid-column: span 5;
  }

  .media-gallery__item--2 img {
    aspect-ratio: 1 / 1;
  }

  .media-gallery__item--3 {
    grid-column: span 7;
    margin-top: clamp(34px, 6vw, 90px);
  }

  .media-gallery__item--3 img {
    aspect-ratio: 16 / 10;
  }

  .media-gallery__item--4 {
    grid-column: 2 / span 10;
    margin-block: clamp(42px, 7vw, 100px);
  }

  .media-gallery__item--4 img {
    aspect-ratio: 16 / 8;
  }

  .media-gallery__item--5 {
    grid-column: 4 / span 7;
  }

  .media-gallery__item--5 img {
    aspect-ratio: 4 / 3;
  }

  .media-gallery figcaption {
    max-width: 720px;
    margin-top: 10px;
    color: rgba(26,26,26,.58);
    font-size: var(--text-xs);
  }

  /* Test layout for Rio: a full-bleed, gapless photo wall.
     The source order stays unchanged; only the rendering changes. */
  .media-gallery--flush .media-gallery__heading {
    margin-bottom: 0;
    padding-bottom: clamp(28px, 4vw, 48px);
  }

  .media-gallery--flush .media-gallery__grid {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: clamp(360px, 35vw, 620px);
    gap: 0;
    align-items: stretch;
  }

  .media-gallery--flush .media-gallery__item,
  .media-gallery--flush .media-gallery__item--0,
  .media-gallery--flush .media-gallery__item--1,
  .media-gallery--flush .media-gallery__item--2,
  .media-gallery--flush .media-gallery__item--3,
  .media-gallery--flush .media-gallery__item--4,
  .media-gallery--flush .media-gallery__item--5 {
    position: relative;
    grid-column: auto;
    margin: 0;
    overflow: hidden;
  }

  .media-gallery--flush .media-gallery__item:nth-child(5n) {
    grid-column: 1 / -1;
  }

  .media-gallery--flush .media-gallery__item img,
  .media-gallery--flush .media-gallery__item--0 img,
  .media-gallery--flush .media-gallery__item--1 img,
  .media-gallery--flush .media-gallery__item--2 img,
  .media-gallery--flush .media-gallery__item--3 img,
  .media-gallery--flush .media-gallery__item--4 img,
  .media-gallery--flush .media-gallery__item--5 img {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
  }

  .media-gallery--flush figcaption {
    position: absolute;
    inset: auto 0 0;
    max-width: none;
    margin: 0;
    padding: 28px 24px 18px;
    color: #fff;
    background: linear-gradient(transparent, rgba(0,0,0,.58));
  }

  .media-gallery--flush[data-image-text-align] figcaption {
    text-align: var(--image-text-align);
  }


  /* Excursion gallery: landscape images span the content width,
     portrait images form two-column pairs. */
  .media-gallery--orientation .media-gallery__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 1200px;
    margin-inline: auto;
  }

  .media-gallery--orientation .media-gallery__item,
  .media-gallery--orientation .media-gallery__item--0,
  .media-gallery--orientation .media-gallery__item--1,
  .media-gallery--orientation .media-gallery__item--2,
  .media-gallery--orientation .media-gallery__item--3,
  .media-gallery--orientation .media-gallery__item--4,
  .media-gallery--orientation .media-gallery__item--5 {
    grid-column: 1 / -1;
    margin: 0;
  }

  .media-gallery--orientation .media-gallery__item[data-orientation="portrait"] {
    grid-column: span 1;
  }

  .media-gallery--orientation .media-gallery__item img,
  .media-gallery--orientation .media-gallery__item--0 img,
  .media-gallery--orientation .media-gallery__item--1 img,
  .media-gallery--orientation .media-gallery__item--2 img,
  .media-gallery--orientation .media-gallery__item--3 img,
  .media-gallery--orientation .media-gallery__item--4 img,
  .media-gallery--orientation .media-gallery__item--5 img {
    width: 100%;
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
  }

  @media (max-width: 760px) {
    .media-gallery__heading {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .media-gallery__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .media-gallery__item,
    .media-gallery__item--0,
    .media-gallery__item--1,
    .media-gallery__item--2,
    .media-gallery__item--3,
    .media-gallery__item--4,
    .media-gallery__item--5 {
      grid-column: 1;
      margin: 0;
    }

    .media-gallery__item:nth-child(3n + 1) img {
      aspect-ratio: 4 / 5;
    }

    .media-gallery__item:nth-child(3n + 2) img {
      aspect-ratio: 4 / 3;
    }

    .media-gallery__item:nth-child(3n) img {
      aspect-ratio: 1 / 1;
    }

    .media-gallery--flush .media-gallery__heading {
      padding-bottom: 24px;
    }

    .media-gallery--flush .media-gallery__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      gap: 0;
    }

    .media-gallery--flush .media-gallery__item,
    .media-gallery--flush .media-gallery__item:nth-child(5n) {
      grid-column: 1;
      aspect-ratio: 4 / 3;
    }

    .media-gallery--flush .media-gallery__item img,
    .media-gallery--flush .media-gallery__item:nth-child(3n + 1) img,
    .media-gallery--flush .media-gallery__item:nth-child(3n + 2) img,
    .media-gallery--flush .media-gallery__item:nth-child(3n) img {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      object-fit: cover;
    }

    .media-gallery--orientation .media-gallery__grid {
      grid-template-columns: 1fr;
      max-width: none;
    }

    .media-gallery--orientation .media-gallery__item,
    .media-gallery--orientation .media-gallery__item--0,
    .media-gallery--orientation .media-gallery__item--1,
    .media-gallery--orientation .media-gallery__item--2,
    .media-gallery--orientation .media-gallery__item--3,
    .media-gallery--orientation .media-gallery__item--4,
    .media-gallery--orientation .media-gallery__item--5,
    .media-gallery--orientation .media-gallery__item[data-orientation="portrait"] {
      grid-column: 1;
      margin: 0;
    }

    .media-gallery--orientation .media-gallery__item img,
    .media-gallery--orientation .media-gallery__item:nth-child(3n + 1) img,
    .media-gallery--orientation .media-gallery__item:nth-child(3n + 2) img,
    .media-gallery--orientation .media-gallery__item:nth-child(3n) img {
      width: 100%;
      height: auto;
      aspect-ratio: auto;
      object-fit: contain;
    }

    /* Mobile panoramic photos must occupy at least a 16:9 frame.
       Narrower originals retain their full height and natural proportions. */
    .media-gallery--orientation .media-gallery__item[data-mobile-panorama="true"] img {
      aspect-ratio: 16 / 9;
      object-fit: cover;
      object-position: center;
    }
  }
</style>


<script>
  const classifyGalleryImages = () => {
    document.querySelectorAll('.media-gallery--orientation .media-gallery__item').forEach((item) => {
      const img = item.querySelector('img');
      if (!(img instanceof HTMLImageElement)) return;

      const applyOrientation = () => {
        if (!img.naturalWidth || !img.naturalHeight) return;
        item.setAttribute(
          'data-orientation',
          img.naturalHeight > img.naturalWidth ? 'portrait' : 'landscape'
        );
        if (img.naturalWidth * 9 > img.naturalHeight * 16) {
          item.setAttribute('data-mobile-panorama', 'true');
        } else {
          item.removeAttribute('data-mobile-panorama');
        }
      };

      if (img.complete) applyOrientation();
      else img.addEventListener('load', applyOrientation, { once: true });
    });
  };

  classifyGalleryImages();
  document.addEventListener('astro:page-load', classifyGalleryImages);
</script>

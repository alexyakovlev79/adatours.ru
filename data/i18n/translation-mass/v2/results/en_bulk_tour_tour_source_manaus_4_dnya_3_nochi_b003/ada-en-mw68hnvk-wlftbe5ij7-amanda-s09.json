    {
      "blockId": "tour:itinerary_text:569e72e117968fcc",
      "field": "itinerary.text",
      "sourceTextSha256": "ecbd5a509733fa83591310378e59ff32762cae82c4c1e67fa54686956035df0c",
      "text": "You will embark on an unforgettable evening excursion led by your knowledgeable English-speaking guide to a nearby natural alligator habitat. As night falls and the jungle comes alive with sound, you’ll have the unique opportunity to observe these powerful, prehistoric creatures in their natural environment. With their razor-sharp teeth gleaming under the moonlight, they offer a truly thrilling sight – and yes, you’ll even be able to take photos (from a safe distance) to capture the moment! This experience is offered in full respect of nature: the lodge operates with a strong commitment to environmental sustainability, and all alligators encountered are safely released back into the wild after observation.",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1F-Ti9HJaf9sH3TqOTfKu2yyF7-GdS9v0",
        "documentSha256": "af0732f00ce4704b2e56783e9d2dbe2a71e6c2ce1908335eff5a47f04b255eb6",

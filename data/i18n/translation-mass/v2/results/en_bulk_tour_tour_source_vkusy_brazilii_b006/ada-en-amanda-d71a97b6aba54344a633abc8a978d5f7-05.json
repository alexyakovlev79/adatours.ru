      "blockId": "tour:itinerary_text:b9ad3e14216c2f08",
      "field": "itinerary.text",
      "sourceTextSha256": "7ddf2e316b9f1cee0a48df0aec0c94c8e47c7c1185d60dfee5b70e2c9d1a9924",

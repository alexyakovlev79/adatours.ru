---
interface Step { title: string; text: string; }
interface Props {
  eyebrow?: string;
  title: string;
  steps: Step[];
  dark?: boolean;
}
const { eyebrow, title, steps, dark = false } = Astro.props;
---

<section class:list={['process section', { 'process--dark': dark }]}>
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <div class="process__steps">
      {steps.map((step, index) => (
        <article class="step">
          <span>{String(index + 1).padStart(2,'0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .process--dark {
    color: var(--color-bg);
    background: var(--color-ink-deep);
  }

  .process h2 {
    max-width: 1000px;
    margin: 12px 0 clamp(46px, 7vw, 92px);
  }

  .process__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    border-top: 1px solid var(--color-line);
  }

  .process--dark .process__steps {
    border-color: rgba(255,255,255,.22);
  }

  .step {
    min-height: 340px;
    padding: 34px 28px 28px 0;
    border-right: 1px solid var(--color-line);
  }

  .process--dark .step {
    border-color: rgba(255,255,255,.22);
  }

  .step + .step {
    padding-left: 28px;
  }

  .step > span {
    color: var(--color-gold-deep);
    font-family: var(--font-display);
    font-size: .82rem;
    letter-spacing: .1em;
  }

  .process--dark .step > span {
    color: var(--color-gold);
  }

  .step h3 {
    margin: 54px 0 20px;
    font-size: clamp(1.55rem, 2vw, 2.5rem);
  }

  .step p {
    color: color-mix(in srgb, currentColor 68%, transparent);
  }

  @media (max-width: 900px) {
    .process__steps {
      grid-template-columns: repeat(2,minmax(0,1fr));
    }
  }

  @media (max-width: 560px) {
    .process__steps {
      grid-template-columns: 1fr;
    }

    .step,
    .step + .step {
      min-height: 0;
      padding: 28px 0 42px;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .step h3 {
      margin-top: 28px;
    }
  }
</style>

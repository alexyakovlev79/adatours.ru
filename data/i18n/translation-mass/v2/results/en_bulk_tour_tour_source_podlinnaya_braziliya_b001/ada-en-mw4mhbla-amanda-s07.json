    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "38c6c3f48b5f745816b94138e0254d15ab9cea7d730444b107396e4b754a6471",
      "text": "This itinerary reveals several very different sides of Brazil. Begin in Rio de Janeiro with Copacabana, Corcovado and Sugar Loaf, then travel to the Amazon for rainforest, riverside villages and wildlife after dark along the water. Next comes Salvador, with its Afro-Brazilian culture and Pelourinho, before the journey ends at Iguazu, where you can see the falls from both the Brazilian and Argentine sides. The flight to Rio at the start and the return flight at the end are routed through São Paulo.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw4mhbla-amanda",
        "model": "GPT-6",
        "wordAbsenceReason": "The Word overview is a different promotional paragraph and lacks this complete ordered lead with São Paulo start/end connections; translated from assigned RU."
      }
    },
    {

        "model": "gpt-6.1-sol"
      },
      "text": "Guatemala City: stone columns and carved details on the church façade"
    },
    {
      "blockId": "tour:itinerary_title:2fb5525f94c7ffcd",
      "field": "itinerary.title",
      "sourceTextSha256": "04439cb6b30456f5c2350f61415b087823ee94994fb6022160679b98841a7d25",

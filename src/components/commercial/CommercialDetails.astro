---
import { withBase } from '../../lib/paths';
import AuthorityInline from '../authority/AuthorityInline.astro';

interface DetailRow {
  title: string;
  text: string;
  href?: string;
  linkLabel?: string;
}
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  rows: DetailRow[];
}
const { id, eyebrow, title, intro, rows } = Astro.props;

// Editorial line pictograms: small visual landmarks, not cards or photos.
// Selection uses the actual row heading so every MICE/DMC page shares this
// treatment without duplicating the content or changing existing wording.
const symbols = {
  route: 'M4 5a2 2 0 1 0 0 4 2 2 0 0 0 0-4z M20 15a2 2 0 1 0 0 4 2 2 0 0 0 0-4z M6 7h8a4 4 0 0 1 0 8H9 M9 15l3-3 M9 15l3 3',
  people: 'M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M17 3a4 4 0 0 1 0 8 M22 20v-2a4 4 0 0 0-3-3.87',
  calendar: 'M3 5h18v16H3z M8 3v4 M16 3v4 M3 10h18 M8 15h3 M8 18h6',
  map: 'M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z M9 3v15 M15 6v15',
  car: 'M5 15l1-6h12l1 6 M3 15h18v4H3z M6 19v2 M18 19v2 M7 15h1 M16 15h1',
  document: 'M7 3h7l4 4v14H7z M14 3v5h5 M10 13h5 M10 17h5',
  wallet: 'M3 6h18v15H3z M3 10h18 M16 15h5',
  chat: 'M4 4h16v12H7l-3 3z M8 9h8 M8 12h5',
  check: 'M12 2l9 4v5c0 6-4 10-9 11-5-1-9-5-9-11V6z M8 12l3 3 5-5',
  compass: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M16 8l-3 6-5 2 2-5z',
} as const;
type Symbol = keyof typeof symbols;
const symbolFor = (heading: string): Symbol => {
  const name = heading.toLowerCase();
  if (/перевод|гид|язык|участник|гост|команд|клиент|групп/.test(name)) return 'people';
  if (/цен|тариф|расчет|бюджет|комисси|оплат|стоим|возврат/.test(name)) return 'wallet';
  if (/ваучер|документ|предложени|содержани|запрос|бриф|результат|подтвержден/.test(name)) return 'document';
  if (/транспорт|автомобил|трансфер|переезд|рейс|перелет|расписани/.test(name)) return 'car';
  if (/даты|срок|планирован|этап|подготовк|программ|разработк/.test(name)) return 'calendar';
  if (/город|страна|географ|маршрут|размещени|отел|локац|площадк/.test(name)) return 'map';
  if (/встреч|связ|общени|контакт|переговор/.test(name)) return 'chat';
  if (/организац|визит|делегац|сотрудничеств|партнер/.test(name)) return 'people';
  if (/изменен|отмен|гарант|правил|согласован/.test(name)) return 'check';
  if (/поездк|путешеств|отдых|впечатлен|услуг/.test(name)) return 'route';
  return 'compass';
};
---

<section class="commercial-details" aria-labelledby={id}>
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
    {intro && <p class="commercial-details__intro"><AuthorityInline text={intro} /></p>}
    <div class="commercial-details__rows">
      {rows.map((row) => (
        <article class="commercial-details__row">
          <div class="commercial-details__heading">
            <span class="commercial-details__pictogram" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path d={symbols[symbolFor(row.title)]} />
              </svg>
            </span>
            <h3>{row.title}</h3>
          </div>
          <div>
            <p><AuthorityInline text={row.text} /></p>
            {row.href && (
              <a href={withBase(row.href)}>{row.linkLabel ?? 'Подробнее'} <span aria-hidden="true">↗</span></a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .commercial-details {
    padding-block: clamp(36px, 4.4vw, 70px);
    background: var(--color-bg);
  }
  .commercial-details h2 {
    max-width: 1020px;
    margin: 10px 0 16px;
    font-size: var(--text-h2);
    line-height: 1.08;
  }
  .commercial-details__intro {
    max-width: 820px;
    margin: 0 0 clamp(22px, 3vw, 38px);
    color: color-mix(in srgb, var(--color-ink) 75%, transparent);
  }
  .commercial-details__rows { border-top: 1px solid var(--color-line); }
  .commercial-details__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr);
    gap: clamp(20px, 5vw, 90px);
    padding: clamp(18px, 2.4vw, 32px) 0;
    border-bottom: 1px solid var(--color-line);
  }
  .commercial-details__heading {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    min-width: 0;
  }
  .commercial-details__pictogram {
    display: grid;
    place-items: center;
    flex: 0 0 46px;
    width: 46px;
    height: 46px;
    border: 1px solid color-mix(in srgb, var(--color-brand-deep) 22%, var(--color-line));
    border-radius: 50%;
    color: var(--color-brand-deep);
    background: color-mix(in srgb, var(--color-brand-deep) 6%, var(--color-bg));
  }
  .commercial-details__pictogram svg { width: 24px; height: 24px; }
  .commercial-details__row h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.5vw, 1.85rem);
    line-height: 1.2;
  }
  .commercial-details__row p {
    max-width: 740px;
    margin: 0;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-ink) 77%, transparent);
  }
  .commercial-details__row a {
    display: inline-block;
    margin-top: 12px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--color-gold-deep);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }
  .commercial-details__row a:hover,
  .commercial-details__row a:focus-visible { color: var(--color-gold-deep); }
  @media (max-width: 720px) {
    .commercial-details__row { grid-template-columns: 1fr; gap: 14px; padding-block: 22px 26px; }
    .commercial-details__heading { align-items: center; gap: 14px; }
    .commercial-details__pictogram { flex-basis: 44px; width: 44px; height: 44px; }
    .commercial-details__row h3 { font-size: clamp(1.27rem, 4.5vw, 1.65rem); }
    .commercial-details__row > div:last-child { padding-left: 58px; }
  }
  @media (max-width: 440px) {
    .commercial-details__row > div:last-child { padding-left: 0; }
  }
</style>

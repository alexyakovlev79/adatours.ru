---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/editorial/Hero.astro';
import EditorialStatement from '../../../components/editorial/EditorialStatement.astro';
import EditorialProof from '../../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../../components/proof/ProcessSteps.astro';
import LeadForm from '../../../components/forms/LeadForm.astro';
---

<BaseLayout
  title="Условия работы с Ada Tours для турагентств и туроператоров"
  description="Как Ada Tours работает с B2B-партнерами: бриф, маршрут, расчет, подтверждение услуг и локальная координация в Бразилии и Латинской Америке."
>
  <Hero
    eyebrow="DMC · B2B"
    title="Сначала запрос, затем точные условия"
    intro="Даты, география, размер группы и формат поездки определяют маршрут, услуги и коммерческие условия."
    image="/media/prototype/rio-night.jpg"
    ctaLabel="Отправить B2B-запрос"
  />

  <EditorialStatement
    eyebrow="Принцип работы"
    text="Один рабочий маршрут, видимые допущения и понятная ответственность за каждую часть программы."
  />

  <ProcessSteps
    eyebrow="От запроса до подтверждения"
    title="4 этапа B2B-работы"
    steps={[
      {
        title: 'Бриф',
        text: 'Даты, количество гостей, география, бюджет, уровень размещения и обязательные элементы поездки.',
      },
      {
        title: 'Предложение',
        text: 'Ada Tours собирает маршрут, наземную логистику и состав услуг, отдельно отмечая то, что требует подтверждения.',
      },
      {
        title: 'Согласование',
        text: 'После правок фиксируется рабочая версия программы и проверяется доступность выбранных услуг.',
      },
      {
        title: 'Подтверждение',
        text: 'Финальные условия, оплата и правила изменений закрепляются для конкретного бронирования.',
      },
    ]}
    dark
  />

  <EditorialProof
    eyebrow="Что входит в запрос"
    title="Что нужно для точного расчета"
    text="Обязательные встречи, даты перелетов, уровень отелей, состав группы и ключевые точки лучше зафиксировать в первом брифе."
    image="/media/prototype/buenos-aires.jpg"
    facts={[
      'Даты или диапазон дат',
      'Количество гостей и состав группы',
      'Страны, города и обязательные точки',
      'Бюджет и уровень размещения',
      'Нужные языки сопровождения',
      'VIP, MICE или другие специальные требования',
    ]}
  />

  <EditorialProof
    eyebrow="Коммерческие условия"
    title="Коммерческие условия под конкретную поездку"
    text="Коммерческая модель, комиссия, сроки расчета и договор зависят от партнера и конкретного запроса. При агентской модели договор и вознаграждение согласуются отдельно, а финальные условия фиксируются вместе с подтвержденным составом поездки."
    image="/media/prototype/lencois.jpg"
    facts={[
      'Состав и стоимость услуг подтверждаются под даты',
      'Условия оплаты фиксируются в конкретном бронировании',
      'Правила изменений зависят от подтвержденных поставщиков',
      'Специальные B2B-условия согласуются с партнером отдельно',
    ]}
    reverse
  />

  <LeadForm title="Отправить запрос от агентства или туроператора" entityId="dmc_terms" />
</BaseLayout>

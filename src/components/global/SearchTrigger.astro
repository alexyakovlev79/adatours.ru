---
interface Props {
  compact?: boolean;
  label?: string;
}
const { compact = false, label = 'Поиск' } = Astro.props;
---
<button
  class:list={['search-trigger', { 'search-trigger--compact': compact }]}
  type="button"
  aria-label={label}
  aria-haspopup="dialog"
  aria-controls="site-search"
  data-search-open
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="11" cy="11" r="6.5"></circle>
    <path d="m16 16 5 5"></path>
  </svg>
  <span>{label}</span>
</button>
<style>
  .search-trigger{display:inline-flex;align-items:center;gap:8px;padding:8px 0;border:0;color:inherit;background:transparent;font-family:var(--font-display);font-size:.74rem;font-weight:600;letter-spacing:.055em;text-transform:uppercase;cursor:pointer;opacity:.95;transition:opacity 180ms ease}
  .search-trigger:hover{opacity:.62}
  .search-trigger svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round}
  .search-trigger--compact{width:44px;height:44px;justify-content:center;padding:0}
  .search-trigger--compact svg{width:22px;height:22px;stroke-width:1.6}
  .search-trigger--compact span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
</style>

---
import PrimaryCTA from '../global/PrimaryCTA.astro';
import { withBase } from '../../lib/paths';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  image?: string;
  ctaHref?: string;
  ctaLabel?: string;
  compact?: boolean;
  meta?: string;
  mediaStatus?: 'approved' | 'needs_replacement' | 'replaced';
  replacementReason?: string;
}

const {
  eyebrow,
  title,
  intro,
  image,
  ctaHref = '/contacts/',
  ctaLabel = 'Оставить заявку',
  compact = false,
  meta,
  mediaStatus,
  replacementReason,
} = Astro.props;

const resolvedImage = image ? withBase(image) : undefined;
const style = resolvedImage ? `--hero-image: url("${resolvedImage}")` : undefined;
---

<section
  class:list={['hero', { 'hero--compact': compact, 'hero--image': image }]}
  style={style}
  data-media-status={mediaStatus ?? (image ? 'legacy' : undefined)}
  data-replacement-reason={replacementReason}
>
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <div class="hero__head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {meta && <p class="hero__meta">{meta}</p>}
    </div>
    <h1>{title}</h1>
    <div class="hero__bottom">
      {intro && <p>{intro}</p>}
      <PrimaryCTA href={ctaHref} label={ctaLabel} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: var(--hero-height);
    overflow: hidden;
    color: var(--color-bg);
    background:
      radial-gradient(circle at 75% 15%, rgba(242, 204, 103, .22), transparent 32%),
      linear-gradient(135deg, #33342f 0%, var(--color-ink-deep) 62%);
    isolation: isolate;
  }

  .hero--compact {
    min-height: min(84svh, 820px);
  }

  .hero--image {
    background-image: var(--hero-image);
    background-position: center;
    background-size: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(15, 16, 14, .18) 0%,
      rgba(15, 16, 14, .18) 35%,
      rgba(15, 16, 14, .66) 100%
    );
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: min(calc(100% - (var(--gutter) * 2)), 1440px);
    margin-inline: auto;
    padding: calc(var(--header-h) + 72px) 0 clamp(48px, 7vw, 96px);
  }

  .hero__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .hero__meta {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 1180px;
    margin: 12px 0 clamp(36px, 5vw, 70px);
  }

  .hero__bottom {
    display: grid;
    grid-template-columns: minmax(0, 650px) auto;
    align-items: end;
    justify-content: space-between;
    gap: 48px;
  }

  .hero__bottom p {
    max-width: 650px;
    margin: 0;
    color: rgba(255,255,255,.84);
    font-size: var(--text-lg);
  }

  @media (max-width: 720px) {
    .hero__content {
      padding-bottom: 34px;
    }

    .hero__head {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .hero__bottom {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>

        "kind": "ai_translation",
        "runId": "ada-en-20261109-de97cc1c",
        "model": "gpt-6.1-sol"
      },
      "text": "Arrival in Mexico City"
    },
    {
      "blockId": "tour:itinerary_text:5a4836cca1208c95",
      "field": "itinerary.text",
      "sourceTextSha256": "d1f61624bd9651ad99d7102eda4ea2de4185d21305241017257f7025838b5017",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-de97cc1c",
        "model": "gpt-6.1-sol"
      },
      "text": "Arrive at Mexico City International Airport, where you’ll be met and transferred to your hotel.\n\nYou’ll stay in a standard room at the four-star Casablanca hotel. The itinerary includes three nights in Mexico City.\n\nThe rest of the day is free. You can rest after your flight or start exploring the capital on your own."
    },

---
import {commercialText} from '../../../lib/i18n/commercial-copy.mjs';
import {sharedUiLocale} from '../../../lib/i18n/shared-ui-locale.mjs';
const uiLocale=sharedUiLocale();
const tr=(value:string)=>commercialText(value,uiLocale);
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/editorial/Hero.astro';
import FactStrip from '../../../components/proof/FactStrip.astro';
import ProcessSteps from '../../../components/proof/ProcessSteps.astro';
import MiceNav from '../../../components/commercial/MiceNav.astro';
import CommercialDetails from '../../../components/commercial/CommercialDetails.astro';
import CommercialCaseGrid from '../../../components/commercial/CommercialCaseGrid.astro';
import CommercialExpert from '../../../components/commercial/CommercialExpert.astro';
import CommercialSearchRecord from '../../../components/commercial/CommercialSearchRecord.astro';
import DmcFaq from '../../../components/commercial/DmcFaq.astro';

const hero = '/media/destinations/sao-paulo/hero-enhanced-20261001.webp';
const title = tr('Деловые делегации в Бразилию и Латинскую Америку | Ada Tours');
const description = tr('Деловые поездки с Ada Tours: профессиональные визиты, переводчики, транспорт и размещение под график встреч. Кейс делегации из 8 участников и подготовка программы.');
---

<BaseLayout lang={uiLocale} leadTitle={tr("Запросить программу делегации")} leadEntityId="mice_business_delegations" title={title} description={description} image={hero}>
  <CommercialSearchRecord id="mice_business_delegations" title={tr("Деловые делегации и профессиональные визиты")} description={description} image={hero} keywords={[tr('бизнес-делегация'), tr('деловые поездки'), tr('переговоры'), tr('визиты на предприятия'), tr('переводчики'), tr('аграрные поездки')]} />
  <Hero compact compactCta mobilePhotoLead eyebrow={tr("MICE · Деловые делегации")}
    title={tr("Деловые делегации в Бразилию и Латинскую Америку")}
    intro={tr("Помогаем подготовить профессиональные визиты, подбираем переводчиков и связываем переговоры с транспортом, отелями и сопровождением. Вы занимаетесь деловой задачей, команда Ada Tours координирует поездку на месте.")}
    image={hero} ctaHref="#request" ctaLabel={tr("Запросить программу")} />
  <MiceNav active="delegations" />

  <FactStrip facts={[
    { value: tr('8 участников'), label: tr('в выполненном кейсе делегации') },
    { value: tr('3 города'), label: tr('Сан-Паулу, Кампинас и Гуаружа') },
    { value: tr('3 языка'), label: tr('русский, португальский и английский в работе переводчика') },
    { value: '2026', label: tr('год опубликованного проекта') },
  ]} />

  <CommercialDetails id="delegations-visits" eyebrow={tr("Профессиональная программа")} title={tr("От цели визита до согласованной встречи")}
    intro={tr("Делегации нужен собеседник по теме и достаточно времени для разговора. Поэтому подготовку начинаем с отрасли, целей и состава участников, а затем собираем маршрут вокруг деловых встреч.")}
    rows={[
      { title: tr('Поиск принимающих организаций'), text: tr('Определяем профиль компаний, хозяйств, исследовательских центров или профессиональных объединений. Если у вас уже есть контакты и назначенные встречи, включаем их в рабочую программу.') },
      { title: tr('Обращение и согласование'), text: tr('Связываемся с подходящими организациями, уточняем возможность визита и обсуждаем содержание встречи. В окончательную программу включаем посещение после согласия принимающей стороны.') },
      { title: tr('Перевод и подготовка'), text: tr('Согласуем языковую пару и формат перевода. Для подбора сопровождения полезны темы переговоров, профиль участников и ожидаемая продолжительность. Учитываем правила доступа, конфиденциальность и требования принимающей организации.') },
      { title: tr('Отраслевая поездка'), text: tr('В [аграрной программе Аргентины на 11 дней](/argentina/tour/argentina-agricultural-11-days/) собраны хозяйства, исследовательские учреждения и культурная часть. Это основа для отраслевого запроса; конкретные визиты согласуем под цели и даты делегации.') },
    ]} />

  <CommercialCaseGrid id="delegations-case" title={tr("Когда время переговоров менялось по ходу дня")}
    intro={tr("В выполненной поездке делегации по Бразилии расписание встреч влияло на весь день: следующий переезд, работу переводчика, питание и свободную программу.")}
    caseIds={['case_mice_business_delegation_sao_paulo_2026']}
    summaries={{ case_mice_business_delegation_sao_paulo_2026: tr('Для 8 участников Ada Tours организовала отели, автомобили и микроавтобусы, русскоязычное сопровождение и перевод на 3 языках. Команда согласовывала изменения транспорта и программы вслед за рабочими встречами.') }} />

  <CommercialDetails id="delegations-logistics" eyebrow={tr("Логистика деловой поездки")} title={tr("Каждая встреча связана с остальной программой")}
    rows={[
      { title: tr('География и размещение'), text: tr('Смотрим на адреса встреч и порядок посещений. Отель выбираем с учетом рабочих районов, аэропортов и переездов между городами. При длинном маршруте сравниваем варианты ночевок и транспорта.') },
      { title: tr('Автомобили и рабочий день'), text: tr('Подбираем транспорт по числу участников и багажу, согласуем часы работы, ожидание на встречах и межгородские поездки. Учитываем время на посадку, проходные и перемещения внутри принимающих объектов.') },
      { title: tr('Общение на месте'), text: tr('Перед поездкой передаем рабочие контакты. При изменении встречи координатор уточняет варианты с транспортом, переводчиком и следующими поставщиками, затем согласует решение с организатором делегации.') },
      { title: tr('Знакомство со страной'), text: tr('Добавляем рестораны, экскурсии и отдых в свободные части расписания. Для участников с разными задачами можно подготовить отдельные выезды или программу сопровождающих в рамках [корпоративной поездки](/mice/).') },
    ]} />

  <CommercialDetails id="delegations-brief" eyebrow={tr("Что прислать")} title={tr("Бриф, который поможет перейти к конкретным организациям")}
    rows={[
      { title: tr('Деловая цель'), text: tr('Отрасль, темы обсуждения, желаемый результат, тип принимающей организации и список уже известных контактов. Укажите, нужны ли поиск новых организаций или сопровождение на назначенных встречах.') },
      { title: tr('Участники и языки'), text: tr('Число участников, компании и должности, рабочие языки, потребность в переводе и особенности доступа на объекты. Персональные данные для бронирования передаются на соответствующем этапе подготовки.') },
      { title: tr('Даты и условия'), text: tr('Диапазон дат, длительность, города, известные рейсы, требования к отелям и бюджет. Отметьте встречи с фиксированным временем и желаемую экскурсионную часть.') },
      { title: tr('Результат подготовки'), text: tr('Вы получите маршрут, состав услуг, расчет, условия бронирования и статус запрошенных визитов. Для [агентского запроса](/dmc/travel-agencies/) отдельно согласуем тарифную модель, документы и общение с заказчиком.') },
    ]} />

  <ProcessSteps eyebrow={tr("Подготовка делегации")} title={tr("Сначала деловая задача, затем все стыковки")} steps={[
    { title: tr('Цели'), text: tr('Определяем темы, профиль организаций и состав участников.') },
    { title: tr('Визиты'), text: tr('Обращаемся к принимающим сторонам и согласуем доступные встречи.') },
    { title: tr('Программа'), text: tr('Связываем подтвержденный график с переездами, переводом и размещением.') },
    { title: tr('Сопровождение'), text: tr('Координируем исполнение и изменения в течение поездки.') },
  ]} />

  <CommercialExpert title={tr("Деловая поездка с принимающей командой в регионе")} text={tr("Команда Ada Tours работает из Рио-де-Жанейро и готовит поездки по Бразилии и Латинской Америке. Анна Аванесова руководит компанией и делится практикой на [профессиональных вебинарах](/webinars/). Опыт работы с группами можно оценить по [выполненным кейсам](/cases/).")} />

  <DmcFaq title={tr("Вопросы о деловых делегациях")} items={[
    { question: tr('Вы только сопровождаете группу или помогаете организовать профессиональные визиты?'), answer: tr('Помогаем с подготовкой визитов: уточняем цель, ищем профильные организации, связываемся с ними и согласуем возможность приема. При необходимости подбираем языковое сопровождение. Встреча подтверждается после согласия принимающей стороны.') },
    { question: tr('Можно ли заказать поездку, если все встречи уже назначены?'), answer: tr('Да. Пришлите даты, адреса и время встреч. Под них подберем размещение, транспорт и переводчиков, рассчитаем переезды и добавим желаемую свободную программу.') },
    { question: tr('Как подбирается переводчик?'), answer: tr('Согласуем языки, тематику, формат встреч и часы работы. В [кейсе делегации по Бразилии](/cases/business-delegation-sao-paulo-campinas-2026/) использовался перевод на русском, португальском и английском. Для новой поездки состав сопровождения определяем по вашему заданию.') },
    { question: tr('Что делать, если предприятие переносит встречу?'), answer: tr('Проверяем, как новый график влияет на транспорт, переводчика, размещение и следующие пункты. Предлагаем доступные варианты и согласуем изменения с организатором. Дополнительные расходы зависят от условий затронутых услуг.') },
    { question: tr('Можно ли включить несколько городов или стран?'), answer: tr('Да. Собираем маршрут вокруг деловых задач, учитываем перелеты и наземные переезды. Сложные стыковки и распределение сопровождения прорабатываем при подготовке предложения.') },
    { question: tr('За сколько времени начинать подготовку профессиональных визитов?'), answer: tr('Обращайтесь, когда определились цель и предполагаемые даты. Для отраслевых визитов требуется время на ответы принимающих организаций, допуски и подбор сопровождения. По вашему запросу определим порядок действий и контрольные сроки.') },
  ]} />
</BaseLayout>

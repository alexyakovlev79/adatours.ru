    {
      "blockId": "tour:itinerary_text:4b5ff9b4a37f43cc",
      "field": "itinerary.text",
      "sourceTextSha256": "3d9a939f0444652b9c0594b0fc19f58332ebeab4d3d5f51d770a3e732162e649",
      "text": "After breakfast, private transfer with your driver to El Dorado Airport and a flight to Pereira. At Matecaña Airport, your private guide will meet you and accompany you in the Coffee Region. Visit Cocora Valley for a canelazo, a walk with an eco-guide, the Quindío ritual and a symbolic tree-planting activity; then continue to Salento, with its artisan workshops and panoramic views. Continue at El Ocaso Coffee Farm to learn about growing, hand-picking, drying, processing and roasting coffee. Enjoy a tasting and coffee lemonade at the farm's main house. These 2 activities are described below. Return to your hotel for an overnight stay in Pereira.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada_en_20261104_58d6a032",
        "model": "GPT-6",
        "wordAbsenceReason": "The verified Word gives the full Day 3 excursion descriptions, but not this unique RU day-summary linking two separately described activity modules; translating the summary avoids duplicating those modules."
      }

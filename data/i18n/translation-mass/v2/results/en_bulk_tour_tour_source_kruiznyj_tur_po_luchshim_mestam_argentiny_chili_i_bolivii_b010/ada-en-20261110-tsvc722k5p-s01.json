        "runId": "ada-en-20261110-tsvc722k5p",
        "model": "ChatGPT"
      },
      "text": "Puerto Natales & Torres del Paine"
    },
    {
      "blockId": "tour:media_alt:36917c7b8fc732b9",
      "field": "media.alt",

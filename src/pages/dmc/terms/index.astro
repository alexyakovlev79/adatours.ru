---
import {commercialText} from '../../../lib/i18n/commercial-copy.mjs';
import {sharedUiLocale} from '../../../lib/i18n/shared-ui-locale.mjs';
const uiLocale=sharedUiLocale();
const tr=(value:string)=>commercialText(value,uiLocale);
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/editorial/Hero.astro';
import DmcNav from '../../../components/commercial/DmcNav.astro';
import DmcFaq from '../../../components/commercial/DmcFaq.astro';
import CommercialDetails from '../../../components/commercial/CommercialDetails.astro';
import CommercialSearchRecord from '../../../components/commercial/CommercialSearchRecord.astro';

const title = tr('Условия работы с Ada Tours: тарифы и бронирование для агентств');
const description = tr('Как работаем с агентствами: нетто и комиссия, разработка программы, подтверждение услуг, оплата, изменения, отмена и контакты на время поездки.');
const heroImage = '/media/home/buenos-aires-enhanced-20260930.webp';
---

<BaseLayout lang={uiLocale}
  leadTitle={tr("Отправить B2B-запрос")}
  leadEntityId="dmc_terms"
  title={title}
  description={description}
  image={heroImage}
>
  <Hero
    eyebrow={tr("Для агентств · Условия работы")}
    title={tr("Условия работы с Ada Tours для агентств")}
    intro={tr("Начинаем с задачи и бюджета. В предложении показываем маршрут, расчет и состав услуг; затем фиксируем бронирования, оплату и порядок изменений. Перед выездом передаем контакты на время поездки.")}
    image={heroImage}
    ctaHref="#request"
    ctaLabel={tr("Отправить B2B-запрос")}
    compact
    compactCta
    mobilePhotoLead
  />

  <DmcNav active="terms" />

  <CommercialSearchRecord
    id="dmc-terms-search-record"
    title={title}
    description={description}
    image={heroImage}
    typeLabel={tr("Для агентств")}
    keywords={[tr('B2B условия'), tr('нетто-тариф'), tr('комиссия'), tr('расчет'), tr('оплата'), tr('бронирование'), tr('изменения'), tr('отмена'), tr('возврат'), tr('ваучеры'), tr('контакты в поездке')]}
  />

  <CommercialDetails
    id="terms-before-request"
    eyebrow={tr("01 · До разработки")}
    title={tr("Определяем задачу и объем работы")}
    rows={[
      {
        title: tr('Исходный запрос'),
        text: tr('Пришлите даты, число гостей, маршрут, бюджет и требования к размещению. Добавьте язык сопровождения, обязательные посещения и уже купленные билеты. Для [деловой делегации](/mice/business-delegations/) нужны цели визитов и требования к принимающим организациям.'),
      },
      {
        title: tr('Формат и подготовка'),
        text: tr('Работаем с индивидуальными поездками, делегациями, группами и отдельными услугами. Минимальный объем заказа, бюджет и срок обращения определяем по задаче. Для профессиональных программ и крупных групп закладываем больше времени на подготовку.'),
      },
      {
        title: tr('Разработка программы'),
        text: tr('До значительной подготовительной работы согласуем стоимость первоначальной разработки и условия бесплатного расчета. Это позволяет заранее определить, какой объем программы и вариантов входит в начальный этап.'),
      },
    ]}
  />

  <CommercialDetails
    id="terms-proposal"
    eyebrow={tr("02 · Предложение")}
    title={tr("Маршрут, расчет и статус услуг")}
    rows={[
      {
        title: tr('Содержание предложения'),
        text: tr('По подробному запросу готовим маршрут, описание включенных и не включенных услуг, предварительную смету или коммерческое предложение. Указываем исходные условия расчета и основные условия бронирования, затем корректируем программу по приоритетам партнера.'),
      },
      {
        title: tr('Нетто-тариф или комиссия'),
        text: tr('Нетто-тариф позволяет агентству самостоятельно устанавливать наценку. Когда это подходит проекту, предлагаем комиссионный тариф. Модель указываем в предложении с самого начала. Цена зависит от направления, сезона, количества участников, категории услуг и индивидуальных требований.'),
      },
      {
        title: tr('Срок действия и наличие'),
        text: tr('Указываем срок действия расчета и разделяем предлагаемые услуги и подтвержденные бронирования. Отели, транспорт и посещения проверяем на выбранные даты. До ответов поставщиков состав доступных вариантов может меняться.'),
      },
      {
        title: tr('Профессиональные визиты'),
        text: tr('Подбираем организации, устанавливаем контакты и проверяем возможность приема. Согласуем язык сопровождения, график и требования принимающей стороны. Визит считаем подтвержденным после ее прямого согласия.'),
        href: '/mice/business-delegations/',
        linkLabel: tr('Как готовим деловые поездки'),
      },
    ]}
  />

  <CommercialDetails
    id="terms-confirmation"
    eyebrow={tr("03 · Подтверждение и расчеты")}
    title={tr("Фиксируем заказ и порядок дальнейших изменений")}
    rows={[
      {
        title: tr('Письменное подтверждение'),
        text: tr('В подтверждении указываем условия, на которых фиксируются цена и состав услуг. Согласованная версия программы становится основой для подготовки документов и обслуживания гостей.'),
      },
      {
        title: tr('Оплата'),
        text: tr('Суммы, валюту, порядок и сроки оплаты определяем для конкретного бронирования. График платежей согласуем до оплаты. Отдельно прописываем, включено ли страхование и какие расходы оплачиваются дополнительно.'),
      },
      {
        title: tr('Даты, гости и состав группы'),
        text: tr('Изменения рассматриваем с учетом сроков и правил поставщиков. При уменьшении группы проверяем расчет на человека; при переносе дат проверяем наличие мест и тарифы. Замена участника зависит в том числе от правил билетов и допуска на посещения.'),
      },
      {
        title: tr('Отмена и возврат'),
        text: tr('Штрафы за отмену и возможные возвраты указываем в договорных условиях конкретного бронирования. При запросе на изменение проверяем условия затронутых услуг и сообщаем партнеру доступные варианты.'),
      },
    ]}
  />

  <CommercialDetails
    id="terms-on-trip"
    eyebrow={tr("04 · Подготовка к выезду и поездка")}
    title={tr("Контакты, документы и решения на месте")}
    rows={[
      {
        title: tr('Ответственный за координацию'),
        text: tr('Для группового проекта назначаем контактное лицо до выезда. Перед поездкой передаем участникам и партнеру необходимые контакты. Часы доступности, порядок экстренной помощи и платные дополнительные услуги определяем в предложении.'),
      },
      {
        title: tr('Работа с клиентом агентства'),
        text: tr('Агентство остается основным коммерческим контактом. Ada Tours ведет операционные вопросы и связывается с гостями для встреч, трансферов и решения ситуаций на маршруте. Порядок принятия решений, конфиденциальность и последующие прямые обращения согласуем между сторонами.'),
        href: '/dmc/travel-agencies/',
        linkLabel: tr('Роли агентства и принимающей команды'),
      },
      {
        title: tr('Документы под вашим брендом'),
        text: tr('Адаптируем программу, подробный маршрут и практические документы к оформлению агентства. Ваучеры и подтверждения готовим в согласованном формате с обязательными сведениями о поставщиках. Использование фотографий и текстов согласуем с учетом необходимых прав.'),
      },
      {
        title: tr('Изменения во время поездки'),
        text: tr('Если возникает непредвиденная ситуация, связываемся с соответствующими поставщиками и информируем агентство о возможных решениях. Дальнейшие действия согласуем по принятому для проекта порядку.'),
      },
    ]}
  />



  <DmcFaq
    title={tr("Вопросы о расчете и подтверждении")}
    items={[
      {
        question: tr('Кто определяет наценку на нетто-тариф?'),
        answer: tr('Агентство устанавливает свою наценку самостоятельно. Для подходящих проектов используем комиссионную модель. Выбранный способ расчета отражаем в предложении с самого начала.'),
      },
      {
        question: tr('Первоначальный расчет бесплатный?'),
        answer: tr('Стоимость первоначальной разработки, минимальный объем заказа и условия бесплатного расчета согласуем до значительной подготовительной работы. Они зависят от задачи и объема программы.'),
      },
      {
        question: tr('Как долго действует предложенная цена?'),
        answer: tr('Срок указываем в коммерческом предложении. Условия фиксации цены и состава услуг записываем в письменном подтверждении после проверки доступности и согласования бронирований.'),
      },
      {
        question: tr('Каков размер предоплаты и когда вносить остаток?'),
        answer: tr('Размер платежей и даты оплаты согласуем для конкретной программы. Партнер получает условия выбранного бронирования до оплаты; ориентироваться нужно на них.'),
      },
      {
        question: tr('Можно заменить участника или уменьшить группу?'),
        answer: tr('Рассматриваем такие изменения с учетом сроков, условий поставщиков и правил оформления билетов или допуска. При уменьшении группы проверяем стоимость на человека и сообщаем результат перерасчета.'),
      },
      {
        question: tr('Когда визит на предприятие считается подтвержденным?'),
        answer: tr('После прямого согласия принимающей организации. Мы подбираем подходящие организации, устанавливаем контакты и согласуем возможность приема. Ее график и правила конфиденциальности или безопасности учитываем в [программе делегации](/mice/business-delegations/).'),
      },
      {
        question: tr('К кому обращаться при изменении планов во время поездки?'),
        answer: tr('Перед выездом передаем необходимые контакты, а часы доступности и порядок экстренной помощи определяем в предложении. На месте связываемся с поставщиками и информируем агентство о возможных решениях.'),
      },
    ]}
  />
</BaseLayout>

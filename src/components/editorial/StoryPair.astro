---
interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  image?: string;
  reverse?: boolean;
}

const { eyebrow, title, text, image, reverse = false } = Astro.props;
---

<section class:list={['story section', { 'story--reverse': reverse }]}>
  <div class="story__media" style={image ? `background-image:url("${image}")` : undefined}></div>
  <div class="story__copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
</section>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(340px, 5fr);
    gap: clamp(34px, 6vw, 100px);
    align-items: center;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .story--reverse {
    grid-template-columns: minmax(340px, 5fr) minmax(0, 7fr);
  }

  .story--reverse .story__media {
    order: 2;
  }

  .story__media {
    min-height: clamp(420px, 52vw, 720px);
    background:
      radial-gradient(circle at 70% 20%, rgba(242,204,103,.22), transparent 30%),
      linear-gradient(150deg, #57584f, #1a1a18);
    background-position: center;
    background-size: cover;
  }

  .story h2 {
    margin: 12px 0 24px;
  }

  .story__copy p:last-child {
    max-width: 520px;
    color: rgba(26,26,26,.72);
  }

  @media (max-width: 820px) {
    .story,
    .story--reverse {
      grid-template-columns: 1fr;
    }

    .story--reverse .story__media {
      order: initial;
    }
  }
</style>

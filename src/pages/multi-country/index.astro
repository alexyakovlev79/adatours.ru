---
import { createHash } from 'node:crypto';
import { getCollection } from 'astro:content';
import { isActiveEntity } from '../../lib/archive.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import DestinationBand from '../../components/editorial/DestinationBand.astro';
import CatalogPagination from '../../components/catalog/CatalogPagination.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import EditorialProof from '../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import { countLabel } from '../../lib/interest-model.mjs';
import { paginateCatalog } from '../../lib/catalog-pagination';
import { compareToursBySalesFit } from '../../lib/tour-ranking';
import { countryPath, mainTourCountries, tourPath } from '../../lib/routes';
import { withBase } from '../../lib/paths';

const [tourEntries, countryEntries] = await Promise.all([
  getCollection('tours', ({ data }) => data.locale === 'ru' && isActiveEntity(data)),
  getCollection('countries', ({ data }) => data.locale === 'ru' && isActiveEntity(data)),
]);
const allTours = [...tourEntries].sort(compareToursBySalesFit);
const multiCountryTours = allTours.filter((entry) => mainTourCountries(entry.data).length > 1);
const countryEntryById = new Map(countryEntries.map((entry) => [entry.data.id, entry]));

const catalogPages = paginateCatalog(multiCountryTours, '/multi-country/');
const firstCatalogPage = catalogPages[0];
const visibleTours = firstCatalogPage?.entries ?? [];
const pagination = firstCatalogPage?.pagination;
const pageHeroTour = multiCountryTours[10];
const proofCoverTour = multiCountryTours[11];
if (!pageHeroTour?.data.hero?.src || !proofCoverTour?.data.hero?.src) {
  throw new Error('Multi-country page requires hero images for tours 11 and 12');
}
if (pageHeroTour.data.hero.src === proofCoverTour.data.hero.src) {
  throw new Error('Multi-country tours 11 and 12 must have different hero images');
}
const catalogVersion = createHash('sha256')
  .update(JSON.stringify(multiCountryTours.map((entry) => entry.data.id)))
  .digest('hex')
  .slice(0, 20);

const countryCounts = new Map();
for (const entry of multiCountryTours) {
  for (const country of mainTourCountries(entry.data)) {
    countryCounts.set(country.id, { country, count: (countryCounts.get(country.id)?.count ?? 0) + 1 });
  }
}
const popularCountries = [...countryCounts.values()]
  .sort((a, b) => b.count - a.count || a.country.name.localeCompare(b.country.name, 'ru'))
  .slice(0, 5);

const usedBackdropTourIds = new Set([
  ...visibleTours.map((entry) => entry.data.id),
  pageHeroTour.data.id,
  proofCoverTour.data.id,
]);
const usedBackdropImages = new Set([
  ...visibleTours.map((entry) => entry.data.hero?.src).filter(Boolean),
  pageHeroTour.data.hero.src,
  proofCoverTour.data.hero.src,
]);
const countryBands = popularCountries.map(({ country, count }) => {
  let coverTour;
  for (let index = multiCountryTours.length - 1; index >= 0; index--) {
    const candidate = multiCountryTours[index];
    const image = candidate.data.hero?.src;
    if (!image
      || usedBackdropTourIds.has(candidate.data.id)
      || usedBackdropImages.has(image)
      || !mainTourCountries(candidate.data).some((item) => item.id === country.id)) continue;
    coverTour = candidate;
    break;
  }
  if (!coverTour?.data.hero?.src) {
    throw new Error(`No unique off-page multi-country cover found for ${country.name}`);
  }
  usedBackdropTourIds.add(coverTour.data.id);
  usedBackdropImages.add(coverTour.data.hero.src);
  return {
    country,
    count,
    image: coverTour.data.hero.src,
    coverTourId: coverTour.data.id,
    imageTextAlign: countryEntryById.get(country.id)?.data.imageTextAlign,
  };
});

const allToursCover = allTours.find((entry) => {
  const image = entry.data.hero?.src;
  return mainTourCountries(entry.data).length === 1 && Boolean(image) && !usedBackdropImages.has(image);
});
if (!allToursCover?.data.hero?.src) throw new Error('No unique single-country cover found for the all-tours band');
usedBackdropImages.add(allToursCover.data.hero.src);

const durations = multiCountryTours
  .map((entry) => entry.data.durationDays)
  .filter((value): value is number => typeof value === 'number' && Number.isFinite(value));
const minDuration = durations.length ? Math.min(...durations) : undefined;
const maxDuration = durations.length ? Math.max(...durations) : undefined;
const durationValue = minDuration && maxDuration
  ? minDuration === maxDuration ? countLabel(minDuration, ['день', 'дня', 'дней']) : `${minDuration}–${maxDuration} дней`
  : 'Гибко';

const hero = pageHeroTour.data.hero.src;
const proofImage = proofCoverTour.data.hero.src;
const absoluteUrl = (path: string) => new URL(withBase(path), Astro.site ?? 'https://adatours.ru/').toString();
const listSchema = pagination ? {
  '@type': 'ItemList',
  '@id': `${absoluteUrl('/multi-country/')}#catalog`,
  name: 'Multi-country туры по Латинской Америке',
  numberOfItems: visibleTours.length,
  itemListElement: visibleTours.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: entry.data.title,
    url: absoluteUrl(tourPath(entry.data)),
  })),
} : undefined;
---

<BaseLayout
  leadTitle="Собрать маршрут по нескольким странам"
  leadEntityId="multi_country"
  title="Туры по нескольким странам Латинской Америки"
  description="Готовые и индивидуальные multi-country маршруты Ada Tours по Бразилии, Аргентине, Перу и другим странам Латинской Америки. Перелеты, трансферы, отели, гиды и экскурсии в одной программе."
  canonical="/multi-country/"
  image={hero}
  breadcrumbs={[{ label: 'Multi-country', href: '/multi-country/' }]}
  pageSchema={listSchema}
>
  <Hero
    eyebrow="Multi-country"
    title="Несколько стран. Один маршрут по Латинской Америке"
    intro="Выберите готовую программу по нескольким странам или возьмите ее за основу. Даты, длительность, отели и состав поездки можно адаптировать под вас."
    image={hero}
    ctaHref="#request"
    ctaLabel="Собрать свой маршрут"
  />

  <EditorialStatement
    eyebrow="Готовые маршруты"
    text="Начните с сильной основы, а дальше оставьте только те страны, города и впечатления, ради которых хочется лететь через океан."
  />

  <FactStrip
    wideFirst
    facts={[
      { value: String(multiCountryTours.length), label: 'готовых маршрутов по нескольким странам' },
      { value: String(countryCounts.size), label: 'стран в текущей подборке' },
      { value: durationValue, label: 'длительность готовых программ' },
      { value: 'Под вас', label: 'можно менять даты, отели и состав поездки' },
    ]}
  />

  <section class="multi-tours section" aria-labelledby="multi-tours-title">
    <div class="container multi-tours__head">
      <p class="eyebrow">Выбрать путешествие</p>
      <h2 id="multi-tours-title">Multi-country туры</h2>
      <p>Сравните страны, длительность и формат. Любой готовый маршрут можно адаптировать под ваши даты, отели и состав поездки.</p>
    </div>

    {pagination && (
      <div
        data-catalog-root
        data-catalog-key={pagination.rootPath}
        data-catalog-version={catalogVersion}
        data-catalog-page={pagination.currentPage}
        data-catalog-from={pagination.from}
        data-catalog-to={pagination.to}
        data-catalog-total={pagination.totalItems}
      >
        <div id="catalog-items" data-catalog-items>
          {visibleTours.map((entry, index) => {
            const data = entry.data;
            const countries = mainTourCountries(data).map((country) => country.name).join(' + ');
            const meta = [
              countries,
              data.durationDays ? countLabel(data.durationDays, ['день', 'дня', 'дней']) : '',
              data.format,
            ].filter(Boolean).join(' · ');
            return (
              <div data-catalog-item={data.id}>
                <DestinationBand
                  headingTag="h3"
                  eyebrow={meta}
                  title={data.title}
                  image={data.hero?.src}
                  imageTextAlign={data.imageTextAlign}
                  mediaStatus={data.hero?.status}
                  replacementReason={data.hero?.replacementReason}
                  href={tourPath(data)}
                  align={index % 2 === 1 ? 'right' : 'left'}
                />
              </div>
            );
          })}
        </div>
        <CatalogPagination pagination={pagination} />
      </div>
    )}
  </section>

  <EditorialProof
    eyebrow="Единая координация"
    title="Сложный маршрут должен ощущаться как одна поездка"
    text="Перелет между странами влияет на трансфер, заселение, экскурсии и следующий выезд. Поэтому весь путь собирается как единая последовательность, а изменения проходят через одну программу."
    image={proofImage}
    facts={[
      'Международные и региональные перелеты',
      'Трансферы и отели под реальное время прибытия',
      'Локальные гиды и экскурсии в каждой стране',
      'Запас времени на длинные и сложные стыковки',
    ]}
  />

  <ProcessSteps
    eyebrow="Как собрать свой вариант"
    title="От готового тура к вашей поездке"
    steps={[
      {
        title: 'Выберите основу',
        text: 'Отметьте маршрут, который ближе всего по странам, длительности и набору впечатлений.',
      },
      {
        title: 'Расставьте приоритеты',
        text: 'Оставьте обязательные места и добавьте то, ради чего едете именно вы.',
      },
      {
        title: 'Соберем логистику',
        text: 'Свяжем перелеты, трансферы, отели, гидов и экскурсии в рабочую последовательность.',
      },
      {
        title: 'Подтвердим программу',
        text: 'Вы получите один маршрут со всеми ключевыми бронированиями и деталями поездки.',
      },
    ]}
    dark
  />

  <section class="multi-links">
    <div class="container section--tight multi-links__intro">
      <p class="eyebrow">Продолжить выбор</p>
      <h2>Страны, которые чаще встречаются в multi-country маршрутах</h2>
    </div>

    {countryBands.map(({ country, count, image, coverTourId, imageTextAlign }, index) => (
      <div data-country-band={country.id} data-cover-tour={coverTourId}>
        <DestinationBand
          headingTag="h3"
          eyebrow={countLabel(count, ['маршрут', 'маршрута', 'маршрутов'])}
          title={country.name}
          image={image}
          imageTextAlign={imageTextAlign}
          href={countryPath(country)}
          align={index % 2 === 1 ? 'right' : 'left'}
        />
      </div>
    ))}

    <div data-all-tours-cover={allToursCover.data.id}>
      <DestinationBand
        headingTag="h3"
        eyebrow="Полный каталог"
        title="Все туры Ada Tours"
        text="Все готовые маршруты по Латинской Америке"
        image={allToursCover.data.hero.src}
        href="/tours/"
        align={countryBands.length % 2 === 1 ? 'right' : 'left'}
      />
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/catalog-load-more';
</script>

<style>
  .multi-tours {
    padding-bottom: 0;
  }

  .multi-tours__head {
    padding-bottom: clamp(44px, 7vw, 84px);
  }

  .multi-tours__head h2,
  .multi-links__intro h2 {
    max-width: 980px;
    margin: 12px 0 22px;
  }

  .multi-tours__head > p:last-child {
    max-width: 760px;
    margin: 0;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
    font-size: var(--text-lg);
  }

  .multi-links {
    border-top: 1px solid var(--color-line);
  }

  .multi-links__intro {
    padding-bottom: clamp(44px, 7vw, 84px);
  }
</style>

    {
      "blockId": "tour:itinerary_text:b04d5d61d358e759",
      "field": "itinerary.text",
      "sourceTextSha256": "56412f02a8f8672ab1c003c36242341578f797c74b61950a6df278a6b34026ad",
      "text": "The yacht sails to the Holandeses Cays, a small archipelago of 21 islands. A barrier reef about 7 miles long shelters the islands, which are among the farthest from mainland Panama on this route.\n\nThe clear turquoise waters are good for fishing and diving. A stop is planned at a well-known anchorage with a natural ‘swimming pool’ between Turtle Island, also known as Barbecue Island, and Benedup Island.\n\nThe crew will prepare a barbecue on the beach.\n\nIf you’d like to explore more of the reef, you can head north to a tunnel where you can see the reef as you pass through.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261110-b87bceceb817",
        "model": "ChatGPT (GPT-6)"
      }

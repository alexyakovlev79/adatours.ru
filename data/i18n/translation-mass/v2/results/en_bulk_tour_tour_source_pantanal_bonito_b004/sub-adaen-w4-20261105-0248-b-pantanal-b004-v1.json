    {
      "blockId": "tour:itinerary_text:4b5ff9b4a37f43cc",
      "field": "itinerary.text",
      "sourceTextSha256": "7ef674b79ddfd9f4e8e42eed1ef63ad9701b33d710306914f3d5ff3391085e33",
      "text": "Enjoy your final morning in the Pantanal, making the most of your last wildlife encounters and the peaceful beauty of this wilderness through the lodge’s shared excursions. Later, depart with your English-speaking guide for Bonito, one of Brazil’s most celebrated ecotourism destinations, known for its crystal-clear rivers, fascinating caves and pristine natural beauty. On arrival, settle into the Pousada Arte da Natureza and prepare for the adventures ahead.",
      "provenance": {
        "kind": "word_aligned",

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import PersonProfile from '../../components/proof/PersonProfile.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const people = await getCollection('people', ({ data }) =>
    data.locale === 'ru' && !['draft', 'archived'].includes(data.status)
  );

  return people.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: entry.data.name,
  jobTitle: entry.data.role,
  worksFor: {
    '@type': 'Organization',
    name: 'Ada Tours',
    url: SITE.url,
  },
  url: new URL(`/team/${entry.data.slug}/`, Astro.site ?? SITE.url).toString(),
  image: entry.data.photo?.src
    ? new URL(entry.data.photo.src, Astro.site ?? SITE.url).toString()
    : undefined,
  knowsAbout: entry.data.expertise,
  sameAs: entry.data.externalProfiles,
};
---

<BaseLayout
  title={`${entry.data.name} - ${entry.data.role}`}
  description={`${entry.data.name}, ${entry.data.role}. Экспертиза: ${entry.data.expertise.join(', ')}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <Hero
    eyebrow="Команда Ada Tours"
    title={entry.data.name}
    intro={entry.data.role}
    compact
    ctaLabel="Обсудить маршрут"
  />

  <PersonProfile
    name={entry.data.name}
    role={entry.data.role}
    photo={entry.data.photo}
    expertise={entry.data.expertise}
    eyebrow="Профиль"
  >
    <Content />
  </PersonProfile>

  <LeadForm title="Обсудить поездку с Ada Tours" entityId={entry.data.id} />
</BaseLayout>

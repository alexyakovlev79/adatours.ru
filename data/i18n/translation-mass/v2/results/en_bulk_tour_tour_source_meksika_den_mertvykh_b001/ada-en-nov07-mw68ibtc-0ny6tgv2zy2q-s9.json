    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "227aa9348bcbe4d2d95770c7fdf12050f3bb802847b7dca601edc8d6a5bf8405",
      "text": "This nine-day trip runs once a year around Día de los Muertos. You'll visit Mexico City, Teotihuacán, Puebla, Cholula, Atlixco, Mixquic and Xochimilco, along with museums dedicated to Frida Kahlo and Diego Rivera. The trip centres on 31 October and 1 and 2 November, when flowers, candles and altars fill streets, homes and cemeteries as families remember those who have died.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-nov07-mw68ibtc-0ny6tgv2zy2q",
        "model": "gpt-6.1-sol",
        "wordAbsenceReason": "The Word contains the day-by-day visits and dates, but has no equivalent opening paragraph summarising the route and observances."
      }
    },

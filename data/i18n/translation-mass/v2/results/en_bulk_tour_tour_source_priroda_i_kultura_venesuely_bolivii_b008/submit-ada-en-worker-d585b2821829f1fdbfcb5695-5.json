      },
      "text": "Canaima, Venezuela: tepuis above the lagoon's green shore"
    },
    {
      "blockId": "tour:itinerary_title:ed497b2a669f6ce4",
      "field": "itinerary.title",
      "sourceTextSha256": "582f8f1d5878995e2ca40c8483f020ad0e3f3d5bfeeb4740671793e8be0e9d5f",
      "provenance": {

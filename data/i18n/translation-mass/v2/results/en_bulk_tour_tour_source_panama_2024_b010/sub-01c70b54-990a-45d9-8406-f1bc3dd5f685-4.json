      "text": "Boquete: Canopy Tour and Coffee Plantation"
    },
    {
      "blockId": "tour:itinerary_text:5a8704e80dc128a8",
      "field": "itinerary.text",
      "sourceTextSha256": "42f449e70f70c6dd1b22c55717d4b389c22aad1a680fee896f69d01aa4903ec5",

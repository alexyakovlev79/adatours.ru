    {
      "blockId": "tour:itinerary_text:569e72e117968fcc",
      "field": "itinerary.text",
      "sourceTextSha256": "01772cbfafa49e5c6bc480886af9ad53ae1d31bcb524e6342dda11ce58a329a3",
      "text": "The great highland Maya market of Chichicastenango (Thursdays and Sundays only), one of the largest indigenous markets in the Americas, famous for its textiles and masks. Amid the misty cobbled streets and red-tiled roofs, visit the 16th-century church of Santo Tomás, built on the site of a Maya temple: its 18 steps, one for each month of the Maya Haab calendar, are still used for offerings of flowers, candles and incense, a striking blend of Maya and Catholic traditions. Then drive to Panajachel, on the shore of Lake Atitlán, with superb views of the lake on the final descent from Sololá. Overnight at Hotel Villa Santa Catarina. (B)",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1u01AIZBrMnePKGELOLUBwZ133xpIPYMH",
        "documentSha256": "e88235c95537f9f403d182ebcbced8daaa366421c23e2f5cb9d61c2bf5cead1c",

---
import PrimaryCTA from '../global/PrimaryCTA.astro';
import { uiText } from '../../lib/i18n/messages.mjs';

interface Props {
  price?: string;
  basis?: string;
  ctaLabel?: string;
  ctaHref?: string;
  locale?: 'ru' | 'en';
  sectionId?: string;
  // Kept for backward compatibility with existing content/component calls.
  // Tour price notes are intentionally not rendered in the public pricing block.
  note?: string;
}
const { price, basis, ctaLabel, ctaHref, locale = 'ru', sectionId } = Astro.props;
const displayedPrice = price ?? uiText(locale, 'tour.onRequest');
const buttonLabel = ctaLabel ?? (locale === 'en' ? 'Enquire by email' : 'Заказать этот тур');
const buttonHref = ctaHref ?? (locale === 'en' ? '#enquiry' : '/contacts/');
---

<section class="pricing section" id={sectionId} data-ada-i18n-pricing={locale === 'en' ? 'en' : undefined}>
  <div class="container pricing__grid">
    <div>
      <p class="eyebrow">{uiText(locale, 'tour.price')}</p>
      <h2>{displayedPrice}</h2>
      {basis && <p class="pricing__basis">{basis}</p>}
    </div>
    <div class="pricing__copy">
      {Astro.slots.has('default') && <div class="pricing__details"><slot /></div>}
      <PrimaryCTA href={buttonHref} label={buttonLabel} variant="light" />
    </div>
  </div>
</section>

<style>
  .pricing {
    /* A warm neutral pause between the map and programme conditions. */
    background: var(--color-surface-beige);
    color: var(--color-ink);
    padding-top: var(--section-y-tight);
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    column-gap: clamp(48px, 8vw, 120px);
    row-gap: var(--heading-gap);
    align-items: end;
  }

  .pricing h2 {
    margin: 12px 0 0;
    font-size: clamp(3rem, 2rem + 3.2vw, 5.5rem);
    line-height: .92;
  }

  .pricing__basis {
    margin: 16px 0 0;
    max-width: 60ch;
    line-height: 1.55;
  }

  .pricing__copy {
    max-width: 500px;
    min-width: 0;
  }

  .pricing__details {
    margin-bottom: clamp(20px, 3vw, 40px);
    min-width: 0;
  }

  .pricing :global(.cta) {
    margin-top: 0;
    color: var(--color-ink);
  }

  @media (max-width: 760px) {
    .pricing__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

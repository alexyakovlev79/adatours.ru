---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/editorial/Hero.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import SearchIndexRecord from '../components/global/SearchIndexRecord.astro';
import { withBase } from '../lib/paths';

const { entry } = Astro.props;
const d = entry.data;

const [destinationEntries, tourEntries, excursionEntries] = await Promise.all([
  getCollection('destinations', ({ data }) =>
    data.locale === 'ru' &&
    !['draft', 'archived'].includes(data.status) &&
    data.countryId === d.id
  ),
  getCollection('tours', ({ data }) =>
    data.locale === 'ru' &&
    !['draft', 'archived'].includes(data.status) &&
    data.countries.includes(d.id)
  ),
  getCollection('excursions', ({ data }) =>
    data.locale === 'ru' &&
    !['draft', 'archived'].includes(data.status) &&
    data.country === d.id
  ),
]);

const preferredDestinations = new Map(
  d.regions.map((name, index) => [name.toLocaleLowerCase('ru'), index])
);

destinationEntries.sort((a, b) => {
  const ai = preferredDestinations.get(a.data.name.toLocaleLowerCase('ru')) ?? 999;
  const bi = preferredDestinations.get(b.data.name.toLocaleLowerCase('ru')) ?? 999;
  if (ai !== bi) return ai - bi;
  return a.data.name.localeCompare(b.data.name, 'ru');
});

tourEntries.sort((a, b) =>
  (b.data.priority ?? 0) - (a.data.priority ?? 0) ||
  a.data.title.localeCompare(b.data.title, 'ru')
);

excursionEntries.sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru'));

const destinationTypeLabel = {
  city: 'Город',
  region: 'Регион',
  island: 'Остров',
  national_park: 'Национальный парк',
  resort: 'Курорт',
  natural_area: 'Природная территория',
  route_cluster: 'Маршрут',
};
---

<BaseLayout
  title={`${d.name}: туры и путешествия`}
  description={d.summary}
  image={d.hero?.src}
>
  <SearchIndexRecord
    title={d.name}
    summary={d.summary}
    entityType="country"
    typeLabel="Страна"
    subtitle=""
    aliases={d.searchAliases}
    geography={[d.name, ...d.regions]}
    themes={d.relatedThemes}
    image={d.hero?.src}
  />

  <Hero
    eyebrow="Страна"
    title={d.name}
    intro={d.summary}
    image={d.hero?.src}
    mediaStatus={d.hero?.status}
    replacementReason={d.hero?.replacementReason}
    ctaLabel="Подобрать маршрут"
  />

  <section class="country-copy section--tight">
    <div class="container prose country-copy__prose">
      <slot />
    </div>
  </section>

  {destinationEntries.length > 0 && (
    <section class="country-linked section" aria-labelledby="country-destinations-title">
      <div class="container">
        <div class="country-linked__heading">
          <p class="eyebrow">Направления</p>
          <h2 id="country-destinations-title">Куда поехать в {d.name}</h2>
          <p>
            Все направления {d.name}, которые уже есть на сайте: города, острова,
            природные территории, курорты и отдельные маршруты.
          </p>
        </div>

        <div class="country-linked__grid">
          {destinationEntries.map((item, index) => {
            const image = item.data.hero?.src ? withBase(item.data.hero.src) : undefined;
            const href = withBase(`/napravleniya/${d.slug}/${item.data.slug}/`);
            return (
              <a
                class:list={['entity-poster', { 'entity-poster--wide': index % 7 === 0 }]}
                href={href}
                style={image ? `--entity-image: url("${image}")` : undefined}
              >
                <span class="entity-poster__shade" aria-hidden="true"></span>
                <span class="entity-poster__content">
                  <span class="entity-poster__meta">
                    {destinationTypeLabel[item.data.destinationType]}
                  </span>
                  <strong>{item.data.name}</strong>
                  <span class="entity-poster__text">{item.data.summary}</span>
                  <span class="entity-poster__link">Смотреть <span aria-hidden="true">↗</span></span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {tourEntries.length > 0 && (
    <section class="country-linked country-linked--tours section" aria-labelledby="country-tours-title">
      <div class="container">
        <div class="country-linked__heading">
          <p class="eyebrow">Туры</p>
          <h2 id="country-tours-title">Туры по {d.name}</h2>
          <p>
            Все опубликованные программы, в маршруте которых есть {d.name}.
            Мног страновые поездки тоже включены, если Бразилия является частью маршрута.
          </p>
        </div>

        <div class="country-linked__grid">
          {tourEntries.map((item, index) => {
            const image = item.data.hero?.src ? withBase(item.data.hero.src) : undefined;
            const meta = [
              item.data.durationDays ? `${item.data.durationDays} дней` : '',
              item.data.format ?? '',
            ].filter(Boolean).join(' · ');
            return (
              <a
                class:list={['entity-poster', 'entity-poster--tour', { 'entity-poster--wide': index % 5 === 0 }]}
                href={withBase(`/tury/${item.data.slug}/`)}
                style={image ? `--entity-image: url("${image}")` : undefined}
              >
                <span class="entity-poster__shade" aria-hidden="true"></span>
                <span class="entity-poster__content">
                  {meta && <span class="entity-poster__meta">{meta}</span>}
                  <strong>{item.data.title}</strong>
                  <span class="entity-poster__text">{item.data.lead}</span>
                  <span class="entity-poster__link">Смотреть <span aria-hidden="true">↗</span></span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {excursionEntries.length > 0 && (
    <section class="country-linked section" aria-labelledby="country-excursions-title">
      <div class="container">
        <div class="country-linked__heading">
          <p class="eyebrow">Экскурсии</p>
          <h2 id="country-excursions-title">Экскурсии в {d.name}</h2>
        </div>

        <div class="country-linked__grid">
          {excursionEntries.map((item, index) => {
            const image = item.data.hero?.src ? withBase(item.data.hero.src) : undefined;
            const meta = [item.data.duration ?? '', item.data.format ?? ''].filter(Boolean).join(' · ');
            return (
              <a
                class:list={['entity-poster', { 'entity-poster--wide': index % 5 === 0 }]}
                href={withBase(`/ekskursii/${item.data.slug}/`)}
                style={image ? `--entity-image: url("${image}")` : undefined}
              >
                <span class="entity-poster__shade" aria-hidden="true"></span>
                <span class="entity-poster__content">
                  {meta && <span class="entity-poster__meta">{meta}</span>}
                  <strong>{item.data.title}</strong>
                  <span class="entity-poster__link">Смотреть <span aria-hidden="true">↗</span></span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <LeadForm title={`Собрать путешествие по стране: ${d.name}`} entityId={d.id} />
</BaseLayout>

<style>
  .country-copy {
    background: var(--color-bg);
  }

  .country-copy__prose {
    max-width: 900px;
  }

  .country-copy__prose :global(p) {
    margin-block: 0 1.35em;
    color: color-mix(in srgb, var(--color-ink) 82%, transparent);
    font-size: clamp(1.18rem, 1.45vw, 1.48rem);
    line-height: 1.55;
  }

  .country-linked {
    background: var(--color-bg);
  }

  .country-linked--tours {
    background: #f5f0e8;
  }

  .country-linked__heading {
    display: grid;
    grid-template-columns: minmax(150px, .34fr) minmax(0, 1fr);
    column-gap: clamp(30px, 6vw, 92px);
    row-gap: 18px;
    align-items: start;
    margin-bottom: clamp(48px, 7vw, 92px);
  }

  .country-linked__heading .eyebrow {
    margin: 8px 0 0;
  }

  .country-linked__heading h2 {
    max-width: 900px;
    margin: 0;
  }

  .country-linked__heading > p:last-child {
    grid-column: 2;
    max-width: 700px;
    margin: 0;
    color: color-mix(in srgb, var(--color-ink) 68%, transparent);
    font-size: var(--text-lg);
  }

  .country-linked__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 2.3vw, 34px);
  }

  .entity-poster {
    --entity-image: linear-gradient(145deg, #5a5b54, #191a17);
    position: relative;
    display: grid;
    min-height: clamp(400px, 38vw, 560px);
    overflow: hidden;
    color: #fff;
    background:
      var(--entity-image),
      linear-gradient(145deg, #5a5b54, #191a17);
    background-position: center;
    background-size: cover;
    isolation: isolate;
  }

  .entity-poster--wide {
    grid-column: 1 / -1;
    min-height: clamp(480px, 52vw, 660px);
  }

  .entity-poster__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(8, 9, 8, .06) 18%, rgba(8, 9, 8, .78) 100%);
    transition: background 250ms ease;
  }

  .entity-poster:hover .entity-poster__shade {
    background: linear-gradient(180deg, rgba(8, 9, 8, .12) 12%, rgba(8, 9, 8, .86) 100%);
  }

  .entity-poster__content {
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: clamp(30px, 4vw, 56px);
  }

  .entity-poster__meta,
  .entity-poster__link {
    font-family: var(--font-display);
    font-size: .76rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .entity-poster strong {
    max-width: 960px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 4rem);
    font-weight: 400;
    line-height: 1.04;
  }

  .entity-poster:not(.entity-poster--wide) strong {
    font-size: clamp(1.8rem, 2.65vw, 3rem);
  }

  .entity-poster__text {
    max-width: 700px;
    color: rgba(255,255,255,.84);
    font-size: clamp(.98rem, 1.2vw, 1.12rem);
    line-height: 1.5;
  }

  .entity-poster__link {
    display: inline-flex;
    gap: 24px;
    align-items: center;
    margin-top: 8px;
    padding-bottom: 7px;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 820px) {
    .country-linked__heading {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .country-linked__heading > p:last-child {
      grid-column: 1;
    }

    .country-linked__grid {
      grid-template-columns: 1fr;
    }

    .entity-poster,
    .entity-poster--wide {
      grid-column: 1;
      min-height: 430px;
    }

    .entity-poster strong,
    .entity-poster:not(.entity-poster--wide) strong {
      font-size: clamp(2rem, 9vw, 3rem);
    }
  }
</style>

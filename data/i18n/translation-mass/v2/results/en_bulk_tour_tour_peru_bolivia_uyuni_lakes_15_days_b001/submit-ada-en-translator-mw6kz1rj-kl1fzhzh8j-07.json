    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "2cc9696d0ba693bbb862dd4d76725ee876ff833809db5ad28b0f7a9f73f65f55",
      "text": "The stone terraces of Machu Picchu, the reed islands of Lake Titicaca and the white expanse of Uyuni give way to the red and green lagoons of the Eduardo Avaroa Reserve. This 15-day, 14-night group tour departs in 2027 and includes the Uros Islands, Taquile, geysers and hot springs.",
      "provenance": {
        "kind": "ai_translation",
        "model": "GPT-6.1 Sol",
        "runId": "ada-en-translator-mw6kz1rj-kl1fzhzh8j"
      }
    },
    {
      "blockId": "tour:priceNote:9b6b7f5cf7b1e557",
      "field": "priceNote",
      "sourceTextSha256": "a325e9594c3817607fbe40b42bb696615bd824e9636737417081897cc4150bd8",
      "text": "From $5960 per person in the 3-star package, based on double or triple occupancy (DBL/TPL). 4-star package: DBL $6218, SGL/TPL on request. Minimum of two participants. New Year departure: an additional $250 net per person.",
      "provenance": {
        "kind": "ai_translation",

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/editorial/Hero.astro';
import EditorialStatement from '../../../components/editorial/EditorialStatement.astro';
import FactStrip from '../../../components/proof/FactStrip.astro';
import EditorialProof from '../../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../../components/proof/ProcessSteps.astro';
import DmcNav from '../../../components/commercial/DmcNav.astro';
import DmcFaq from '../../../components/commercial/DmcFaq.astro';
import { ORG } from '../../../data/organization/ada-tours';
---

<BaseLayout
  leadTitle="Запросить предложение для клиента"
  leadEntityId="dmc_for_agencies"
  title="DMC для турагентств и туроператоров в Бразилии | принимающий туроператор в Южной Америке Ada Tours"
  description="Принимающее обслуживание Ada Tours для турагентств и туроператоров: маршруты, отели, трансферы, гиды, FIT, группы и multi-country по Латинской (Южной) Америке."
  image="/media/home/lencois-enhanced-20260930.webp"
>
  <Hero
    eyebrow="DMC · Для турагентств"
    title="DMC для турагентств и туроператоров"
    intro="Одна локальная команда собирает наземную программу по Бразилии и Латинской Америке: маршрут, размещение, транспорт, гидов и координацию на месте."
    image="/media/home/lencois-enhanced-20260930.webp"
    ctaHref="#request"
    ctaLabel="Запросить предложение"
  />

  <DmcNav active="agencies" />

  <EditorialStatement
    eyebrow="Рабочая схема"
    text="Для первого расчета достаточно агентского брифа. Дальше собираем программу и согласовываем ее по пунктам."
  />

  <FactStrip
    facts={[
      { value: 'Multi-country', label: 'маршруты по нескольким странам' },
      { value: String(ORG.service.languages.length), label: 'языков коммуникации' },
      { value: 'FIT', label: 'индивидуальные путешествия' },
      { value: ORG.service.groups.standard.display, label: ORG.service.groups.standard.label },
    ]}
  />

  <EditorialProof
    eyebrow="Кому подходит"
    title="Туроператоры, luxury travel advisors и MICE-агентства"
    text="Работаем с партнерами, которым нужен DMC по Бразилии или связанная программа по нескольким странам Латинской Америки."
    image="/media/destinations/foz-do-iguacu/gallery-1-enhanced-20261001.webp"
    facts={ORG.business.b2bPartnerTypes}
  />

  <EditorialProof
    eyebrow="Что можно поручить"
    title="Маршрут, размещение и исполнение на месте"
    text="Собираем наземную часть поездки и держим ее как одну программу: от прилета и размещения до экскурсий, деловой части и финального трансфера."
    image="/media/home/rio-night-enhanced-20260930.webp"
    facts={[
      'Маршрут и наземные переезды',
      'Отели и размещение',
      'Трансферы, транспорт и гиды',
      'Экскурсии, MICE и специальные запросы',
    ]}
    reverse
  />

  <EditorialProof
    eyebrow="Что прислать"
    title="5 пунктов для содержательного первого расчета"
    text="Чем точнее исходный бриф, тем меньше итераций уходит на маршрут и состав услуг."
    image="/media/home/buenos-aires-enhanced-20260930.webp"
    facts={[
      'Даты или диапазон дат',
      'Количество путешественников и состав группы',
      'Страны, города и обязательные точки',
      'Уровень размещения и бюджет',
      'VIP, MICE и другие специальные требования',
    ]}
  />

  <ProcessSteps
    eyebrow="Рабочий процесс"
    title="От запроса партнера до программы на месте"
    steps={[
      { title: 'Бриф', text: 'Фиксируем даты, географию, состав группы и обязательные условия.' },
      { title: 'Маршрут', text: 'Связываем города, перелеты, трансферы, размещение и программу.' },
      { title: 'Предложение', text: 'Собираем расчет после проверки доступности и состава услуг.' },
      { title: 'Координация', text: 'Во время поездки локальная команда ведет подрядчиков и изменения по маршруту.' },
    ]}
    dark
  />

  <DmcFaq
    title="Что нужно турагентству для работы с DMC"
    items={[
      {
        question: 'Что прислать для первого расчета?',
        answer: 'Даты или диапазон дат, количество путешественников, страны и города, уровень размещения, бюджет и специальные требования.',
      },
      {
        question: 'Можно ли собрать multi-country маршрут через Ada Tours?',
        answer: 'Да. Ada Tours связывает наземную программу по нескольким странам Латинской Америки в один маршрут с размещением, транспортом и локальными услугами.',
      },
      {
        question: 'С какими B2B-партнерами работает Ada Tours?',
        answer: `Ada Tours работает с турагентствами и туроператорами, включая ${ORG.business.b2bPartnerTypes.join(', ')}.`,
      },
      {
        question: 'С группами какого размера работает Ada Tours?',
        answer: `Обычные группы — ${ORG.service.groups.standard.display} человек. Для крупных событий подтвержден диапазон ${ORG.service.groups.largeEvents.display} участников.`,
      },
    ]}
  />
</BaseLayout>

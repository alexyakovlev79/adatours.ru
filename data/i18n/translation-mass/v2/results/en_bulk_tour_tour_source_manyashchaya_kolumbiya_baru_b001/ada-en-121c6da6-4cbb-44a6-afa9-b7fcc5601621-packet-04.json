    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "b5c5b800a69b4e4254080c186bbb99065ad496f5ed095278f4b7cdc1fc659462",
      "text": "This itinerary combines Colombia’s main cities with several days on the Caribbean coast. The first part of the trip brings a new guided visit or a journey to the next stop almost every day. Barú gives you a few quieter days before you return to Cartagena. Start in Bogotá with its historic centre, the Gold Museum and the views from Monserrate. Then visit Lake Guatavita and the underground Salt Cathedral of Zipaquirá. The Medellín part of the trip includes El Peñón de Guatapé, the colourful town of Guatapé, the Museum of Antioquia, Plaza Botero and Comuna 13. After Cartagena, spend three nights on Barú with breakfast, lunch and dinner included.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-121c6da6-4cbb-44a6-afa9-b7fcc5601621",
        "model": "ChatGPT"

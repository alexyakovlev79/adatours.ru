---
import { themeIds } from '../lib/interest-model.mjs';
import { getVipTourPaths } from '../lib/vip-catalog';
import { seoTourTitle } from '../lib/seo-page.mjs';
import { isActiveEntity, isArchivedEntity } from '../lib/archive.mjs';
import ArchiveNotice from '../components/global/ArchiveNotice.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import InterestLinks from '../components/editorial/InterestLinks.astro';
import Hero from '../components/editorial/Hero.astro';
import TripStats from '../components/tour/TripStats.astro';
import HighlightsEditorial from '../components/tour/HighlightsEditorial.astro';
import Itinerary from '../components/tour/Itinerary.astro';
import TourPricing from '../components/tour/TourPricing.astro';
import IncludedExcluded from '../components/tour/IncludedExcluded.astro';
import StoryPair from '../components/editorial/StoryPair.astro';
import SearchIndexRecord from '../components/global/SearchIndexRecord.astro';
import InlineMarkdown from '../components/global/InlineMarkdown.astro';
import { withBase } from '../lib/paths';
import { destinationCatalogById } from '../lib/content-validation';
import { countryPath, destinationPath, tourBreadcrumbs, tourPath } from '../lib/routes';
import { mainTourCountryIds, mainTourDestinationIds, optionalTourDestinationIds } from '../lib/tour-relations';

const { entry } = Astro.props;
const d = entry.data;
const archived = isArchivedEntity(d);
const vip = !archived && (await getVipTourPaths()).has(tourPath(d));
const roundedPrice = typeof d.priceFrom === 'number' ? Math.round(d.priceFrom) : null;
const currencyPrefix = d.currency === 'USD' ? String.fromCharCode(36) : '';
const money = roundedPrice && d.currency
  ? 'от ' + currencyPrefix + roundedPrice.toLocaleString('ru-RU', { maximumFractionDigits: 0 })
  : 'По запросу';

const pluralRu = (value: number, one: string, few: string, many: string) => {
  const n = Math.abs(value) % 100;
  const n1 = n % 10;
  if (n >= 11 && n <= 19) return many;
  if (n1 === 1) return one;
  if (n1 >= 2 && n1 <= 4) return few;
  return many;
};

const routePointCount = mainTourDestinationIds(d).length || d.route.length;
const stats = [
  d.durationDays ? {
    value: String(d.durationDays),
    label: pluralRu(d.durationDays, 'день', 'дня', 'дней'),
  } : null,
  d.durationNights !== undefined ? {
    value: String(d.durationNights),
    label: pluralRu(d.durationNights, 'ночь', 'ночи', 'ночей'),
  } : null,
  {
    value: String(routePointCount),
    label: pluralRu(routePointCount, 'точка маршрута', 'точки маршрута', 'точек маршрута'),
  },
  d.format ? { value: d.format, label: 'формат', kind: 'format' as const } : null,
].filter(Boolean);

// Media QA status must never silently remove a source image from the page.
const usableGallery = d.gallery;
const firstStory = usableGallery[0] && d.highlights[0]
  ? { item: d.highlights[0], image: usableGallery[0] }
  : null;
const lastStory = usableGallery[1] && d.highlights.length > 1
  ? { item: d.highlights[d.highlights.length - 1], image: usableGallery[1] }
  : null;
const editorialHighlights = d.highlights.filter((_, index) => {
  if (firstStory && index === 0) return false;
  if (lastStory && index === d.highlights.length - 1) return false;
  return true;
});

const [countryEntries, destinationEntries] = await Promise.all([
  getCollection('countries', ({ data }) => data.locale === 'ru' && isActiveEntity(data)),
  getCollection('destinations', ({ data }) => data.locale === 'ru' && isActiveEntity(data) && d.destinations.includes(data.id)),
]);

const countryById = new Map(countryEntries.map((item) => [item.data.id, item]));
const destinationById = new Map(destinationEntries.map((item) => [item.data.id, item]));
const countryNames = d.countries.map((id) => countryById.get(id)?.data.name).filter(Boolean) as string[];
const routeDestinations = d.destinations.map((id) => {
  const destination = destinationById.get(id);
  const planned = destinationCatalogById.get(id);
  const country = destination ? countryById.get(destination.data.countryId) : undefined;
  return {
    id,
    name: destination?.data.name ?? planned?.name ?? '',
    // Keep a future place as text; its link activates when the page is published.
    href: destination && country ? destinationPath(destination.data) : undefined,
  };
}).filter((item) => item.name);
const destinationNames = routeDestinations.map((item) => item.name);
const mainPlaces = routeDestinations.filter((item) => mainTourDestinationIds(d).includes(item.id));
const optionalPlaces = routeDestinations.filter((item) => optionalTourDestinationIds(d).includes(item.id));
const mainCountryEntries = mainTourCountryIds(d).map((id) => countryById.get(id)).filter(Boolean);
const placeGroups = [
  { label: 'Места маршрута', entries: mainPlaces },
  { label: 'Места факультативных экскурсий и вариантов программы', entries: optionalPlaces },
];
const durationLabel = d.durationDays
  ? `${d.durationDays} ${pluralRu(d.durationDays, 'день', 'дня', 'дней')}`
  : '';
const subtitleParts = [
  durationLabel,
  countryNames.join(', '),
].filter(Boolean);
// Keep the full itinerary in tour data; hero shows only the trip duration.
const heroMeta = durationLabel || undefined;

// Treat the lead as the opening paragraph of the description, not hero text.
// Only move its display position; do not edit the authored body or deduplicate.
const tourBodyHtml = await Astro.slots.render('default');
const firstHeadingMatch = tourBodyHtml.match(/^(\s*(?:<!--[\s\S]*?-->\s*)*<h2\b[^>]*>[\s\S]*?<\/h2>)/i);
const firstHeadingHtml = firstHeadingMatch?.[1] ?? '';
const remainingBodyHtml = firstHeadingHtml ? tourBodyHtml.slice(firstHeadingHtml.length) : tourBodyHtml;
const hasTourDescription = Boolean(d.lead?.trim() || tourBodyHtml.trim());
---

<BaseLayout breadcrumbsInHero leadTourId={archived ? undefined : d.id} leadTitle={archived ? "Подобрать другую поездку" : "Получить расчет и адаптировать маршрут под ваши даты"} leadEntityId={archived ? "" : d.id} headerTheme={archived ? 'dark' : 'light'} noindex={archived} title={seoTourTitle(d)} description={d.lead} image={d.hero?.src} canonical={tourPath(d)} breadcrumbs={tourBreadcrumbs(d)}>
  {!archived && <SearchIndexRecord
    title={d.title}
    summary={d.lead}
    entityType="tour"
    typeLabel="Тур"
    subtitle={subtitleParts.join(' · ')}
    aliases={d.searchAliases}
    geography={[...countryNames, ...destinationNames, ...d.route]}
    themes={themeIds(d)}
    image={d.hero?.src}
    tourCountryCount={new Set(mainTourCountryIds(d)).size}
    tourDurationDays={d.durationDays}
  />}
  {archived && <ArchiveNotice id={d.id} kind="tour" />}

  <Hero
    tour
    vip={vip}
    eyebrow={archived ? "Архивный тур" : "Индивидуальный тур"}
    title={d.title}
    image={d.hero?.src}
    imageTextAlign={d.imageTextAlign}
    mediaStatus={d.hero?.status}
    replacementReason={d.hero?.replacementReason}
    meta={heroMeta}
    ctaLabel={archived ? "Актуальные туры" : "Получить программу"}
    ctaHref={archived ? "/tours/" : "/contacts/"}
  >
    {!archived && <Breadcrumbs slot="breadcrumbs" inline pathname={Astro.url.pathname} title={d.title} items={tourBreadcrumbs(d)} />}
  </Hero>

  {d.durationDays && <TripStats stats={stats} />}

  <InterestLinks entity={d} />

  {hasTourDescription && (
    <section class="tour-copy">
      <div class="container prose" data-tour-description>
        {firstHeadingHtml && <Fragment set:html={firstHeadingHtml} />}
        <div class="tour-copy__text" id={`tour-description-${d.id}`} data-tour-description-text>
          {d.lead?.trim() && <p class="tour-lead"><InlineMarkdown text={d.lead} /></p>}
          {remainingBodyHtml && <Fragment set:html={remainingBodyHtml} />}
        </div>
        <button class="tour-copy__toggle" type="button" aria-expanded="false" aria-controls={`tour-description-${d.id}`} data-tour-description-toggle hidden>
          <span data-tour-description-label>Подробнее о путешествии</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </section>
  )}

  {mainCountryEntries.length > 0 && (
    <nav class="tour-destinations container" aria-label="Страны маршрута">
      <p class="eyebrow">Страны маршрута</p>
      <ul>
        {mainCountryEntries.map((country) => (
          <li><a href={withBase(countryPath(country.data))}>{country.data.name}</a></li>
        ))}
      </ul>
    </nav>
  )}

  {placeGroups.filter((group) => group.entries.length).map((group) => (
    <nav class="tour-destinations container" aria-label={group.label}>
      <p class="eyebrow">{group.label}</p>
      <ul>
        {group.entries.map((item) => (
          <li>{item.href ? <a href={withBase(item.href)}>{item.name}</a> : <span>{item.name}</span>}</li>
        ))}
      </ul>
    </nav>
  ))}

  {firstStory && (
    <StoryPair
      eyebrow="Акцент маршрута"
      title={firstStory.item.title}
      text={firstStory.item.text}
      image={firstStory.image.src}
      imageTextAlign={d.imageTextAlign}
      mediaStatus={firstStory.image.status}
      replacementReason={firstStory.image.replacementReason}
    />
  )}

  {editorialHighlights.length > 0 && <HighlightsEditorial items={editorialHighlights} />}


  {d.itinerary.length > 0 && <Itinerary days={d.itinerary} />}

  {lastStory && (
    <StoryPair
      eyebrow="Еще один акцент"
      title={lastStory.item.title}
      text={lastStory.item.text}
      image={lastStory.image.src}
      imageTextAlign={d.imageTextAlign}
      mediaStatus={lastStory.image.status}
      replacementReason={lastStory.image.replacementReason}
      reverse
    />
  )}

  {!archived && <TourPricing price={money} />}
  {(d.included.length > 0 || d.notIncluded.length > 0 || d.notes.length > 0) && (
    <IncludedExcluded included={d.included} notIncluded={d.notIncluded} notes={d.notes} />
  )}
</BaseLayout>

<script>
  const initTourDescriptions = () => {
    document.querySelectorAll<HTMLElement>('[data-tour-description]').forEach((section) => {
      if (section.dataset.descriptionReady) return;
      const text = section.querySelector<HTMLElement>('[data-tour-description-text]');
      const toggle = section.querySelector<HTMLButtonElement>('[data-tour-description-toggle]');
      const label = section.querySelector<HTMLElement>('[data-tour-description-label]');
      if (!text || !toggle || !label) return;
      section.dataset.descriptionReady = 'true';
      let expanded = false;

      const update = () => {
        const firstParagraph = text.querySelector<HTMLElement>('p');
        const lead = text.querySelector<HTMLElement>('.tour-lead');
        const lineHeight = parseFloat(getComputedStyle(firstParagraph ?? text).lineHeight) || 30;
        // Keep the whole lead, plus a faded glimpse of the continuation.
        // Without a lead, show roughly ten lines at the current screen width.
        const leadHeight = lead
          ? lead.getBoundingClientRect().bottom - text.getBoundingClientRect().top
          : 0;
        const previewHeight = Math.ceil(Math.max(lineHeight * 10, leadHeight + lineHeight * 3));
        const long = text.scrollHeight > previewHeight + lineHeight;
        text.style.setProperty('--tour-copy-preview-height', `${previewHeight}px`);
        text.style.setProperty('--tour-copy-fade-height', `${lineHeight * 2.5}px`);
        text.classList.toggle('is-collapsed', long && !expanded);
        toggle.hidden = !long;
        toggle.setAttribute('aria-expanded', String(expanded));
        label.textContent = expanded ? 'Свернуть' : 'Подробнее о путешествии';
      };

      toggle.addEventListener('click', () => {
        expanded = !expanded;
        update();
        // Keep the control and beginning in view when closing a long description.
        if (!expanded && text.getBoundingClientRect().top < 0) {
          window.scrollTo({
            top: Math.max(0, window.scrollY + text.getBoundingClientRect().top - 120),
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        }
      });
      // A keyboard user reaching a link inside the clipped text sees it immediately.
      text.addEventListener('focusin', () => {
        if (!expanded && !toggle.hidden) {
          expanded = true;
          update();
        }
      });

      update();
      if ('ResizeObserver' in window) new ResizeObserver(update).observe(text);
      else window.addEventListener('resize', update);
      document.fonts.ready.then(update);
    });
  };
  initTourDescriptions();
  document.addEventListener('astro:page-load', initTourDescriptions);
</script>

<style>
  .tour-copy { background: var(--color-bg); padding: 0 0 clamp(28px, 4vw, 56px); }
  .tour-copy :global(.prose) { padding-top: 0; padding-bottom: 0; }
  .tour-copy :global(.prose:empty) { display: none; }
  .tour-copy .tour-lead {
    font-weight: 600;
  }

  .tour-copy__text { display: flow-root; }
  .tour-copy__text.is-collapsed {
    max-height: var(--tour-copy-preview-height);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - var(--tour-copy-fade-height)), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - var(--tour-copy-fade-height)), transparent);
  }
  .tour-copy__toggle {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin-top: 12px;
    padding: 8px 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: var(--text-base);
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }
  .tour-copy__toggle[hidden] { display: none; }
  .tour-copy__toggle:hover { color: var(--color-gold-deep); }
  .tour-copy__toggle svg { flex: none; transition: transform .2s ease; }
  .tour-copy__toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  @media print {
    .tour-copy__text.is-collapsed { max-height: none; overflow: visible; -webkit-mask-image: none; mask-image: none; }
    .tour-copy__toggle { display: none; }
  }

  .tour-destinations { padding-block: 0 clamp(28px, 4vw, 56px); }
  .tour-destinations ul { display: flex; flex-wrap: wrap; gap: 12px 24px; margin: 0; padding: 0; list-style: none; }
  .tour-destinations a { text-decoration: underline; text-underline-offset: .2em; }
</style>


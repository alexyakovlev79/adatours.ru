      "text": "Mashpi to Quito"
    },
    {
      "blockId": "tour:itinerary_text:fb5db666cae6efb7",
      "field": "itinerary.text",
      "sourceTextSha256": "a708c81957a83b60d8bf190bb66267dbf9c5c2c9630a9ae8b29f8a029e453d6c",

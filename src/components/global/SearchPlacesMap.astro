---
import {withBase} from '../../lib/paths';
const yandexKey=import.meta.env.PUBLIC_YANDEX_MAPS_API_KEY||'';
const googleKey=import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY||'';
const googleMapId=import.meta.env.PUBLIC_GOOGLE_MAP_ID||'';
const mediaOrigin=process.env.MEDIA_CDN_ORIGIN||import.meta.env.MEDIA_CDN_ORIGIN||'https://img.adatours.ru';
---
<section class="search-places-map" aria-label="Найденные места на карте"
  data-search-places-map data-yandex-key={yandexKey}
  data-google-key={googleKey} data-google-map-id={googleMapId}
  data-geo-url={withBase('/search-geo-places.json')}
  data-media-origin={mediaOrigin} hidden>
  <div class="search-places-map__canvas" data-search-map-canvas
    role="group" aria-label="Карта результатов поиска"></div>
  <p class="search-places-map__status" data-search-map-status aria-live="polite">
    Введите хотя бы 2 символа, чтобы увидеть места на карте.
  </p>
  <article class="search-places-map__card" data-search-map-card hidden>
    <button type="button" class="search-places-map__close"
      data-search-map-card-close aria-label="Закрыть описание места">×</button>
    <img data-search-map-photo alt="" loading="lazy" hidden />
    <div class="search-places-map__card-copy">
      <h3 data-search-map-title></h3>
      <p data-search-map-description></p>
      <a href="#" data-search-map-link>Подробнее о месте →</a>
    </div>
  </article>
</section>
<style>
  .search-places-map{
    position:relative;align-self:start;width:100%;height:auto;
    aspect-ratio:4/3;margin:0;background:#EFEDE8;isolation:isolate;overflow:hidden
  }
  .search-places-map[hidden],.search-places-map__card[hidden]{display:none}
  .search-places-map.is-preparing{
    position:fixed!important;top:0!important;left:-200vw!important;
    width:min(46vw,550px)!important;max-width:none!important;
    height:auto!important;aspect-ratio:4/3!important;
    margin:0!important;visibility:hidden;pointer-events:none
  }
  .search-places-map__canvas{position:absolute;inset:0}
  .search-places-map__status{
    position:absolute;inset:0;z-index:3;display:grid;place-items:center;
    padding:12px 16px;margin:0;text-align:center;background:#F6F4EE;
    color:#56534B;font-size:.89rem;pointer-events:none
  }
  .search-places-map__status[hidden]{display:none}
  .search-places-map__card{
    position:absolute;top:9px;left:9px;z-index:9;
    width:min(278px,calc(100% - 18px));max-height:calc(100% - 48px);
    overflow:auto;color:#1A1A1A;background:#FFFCF8;box-shadow:0 4px 20px #0003
  }
  .search-places-map__card img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}
  .search-places-map__card img[hidden]{display:none}
  .search-places-map__card-copy{padding:12px 15px 15px}
  .search-places-map__card h3{margin:0 0 7px;font-family:var(--font-display);
    font-weight:500;font-size:clamp(18px,2vw,22px);line-height:1.15}
  .search-places-map__card p{font-size:13px;line-height:1.4;margin:0 0 10px;
    overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical}
  .search-places-map__card a{color:var(--color-brand-deep);font-size:13px;
    font-weight:600;text-decoration:underline}
  .search-places-map__close{position:absolute;right:7px;top:7px;z-index:2;
    width:32px;height:32px;background:#FFFCF8;border:0;
    color:#1A1A1A;font-size:25px;line-height:1;cursor:pointer}
  .search-places-map :global(.search-places-map__pin){
    display:grid;place-items:center;width:34px;height:34px;
    background:var(--color-brand);border:2px solid #1A1A1A;
    border-radius:50%;box-shadow:0 2px 9px #0003;color:#1A1A1A;
    font-size:13px;font-weight:700;cursor:pointer
  }
  .search-places-map :global(.search-places-map__pin:hover),
  .search-places-map :global(.search-places-map__pin:focus-visible){
    background:var(--color-brand-hover);outline:2px solid #FFFCF8;outline-offset:1px
  }
  @media(max-width:760px){
    .search-places-map.is-preparing{
      width:calc(100vw - 2 * var(--gutter))!important
    }
    .search-places-map__card{width:min(245px,calc(100% - 18px))}
    .search-places-map__card img{max-height:130px}
    .search-places-map__card-copy{padding:9px 12px 12px}
    .search-places-map__card p{-webkit-line-clamp:2}
  }
</style>

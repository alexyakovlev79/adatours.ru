    {
      "blockId": "tour:itinerary_text:4b5ff9b4a37f43cc",
      "field": "itinerary.text",
      "sourceTextSha256": "8c91aca483461fe10361bdd241b35335cf76b3f3ff6376f26050d4728f961bd7",
      "text": "After breakfast, a tour through the city to the station, where an eco-friendly train climbs through the jungle to the top of Corcovado, with spectacular views of the Tijuca Forest, home to monkeys and exotic birds. At the summit, 710 metres above sea level, stands the symbol of Rio, the 38-metre statue of Christ the Redeemer, built in 1931, with a breathtaking panorama of the city and its surroundings: the Rio–Niterói Bridge, Guanabara Bay, the Botanical Garden, the legendary Maracanã Stadium, Sugar Loaf and more.",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1uABQ0zRQzYr2BAfQJdxCiSzAnVokBp8V",
        "documentSha256": "c497465aaf05b3457cbd5e1645cb363f7f38a48fdfe238375a666b96a483bdaf",

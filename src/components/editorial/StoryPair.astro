---
import { withBase } from '../../lib/paths';

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  image?: string;
  reverse?: boolean;
  mediaStatus?: 'approved' | 'needs_replacement' | 'replaced';
  replacementReason?: string;
}

const { eyebrow, title, text, image, reverse = false, mediaStatus, replacementReason } = Astro.props;
const resolvedImage = image ? withBase(image) : undefined;
---

<section
  class:list={['story section', { 'story--reverse': reverse }]}
  data-media-status={mediaStatus ?? (image ? 'legacy' : undefined)}
  data-replacement-reason={replacementReason}
>
  <div class="story__media" style={resolvedImage ? `background-image:url("${resolvedImage}")` : undefined}></div>
  <div class="story__copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
</section>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr);
    gap: clamp(34px, 5vw, 80px);
    align-items: center;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .story--reverse {
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
  }

  .story--reverse .story__media {
    order: 2;
  }

  .story__media {
    min-height: clamp(440px, 52vw, 720px);
    background:
      radial-gradient(circle at 70% 20%, rgba(242,204,103,.22), transparent 30%),
      linear-gradient(150deg, #57584f, #1a1a18);
    background-position: center;
    background-size: cover;
  }

  .story__copy {
    min-width: 0;
    max-width: 100%;
  }

  .story h2 {
    max-width: 100%;
    margin: 12px 0 24px;
    font-size: clamp(2.35rem, 3.4vw, 4rem);
    line-height: 1.04;
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .story__copy p:last-child {
    max-width: 520px;
    color: rgba(26,26,26,.72);
  }

  @media (max-width: 820px) {
    .story,
    .story--reverse {
      grid-template-columns: 1fr;
    }

    .story--reverse .story__media {
      order: initial;
    }
  }
</style>

        "model": "GPT-6.1"
      },
      "text": "Thatched houses and boats on the water in Iquitos, Peru"
    },
    {
      "blockId": "tour:media_hover:61888760ff677907",
      "field": "media.hover",
      "sourceTextSha256": "7eac4f03b42d9dba5c990c7ca6fe76c01ae63b5bc051a1bed8fe0c2771f0b0ba",

    },
    {
      "blockId": "tour:itinerary_text:b9ad3e14216c2f08",
      "field": "itinerary.text",
      "sourceTextSha256": "f786dc8297dc2ec59d8d69021bc6a720c8a3971e0343fb77aad8fa78ecba53bf",

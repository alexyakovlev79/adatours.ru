        "kind": "ai_translation",
        "runId": "ada-en-mw4he47t-amanda",
        "model": "GPT-6",
        "wordAbsenceReason": "Word paragraph 61 has no equivalent concise passage with the 275-cascade count and Guarani etymology. It also incorrectly connects Iguazu to the Amazon River; translate the assigned current RU passage rather than reproduce that contradictory geography."
      }

    {
      "blockId": "tour:itinerary_text:b04d5d61d358e759",
      "field": "itinerary.text",
      "sourceTextSha256": "98ae6151828702db97e48a0512630f15f5b05fcf1ef9e6dc43d8b18c46c90d8e",
      "text": "Transfer to the airport for your flight to Manaus. Upon arrival, you will be met and transferred to the hotel. Dinner and an evening program await.\n\nFrom Manaus, you will venture into the jungle, where you will stay in lodges and immerse yourself in exotic surroundings. Options include jungle walks or piranha fishing. During a night safari filled with the sounds of the jungle, you may spot the glowing eyes of a caiman.\n\nImportant: You must arrive in Manaus by 4:00 PM and depart no earlier than 2:30 PM. Otherwise, an individual transfer to/from the lodge will need to be arranged (not included in the program price).",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1Ot3vZZKbdw7lpVeOZQjbZXvCNHM3B0BN",

    {
      "blockId": "tour:itinerary_text:c3205ac1e20a266d",
      "field": "itinerary.text",
      "sourceTextSha256": "009ae7e267375377a4bdd062c45411ac0efb4b31e073f35b682b1ca92fe899d6",
      "text": "Sightseeing tour with an English-speaking guide, beginning in the city centre at La Moneda Palace. Built in neoclassical style at the end of the Spanish colonial era to house the royal mint, it has been the seat of the Chilean government since the mid-19th century and is a national historic monument.\n\nContinue to the Plaza de Armas, where the history of the city began, surrounded by the Cathedral, the City Hall, the Central Post Office and the former Royal Audience building. Then climb Santa Lucía Hill for a magnificent panorama of the city, before discovering the modern districts of Vitacura, Las Condes and Providencia and driving along the Mapocho River.\n\nOptional at an additional cost: Maipo Valley wineries. Visit to wineries in the Maipo Valley, with a tasting.\n\nUSD 230 per person. Minimum 2 people.",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1D9b9CT24BvopVtwbWVZClhDY4V-81Q5M",
        "documentSha256": "08e0d302e63195697d0b6b436bbaa7bd566d75aa46e060ec8fb0006011d8960c",

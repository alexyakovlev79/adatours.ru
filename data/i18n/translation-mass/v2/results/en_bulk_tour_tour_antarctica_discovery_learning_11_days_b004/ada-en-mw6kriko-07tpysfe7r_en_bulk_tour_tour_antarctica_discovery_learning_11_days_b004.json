      },
      "text": "The currency of the rates, the ship, cabin category and availability, meals, the language of the guides, included services and additional costs are confirmed before booking."
    },
    {
      "blockId": "tour:note:053e6649ee6d2fa2",
      "field": "note",
      "sourceTextSha256": "274c9da2b7ecd773247dc8e6d60cf53e96c6f39331079247d42e760736506e49",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6kriko-07tpysfe7r",
        "model": "GPT-6.1 Codex"
      },
      "text": "The voyage lasts 11 days, with 10 nights between departure and return."
    },
    {
      "blockId": "tour:note:a4288deb640e621a",
      "field": "note",
      "sourceTextSha256": "3a4ed6d753d3f886dbe97fcd0a38d37e534cdc616af59c8dac36dabd50991382",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6kriko-07tpysfe7r",
        "model": "GPT-6.1 Codex"
      },
      "text": "Possible visits include Danco Island, Neko Harbour, Paradise Bay, Port Lockroy and Jougla Point. Day 8 may feature either Deception Island or Half Moon Island. Both visits are subject to availability, and the itinerary does not guarantee both."
    },
    {
      "blockId": "tour:itinerary_title:5cd7a3d146d31311",
      "field": "itinerary.title",
      "sourceTextSha256": "666c55bfe1f26495a74e160ef87891bbb681b30052c390b7a51782439a9525bd",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6kriko-07tpysfe7r",
        "model": "GPT-6.1 Codex"
      },
      "text": "Ushuaia and the Beagle Channel"
    },
    {
      "blockId": "tour:itinerary_text:5a4836cca1208c95",
      "field": "itinerary.text",
      "sourceTextSha256": "3733ae519b143ebede64feee2829c4b64ea3bc74b38a0425771dcaa71af5dd6f",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6kriko-07tpysfe7r",
        "model": "GPT-6.1 Codex"
      },
      "text": "The ship departs from Ushuaia in Tierra del Fuego in the afternoon. Until late in the evening, it follows the Beagle Channel past mountains and islands before beginning the crossing to Antarctica."
    },
    {
      "blockId": "tour:itinerary_label:540a508e8a789df1",

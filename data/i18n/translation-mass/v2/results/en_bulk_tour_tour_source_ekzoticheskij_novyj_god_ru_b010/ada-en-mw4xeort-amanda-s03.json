        "kind": "ai_translation",
        "runId": "ada-en-mw4xeort-amanda",
        "model": "GPT-6",
        "wordAbsenceReason": "The selected Word 2027 contains no matching jungle boat, piranha-fishing, caboclo-village or survival-skills programme paragraph; these details are translated from the assigned RU block."
      }
    },

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import EditorialProof from '../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
---

<BaseLayout
  title="VIP и Luxury путешествия по Бразилии и Латинской Америке"
  description="Индивидуальные VIP и luxury маршруты по Бразилии и Латинской Америке с персональной сборкой программы."
>
  <Hero
    eyebrow="VIP / Luxury"
    title="Не больше услуг. Больше контроля над поездкой"
    intro="VIP-формат начинается не с яхты или вертолета, а с персональной сборки маршрута, гибкости программы и способности команды решать детали без участия гостя."
    image="/media/prototype/rio-night.jpg"
    ctaLabel="Собрать VIP-маршрут"
  />

  <EditorialStatement
    eyebrow="Private travel"
    text="Для сложной частной поездки важны 3 вещи: правильные люди на месте, запас по времени и возможность быстро менять программу, когда меняются планы гостя."
  />

  <EditorialProof
    eyebrow="Бразилия"
    title="Рио, Игуасу и побережье без ощущения пакетного тура"
    text="Один и тот же маршрут может выглядеть совершенно по-разному в зависимости от размещения, формата трансферов, гидов, ресторанов, приватных активностей и количества свободного времени."
    image="/media/prototype/iguazu.jpg"
    facts={[
      'Индивидуальная логистика',
      'Частные гиды и трансферы',
      'Подбор размещения под маршрут',
      'Дополнительные активности под запрос',
    ]}
  />

  <EditorialProof
    eyebrow="Персонализация"
    title="Не перегружать программу только потому, что бюджет это позволяет"
    text="В premium-поездке свободный день может быть ценнее еще одной экскурсии. Поэтому программу лучше строить вокруг ритма гостя, а не вокруг максимального числа включенных услуг."
    image="/media/prototype/patagonia.jpg"
    reverse
  />

  <ProcessSteps
    eyebrow="Как собирается VIP-маршрут"
    title="Сначала образ поездки, потом список услуг"
    steps={[
      { title: 'Пожелания', text: 'Определяем ритм, интересы, уровень приватности и то, что точно не должно попасть в программу.' },
      { title: 'Маршрут', text: 'Выбираем 2-4 главных точки вместо попытки увидеть все за одну поездку.' },
      { title: 'Детали', text: 'Подбираем размещение, транспорт, гидов, рестораны и дополнительные активности.' },
      { title: 'Гибкость', text: 'Оставляем пространство для изменений и свободного времени уже в самой конструкции программы.' },
    ]}
    dark
  />

  <LeadForm title="Собрать индивидуальный VIP-маршрут" entityId="vip" />
</BaseLayout>

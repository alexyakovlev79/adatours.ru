    {
      "blockId": "tour:itinerary_text:4b5ff9b4a37f43cc",
      "field": "itinerary.text",
      "sourceTextSha256": "f9c7ce1ffa18d8c76d723adf320b89838cd54d4de0586a89a4b8865bc2f08512",
      "text": "After breakfast, travel to Chalchuapa to visit Tazumal, a Maya archaeological complex with ceremonial structures dating to around AD 100–1200. Finds include a drainage system, tombs, pyramids, palaces and ritual objects.\n\nThe next stop is the nearby Casa Blanca archaeological site. Then continue to Santa Ana, El Salvador’s second-largest city, to see the Neo-Gothic cathedral, the theatre and the Municipal Palace.\n\nYou can have lunch on the shore of Lake Coatepeque and relax by the water if you wish. Then visit Ataco, known for its textiles and the murals on its colonial houses.\n\nOvernight at Hotel Fleur de Lis. Meals: breakfast.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-986f3332f46d53ddb5737edd",
        "model": "Codex GPT-6"

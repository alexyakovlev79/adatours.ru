---
import PrimaryCTA from '../global/PrimaryCTA.astro';

interface Props {
  price?: string;
  note?: string;
}
const { price = 'По запросу', note } = Astro.props;
---

<section class="pricing section">
  <div class="container pricing__grid">
    <div>
      <p class="eyebrow">Стоимость</p>
      <h2>{price}</h2>
    </div>
    <div class="pricing__copy">
      <p>{note ?? 'Финальная стоимость зависит от дат, категории размещения и выбранных дополнительных услуг.'}</p>
      <PrimaryCTA href="/contacts/" label="Получить расчет" />
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--color-gold);
    color: var(--color-ink-deep);
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: clamp(48px, 8vw, 120px);
    align-items: end;
  }

  .pricing h2 {
    margin: 12px 0 0;
    font-size: var(--text-display);
    line-height: .88;
  }

  .pricing__copy {
    max-width: 500px;
  }

  .pricing__copy p {
    margin-top: 0;
  }

  .pricing :global(.cta) {
    margin-top: 22px;
    border-color: var(--color-ink-deep);
    background: transparent;
  }

  @media (max-width: 760px) {
    .pricing__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

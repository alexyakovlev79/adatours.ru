---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/editorial/Hero.astro';
import TripStats from '../components/tour/TripStats.astro';
import MediaGallery from '../components/editorial/MediaGallery.astro';
import TourPricing from '../components/tour/TourPricing.astro';
import IncludedExcluded from '../components/tour/IncludedExcluded.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import EditorialStatement from '../components/editorial/EditorialStatement.astro';
import DestinationBand from '../components/editorial/DestinationBand.astro';

const { entry } = Astro.props;
const d = entry.data;

const [countryEntries, destinationEntries, tourEntries, excursionEntries] = await Promise.all([
  getCollection('countries', ({ data }) => data.locale === 'ru'),
  getCollection('destinations', ({ data }) => data.locale === 'ru' && data.id === d.destination),
  getCollection('tours', ({ data }) =>
    data.locale === 'ru' &&
    !['draft', 'archived'].includes(data.status)
  ),
  getCollection('excursions', ({ data }) =>
    data.locale === 'ru' &&
    !['draft', 'archived'].includes(data.status)
  ),
]);

const country = countryEntries.find((item) => item.data.id === d.country);
const destination = destinationEntries[0];
const destinationCountry = destination
  ? countryEntries.find((item) => item.data.id === destination.data.countryId)
  : undefined;

const getTourExcursionIds = (tour) => {
  const ids = new Set<string>();

  for (const item of tour.data.itinerary) {
    if (item.excursionRef) ids.add(item.excursionRef);

    for (const block of item.contentBlocks) {
      if (block.type === 'excursion') ids.add(block.excursionRef);
    }
  }

  return ids;
};

const relatedExcursionTourOverlap = new Map<string, number>();

for (const tour of tourEntries) {
  const tourExcursionIds = getTourExcursionIds(tour);

  if (!tourExcursionIds.has(d.id)) continue;

  tourExcursionIds.delete(d.id);

  for (const excursionId of tourExcursionIds) {
    relatedExcursionTourOverlap.set(
      excursionId,
      (relatedExcursionTourOverlap.get(excursionId) ?? 0) + 1
    );
  }
}

const relatedExcursions = excursionEntries
  .filter((item) => item.data.id !== d.id && relatedExcursionTourOverlap.has(item.data.id))
  .sort((a, b) => {
    const overlapDiff =
      (relatedExcursionTourOverlap.get(b.data.id) ?? 0) -
      (relatedExcursionTourOverlap.get(a.data.id) ?? 0);

    return overlapDiff || a.data.title.localeCompare(b.data.title, 'ru');
  })
  .slice(0, 10);

const fallbackCountries: Record<string, { label: string; href: string }> = {
  country_ecuador: { label: 'Эквадор', href: '/strany/ekvador/' },
};

const fallbackDestinations: Record<string, { label: string; href: string }> = {
  destination_ecuador_kito_vulkan_kotopahi: {
    label: 'Кито и вулкан Котопахи',
    href: '/napravleniya/ekvador/kito-vulkan-kotopahi/',
  },
};

const destinationName =
  destination?.data.name ??
  d.destinationName ??
  (d.destination ? fallbackDestinations[d.destination]?.label : undefined);

const destinationHref = destinationCountry && destination
  ? `/napravleniya/${destinationCountry.data.slug}/${destination.data.slug}/`
  : undefined;

const countryBreadcrumb = country
  ? {
      label: country.data.name,
      href: `/strany/${country.data.slug}/`,
    }
  : fallbackCountries[d.country];

const destinationBreadcrumb = country && destination
  ? {
      label: destination.data.name,
      href: `/napravleniya/${country.data.slug}/${destination.data.slug}/`,
    }
  : d.destination
    ? fallbackDestinations[d.destination]
    : undefined;

const excursionBreadcrumbs = [
  ...(countryBreadcrumb ? [countryBreadcrumb] : []),
  ...(destinationBreadcrumb ? [destinationBreadcrumb] : []),
  {
    label: 'Экскурсии',
    href: '/ekskursii/',
  },
  {
    label: d.title,
    href: `/ekskursii/${d.slug}/`,
  },
];

const roundedPrice = typeof d.priceFrom === 'number' ? Math.round(d.priceFrom) : null;
const currencyPrefix = d.currency === 'USD' ? String.fromCharCode(36) : '';
const money = roundedPrice && d.currency
  ? 'от ' + currencyPrefix + roundedPrice.toLocaleString('ru-RU', { maximumFractionDigits: 0 })
  : 'По запросу';

const stats = [
  d.duration ? { value: d.duration, label: 'продолжительность' } : null,
  destinationName ? { value: destinationName, label: 'место' } : null,
  d.format ? { value: d.format, label: 'формат' } : null,
].filter(Boolean);

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://adatours.ru').toString();
const excursionSchema = {
  '@type': 'TouristTrip',
  '@id': `${pageUrl}#excursion`,
  name: d.title,
  description: d.lead,
  url: pageUrl,
  ...(d.hero?.src ? { image: d.hero.src } : {}),
  ...(d.route.length > 0 ? {
    itinerary: {
      '@type': 'ItemList',
      itemListElement: d.route.map((name, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: { '@type': 'Place', name },
      })),
    },
  } : {}),
  ...(roundedPrice && d.currency ? {
    offers: {
      '@type': 'Offer',
      price: roundedPrice,
      priceCurrency: d.currency,
      url: pageUrl,
    },
  } : {}),
};
---

<BaseLayout
  title={d.title}
  description={d.lead}
  image={d.hero?.src}
  pageSchema={excursionSchema}
  breadcrumbs={excursionBreadcrumbs}
>
  <Hero
    eyebrow="Экскурсия"
    title={d.title}
    intro={d.lead}
    image={d.hero?.src}
    mediaStatus={d.hero?.status}
    replacementReason={d.hero?.replacementReason}
    meta={[d.duration ?? '', d.route.join(' · ')].filter(Boolean).join(' · ')}
    ctaLabel="Заказать экскурсию"
  />

  {stats.length > 0 && <TripStats stats={stats} />}

  <section class="excursion-copy section--tight">
    <div class="container prose">
      <slot />
    </div>
  </section>

  {destination && destinationHref && (
    <DestinationBand
      eyebrow="Место"
      title={destination.data.name}
      text={destination.data.summary}
      image={destination.data.hero?.src}
      mediaStatus={destination.data.hero?.status}
      replacementReason={destination.data.hero?.replacementReason}
      href={destinationHref}
      descriptionBelow={true}
    />
  )}

  {d.gallery.length > 0 && (
    <MediaGallery
      items={d.gallery}
      eyebrow="Фотографии"
      title="Экскурсия в кадрах"
      layout="orientation"
    />
  )}

  <TourPricing price={money} ctaLabel="Заказать экскурсию" />

  {(d.included.length > 0 || d.notIncluded.length > 0 || d.notes.length > 0) && (
    <IncludedExcluded included={d.included} notIncluded={d.notIncluded} notes={d.notes} />
  )}

  {relatedExcursions.length > 0 && (
    <>
      <EditorialStatement eyebrow="Рядом" text="Другие экскурсии, которые можно добавить к поездке" />
      {relatedExcursions.map((item, index) => (
        <DestinationBand
          eyebrow={[item.data.duration ?? '', item.data.format ?? ''].filter(Boolean).join(' · ')}
          title={item.data.title}
          text={item.data.lead}
          image={item.data.hero?.src}
          mediaStatus={item.data.hero?.status}
          replacementReason={item.data.hero?.replacementReason}
          href={`/ekskursii/${item.data.slug}/`}
          align={index % 2 === 1 ? 'right' : 'left'}
        />
      ))}
    </>
  )}

  <LeadForm title={`Заказать экскурсию: ${d.title}`} entityId={d.id} />
</BaseLayout>

<style>
  .excursion-copy {
    background: var(--color-bg);
    padding-block: clamp(58px, 6vw, 96px);
  }

  .excursion-copy :global(.prose) {
    max-width: 900px;
  }

  .excursion-copy :global(.prose p) {
    margin-block: 0 1.3em;
    color: color-mix(in srgb, var(--color-ink) 82%, transparent);
    font-size: clamp(1.12rem, 1.4vw, 1.42rem);
    line-height: 1.58;
  }

  .excursion-copy :global(.prose p:last-child) {
    margin-bottom: 0;
  }
</style>

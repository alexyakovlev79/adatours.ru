    {
      "blockId": "tour:itinerary_text:25152ad0c634f823",
      "field": "itinerary.text",
      "sourceTextSha256": "43ad5d975627fcb81b81fbff3df14ffea4b29fca57426d1a9875394afd0698f1",
      "text": "The next 4 days have no compulsory excursions.\n\nThe hotel is right on the beachfront, so you can head straight to the sea in the morning and easily return to your room during the day.\n\nAt low tide, the sea recedes, leaving shallow natural pools between the reefs. Later, the water rises again and covers the rocks.\n\nYou can swim at Muro Alto, walk along the shore or relax by the pool.\n\nFor a more active day, diving and buggy rides along the coast are available.\n\nAfter Rio, Iguazu and the Amazon, these 4 days give you time without further flights or transfers.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw5fhrrp-amanda",
        "model": "GPT-6",
        "wordAbsenceReason": "Word provides only the Days 12–15 beach-stay heading, not the RU details about tides, pools, diving and buggy rides."
      }
    },

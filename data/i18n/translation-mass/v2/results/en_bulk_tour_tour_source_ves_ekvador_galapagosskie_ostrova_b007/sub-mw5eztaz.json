      "text": "The Amazon – Papallacta",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1FAu_uKH11zRCdWd-h-4l9OhxTCCnAekG",
        "documentSha256": "748959185907f90ae151328c9ed1cd6351d3c55b13758bbf4041e8a4e43fa672",
        "paragraphs": [
          {
            "ref": "word/document.xml:p86",
            "text": "The Amazon",
            "textSha256": "336b7a8f378318e64b27502026297091388b9f21cf6e0b2b12d5ce6308908ab0"
          },
          {
            "ref": "word/document.xml:p89",
            "text": "Day 7 · Drive to Papallacta (about 3 hours), stopping at the Archidona market, where you can try chontacuro, the palm-weevil larvae eaten by Indigenous communities. Afternoon in the hot springs of Termas de Papallacta, at about 3,300 m on the historic Cinnamon Route followed by Francisco de Orellana in 1542: nine hot and three cold pools, between 36 and 40 °C, rich in minerals. Overnight at Termas de Papallacta 4★. (B)",
            "textSha256": "0b2bec50fc008bc2f2e66ba686ea3b40af3779794bc3961fd93be83110ed1556"
          }
        ],
        "transformation": "compose_route_label",
        "rationale": "Compose the transfer-day heading from its confirmed start region and destination."
      }
    },

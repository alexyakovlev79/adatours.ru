        "kind": "ai_translation",
        "runId": "ada-en-mw376iyr-amanda",
        "model": "GPT-6",
        "wordAbsenceReason": "The corresponding Word paragraph combines this day summary with the full descriptions of both optional island routes. There is no separate summary matching this block; translated the assigned RU summary to keep the alternatives separate from their excursion modules."
      }
    },

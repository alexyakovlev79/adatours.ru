---
import { withBase } from '../../lib/paths';
import InlineMarkdown from '../global/InlineMarkdown.astro';

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  image: string;
  facts?: string[];
  reverse?: boolean;
}
const { eyebrow, title, text, image, facts = [], reverse = false } = Astro.props;
---

<section class:list={['proof', { 'proof--reverse': reverse }]}>
  <div class="proof__media">
    <img src={withBase(image)} alt="" loading="lazy" />
  </div>
  <div class="proof__copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p><InlineMarkdown text={text} /></p>
    {facts.length > 0 && (
      <ul>
        {facts.map((fact) => <li><InlineMarkdown text={fact} /></li>)}
      </ul>
    )}
  </div>
</section>

<style>
  .proof {
    position: relative;
    display: grid;
    width: 100%;
    min-height: clamp(440px, 55vw, 680px);
    margin: 0;
    padding: 0;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background: #171815;
  }
  .proof__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .proof__media img { width: 100%; height: 100%; max-width: none; object-fit: cover; }
  .proof::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(10,10,9,.8), rgba(10,10,9,.2) 90%);
  }
  .proof__copy {
    align-self: end;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    min-width: 0;
    margin-inline: auto;
    padding-block: clamp(48px, 6vw, 86px);
  }
  .proof h2 { max-width: 920px; margin: 10px 0 18px; color: inherit; font-size: var(--text-h2); line-height: 1.04; overflow-wrap: break-word; }
  .proof__copy > p:last-of-type { max-width: 700px; margin-bottom: 0; color: rgba(255,255,255,.9); }
  .proof ul { max-width: 760px; margin: 28px 0 0; padding: 0; list-style: none; border-top: 1px solid rgba(255,255,255,.35); }
  .proof li { padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,.35); font-size: .92rem; }
  .proof--reverse .proof__copy { text-align: right; }
  .proof--reverse h2,
  .proof--reverse .proof__copy > p:last-of-type,
  .proof--reverse ul { margin-left: auto; }
  .proof--reverse::before { background: linear-gradient(270deg, rgba(10,10,9,.8), rgba(10,10,9,.2) 90%); }
  @media (max-width: 820px) {
    .proof::before { background: linear-gradient(180deg, rgba(10,10,9,.2), rgba(10,10,9,.88)); }
  }
</style>

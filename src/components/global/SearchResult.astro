<template data-search-result-template>
  <a class="search-result" data-result-link>
    <div class="search-result__main">
      <div class="search-result__heading">
        <h3 data-result-title></h3>
        <span class="search-result__type" data-result-type></span>
      </div>
      <p class="search-result__subtitle" data-result-subtitle></p>
      <p class="search-result__summary" data-result-summary></p>
    </div>
    <span class="search-result__arrow" aria-hidden="true">↗</span>
  </a>
</template>
<style>
  .search-result{display:grid;grid-template-columns:1fr auto;align-items:start;gap:28px;padding:26px 0 28px;border-top:1px solid var(--color-line);transition:opacity 180ms ease}
  .search-result:hover{opacity:.62}
  .search-result__heading{display:flex;align-items:baseline;gap:14px 18px;flex-wrap:wrap}
  .search-result h3{margin:0;font-size:clamp(1.55rem,1.2rem + 1vw,2.35rem);line-height:1.04}
  .search-result__type{font-family:var(--font-display);font-size:.68rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:var(--color-gold-deep)}
  .search-result__subtitle,.search-result__summary{max-width:760px;margin:8px 0 0}
  .search-result__subtitle{font-family:var(--font-display);font-size:.86rem;line-height:1.35;color:color-mix(in srgb,var(--color-ink) 62%,transparent)}
  .search-result__summary{font-size:.98rem;line-height:1.55;color:color-mix(in srgb,var(--color-ink) 76%,transparent)}
  .search-result__arrow{padding-top:3px;font-size:1.35rem;line-height:1}
  @media(max-width:640px){.search-result{gap:18px;padding-block:22px 24px}.search-result__summary{display:-webkit-box;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical}}
</style>

        "kind": "ai_translation",
        "model": "ChatGPT",
        "runId": "ada-en-9457ab67-20261104",
        "wordAbsenceReason": "The Word overview paragraph 18 does not include this RU lead's combined museums, Chicaque, upper/lower basin, canoe and three-night summary. These appear separately in paragraphs 43–53 and 68–87; translated the current RU lead."
      }
    },

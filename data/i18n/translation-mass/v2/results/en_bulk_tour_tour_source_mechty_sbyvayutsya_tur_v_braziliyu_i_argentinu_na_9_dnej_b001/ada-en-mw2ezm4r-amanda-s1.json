      "sourceTextSha256": "a176132b4405c9bfa326703fd7e5ad24347f85061e1b49709f7ad97e62eb6856",
      "text": "Brazil and Argentina for Adults: Rio, Iguazu and Buenos Aires in 9 Days",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw2ezm4r-amanda",
        "model": "GPT-6",
        "wordAbsenceReason": "The Word cover uses Dreams Come True; the current RU title specifies the adult audience and nine-day route, which have no equivalent complete title in Word."
      }
    },
    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "a61a1fd108f9e5ac2b2d818c0bb0a5c3eace6bc26d6314104528eed81f752ee8",
      "text": "This 9-day itinerary brings together Rio de Janeiro, Iguazu Falls and Buenos Aires. In Rio, see the city from Sugar Loaf and Corcovado, explore the historic centre and choose optional activities such as a boat trip, an evening show, the Botanical Garden, a helicopter flight or hang gliding. Two days are then devoted to Iguazu, allowing you to see the falls from both the Brazilian and Argentine sides. The trip ends in Buenos Aires, with a city tour and tango show included, plus a free day for Tigre, a gaucho ranch or a trip to Montevideo.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw2ezm4r-amanda",
        "model": "GPT-6",
        "wordAbsenceReason": "The Word overview is a different promotional paragraph and does not contain the current RU lead's complete summary of included and optional activities; translated the assigned RU lead."
      }
    },

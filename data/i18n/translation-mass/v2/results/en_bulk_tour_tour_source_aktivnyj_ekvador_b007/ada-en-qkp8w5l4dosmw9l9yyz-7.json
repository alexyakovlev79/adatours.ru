      "sourceTextSha256": "9841cf9b238ef12c0cbeb09565885868a85362b9c4ad86c05ac907ee74ea3e5b",
      "text": "Canyoning in Baños",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-qkp8w5l4dosmw9l9yyz",
        "model": "GPT-6"
      }

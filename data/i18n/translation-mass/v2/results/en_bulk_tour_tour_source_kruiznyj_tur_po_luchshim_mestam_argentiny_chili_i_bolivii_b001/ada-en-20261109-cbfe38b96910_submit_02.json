    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "de09f45863bec3d143e718821be07beb14ee67003ca2da1f7583fab96c6fb00d",
      "text": "This 18-day journey through three South American countries takes you from Santiago, Chile, through high-altitude deserts and across the Uyuni Salt Flat, then to Torres del Paine, on a cruise through the fjords of southern Patagonia and Tierra del Fuego, and on to Ushuaia, Buenos Aires and Bariloche. The scenery changes dramatically along the way. Big cities give way to the lagoons and volcanoes of the Altiplano, then to the glaciers, straits and forests of Patagonia. The trip ends among Argentina’s lakes and mountains.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-cbfe38b96910",
        "model": "gpt-6.1-sol"
      }

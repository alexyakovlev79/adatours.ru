      "sourceTextSha256": "d0b1499feb786d9a583329b7fae971bbf4efa5447ad4236bc1179bf674516030",
      "text": "Iguaçu Falls from the Brazilian side",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6jq3bq-tagrtz0i7c",
        "model": "GPT-6.1"
      }
    },

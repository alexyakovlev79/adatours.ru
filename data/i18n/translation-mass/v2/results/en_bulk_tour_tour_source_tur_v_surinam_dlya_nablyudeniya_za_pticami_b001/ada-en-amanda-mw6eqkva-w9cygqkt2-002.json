    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "cd09defd3bac32c8502bcf76d15a2cd30d39f76b1f58cfa56d8c7db800bd8b6d",
      "text": "Suriname remains one of South America’s least-explored birding destinations. Tropical forest covers most of the country, and its low population density and small number of visitors help preserve the natural areas of the Guiana Shield. On this private, eight-day tour, you’ll go out each day when birds are most active. The route takes you through open savanna, riverside forest, former plantations, secondary forest and stretches of the Atlantic coast. You’ll walk early in the morning, watch birds during the day and head out again in the evening as nocturnal species become active.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "amanda-ada-en-translator-20261107",
        "model": "GPT-6.1",
        "wordAbsenceReason": "The matched 2026 Word document moves directly from the title, duration and price to Day 1 and contains no standalone overview of Suriname, the habitats or the birding schedule."
      }
    },

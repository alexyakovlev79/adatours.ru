---
import { createHash } from 'node:crypto';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import DestinationBand from '../../components/editorial/DestinationBand.astro';
import CatalogPagination from '../../components/catalog/CatalogPagination.astro';
import MultiCountrySelector from '../../components/catalog/MultiCountrySelector.astro';
import { getMultiCountryCatalog } from '../../lib/multi-country-catalog.ts';
import { multiCountryCatalogPath } from '../../lib/multi-country-catalog.mjs';
import MultiCountryRelated from '../../components/catalog/MultiCountryRelated.astro';
import { formatMultiCountryNames } from '../../lib/multi-country-combinations.mjs';
import { multiCountrySeoMetadata } from '../../lib/multi-country-seo.mjs';
import combinationCovers from '../../data/media/multi-country-heroes.json';
import destinationCatalog from '../../data/catalog/destinations.json';
import { paginateCatalog } from '../../lib/catalog-pagination';
import { mainTourCountries, tourPath } from '../../lib/routes';
import { countLabel } from '../../lib/interest-model.mjs';
import { countInEnglish } from '../../lib/i18n/messages.mjs';
import { sharedUiLocale,sharedCountryName,sharedInterestName } from '../../lib/i18n/shared-ui-locale.mjs';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const index = await getMultiCountryCatalog();
  return index.filter((row) => row.path !== '/multi-country/').flatMap((row) => {
    const version = createHash('sha256')
      .update(JSON.stringify(row.tours.map((entry) => entry.data.id))).digest('hex').slice(0, 20);
    const seoMeta = multiCountrySeoMetadata({ countries: row.countries, tours: row.tours,
      destinations: destinationCatalog, theme: row.theme });
    return paginateCatalog(row.tours, row.path).map(({ entries, pagination }) => ({
      params: { selection: pagination.canonical.replace(/^\/multi-country\/|\/$/g, '') },
      props: { entries, pagination, catalogVersion: version, slugs: row.slugs,
        comboCountries: row.countries, seoMeta, theme: row.theme, catalogId: row.id,
        hero: combinationCovers.covers[row.key]?.src ?? row.theme?.hero?.src ?? row.tours[0]?.data.hero?.src,
      },
    }));
  });
}

const {
  entries, pagination, catalogVersion, slugs, comboCountries,
  hero, seoMeta, theme, catalogId,
} = Astro.props;
const uiLocale = sharedUiLocale();
const countryDisplayNames = uiLocale === 'en'
  ? new Map((await getCollection('countries', ({ data }) => data.locale === 'ru')).map(({ data }) => [data.id,sharedCountryName(data.slug,data.name,uiLocale)]))
  : new Map<string, string>();
const themeName = theme ? sharedInterestName(theme.id,theme.name,uiLocale) : '';
const names = comboCountries.map((country) => uiLocale==='en'?sharedCountryName(country.slug,country.name,uiLocale):country.name);
// Page titles always use the canonical alphabetical country order.
const countriesText = names.length ? (uiLocale==='en'?names.join(' + '):formatMultiCountryNames(names)) : (uiLocale==='en'?'Several countries':'Несколько стран');
const heading = theme ? themeName + ': ' + countriesText : (uiLocale==='en'?'Tours: ':'Туры: ') + countriesText;
const parentCombination = multiCountryCatalogPath(slugs);
const pageBreadcrumbs = [
  { label: 'Главная', href: '/' },
  { label: 'Multi-country', href: '/multi-country/' },
  ...(slugs.length ? [{ label: countriesText, href: parentCombination }] : []),
  ...(theme ? [{ label: themeName, href: pagination.rootPath }] : []),
  ...(pagination.currentPage > 1 ? [{ label: (uiLocale==='en'?'Page ':'Страница ') + pagination.currentPage, href: pagination.canonical }] : []),
];
const baseTitle = seoMeta.title;
const pageSuffix = pagination.currentPage > 1 ? (uiLocale==='en'?' — page ':' — страница ') + pagination.currentPage + (uiLocale==='en'?' of ':' из ') + pagination.totalPages : '';
const matchingTourPhrase = countLabel(pagination.totalItems,
  ['подходящий тур', 'подходящих тура', 'подходящих туров']);
const matchingTourAgreement = pagination.totalItems % 10 === 1 && pagination.totalItems % 100 !== 11
  ? 'включающий' : 'включающих';
const description = seoMeta.description
  + (pagination.currentPage > 1 ? ' Страница ' + pagination.currentPage + ' из ' + pagination.totalPages
    + ', маршруты ' + pagination.from + '–' + pagination.to + ' из ' + pagination.totalItems + '.' : '');
const absolute = (path: string) => new URL(withBase(path), Astro.site ?? 'https://adatours.ru/').toString();
const itemList = {
  '@type': 'ItemList',
  '@id': absolute(pagination.canonical) + '#catalog',
  name: baseTitle,
  numberOfItems: entries.length,
  itemListElement: entries.map((entry, index) => ({
    '@type': 'ListItem',
    position: pagination.offset + index + 1,
    name: entry.data.title,
    url: absolute(tourPath(entry.data)),
  })),
};
---

<BaseLayout
  leadTitle={(uiLocale==='en'?'Plan an itinerary: ':'Собрать маршрут: ') + countriesText}
  leadEntityId={catalogId}
  title={baseTitle + pageSuffix}
  description={description}
  canonical={pagination.canonical}
  image={hero}
  pageSchema={itemList}
  breadcrumbs={pageBreadcrumbs}
>
  <Hero
    eyebrow="Multi-country"
    title={heading + (pagination.currentPage > 1 ? (uiLocale==='en'?' — page ':' — страница ') + pagination.currentPage : '')}
    intro={uiLocale==='en'
      ? (themeName ? themeName + '. ' : '') + (slugs.length ? 'Choose an itinerary visiting ' + countriesText + '. ' : 'Choose a journey across several countries. ') + 'Compare the duration and style of the available programmes.'
      : (theme ? theme.name + '. ' : '') + (slugs.length ? 'Выберите маршрут, включающий страны: ' + countriesText + '. ' : 'Выберите путешествие по нескольким странам. ') + 'Сравните длительность и формат готовых программ.'}
    image={hero}
    compact
    ctaHref="#request"
    ctaLabel="Собрать свой маршрут"
  />

  <section class="combination-tours section" aria-labelledby="combination-tours-title">
    <div class="container combination-tours__head">
      <p class="eyebrow">Выбрать путешествие</p>
      <h2 id="combination-tours-title">{theme ? countriesText + ': ' + themeName : countriesText}</h2>
      <p>{uiLocale==='en'
        ? `${countInEnglish(pagination.totalItems,'matching tour','matching tours')} ${slugs.length?'visiting these countries':'through several countries in one journey'}.`
        : `${matchingTourPhrase}, ${matchingTourAgreement} ${slugs.length ? 'посещение этих стран' : 'несколько стран в одной поездке'}.`}</p>
    </div>

    <MultiCountrySelector selected={slugs} themeId={theme?.id} />

    {pagination.currentPage > 1 && (
      <div class="container combination-tours__back">
        <a href={withBase(pagination.rootPath)}>{uiLocale==='en'?'← Back to the first page of this selection':'← На первую страницу этой подборки'}</a>
      </div>
    )}

    <div
      data-catalog-root
      data-catalog-key={pagination.rootPath}
      data-catalog-version={catalogVersion}
      data-catalog-page={pagination.currentPage}
      data-catalog-from={pagination.from}
      data-catalog-to={pagination.to}
      data-catalog-total={pagination.totalItems}
    >
      <div id="catalog-items" data-catalog-items>
        {entries.map((entry, index) => {
          const data = entry.data;
          const countryNames = mainTourCountries(data)
            .sort((a, b) => a.slug.localeCompare(b.slug, 'en'))
            .map((country) => countryDisplayNames.get(country.id) ?? country.name);
          const countryLabel = uiLocale === 'en' ? countryNames.join(' + ') : formatMultiCountryNames(countryNames);
          const meta = [
            countryLabel,
            data.durationDays ? uiLocale === 'en' ? countInEnglish(data.durationDays, 'day', 'days') : countLabel(data.durationDays, ['день', 'дня', 'дней']) : '',
            data._i18n?.formatLabel ?? data.format,
          ].filter(Boolean).join(' · ');
          return (
            <div data-catalog-item={data.id}>
              <DestinationBand
                headingTag="h3"
                eyebrow={meta}
                title={data.title}
                image={data.hero?.src}
                imageTextAlign={data.imageTextAlign}
                mediaStatus={data.hero?.status}
                replacementReason={data.hero?.replacementReason}
                href={tourPath(data)}
                align={(pagination.offset + index) % 2 === 1 ? 'right' : 'left'}
              />
            </div>
          );
        })}
      </div>
      <CatalogPagination pagination={pagination} />
    </div>
  </section>
  <MultiCountryRelated slugs={slugs} themeId={theme?.id} currentPath={pagination.rootPath}
    showAll={!slugs.length} />
</BaseLayout>

<script>
  import '../../scripts/catalog-load-more';
</script>

<style>
  .combination-tours { padding-bottom: 0; }
  .combination-tours__head { padding-bottom: var(--heading-gap); }
  .combination-tours__head h2 {
    max-width: 980px;
    margin: 12px 0 18px;
    overflow-wrap: anywhere;
  }
  .combination-tours__head > p:last-child {
    max-width: 760px;
    margin: 0;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
    font-size: var(--text-lg);
  }
  .combination-tours__back { padding: 16px 0 30px; }
  .combination-tours__back a { color: var(--color-ink); text-underline-offset: 4px; }
</style>


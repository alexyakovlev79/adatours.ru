---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import EditorialProof from '../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title="DMC по Бразилии и Латинской Америке"
  description="Ada Tours как принимающий партнер для турагентств и туроператоров по Бразилии и странам Латинской Америки."
>
  <Hero
    eyebrow="DMC / B2B"
    title="Ваш DMC-партнер в Бразилии и Латинской Америке"
    intro="Маршруты, отели, трансферы, гиды и локальная координация для FIT, групп, VIP и MICE."
    image="/media/prototype/rio-night.jpg"
    ctaLabel="Запросить предложение"
  />

  <EditorialStatement
    eyebrow="Для агентств"
    text="Вы общаетесь с одной командой. Мы собираем наземную часть поездки на месте."
  />

  <FactStrip
    facts={[
      { value: 'FIT', label: 'индивидуальные путешествия' },
      { value: 'Groups', label: 'групповые программы' },
      { value: 'MICE', label: 'деловые и корпоративные поездки' },
      { value: 'VIP', label: 'сложные частные запросы' },
    ]}
  />

  <EditorialProof
    eyebrow="География"
    title="Бразилия и маршруты по всему региону"
    text="Бразилия остается ключевым направлением Ada Tours. Для поездок по региону мы связываем перелеты, наземную часть и локальных партнеров в одну программу."
    image="/media/prototype/lencois.jpg"
    facts={[
      'Наземная программа и логистика',
      'Локальные гиды и транспорт',
      'Размещение и специальные запросы',
      'Координация multi-country маршрутов',
    ]}
  />

  <ProcessSteps
    eyebrow="Как строится запрос"
    title="Запрос. Расчет. Подтверждение. Поездка."
    steps={[
      { title: 'Запрос', text: 'Даты, география, состав группы, бюджет и обязательные элементы.' },
      { title: 'Маршрут', text: 'Города, перелеты, трансферы и наземная часть в одной схеме.' },
      { title: 'Предложение', text: 'Программа и расчет с четкими включениями после сверки доступности.' },
      { title: 'На месте', text: 'Одна команда координирует подрядчиков и изменения по ходу поездки.' },
    ]}
    dark
  />

  <section class="dmc-paths section--tight">
    <div class="container dmc-paths__grid">
      <div>
        <p class="eyebrow">B2B</p>
        <h2>Для партнеров</h2>
      </div>
      <nav aria-label="Разделы DMC">
        <a href={withBase("/dmc/dlya-turagentstv/")}>Для турагентств и туроператоров <span aria-hidden="true">↗</span></a>
        <a href={withBase("/dmc/usloviya-raboty/")}>Условия работы <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </section>

  <LeadForm title="Запросить B2B-предложение" entityId="dmc" />
</BaseLayout>


<style>
  .dmc-paths {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .dmc-paths__grid {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: clamp(40px, 8vw, 120px);
    align-items: start;
  }

  .dmc-paths h2 {
    margin: 12px 0 0;
  }

  .dmc-paths nav {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .dmc-paths nav a {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  @media (max-width: 760px) {
    .dmc-paths__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

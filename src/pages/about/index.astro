---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import EditorialProof from '../../components/proof/EditorialProof.astro';
import PersonProfile from '../../components/proof/PersonProfile.astro';
import { ORG } from '../../data/organization/ada-tours';

const people = await getCollection('people', ({ data }) => data.id === 'person_anna' && data.locale === 'ru');
const anna = people[0];
const AnnaContent = anna ? (await render(anna)).Content : null;
---

<BaseLayout leadTitle="Обсудить поездку или партнерство" leadEntityId="about"
  title="Ada Tours - DMC из Рио-де-Жанейро для Бразилии и Латинской Америки"
  description="Ada Tours организует индивидуальные, VIP, MICE и multi-country поездки по Бразилии и Латинской Америке и работает с туроператорами и турагентствами."
>
  <Hero
    eyebrow="Ada Tours · DMC · Рио-де-Жанейро"
    title="Латинская Америка, собранная на месте"
    intro="Ada Tours проектирует частные путешествия, VIP, MICE, деловые делегации и маршруты по нескольким странам для путешественников, туроператоров и турагентств."
    image="/media/catalog/tury/hero-enhanced-20260930.webp"
    ctaLabel="Обсудить поездку"
  />

  <EditorialStatement
    eyebrow="Где мы работаем"
    text="Мы работаем из Рио-де-Жанейро. Бразилия для Ada Tours - домашняя территория; Аргентина, Перу и другие страны региона продолжают маршрут, когда поездке нужна большая география."
  />

  <FactStrip
    wideFirst
    facts={[
      { value: 'Рио-де-Жанейро', label: 'база команды Ada Tours' },
      { value: String(ORG.service.languages.length), label: 'языков коммуникации' },
      { value: ORG.service.groups.standard.display, label: 'человек в обычной группе' },
      { value: ORG.service.groups.largeEvents.display, label: 'участников крупных событий' },
    ]}
  />

  <EditorialProof
    eyebrow="Частные путешествия"
    title="Маршрут начинается с человека"
    text="Даты, темп, интересы и уровень сервиса определяют программу. Ada Tours собирает индивидуальные и VIP-поездки, а при необходимости соединяет несколько стран в один маршрут."
    image="/media/home/lencois-enhanced-20260930.webp"
    facts={[
      'Индивидуальные маршруты по Бразилии и Латинской Америке',
      'VIP / Luxury',
      'Multi-country путешествия',
      'Поездки вокруг конкретного интереса',
    ]}
  />

  <EditorialProof
    eyebrow="DMC / B2B / MICE"
    title="От агентского запроса до события на 500 человек"
    text="Ada Tours работает с зарубежными туроператорами и турагентствами, MICE-агентствами, корпоративными группами и делегациями. В Бразилии мы связываем размещение, транспорт, площадки, переводчиков и встречи в одну программу."
    image="/media/home/rio-night-enhanced-20260930.webp"
    facts={[
      ...ORG.business.b2bPartnerTypes,
      'Корпоративные группы и делегации',
    ]}
    reverse
  />

  <EditorialStatement
    eyebrow="Кто стоит за Ada Tours"
    text="В основе подхода Ada Tours - личный опыт Анны Аванесовой в Латинской Америке: от самостоятельных наземных маршрутов до работы с VIP, группами, MICE и международными партнерами."
  />

  {anna && AnnaContent && (
    <PersonProfile
      name={anna.data.name}
      role={anna.data.role}
      photo={anna.data.photo}
      expertise={anna.data.expertise}
      href={`/team/${anna.data.slug}/`}
      eyebrow="Основатель"
    >
      <AnnaContent />
    </PersonProfile>
  )}

</BaseLayout>

---
import PrimaryCTA from '../global/PrimaryCTA.astro';

interface Props {
  price?: string;
  ctaLabel?: string;
  // Kept for backward compatibility with existing content/component calls.
  // Tour price notes are intentionally not rendered in the public pricing block.
  note?: string;
}
const { price = 'По запросу', ctaLabel = 'Заказать этот тур' } = Astro.props;
---

<section class="pricing section">
  <div class="container pricing__grid">
    <div>
      <p class="eyebrow">Стоимость</p>
      <h2>{price}</h2>
    </div>
    <div class="pricing__copy">
      <PrimaryCTA href="/contacts/" label={ctaLabel} variant="gold" />
    </div>
  </div>
</section>

<style>
  .pricing {
    /* Inverse of the previous gold block: dark surface, golden primary action. */
    background: var(--color-ink-deep);
    color: var(--color-bg);
    padding-top: clamp(32px, 4vw, 56px);
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: clamp(48px, 8vw, 120px);
    align-items: end;
  }

  .pricing h2 {
    margin: 12px 0 0;
    font-size: clamp(3rem, 2rem + 3.2vw, 5.5rem);
    line-height: .92;
  }

  .pricing__copy {
    max-width: 500px;
  }

  .pricing :global(.cta) {
    margin-top: 0;
  }

  @media (max-width: 760px) {
    .pricing__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

    {
      "blockId": "tour:contentBlock_text:977511f6f9f04ae3",
      "field": "contentBlock.text",
      "sourceTextSha256": "3659d046979a9142ce79f11518b7157d03e7a7a4dc3721f2f89b17527de9b330",
      "text": "Join a 4-hour group city tour and visit to Sugarloaf Mountain with an English-speaking guide.\nWe drive to Praia Vermelha (Red Beach), where you take the cable car up towards the summit of Sugarloaf Mountain. Your first stop is Morro da Urca, which has a wide viewing platform. The smaller platform on Sugarloaf itself overlooks Rio, Copacabana Beach, the bay, the surrounding mountains, islands in the ocean, the bridge to Niterói and the Christ the Redeemer statue.\nYou then head into the historic centre of Rio, where you can see several old churches, monasteries, the city's main cathedral and colonial-style buildings.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw9tridg-7fvtasls9c",
        "model": "GPT-6.1"
      }
    },
    {

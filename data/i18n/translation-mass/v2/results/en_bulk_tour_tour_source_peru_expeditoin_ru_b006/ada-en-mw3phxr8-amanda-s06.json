    {
      "blockId": "tour:itinerary_text:ec46e3209ab74818",
      "field": "itinerary.text",
      "sourceTextSha256": "2afc354363e28f533e4bfe31016fc39668cd895b065560d5d3a966b2d126de87",
      "text": "A day in the most outstanding sites of the Sacred Valley. First, Chinchero, the most typical and picturesque town of the valley, with its Inca archaeological complex and beautiful colonial church; it is also famous for its weavers, who may show you the ancient Inca techniques for dyeing and spinning alpaca wool. Continue to Moray, a remarkable Inca complex of colossal concentric terraces resembling a large amphitheatre, which served as an agricultural laboratory where different microclimates were recreated. Buffet lunch at a local restaurant, then Ollantaytambo, a military, religious and agricultural centre of the Incas, with the Temple of the Ten Windows, the Ñusta’s Baths and the Temple of the Sun. Overnight in the Sacred Valley.",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1XrZzfxaD87HpTT-eN2AroxoaHB_haPhZ",
        "documentSha256": "90d9d277cfc4f1997307081e08ca6496b6cbe32f9f53f5179fe064857a36b8be",

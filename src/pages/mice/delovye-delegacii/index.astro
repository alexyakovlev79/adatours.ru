---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/editorial/Hero.astro';
import EditorialStatement from '../../../components/editorial/EditorialStatement.astro';
import EditorialProof from '../../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../../components/proof/ProcessSteps.astro';
import LeadForm from '../../../components/forms/LeadForm.astro';
---

<BaseLayout
  title="Деловые делегации в Бразилию и Латинскую Америку"
  description="Организация деловых делегаций: логистика, встречи, транспорт, переводчики и программа в Бразилии и Латинской Америке."
>
  <Hero
    eyebrow="MICE · Деловые делегации"
    title="Когда расписание встреч важнее туристической программы"
    intro="Деловая часть задает каркас поездки. Все остальное — перелеты, размещение, транспорт, питание и свободное время — должно работать вокруг нее."
    image="/media/prototype/rio-night.jpg"
    ctaLabel="Обсудить делегацию"
  />

  <EditorialStatement
    eyebrow="DMC coordination"
    text="Хорошая делегация незаметна по логистике: участники успевают на встречи, транспорт приходит вовремя, а изменения не ломают весь день."
  />

  <EditorialProof
    eyebrow="На месте"
    title="Один координатор видит всю программу"
    text="Маршрут строится так, чтобы деловые встречи, перемещения и вечерняя часть не конкурировали друг с другом. Если график меняется, корректируется не один трансфер, а вся связанная цепочка."
    image="/media/prototype/buenos-aires.jpg"
    facts={[
      'Аэропорт и городские трансферы',
      'Районы размещения рядом с деловой программой',
      'Переводчики и сопровождающие по запросу',
      'Рестораны, мероприятия и экскурсии после встреч',
    ]}
    reverse
  />

  <ProcessSteps
    eyebrow="Подготовка"
    title="4 компонента одной деловой поездки"
    steps={[
      { title: 'Встречи', text: 'Фиксируем обязательную деловую сетку и точные адреса.' },
      { title: 'Время', text: 'Считаем реальное время дорог и резерв между точками.' },
      { title: 'Сервис', text: 'Добавляем транспорт, сопровождающих, питание и размещение.' },
      { title: 'Свободная часть', text: 'Заполняем оставшееся время без риска для деловой программы.' },
    ]}
  />

  <LeadForm title="Запросить программу делегации" entityId="mice_business_delegations" />
</BaseLayout>

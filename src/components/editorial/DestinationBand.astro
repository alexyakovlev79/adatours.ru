---
import { withBase } from '../../lib/paths';
import InlineMarkdown from '../global/InlineMarkdown.astro';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  href: string;
  image?: string;
  align?: 'left' | 'right';
  mediaStatus?: 'approved' | 'needs_replacement' | 'replaced';
  replacementReason?: string;
  descriptionBelow?: boolean;
}

const {
  eyebrow,
  title,
  text,
  href,
  image,
  align = 'left',
  mediaStatus,
  replacementReason,
  descriptionBelow = false,
} = Astro.props;

const resolvedImage = image ? withBase(image) : undefined;
const style = resolvedImage ? `--band-image: url("${resolvedImage}")` : undefined;
const resolvedHref = withBase(href);
---

{descriptionBelow ? (
  <a
    class:list={['band-card', `band-card--${align}`]}
    href={resolvedHref}
    data-media-status={mediaStatus ?? (image ? 'legacy' : undefined)}
    data-replacement-reason={replacementReason}
  >
    {resolvedImage
      ? <img class="band-card__media" src={resolvedImage} alt="" aria-hidden="true" loading="lazy" referrerpolicy="no-referrer" />
      : <span class="band-card__media" aria-hidden="true"></span>}
    <span class="band-card__overlay" aria-hidden="true"></span>
    {eyebrow && <span class="band-card__eyebrow eyebrow">{eyebrow}</span>}
    <strong class="band-card__title">{title}</strong>
    {text && <span class="band-card__description"><InlineMarkdown text={text} /></span>}
    <span class="band-card__link">Смотреть <span aria-hidden="true">↗</span></span>
  </a>
) : (
  <a class:list={['band', `band--${align}`, { 'band--image': image }]} href={resolvedHref} style={style}
    data-media-status={mediaStatus ?? (image ? 'legacy' : undefined)}
    data-replacement-reason={replacementReason}
  >
    <div class="band__overlay"></div>
    <div class="band__content">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      {text && <p class="band__text"><InlineMarkdown text={text} /></p>}
      <span class="band__link">Смотреть <span aria-hidden="true">↗</span></span>
    </div>
  </a>
)}

<style>
  /* Full-width tour card used on country pages. On desktop all copy stays over
     the hero. On mobile only the description moves below the image. */
  .band-card {
    position: relative;
    display: grid;
    grid-template-columns:
      minmax(var(--gutter), 1fr)
      minmax(0, var(--container-max))
      minmax(var(--gutter), 1fr);
    grid-template-rows: minmax(0, 1fr) auto auto auto auto 0;
    min-height: clamp(440px, 55vw, 680px);
    overflow: hidden;
    color: var(--color-bg);
    background:
      radial-gradient(circle at 75% 25%, rgba(242, 204, 103, .2), transparent 28%),
      linear-gradient(135deg, #45463e, #171815);
    isolation: isolate;
  }

  .band-card__media,
  .band-card__overlay {
    position: absolute;
    inset: 0;
  }

  .band-card__media {
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    background:
      radial-gradient(circle at 75% 25%, rgba(242, 204, 103, .2), transparent 28%),
      linear-gradient(135deg, #45463e, #171815);
  }

  .band-card__overlay {
    z-index: -1;
    background: linear-gradient(90deg, rgba(10,10,9,.7), rgba(10,10,9,.08) 72%);
    transition: background 350ms var(--ease-out);
  }

  .band-card:hover .band-card__overlay {
    background: linear-gradient(90deg, rgba(10,10,9,.78), rgba(10,10,9,.14) 72%);
  }

  .band-card__eyebrow,
  .band-card__title,
  .band-card__description,
  .band-card__link {
    grid-column: 2;
    justify-self: start;
    max-width: 1120px;
  }

  .band-card__eyebrow {
    grid-row: 2;
    align-self: end;
    margin: 0 0 10px;
  }

  .band-card__title {
    grid-row: 3;
    display: block;
    max-width: 1120px;
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 3vw, 3.65rem);
    font-weight: 400;
    line-height: 1.04;
  }

  .band-card__description {
    grid-row: 4;
    display: block;
    max-width: 700px;
    margin: 0 0 24px;
    color: rgba(255,255,255,.84);
    font-size: clamp(.98rem, 1.2vw, 1.12rem);
    line-height: 1.5;
  }

  .band-card__link {
    grid-row: 5;
    display: inline-flex;
    gap: 28px;
    align-items: center;
    margin-bottom: clamp(34px, 4vw, 58px);
    padding-bottom: 7px;
    border-bottom: 1px solid currentColor;
    font-family: var(--font-display);
    font-size: .76rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .band-card--right .band-card__eyebrow,
  .band-card--right .band-card__title,
  .band-card--right .band-card__description,
  .band-card--right .band-card__link {
    justify-self: end;
    text-align: right;
  }

  .band {
    position: relative;
    display: grid;
    min-height: clamp(440px, 55vw, 680px);
    overflow: hidden;
    color: var(--color-bg);
    background:
      radial-gradient(circle at 75% 25%, rgba(242, 204, 103, .2), transparent 28%),
      linear-gradient(135deg, #45463e, #171815);
    isolation: isolate;
  }

  .band--image {
    background-image: var(--band-image);
    background-size: cover;
    background-position: center;
  }

  .band__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(10,10,9,.7), rgba(10,10,9,.08) 72%);
    transition: background 350ms var(--ease-out);
  }

  .band:hover .band__overlay {
    background: linear-gradient(90deg, rgba(10,10,9,.78), rgba(10,10,9,.14) 72%);
  }

  .band__content {
    align-self: end;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
    padding-block: clamp(48px, 6vw, 86px);
  }

  .band--right .band__content {
    text-align: right;
  }

  .band h2 {
    max-width: 920px;
    margin: 10px 0 18px;
  }

  .band--right h2,
  .band--right .band__text {
    margin-left: auto;
  }

  .band__text {
    max-width: 580px;
    margin-bottom: 26px;
    color: rgba(255,255,255,.84);
  }

  .band__link {
    display: inline-flex;
    gap: 28px;
    align-items: center;
    padding-bottom: 7px;
    border-bottom: 1px solid currentColor;
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .band-card {
      display: grid;
      grid-template-columns: var(--gutter) minmax(0, 1fr) var(--gutter);
      grid-template-rows: 320px auto;
      min-height: 0;
      overflow: visible;
      color: var(--color-ink);
      background: var(--color-bg);
    }

    .band-card__media,
    .band-card__overlay {
      position: static;
      grid-column: 1 / -1;
      grid-row: 1;
      inset: auto;
    }

    .band-card__media {
      z-index: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      object-fit: cover;
      object-position: center;
    }

    .band-card__overlay {
      z-index: 1;
      background: linear-gradient(180deg, rgba(8,9,8,.04) 20%, rgba(8,9,8,.72) 100%);
    }

    .band-card__eyebrow {
      display: none;
    }

    .band-card__title,
    .band-card__link {
      grid-column: 2;
      grid-row: 1;
      z-index: 2;
      justify-self: start;
      color: #fff;
      text-align: left;
    }

    .band-card__title {
      align-self: end;
      max-width: 100%;
      margin: 0 0 70px;
      font-size: clamp(1.7rem, 7.2vw, 2.35rem);
      line-height: 1.06;
    }

    .band-card__link {
      align-self: end;
      margin: 0 0 24px;
    }

    .band-card__description,
    .band-card--right .band-card__description {
      grid-column: 2;
      grid-row: 2;
      z-index: 0;
      justify-self: stretch;
      max-width: none;
      margin: 0;
      padding-block: 18px 24px;
      color: color-mix(in srgb, var(--color-ink) 76%, transparent);
      font-size: 1rem;
      line-height: 1.5;
      text-align: left;
      background: var(--color-bg);
    }

    .band-card--right .band-card__title,
    .band-card--right .band-card__link {
      justify-self: start;
      text-align: left;
    }
  }
</style>

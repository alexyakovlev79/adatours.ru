          {
            "ref": "word/document.xml:w:p[9]",
            "textSha256": "46f325bb9932f97eab2db0faa7507c33eb583f79a713f322bc94114a1ed67ebc",
            "text": "You will get acquainted with the capital of Venezuela — Caracas,"
          },
          {

---
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/global.css';
import '../styles/image-text-align.css';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import SearchOverlay from '../components/global/SearchOverlay.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import { SITE } from '../lib/site';
import { withBase } from '../lib/paths';
import { expandBreadcrumbTrails, type BreadcrumbItem } from '../lib/routes';
import { ORG } from '../data/organization/ada-tours';
import { validateSiteContent } from '../lib/content-validation';

await validateSiteContent();

interface Props {
  leadTitle?: string;
  leadEntityId?: string;
  leadTourId?: string;
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  lang?: string;
  headerTheme?: 'light' | 'dark';
  noindex?: boolean;
  showBreadcrumbs?: boolean;
  hideCurrentBreadcrumbLabel?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  pageSchema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  leadTitle,
  leadEntityId,
  leadTourId,
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical,
  image,
  lang = SITE.locale,
  headerTheme = 'light',
  noindex = false,
  showBreadcrumbs = true,
  hideCurrentBreadcrumbLabel = false,
  breadcrumbs,
  pageSchema,
} = Astro.props;

const canonicalUrl = canonical
  ? new URL(withBase(canonical), Astro.site ?? SITE.url).toString()
  : new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const fullTitle = title.includes('Ada Tours') ? title : `${title} | Ada Tours`;
const isPreview = import.meta.env.BASE_URL !== '/';
const faviconSvgUrl = withBase('/favicon.svg');
const favicon48Url = withBase('/favicon-48x48.png');
const favicon32Url = withBase('/favicon-32x32.png');
const favicon16Url = withBase('/favicon-16x16.png');
const faviconIcoUrl = withBase('/favicon.ico');
const appleTouchIconUrl = withBase('/apple-touch-icon.png');
const ogImageUrl = image ? new URL(withBase(image), Astro.site ?? SITE.url).toString() : undefined;

const base = import.meta.env.BASE_URL || '/';
const normalizedBase = base.endsWith('/') ? base : `${base}/`;
let logicalPath = Astro.url.pathname;
if (normalizedBase !== '/' && logicalPath.startsWith(normalizedBase)) {
  logicalPath = `/${logicalPath.slice(normalizedBase.length)}`;
}
if (!logicalPath.startsWith('/')) logicalPath = `/${logicalPath}`;

const segments = logicalPath.split('/').filter(Boolean);
const breadcrumbLabels: Record<string, string> = {
  country: 'Страны',
  tours: 'Туры',
  excursions: 'Экскурсии',
  places: 'Направления',
  'interests': 'По интересам',
  dmc: 'Для агентств',
  'travel-agencies': 'Для турагентств',
  'terms': 'Условия работы',
  mice: 'MICE',
  'business-delegations': 'Деловые делегации',
  vip: 'VIP',
  'multi-country': 'Multi-country',
  about: 'О нас',
  team: 'Команда',
  contacts: 'Контакты',
  cases: 'Кейсы',
  reviews: 'Отзывы',
  articles: 'Статьи',
  brazil: 'Бразилия',
  argentina: 'Аргентина',
  peru: 'Перу',
  'rio-de-janeiro': 'Рио-де-Жанейро',
  'foz-do-iguacu': 'Игуасу',
  'manaus-amazon': 'Амазония',
  pantanal: 'Пантанал',
  'buenos-aires': 'Буэнос-Айрес',
  'el-calafate': 'Эль-Калафате',
  mendoza: 'Мендоса',
  cusco: 'Куско',
  'machu-picchu': 'Мачу-Пикчу',
  lima: 'Лима',
};

const pageTitle = title.replace(/\s*[|–—-]\s*Ada Tours.*$/i, '').trim();
const breadcrumbItems = [
  { name: 'Главная', url: new URL(withBase('/'), Astro.site ?? SITE.url).toString() },
  ...segments.map((segment, index) => ({
    name: breadcrumbLabels[segment] ?? (index === segments.length - 1 ? pageTitle : segment.replace(/-/g, ' ')),
    url: new URL(
      withBase(`/${segments.slice(0, index + 1).join('/')}/`),
      Astro.site ?? SITE.url,
    ).toString(),
  })),
];

const schemaBreadcrumbTrails = breadcrumbs?.length
  ? expandBreadcrumbTrails(breadcrumbs).map((trail) => trail.map((item) => ({
      name: item.label,
      url: new URL(withBase(item.href), Astro.site ?? SITE.url).toString(),
    })))
  : [breadcrumbItems];

const organizationSchema = {
  '@type': ['Organization', 'TravelAgency'],
  '@id': `${SITE.url}/#organization`,
  name: ORG.brand,
  legalName: ORG.legal.name,
  url: SITE.url,
  email: ORG.contacts.email,
  telephone: ORG.contacts.phoneDisplay,
  sameAs: Object.values(ORG.externalProfiles),
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'CNPJ',
    value: ORG.legal.cnpj,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: ORG.legal.streetAddress,
    addressLocality: ORG.legal.addressLocality,
    addressRegion: ORG.legal.addressRegion,
    postalCode: ORG.legal.postalCode,
    addressCountry: ORG.legal.addressCountry,
  },
};

const webSiteSchema = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  inLanguage: lang,
  publisher: { '@id': `${SITE.url}/#organization` },
};

const webPageSchema = {
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: fullTitle,
  description,
  inLanguage: lang,
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#organization` },
};

const breadcrumbSchemas = (segments.length > 0 || Boolean(breadcrumbs?.length)) ? schemaBreadcrumbTrails.map((trail, trailIndex) => ({
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumb${trailIndex ? `-${trailIndex + 1}` : ''}`,
  itemListElement: trail.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
})) : [];

const extraSchemas = !pageSchema ? [] : (Array.isArray(pageSchema) ? pageSchema : [pageSchema]);
const graph = [
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  ...breadcrumbSchemas,
  ...extraSchemas,
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={faviconSvgUrl} />
    <link rel="icon" type="image/png" sizes="48x48" href={favicon48Url} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32Url} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16Url} />
    <link rel="shortcut icon" href={faviconIcoUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
    {(isPreview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="theme-color" content="#131412" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    <SiteHeader theme={headerTheme} />
    <SearchOverlay />
    {showBreadcrumbs && !noindex && segments.length > 0 && (
      <Breadcrumbs
        pathname={Astro.url.pathname}
        title={title}
        theme={headerTheme}
        items={breadcrumbs}
        hideCurrentLabel={hideCurrentBreadcrumbLabel}
      />
    )}
    <main>
      <slot />
      <div id="request" data-lead-location="footer" data-interest-section={leadEntityId?.startsWith('theme_') ? 'cta' : undefined} data-pagefind-ignore>
        <LeadForm title={leadTitle} entityId={leadEntityId || logicalPath} tourId={leadTourId} pageUrl={canonicalUrl} locale={lang} />
      </div>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  #request { scroll-margin-top: 100px; }
</style>

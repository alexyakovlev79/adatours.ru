---
import { getCollection } from 'astro:content';
import { isActiveEntity } from '../../lib/archive.mjs';
import { withBase } from '../../lib/paths';
import AuthorityInline from '../authority/AuthorityInline.astro';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  intro?: string;
  caseIds: string[];
  summaries?: Record<string, string>;
}
const { id, title, eyebrow = 'Выполненные проекты', intro, caseIds, summaries = {} } = Astro.props;
const byId = new Map((await getCollection('cases', ({ data }) => data.locale === 'ru' && isActiveEntity(data))).map(entry => [entry.data.id, entry]));
const entries = caseIds.map(caseId => {
  const entry = byId.get(caseId);
  if (!entry) throw new Error(`Commercial case missing: ${caseId}`);
  return entry;
});
---

<section class="commercial-cases section" aria-labelledby={id}>
  <div class="container">
    <header>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={id}>{title}</h2>
      {intro && <p class="commercial-cases__intro"><AuthorityInline text={intro} /></p>}
    </header>
    <div class:list={['commercial-cases__grid', { 'commercial-cases__grid--single': entries.length === 1, 'commercial-cases__grid--three': entries.length === 3 }]}>
      {entries.map(({ data }) => (
        <article class="commercial-case">
          <a class="commercial-case__photo" href={withBase(`/cases/${data.slug}/`)} tabindex="-1" aria-hidden="true">
            {data.hero?.src && <img src={withBase(data.hero.src)} alt="" width="960" height="640" loading="lazy" decoding="async" />}
          </a>
          <div class="commercial-case__body">
            <p class="commercial-case__meta">{[data.groupSize, data.year, data.segment].filter(Boolean).join(' · ')}</p>
            <h3><a href={withBase(`/cases/${data.slug}/`)}>{data.title}</a></h3>
            <p>{summaries[data.id] ?? data.summary}</p>
            <a class="commercial-case__link" href={withBase(`/cases/${data.slug}/`)}>Задача и работа команды <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .commercial-cases { background: var(--color-bg-alt, #f4f2ec); }
  header { max-width: 980px; margin-bottom: 30px; }
  h2 { margin: 10px 0 18px; font-size: clamp(2rem, 3.3vw, 3.6rem); line-height: 1.1; }
  .commercial-cases__intro { max-width: 820px; color: var(--color-text-muted); }
  .commercial-cases__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(22px, 3vw, 44px); }
  .commercial-cases__grid--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .commercial-case { background: var(--color-bg); }
  .commercial-case__photo { display: block; overflow: hidden; }
  .commercial-case__photo img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; transition: transform .3s ease; }
  .commercial-case:hover .commercial-case__photo img { transform: scale(1.025); }
  .commercial-case__body { padding: clamp(22px, 2.5vw, 34px); }
  .commercial-case__meta { margin: 0 0 12px; font-size: .78rem; line-height: 1.5; color: var(--color-brand-deep); }
  h3 { margin: 0 0 16px; font-size: clamp(1.4rem, 1.8vw, 2rem); line-height: 1.2; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--color-brand-deep); }
  .commercial-case__body > p:not(.commercial-case__meta) { margin: 0 0 22px; color: var(--color-text-muted); line-height: 1.6; }
  .commercial-case__link { display: inline-flex; align-items: baseline; gap: 12px; color: var(--color-brand-deep); font-size: .93rem; text-underline-offset: .2em; }
  .commercial-cases__grid--single { grid-template-columns: 1fr; }
  .commercial-cases__grid--single .commercial-case { display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; }
  .commercial-cases__grid--single .commercial-case__photo img { height: 100%; min-height: 290px; }
  @media (min-width: 761px) and (max-width: 1100px) {
    .commercial-cases__grid--three { grid-template-columns: 1fr; }
    .commercial-cases__grid--three .commercial-case { display: grid; grid-template-columns: minmax(230px, .7fr) minmax(0, 1fr); }
    .commercial-cases__grid--three .commercial-case__photo img { height: 100%; }
  }
  @media (max-width: 760px) { .commercial-cases__grid, .commercial-cases__grid--single .commercial-case { grid-template-columns: 1fr; } .commercial-cases__grid--single .commercial-case__photo img { min-height: 0; height: auto; } }
  @media (prefers-reduced-motion: reduce) { .commercial-case__photo img { transition: none; } .commercial-case:hover .commercial-case__photo img { transform: none; } }
</style>

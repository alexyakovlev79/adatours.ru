---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/editorial/Hero.astro';
import EditorialStatement from '../components/editorial/EditorialStatement.astro';
import StoryPair from '../components/editorial/StoryPair.astro';
import TripStats from '../components/tour/TripStats.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import DestinationBand from '../components/editorial/DestinationBand.astro';
import SearchIndexRecord from '../components/global/SearchIndexRecord.astro';
import { withBase } from '../lib/paths';

const { entry } = Astro.props;
const d = entry.data;
const [tourEntries, countryEntries] = await Promise.all([
  getCollection('tours', ({ data }) =>
    data.locale === 'ru' &&
    !['draft', 'archived'].includes(data.status) &&
    data.destinations.includes(d.id)
  ),
  getCollection('countries', ({ data }) => data.locale === 'ru' && data.id === d.countryId),
]);

const relatedTours = tourEntries
  .sort((a, b) => (b.data.priority ?? 0) - (a.data.priority ?? 0))
  .slice(0, 3);
const country = countryEntries[0];
const countryName = country?.data.name ?? '';

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://adatours.ru').toString();
const countryUrl = country
  ? new URL(withBase(`/strany/${country.data.slug}/`), Astro.site ?? 'https://adatours.ru').toString()
  : undefined;

const destinationSchema = {
  '@type': 'TouristDestination',
  '@id': `${pageUrl}#destination`,
  name: d.name,
  description: d.summary,
  url: pageUrl,
  ...(d.hero?.src ? { image: d.hero.src } : {}),
  ...(country && countryUrl ? {
    containedInPlace: {
      '@type': 'Country',
      '@id': `${countryUrl}#country`,
      name: country.data.name,
      url: countryUrl,
    },
  } : {}),
};
---

<BaseLayout
  title={`${d.name}: туры и экскурсии`}
  description={d.summary}
  image={d.hero?.src}
  pageSchema={destinationSchema}
>
  <SearchIndexRecord
    title={d.name}
    summary={d.summary}
    entityType="destination"
    typeLabel="Место"
    subtitle={countryName ? `Место · ${countryName}` : 'Место'}
    aliases={d.searchAliases}
    geography={[d.name, countryName].filter(Boolean)}
    themes={d.themes}
    image={d.hero?.src}
  />

  <Hero
    eyebrow="Направление"
    title={d.name}
    intro={d.summary}
    image={d.hero?.src}
    ctaLabel="Собрать поездку"
  />

  {d.facts.length > 0 && <TripStats stats={d.facts} />}

  <EditorialStatement eyebrow="Город в маршруте" text={d.summary} />

  <section class="destination-copy section--tight">
    <div class="container prose">
      <slot />
    </div>
  </section>

  {d.featureBands.map((band, index) => (
    <StoryPair
      eyebrow={band.eyebrow}
      title={band.title}
      text={band.text}
      image={band.image}
      reverse={index % 2 === 1}
    />
  ))}

  {relatedTours.length > 0 && (
    <>
      <EditorialStatement eyebrow="Маршруты" text={`Туры через ${d.name}`} />
      {relatedTours.map((tour, index) => (
        <DestinationBand
          eyebrow={[tour.data.durationDays ? `${tour.data.durationDays} дней` : '', tour.data.format ?? ''].filter(Boolean).join(' · ')}
          title={tour.data.title}
          text={tour.data.lead}
          image={tour.data.hero?.src}
          href={`/tury/${tour.data.slug}/`}
          align={index % 2 === 1 ? 'right' : 'left'}
        />
      ))}
    </>
  )}

  <LeadForm title={`Собрать поездку: ${d.name}`} entityId={d.id} />
</BaseLayout>

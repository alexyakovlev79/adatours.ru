---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/editorial/Hero.astro';
import EditorialStatement from '../components/editorial/EditorialStatement.astro';
import DestinationBand from '../components/editorial/DestinationBand.astro';
import StoryPair from '../components/editorial/StoryPair.astro';
import LeadForm from '../components/forms/LeadForm.astro';

const [brazil] = await getCollection('countries', ({ data }) =>
  data.id === 'country_brazil' && data.locale === 'ru' && !['draft', 'archived'].includes(data.status)
);
---

<BaseLayout
  title="Ada Tours — путешествия по Бразилии и Латинской Америке"
  description="Индивидуальные путешествия, VIP, MICE и DMC по Бразилии и Латинской Америке."
>
  <Hero
    eyebrow="Ada Tours · Brazil & Latin America"
    title="Латинская Америка, собранная под вас"
    intro="Индивидуальные маршруты по Бразилии и Латинской Америке, VIP-поездки, MICE и работа с турагентствами. Локальную часть программы координирует Ada Tours."
    image="/media/catalog/tury/hero-enhanced-20260930.webp"
    ctaLabel="Обсудить поездку"
  />

  <EditorialStatement
    eyebrow="Путешествия"
    text="От Рио до Патагонии. Маршрут строится вокруг ваших дат, интересов и желаемого уровня сервиса."
  />

  <DestinationBand
    eyebrow="Направление №1"
    title="Бразилия"
    text="Рио, Игуасу, Амазония, Пантанал и побережье в десятках сочетаний."
    href="/braziliya/"
    image="/media/home/lencois-enhanced-20260930.webp"
    imageTextAlign={brazil?.data.imageTextAlign}
  />

  <StoryPair
    eyebrow="Аргентина"
    title="Город, вино и Патагония"
    text="Буэнос-Айрес можно соединить с Мендосой, ледниками, Ушуайей или продолжением маршрута в Чили."
    image="/media/home/patagonia-enhanced-20260930.webp"
    reverse
  />

  <DestinationBand
    eyebrow="Multi-country"
    title="Несколько стран в одной поездке"
    text="Перелеты, трансферы и отели соединяем так, чтобы больше времени осталось на саму поездку."
    href="/multi-country/"
    image="/media/home/buenos-aires-enhanced-20260930.webp"
    align="right"
  />

  <StoryPair
    eyebrow="Природа"
    title="Амазония требует времени"
    text="В Амазонии дорога сама становится частью путешествия. Здесь особенно ценны несколько спокойных дней."
    image="/media/home/amazon-enhanced-20260930.webp"
  />

  <DestinationBand
    eyebrow="MICE"
    title="Деловые поездки и группы"
    text="Встречи, транспорт, площадки и программа вне деловой части под одной координацией."
    href="/mice/"
    image="/media/home/rio-night-enhanced-20260930.webp"
  />

  <EditorialStatement
    eyebrow="DMC / B2B"
    text="Для турагентств Ada Tours собирает наземную часть поездки и ведет маршрут на месте одной командой."
  />

  <DestinationBand
    eyebrow="Для партнеров"
    title="DMC по Бразилии и Латинской Америке"
    text="FIT, группы, VIP и MICE. Один принимающий партнер для сложных маршрутов."
    href="/dmc/"
    image="/media/catalog/tury/hero-enhanced-20260930.webp"
    align="right"
  />

  <LeadForm title="Расскажите, какой маршрут нужен" entityId="home" />
</BaseLayout>

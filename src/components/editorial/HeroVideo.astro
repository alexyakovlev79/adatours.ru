---
import { withBase } from '../../lib/paths';
import videoPosters from '../../data/media/hero-video-posters.json';
interface Props {
  src?: string; mobileSrc?: string; poster?: string; mobilePoster?: string;
  lazy?: boolean;
  controlsPosition?: 'hero' | 'cover';
  selection?: 'device' | 'orientation';
  placement?: 'hero' | 'cover';
  controls?: boolean;
  layer?: 'background' | 'foreground';
}
const { src, mobileSrc, poster, mobilePoster, lazy = false, controlsPosition = 'hero', selection = 'device', placement = 'hero', controls = true, layer = 'background' } = Astro.props;
const firstFrameFor = (source?: string) => videoPosters.items.find((item) => item.src === source)?.poster;
const desktopPoster = poster ?? firstFrameFor(src);
const phonePoster = mobilePoster ?? firstFrameFor(mobileSrc);
---

<hero-background-video data-lazy={lazy ? '' : undefined} data-controls-position={controlsPosition} data-selection={selection} data-placement={placement} data-layer={layer}>
  <!-- Inert even to the preload scanner: activate ONLY for a photo device branch. -->
  <template data-static-hero><slot /></template>
  <noscript><slot /></noscript>
  <template data-first-frame>
    <img class="hero-video-poster" alt="" aria-hidden="true" loading="eager" fetchpriority={lazy ? 'auto' : 'high'} />
  </template>
  <video class="hero-video" data-src={src ? withBase(src) : undefined}
    data-mobile-src={mobileSrc ? withBase(mobileSrc) : undefined}
    data-poster={desktopPoster ? withBase(desktopPoster) : undefined}
    data-mobile-poster={phonePoster ? withBase(phonePoster) : undefined}
    muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
  {controls && <button class="hero-video-toggle" type="button" hidden aria-label="Приостановить видео">
    <span aria-hidden="true">Ⅱ</span>
  </button>}
</hero-background-video>

<script>
  import { initializeVideoCovers } from '../../scripts/video-covers.mjs';
  initializeVideoCovers();
</script>

<style>
  hero-background-video { display: contents; }
  .hero-video, .hero-video-poster {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }
  hero-background-video[data-layer="foreground"] .hero-video,
  hero-background-video[data-layer="foreground"] .hero-video-poster { z-index: 0; }
  .hero-video { opacity: 0; }
  .hero-video.is-playing { opacity: 1; }
  .hero-video-toggle {
    position: absolute;
    top: calc(var(--header-h) + 20px);
    right: var(--gutter);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 65%);
    border-radius: 50%;
    color: #fff;
    background: rgb(15 16 14 / 50%);
    cursor: pointer;
    font-size: 1rem;
  }
  .hero-video-toggle[hidden] { display: none; }
  hero-background-video[data-controls-position="cover"] .hero-video-toggle { top: 20px; }
  .hero-video-toggle:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
</style>


    {
      "blockId": "tour:itinerary_text:569e72e117968fcc",
      "field": "itinerary.text",
      "sourceTextSha256": "ea0155f00662a3a4a0df9d022a855c90855e049c50635c5dde9f9d6d0a757c48",
      "text": "After a tropical breakfast at your hotel, head out to the world-famous statue of Christ the Redeemer on Corcovado. A specially designed train climbs from the foot of the mountain through the Tijuca rainforest, where you may spot toucans, monkeys and other tropical wildlife.\n\nAt the summit, 710 metres above sea level, stands the iconic 38-metre statue of Christ the Redeemer, with a stunning panorama of the whole city, so high up that you seem to fly with the birds: from Guanabara Bay and Maracanã Stadium to Sugar Loaf, Copacabana, Ipanema and Gávea Mountain. Transfer to the hotel.",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1AzNz1-uUndjI6U7ZXLyKv1nncZ4eCaYQ",
        "documentSha256": "63e7ac586b1bf2f20cdfc0126ac682a3b6034e8e3ef964ab856cf5696433ada8",

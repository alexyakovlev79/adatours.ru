---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrimaryCTA from '../components/global/PrimaryCTA.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="Страница не найдена"
  description="Страница не найдена. Вернитесь на главную Ada Tours или перейдите к направлениям."
  canonical="/404.html"
  headerTheme="dark"
  noindex
>
  <section class="not-found">
    <div class="not-found__overlay"></div>
    <div class="not-found__content">
      <p class="eyebrow">404</p>
      <h1>Маршрут изменился</h1>
      <p>Такой страницы нет. Можно вернуться на главную или выбрать другое направление.</p>
      <div class="not-found__actions">
        <PrimaryCTA href="/" label="На главную" />
        <a href={withBase('/country/')}>Смотреть страны ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    display: grid;
    min-height: clamp(480px, 34vw, 600px);
    color: var(--color-ink);
    background:
      linear-gradient(145deg, var(--color-surface), var(--color-surface-beige));
    isolation: isolate;
  }

  .not-found__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: transparent;
  }

  .not-found__content {
    align-self: end;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
    padding: calc(var(--header-h) + 80px) 0 clamp(50px, 8vw, 110px);
  }

  .not-found h1 {
    max-width: 950px;
    margin: 12px 0 24px;
  }

  .not-found p:not(.eyebrow) {
    max-width: 650px;
    color: var(--color-text-muted);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 34px;
    align-items: center;
    margin-top: 34px;
  }

  @media (max-width: 720px) {
    .not-found {
      min-height: clamp(380px, 110vw, 500px);
    }
  }
</style>

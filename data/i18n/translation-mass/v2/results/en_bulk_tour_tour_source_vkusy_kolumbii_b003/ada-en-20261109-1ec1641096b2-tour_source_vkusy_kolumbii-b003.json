      "sourceTextSha256": "daf3e652768b8b484125d6b6c7e55be2699285cac54733d168312f1e92bf701a",
      "text": "Bogotá to Hacienda Coloma",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-1ec1641096b2",
        "model": "GPT-6 Codex"
      }

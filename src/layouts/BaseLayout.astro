---
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/global.css';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import { SITE } from '../lib/site';
import { withBase } from '../lib/paths';
import { ORG } from '../data/organization/ada-tours';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  lang?: string;
  headerTheme?: 'light' | 'dark';
  noindex?: boolean;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical,
  image,
  lang = SITE.locale,
  headerTheme = 'light',
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const fullTitle = title.includes('Ada Tours') ? title : `${title} | Ada Tours`;
const isPreview = import.meta.env.BASE_URL !== '/';
const faviconUrl = withBase('/favicon.png');
const appleTouchIconUrl = withBase('/apple-touch-icon.png');

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'TravelAgency'],
  name: ORG.brand,
  legalName: ORG.legal.name,
  url: SITE.url,
  email: ORG.contacts.email,
  telephone: ORG.contacts.phoneDisplay,
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'CNPJ',
    value: ORG.legal.cnpj,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: ORG.legal.streetAddress,
    addressLocality: ORG.legal.addressLocality,
    addressRegion: ORG.legal.addressRegion,
    postalCode: ORG.legal.postalCode,
    addressCountry: ORG.legal.addressCountry,
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="120x120" href={faviconUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
    {(isPreview || noindex) && <meta name="robots" content="noindex,nofollow,noarchive" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={new URL(image, Astro.site ?? SITE.url).toString()} />}
    <meta name="theme-color" content="#131412" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <SiteHeader theme={headerTheme} />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

---
import { getTourFilterIndex } from '../../lib/tour-filter-catalog';
import { tourFilterOptions } from '../../lib/tour-filters.mjs';
import CatalogFilterMenu from './CatalogFilterMenu.astro';
import { withBase } from '../../lib/paths';

interface Props { countryId?: string; themeId?: string; vip?: boolean; countryOverview?: boolean; }
const { countryId, themeId, vip = false, countryOverview = false } = Astro.props;
const index = await getTourFilterIndex();
const options = tourFilterOptions(index.regular, index.vip, { countryId, themeId, vip, countryOverview });
const menus = [
  { label: 'Страна', placeholder: 'Выбрать страну', selected: countryId,
    options: options.countries, reset: 'Все страны', resetHref: options.allCountriesHref },
  { label: 'Интерес', placeholder: 'Выбрать интерес', selected: themeId,
    options: options.themes, reset: 'Все интересы', resetHref: options.allThemesHref },
];
---

<nav class="tour-filters container" aria-label={vip ? 'Подбор VIP-туров' : 'Подбор туров'} data-tour-filters>
  {menus.map((menu) => <CatalogFilterMenu {...menu} />)}
  <div class="tour-filters__vip-field">
    <label class:list={['tour-filters__vip', { 'tour-filters__vip--unavailable': !options.toggleHref }]}>
      <input type="checkbox" checked={vip} disabled={!options.toggleHref} data-tour-vip-toggle
        data-href={options.toggleHref ? withBase(options.toggleHref) : undefined}
        aria-describedby={!options.toggleHref ? 'tour-filter-vip-note' : undefined} />
      <span>VIP</span>
    </label>
    {!options.toggleHref && <small id="tour-filter-vip-note" class="tour-filters__note">Для этой подборки пока нет VIP-туров.</small>}
    {options.toggleHref && <noscript><a class="tour-filters__fallback" href={withBase(options.toggleHref)}>{vip ? 'Все туры этой подборки' : 'VIP-туры этой подборки'}</a></noscript>}
  </div>
</nav>

<script>
  document.querySelectorAll<HTMLElement>('[data-tour-filters]').forEach((root) => {
    const toggle = root.querySelector<HTMLInputElement>('[data-tour-vip-toggle]');
    toggle?.addEventListener('change', () => {
      if (toggle.dataset.href) window.location.assign(toggle.dataset.href);
    });
    window.addEventListener('pageshow', () => { if (toggle) toggle.checked = toggle.defaultChecked; });
  });
</script>

<style>
  .tour-filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(90px, auto); gap: 20px; align-items: start; padding-block: clamp(24px, 4vw, 40px); }
  .tour-filters__vip-field { padding-top: calc(.78rem * 1.5 + 10px); }
  .tour-filters__vip { display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 14px 18px; border: 1px solid var(--color-line); border-radius: 4px; background: var(--color-surface); cursor: pointer; }
  .tour-filters__vip input:focus-visible { outline: 2px solid var(--color-gold-deep); outline-offset: 3px; }
  .tour-filters__vip input { width: 20px; height: 20px; margin: 0; accent-color: var(--color-gold-deep); cursor: inherit; }
  .tour-filters__vip--unavailable { cursor: default; }
  .tour-filters__note { display: block; max-width: 190px; margin-top: 8px; line-height: 1.4; }
  .tour-filters__fallback { display: inline-block; margin-top: 8px; color: var(--color-ink); text-underline-offset: .2em; }
  @media (max-width: 600px) { .tour-filters { grid-template-columns: 1fr; gap: 16px; } .tour-filters__vip-field { padding-top: 0; } .tour-filters__note { max-width: none; } }
</style>

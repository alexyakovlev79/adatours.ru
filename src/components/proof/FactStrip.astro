---
interface Fact { value: string; label: string; }
interface Props { facts: Fact[]; dark?: boolean; wideFirst?: boolean; }
const { facts, dark = false, wideFirst = false } = Astro.props;
---

<section class:list={['fact-strip', { 'fact-strip--dark': dark, 'fact-strip--wide-first': wideFirst }]}>
  <div class="fact-strip__inner">
    {facts.map((fact) => (
      <div class:list={['fact', { 'fact--long': fact.value.length > 9 }]}>
        <strong>{fact.value}</strong>
        <span>{fact.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .fact-strip {
    background: var(--color-bg);
  }

  .fact-strip--dark {
    color: var(--color-bg);
    background: var(--color-ink-deep);
  }

  .fact-strip__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .fact-strip--wide-first .fact-strip__inner {
    grid-template-columns: minmax(245px, 1.18fr) repeat(3, minmax(170px, 1fr));
  }

  .fact {
    min-width: 0;
    min-height: 180px;
    padding: 38px 28px;
  }

  .fact + .fact {
    border-left: 1px solid var(--color-line);
  }

  .fact-strip--dark .fact + .fact {
    border-color: rgba(255,255,255,.18);
  }

  .fact strong {
    display: block;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.4vw, 4.8rem);
    font-weight: 500;
    line-height: .95;
    letter-spacing: -.045em;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .fact--long strong {
    font-size: clamp(1.8rem, 2.5vw, 3.3rem);
  }

  .fact span {
    display: block;
    margin-top: 12px;
    color: var(--color-muted);
    font-size: .76rem;
    line-height: 1.35;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .fact-strip--dark .fact span {
    color: rgba(255,255,255,.56);
  }

  @media (max-width: 900px) and (min-width: 681px) {
    .fact-strip--wide-first .fact-strip__inner {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
  }

  @media (max-width: 680px) {
    .fact-strip__inner,
    .fact-strip--wide-first .fact-strip__inner {
      grid-template-columns: repeat(2, minmax(0,1fr));
    }

    .fact,
    .fact + .fact {
      min-height: 132px;
      padding: 26px 16px;
      border: 0;
    }

    .fact:nth-child(even) {
      border-left: 1px solid var(--color-line);
    }

    .fact:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
    }

    .fact-strip--dark .fact:nth-child(even),
    .fact-strip--dark .fact:nth-child(n + 3) {
      border-color: rgba(255,255,255,.18);
    }

    .fact--long strong {
      font-size: clamp(1.65rem, 7vw, 2.15rem);
    }

    .fact-strip--wide-first .fact:first-child strong {
      font-size: clamp(1.65rem, 7vw, 2rem);
    }
  }
</style>

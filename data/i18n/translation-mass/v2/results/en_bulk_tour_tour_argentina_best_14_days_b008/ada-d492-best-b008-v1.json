    {
      "blockId": "tour:itinerary_text:b04d5d61d358e759",
      "field": "itinerary.text",
      "sourceTextSha256": "1fc3a26450ef75a02152a0c9a288727274157c7a40385f9d5e8e80a4c00128ba",
      "text": "Take in the rare and breathtaking beauty of the Perito Moreno Glacier, one of the jewels of UNESCO’s World Heritage. Your guide picks you up at your hotel in the morning for a full-day tour, sharing details about the glacier and the national park on the way.\n\nThe first stop is a series of walkways with views of the glacier, ideal for photos. The tour then continues through the park’s natural scenery, and you walk along the walkways to watch chunks of ice break off and crash into the water. At the end of the day, return to your hotel.\n\nOptional: ice trekking, a walk on the glacier itself, ending with a cocktail served with glacier ice (see Optional Excursions).",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1KbvQKYTq3UYSQuBCRbvjvxv0-kAx0igy",
        "documentSha256": "0612abba285db9917be89860efc045fe68dda196030c4a038b47b2a55e27d3a2",

---
import PhoneField from './PhoneField.astro';
import { withBase } from '../../lib/paths';

interface Props {
  title?: string;
  entityId?: string;
  tourId?: string;
  pageUrl?: string;
  locale?: string;
}
const {
  title = 'Расскажите, какой маршрут вам нужен',
  entityId = '',
  tourId = '',
  pageUrl = Astro.url.toString(),
  locale = 'ru',
} = Astro.props;

const privacyHref = withBase('/privacy/');
const personalDataHref = withBase('/personal-data/');
---

<section class="lead section">
  <div class="container lead__grid">
    <div>
      <p class="eyebrow">Ada Tours</p>
      <h2>{title}</h2>
    </div>

    <form
      class="form"
      data-lead-form
      data-lead-form-version="3"
      data-lead-title={title}
      method="post"
      novalidate
    >
      <input type="hidden" name="entity_id" value={entityId} />
      <input type="hidden" name="tour_id" value={tourId} />
      <input type="hidden" name="page_url" value={pageUrl} />
      <input type="hidden" name="locale" value={locale} />

      <div class="form-hp" aria-hidden="true">
        <label>
          <span>Website</span>
          <input name="company_website" type="text" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <label>
        <span>Имя</span>
        <input name="name" type="text" autocomplete="name" maxlength="180" placeholder="Ваше имя" />
      </label>

      <div class="form-field">
        <span class="form-field__label">Номер для связи</span>
        <PhoneField />
      </div>

      <label>
        <span>Email</span>
        <input
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          autocapitalize="none"
          autocorrect="off"
          spellcheck="false"
          maxlength="254"
          placeholder="name@example.com"
        />
      </label>

      <fieldset class="contact-method">
        <legend>Как с вами связаться</legend>
        <div class="contact-method__options">
          <label class="contact-method__option">
            <input type="radio" name="contact_method" value="phone" disabled />
            <span>Телефон</span>
          </label>
          <label class="contact-method__option">
            <input type="radio" name="contact_method" value="whatsapp" disabled />
            <span>WhatsApp</span>
          </label>
          <label class="contact-method__option">
            <input type="radio" name="contact_method" value="telegram" disabled />
            <span>Telegram</span>
          </label>
          <label class="contact-method__option">
            <input type="radio" name="contact_method" value="email" disabled />
            <span>Email</span>
          </label>
        </div>
      </fieldset>

      <label>
        <span>Комментарий</span>
        <textarea
          name="comment"
          rows="3"
          maxlength="3000"
          placeholder="Даты, состав группы, пожелания"
        ></textarea>
      </label>

      <button type="submit">Оставить заявку <span aria-hidden="true">↗</span></button>

      <p class="form__status" data-lead-status role="status" aria-live="polite"></p>
      <p class="form__consent">
        Нажимая «Оставить заявку», вы соглашаетесь с{' '}
        <a href={privacyHref}>политикой конфиденциальности</a>{' '}
        и{' '}
        <a href={personalDataHref}>обработкой персональных данных</a>.
      </p>
    </form>
  </div>
</section>

<script>
  const FORM_ENDPOINT = String((window as any).ADATOURS_FORM_ENDPOINT || '').trim();
  const TRACKING_KEYS = [
    'utm_source',
    'utm_medium',
    'utm_campaign',
    'utm_content',
    'utm_term',
    'utm_id',
    'gclid',
    'yclid',
    'ysclid',
  ];

  const readTracking = () => {
    const query = new URLSearchParams(window.location.search);
    const tracking = {};
    for (const key of TRACKING_KEYS) {
      const value = query.get(key);
      if (value) tracking[key] = value;
    }
    return tracking;
  };

  const showSuccessNotice = () => {
    document.querySelector('.adatours-success-toast')?.remove();

    const notice = document.createElement('div');
    notice.className = 'adatours-success-toast';
    notice.setAttribute('role', 'status');
    notice.setAttribute('aria-live', 'polite');
    notice.textContent = 'Спасибо! Заявка отправлена. Мы свяжемся с вами.';
    document.body.appendChild(notice);

    window.setTimeout(() => {
      if (notice.isConnected) notice.remove();
    }, 3500);
  };

  const phoneMeta = (input, dialInput) => {
    const mask = input.dataset.mask || '';
    const dial = dialInput.value || input.dataset.dial || '';
    const rest = mask.startsWith(dial) ? mask.slice(dial.length) : mask;
    const pattern = rest.replace(/^[\s-]+/, '');
    return {
      expectedDigits: (pattern.match(/9/g) || []).length,
      dialDigits: dial.replace(/\D/g, ''),
    };
  };

  const form = document.querySelector('[data-lead-form]');
  let overlay = null;
  let lastOpener = null;
  let homeMarker = null;

  const restoreFormHome = () => {
    if (!(form instanceof HTMLFormElement) || !(homeMarker instanceof Comment) || !homeMarker.parentNode) return;
    form.classList.remove('form--modal');
    homeMarker.parentNode.insertBefore(form, homeMarker.nextSibling);
  };

  const closeModal = () => {
    if (!(overlay instanceof HTMLElement)) return;
    const oldOverlay = overlay;
    overlay = null;
    restoreFormHome();
    oldOverlay.remove();
    document.body.classList.remove('lead-modal-open');
    document.removeEventListener('keydown', onModalKeydown);
    if (lastOpener instanceof HTMLElement) lastOpener.focus();
    lastOpener = null;
  };

  const onModalKeydown = (event) => {
    if (!(overlay instanceof HTMLElement)) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      closeModal();
      return;
    }

    if (event.key !== 'Tab') return;
    const focusable = Array.from(
      overlay.querySelectorAll('button:not([disabled]),input:not([disabled]),textarea:not([disabled]),a[href]')
    ).filter((element) => element instanceof HTMLElement && element.offsetParent !== null);

    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  };

  const openModal = (opener) => {
    if (!(form instanceof HTMLFormElement) || overlay) return;

    if (!(homeMarker instanceof Comment)) {
      homeMarker = document.createComment('adatours-lead-form-home');
      form.parentNode?.insertBefore(homeMarker, form);
    }

    lastOpener = opener instanceof HTMLElement ? opener : document.activeElement;

    const nextOverlay = document.createElement('div');
    nextOverlay.className = 'adatours-modal-overlay';
    nextOverlay.setAttribute('data-lead-modal-overlay', '');

    const dialog = document.createElement('div');
    dialog.className = 'adatours-modal';
    dialog.setAttribute('role', 'dialog');
    dialog.setAttribute('aria-modal', 'true');
    dialog.setAttribute('aria-labelledby', 'adatours-modal-title');

    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'adatours-modal-close';
    close.setAttribute('aria-label', 'Закрыть форму');

    const head = document.createElement('div');
    head.className = 'adatours-modal-head';

    const heading = document.createElement('h2');
    heading.className = 'adatours-modal-title';
    heading.id = 'adatours-modal-title';
    heading.textContent = form.dataset.leadTitle || 'Оставить заявку';

    const lead = document.createElement('p');
    lead.className = 'adatours-modal-lead';
    lead.textContent = 'Оставьте контакты и коротко опишите поездку. Мы свяжемся с вами и уточним детали.';

    head.append(heading, lead);
    dialog.append(close, head);

    form.hidden = false;
    form.classList.add('form--modal');
    dialog.appendChild(form);
    nextOverlay.appendChild(dialog);
    document.body.appendChild(nextOverlay);
    overlay = nextOverlay;
    document.body.classList.add('lead-modal-open');

    const status = form.querySelector('[data-lead-status]');
    if (status instanceof HTMLElement && !form.dataset.leadSent) {
      status.textContent = '';
      status.classList.remove('is-error', 'is-success');
    }

    close.addEventListener('click', closeModal);
    nextOverlay.addEventListener('mousedown', (event) => {
      if (event.target === nextOverlay) closeModal();
    });
    document.addEventListener('keydown', onModalKeydown);

    const nameInput = form.querySelector('input[name="name"]');
    window.setTimeout(() => {
      if (nameInput instanceof HTMLInputElement) nameInput.focus();
    }, 0);
  };

  const isLeadTrigger = (anchor) => {
    if (!(anchor instanceof HTMLAnchorElement)) return false;
    if (anchor.dataset.leadModal === 'true') return true;
    const label = (anchor.textContent || '').replace(/↗/g, '').replace(/\s+/g, ' ').trim().toLocaleLowerCase('ru');
    return label === 'оставить заявку';
  };

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const anchor = event.target.closest('a[href]');
    if (!(anchor instanceof HTMLAnchorElement) || !isLeadTrigger(anchor)) return;
    if (event instanceof MouseEvent && (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)) return;

    event.preventDefault();
    openModal(anchor);
  });

  if (form instanceof HTMLFormElement) {
    const nameInput = form.querySelector('input[name="name"]');
    const phoneInput = form.querySelector('[data-phone-input]');
    const phoneCountryInput = form.querySelector('[data-phone-country]');
    const phoneDialInput = form.querySelector('[data-phone-dial-hidden]');
    const emailInput = form.querySelector('input[name="email"]');
    const commentInput = form.querySelector('textarea[name="comment"]');
    const honeypotInput = form.querySelector('input[name="company_website"]');
    const entityInput = form.querySelector('input[name="entity_id"]');
    const tourInput = form.querySelector('input[name="tour_id"]');
    const pageInput = form.querySelector('input[name="page_url"]');
    const localeInput = form.querySelector('input[name="locale"]');
    const submit = form.querySelector('button[type="submit"]');
    const status = form.querySelector('[data-lead-status]');
    const phoneControl = form.querySelector('.phone-field__control');
    const contactChoices = Array.from(form.querySelectorAll('input[name="contact_method"]'));

    if (nameInput instanceof HTMLInputElement &&
        phoneInput instanceof HTMLInputElement &&
        phoneCountryInput instanceof HTMLInputElement &&
        phoneDialInput instanceof HTMLInputElement &&
        emailInput instanceof HTMLInputElement &&
        commentInput instanceof HTMLTextAreaElement &&
        honeypotInput instanceof HTMLInputElement &&
        entityInput instanceof HTMLInputElement &&
        tourInput instanceof HTMLInputElement &&
        pageInput instanceof HTMLInputElement &&
        localeInput instanceof HTMLInputElement &&
        submit instanceof HTMLButtonElement &&
        status instanceof HTMLElement) {
      const startedAt = Date.now();

      const setStatus = (message, type = '') => {
        status.textContent = message;
        status.classList.toggle('is-error', type === 'error');
        status.classList.toggle('is-success', type === 'success');
      };

      const updateContactMethods = () => {
        const hasPhone = Boolean(phoneInput.value.trim());
        const hasEmail = Boolean(emailInput.value.trim());

        for (const choice of contactChoices) {
          if (!(choice instanceof HTMLInputElement)) continue;
          const available = choice.value === 'email' ? hasEmail : hasPhone;
          choice.disabled = !available;
          if (!available && choice.checked) choice.checked = false;
        }
      };

      const finishSuccess = () => {
        form.dataset.leadSent = 'true';
        setStatus('Спасибо! Заявка отправлена. Мы свяжемся с вами.', 'success');
        showSuccessNotice();

        if (overlay instanceof HTMLElement) {
          window.setTimeout(closeModal, 650);
        } else {
          window.setTimeout(() => {
            form.hidden = true;
          }, 650);
        }
      };

      const resetValidation = () => {
        nameInput.setAttribute('aria-invalid', 'false');
        phoneInput.setAttribute('aria-invalid', 'false');
        emailInput.setAttribute('aria-invalid', 'false');
        phoneControl?.classList.remove('is-invalid');
        setStatus('');
      };

      const validate = () => {
        resetValidation();

        if (!nameInput.value.trim()) {
          nameInput.setAttribute('aria-invalid', 'true');
          nameInput.focus();
          setStatus('Укажите имя.', 'error');
          return false;
        }

        const hasPhone = Boolean(phoneInput.value.trim());
        const hasEmail = Boolean(emailInput.value.trim());

        if (!hasPhone && !hasEmail) {
          phoneInput.setAttribute('aria-invalid', 'true');
          emailInput.setAttribute('aria-invalid', 'true');
          phoneControl?.classList.add('is-invalid');
          phoneInput.focus();
          setStatus('Укажите телефон или email.', 'error');
          return false;
        }

        if (hasPhone) {
          const { expectedDigits } = phoneMeta(phoneInput, phoneDialInput);
          const actualDigits = (phoneInput.value.match(/\d/g) || []).length;
          if (!expectedDigits || actualDigits !== expectedDigits) {
            phoneInput.setAttribute('aria-invalid', 'true');
            phoneControl?.classList.add('is-invalid');
            phoneInput.focus();
            setStatus('Проверьте номер телефона.', 'error');
            return false;
          }
        }

        if (hasEmail && !emailInput.validity.valid) {
          emailInput.setAttribute('aria-invalid', 'true');
          emailInput.focus();
          setStatus('Проверьте email.', 'error');
          return false;
        }

        const method = form.querySelector('input[name="contact_method"]:checked');
        if (!(method instanceof HTMLInputElement)) {
          setStatus('Выберите способ связи.', 'error');
          return false;
        }

        return true;
      };

      nameInput.addEventListener('input', () => nameInput.setAttribute('aria-invalid', 'false'));
      phoneInput.addEventListener('input', () => {
        phoneInput.setAttribute('aria-invalid', 'false');
        phoneControl?.classList.remove('is-invalid');
        updateContactMethods();
      });
      emailInput.addEventListener('input', () => {
        emailInput.setAttribute('aria-invalid', 'false');
        updateContactMethods();
      });

      updateContactMethods();
      window.setTimeout(updateContactMethods, 0);
      window.addEventListener('pageshow', updateContactMethods);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!validate()) return;

        if (honeypotInput.value) {
          finishSuccess();
          return;
        }

        if (!FORM_ENDPOINT) {
          setStatus('Отправка заявки пока не подключена. Попробуйте связаться с нами напрямую.', 'error');
          return;
        }

        const method = form.querySelector('input[name="contact_method"]:checked');
        const { dialDigits } = phoneMeta(phoneInput, phoneDialInput);
        const localDigits = phoneInput.value.replace(/\D/g, '');
        const normalizedPhone = localDigits ? `+${dialDigits}${localDigits}` : '';

        const payload = {
          site: 'adatours',
          lang: localeInput.value || 'ru',
          full_name: nameInput.value.trim(),
          phone: normalizedPhone,
          phone_country: phoneCountryInput.value,
          email: emailInput.value.trim(),
          comment: commentInput.value.trim(),
          contact_method: method instanceof HTMLInputElement ? method.value : '',
          entity_id: entityInput.value,
          tour_id: tourInput.value,
          company_website: honeypotInput.value,
          page_url: window.location.href,
          canonical_url: pageInput.value,
          referrer: document.referrer || '',
          utm: readTracking(),
          form_started_at: new Date(startedAt).toISOString(),
          submitted_at: new Date().toISOString(),
        };

        submit.disabled = true;
        form.setAttribute('aria-busy', 'true');
        setStatus('Отправляем заявку…');

        let sent = false;
        try {
          const response = await fetch(FORM_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'omit',
            body: JSON.stringify(payload),
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);

          sent = true;
          document.dispatchEvent(new CustomEvent('adatours:lead-success', {
            detail: { lang: payload.lang, entityId: payload.entity_id, tourId: payload.tour_id },
          }));
          finishSuccess();
        } catch (_) {
          setStatus('Не удалось отправить заявку. Попробуйте еще раз чуть позже.', 'error');
        } finally {
          form.setAttribute('aria-busy', 'false');
          if (!sent) submit.disabled = false;
        }
      });
    }
  }
</script>

<style>
  .lead {
    color: var(--color-bg);
    background: var(--color-ink-deep);
  }

  .lead__grid {
    display: grid;
    grid-template-columns: 1fr .8fr;
    gap: clamp(50px, 8vw, 130px);
    align-items: start;
  }

  .lead h2 {
    margin: 12px 0 24px;
  }

  .form {
    position: relative;
    display: grid;
    gap: 28px;
    padding-top: 6px;
  }

  .form[hidden] {
    display: none;
  }

  .form label,
  .form-field {
    display: grid;
    gap: 8px;
  }

  .form label span,
  .form-field__label,
  .contact-method legend {
    color: rgba(255,255,255,.55);
    font-size: .72rem;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .form input,
  .form textarea {
    width: 100%;
    padding: 12px 0;
    border: 0;
    border-bottom: 1px solid rgba(255,255,255,.35);
    border-radius: 0;
    outline: 0;
    color: var(--color-bg);
    background: transparent;
  }

  .form input:focus,
  .form textarea:focus {
    border-bottom-color: var(--color-gold);
  }

  .form input[aria-invalid="true"],
  .form textarea[aria-invalid="true"] {
    border-bottom-color: #e79683;
  }

  .form :global(.phone-field__control.is-invalid) {
    border-bottom-color: #e79683;
  }

  .contact-method {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .contact-method legend {
    margin: 0 0 12px;
    padding: 0;
  }

  .contact-method__options {
    display: flex;
    align-items: center;
    gap: clamp(18px, 3vw, 32px);
    flex-wrap: wrap;
  }

  .form .contact-method__option {
    display: inline-flex;
    cursor: pointer;
  }

  .contact-method__option input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .form .contact-method__option span {
    position: relative;
    padding: 0 0 7px;
    color: rgba(255,255,255,.68);
    font-size: .95rem;
    line-height: 1.2;
    letter-spacing: .01em;
    text-transform: none;
    transition: color 180ms ease, border-color 180ms ease, opacity 180ms ease;
    border-bottom: 2px solid transparent;
  }

  .form .contact-method__option:hover span {
    color: var(--color-bg);
  }

  .form .contact-method__option input:checked + span {
    color: var(--color-gold);
    border-bottom-color: var(--color-gold);
  }

  .form .contact-method__option input:disabled + span {
    color: rgba(255,255,255,.28);
    cursor: not-allowed;
    opacity: .72;
  }

  .form .contact-method__option input:focus-visible + span {
    outline: 2px solid var(--color-gold-deep);
    outline-offset: 4px;
  }

  .form button {
    display: inline-flex;
    justify-content: space-between;
    gap: 30px;
    margin-top: 2px;
    padding: 17px 20px;
    border: 0;
    color: var(--color-ink-deep);
    background: var(--color-gold);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: .8rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .form button:disabled {
    opacity: .62;
    cursor: wait;
  }

  .form__status {
    min-height: 20px;
    margin: -12px 0 0;
    color: rgba(255,255,255,.68);
    font-size: .8rem;
    line-height: 1.5;
  }

  .form__status.is-error {
    color: #ffc1b2;
  }

  .form__status.is-success {
    color: #9be2b8;
  }

  .form__consent {
    margin: -14px 0 0;
    color: rgba(255,255,255,.55);
    font-size: .75rem;
    line-height: 1.55;
  }

  .form__consent a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .form-hp {
    position: absolute !important;
    left: -10000px !important;
    top: auto !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  :global(body.lead-modal-open) {
    overflow: hidden;
  }

  :global(.adatours-modal-overlay) {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(19,20,18,.72);
    animation: adatours-fade-in 140ms ease-out;
  }

  :global(.adatours-modal) {
    position: relative;
    width: min(760px, 100%);
    max-height: calc(100dvh - 48px);
    overflow: auto;
    padding: 30px 44px;
    border-radius: 12px;
    color: var(--color-ink);
    background: var(--color-bg);
    box-shadow: 0 28px 80px rgba(0,0,0,.28);
    animation: adatours-modal-in 160ms ease-out;
  }

  :global(.adatours-modal-close) {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 42px;
    height: 42px;
    border: 0;
    color: #6f6a62;
    background: transparent;
    cursor: pointer;
  }

  :global(.adatours-modal-close)::before,
  :global(.adatours-modal-close)::after {
    content: "";
    position: absolute;
    top: 20px;
    left: 10px;
    width: 22px;
    height: 1.5px;
    background: currentColor;
  }

  :global(.adatours-modal-close)::before {
    transform: rotate(45deg);
  }

  :global(.adatours-modal-close)::after {
    transform: rotate(-45deg);
  }

  :global(.adatours-modal-head) {
    padding-right: 44px;
    margin-bottom: 18px;
  }

  :global(.adatours-modal-title) {
    margin: 0;
    color: var(--color-ink-deep);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.7rem + 1vw, 2.75rem);
    line-height: 1.02;
    letter-spacing: -.025em;
  }

  :global(.adatours-modal-lead) {
    max-width: 590px;
    margin: 8px 0 0;
    color: #6f6a62;
    font-size: .9rem;
    line-height: 1.55;
  }

  :global(.adatours-modal) .form {
    gap: 12px;
    padding-top: 0;
    color: var(--color-ink);
  }

  :global(.adatours-modal) .form label,
  :global(.adatours-modal) .form-field {
    gap: 6px;
  }

  :global(.adatours-modal) .form label span,
  :global(.adatours-modal) .form-field__label,
  :global(.adatours-modal) .contact-method legend {
    color: #6f6a62;
  }

  :global(.adatours-modal) .form > label > input,
  :global(.adatours-modal) .form > label > textarea {
    padding: 12px 14px;
    border: 1px solid #c9c5bd;
    color: var(--color-ink);
    background: #fff;
  }

  :global(.adatours-modal) .form > label > input:focus,
  :global(.adatours-modal) .form > label > textarea:focus {

---
import { isActiveEntity } from '../../lib/archive.mjs';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { destinationPath } from '../../lib/routes';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import DestinationBand from '../../components/editorial/DestinationBand.astro';
import { buildDestinationTourCounts, compareDestinationsByPopularity } from '../../lib/destination-popularity';

const [destinations, countries, tours] = await Promise.all([
  getCollection('destinations', ({ data }) =>
    data.locale === 'ru' && isActiveEntity(data)
  ),
  getCollection('countries', ({ data }) =>
    data.locale === 'ru' && isActiveEntity(data)
  ),
  getCollection('tours', ({ data }) =>
    data.locale === 'ru' && isActiveEntity(data)
  ),
]);

const countryById = new Map(countries.map((country) => [
  country.data.id,
  { name: country.data.name, slug: country.data.slug },
]));

const destinationTourCounts = buildDestinationTourCounts(tours);
const ordered = destinations.sort(compareDestinationsByPopularity(destinationTourCounts));
---

<BaseLayout
  title="Места Латинской Америки | Ada Tours"
  description="Рио-де-Жанейро, Игуасу, Амазония, Пантанал, Буэнос-Айрес, Патагония, Мендоса, Лима, Куско и Мачу-Пикчу в структуре маршрутов Ada Tours."
>
  <Hero
    eyebrow="Направления"
    title="Места, ради которых летят в Латинскую Америку"
    intro="Рио, Игуасу, Амазония, Патагония, Куско и десятки других мест. Выберите точку на карте, мы свяжем ее с подходящим маршрутом."
    image="/media/home/patagonia-enhanced-20260930.webp"
  />

  <EditorialStatement
    eyebrow="Выбирайте по месту"
    text="Одно место может стать центром путешествия или частью большого маршрута по нескольким странам."
  />

  {ordered.map((destination, index) => {
    const country = countryById.get(destination.data.countryId);
    if (!country) return null;

    return (
      <DestinationBand
        eyebrow={country.name}
        title={destination.data.name}
        text={destination.data.summary}
        image={destination.data.hero?.src}
        imageTextAlign={destination.data.imageTextAlign}
        href={destinationPath(destination.data)}
        align={index % 3 === 1 ? 'right' : 'left'}
      />
    );
  })}
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/editorial/Hero.astro';
import FactStrip from '../../../components/proof/FactStrip.astro';
import ProcessSteps from '../../../components/proof/ProcessSteps.astro';
import MiceNav from '../../../components/commercial/MiceNav.astro';
import CommercialDetails from '../../../components/commercial/CommercialDetails.astro';
import CommercialCaseGrid from '../../../components/commercial/CommercialCaseGrid.astro';
import CommercialExpert from '../../../components/commercial/CommercialExpert.astro';
import CommercialSearchRecord from '../../../components/commercial/CommercialSearchRecord.astro';
import DmcFaq from '../../../components/commercial/DmcFaq.astro';

const hero = '/media/destinations/sao-paulo/hero-enhanced-20261001.webp';
const title = 'Деловые делегации в Бразилию и Латинскую Америку | Ada Tours';
const description = 'Деловые поездки с Ada Tours: профессиональные визиты, переводчики, транспорт и размещение под график встреч. Кейс делегации из 8 участников и подготовка программы.';
---

<BaseLayout leadTitle="Запросить программу делегации" leadEntityId="mice_business_delegations" title={title} description={description} image={hero}>
  <CommercialSearchRecord id="mice_business_delegations" title="Деловые делегации и профессиональные визиты" description={description} image={hero} keywords={['бизнес-делегация', 'деловые поездки', 'переговоры', 'визиты на предприятия', 'переводчики', 'аграрные поездки']} />
  <Hero compact compactCta mobilePhotoLead eyebrow="MICE · Деловые делегации"
    title="Деловые делегации в Бразилию и Латинскую Америку"
    intro="Помогаем подготовить профессиональные визиты, подбираем переводчиков и связываем переговоры с транспортом, отелями и сопровождением. Вы занимаетесь деловой задачей, команда Ada Tours координирует поездку на месте."
    image={hero} ctaHref="#request" ctaLabel="Подготовить программу делегации" />
  <MiceNav active="delegations" />

  <FactStrip facts={[
    { value: '8 участников', label: 'в выполненном кейсе делегации' },
    { value: '3 города', label: 'Сан-Паулу, Кампинас и Гуаружа' },
    { value: '3 языка', label: 'русский, португальский и английский в работе переводчика' },
    { value: '2026', label: 'год опубликованного проекта' },
  ]} />

  <CommercialDetails id="delegations-visits" eyebrow="Профессиональная программа" title="От цели визита до согласованной встречи"
    intro="Делегации нужен собеседник по теме и достаточно времени для разговора. Поэтому подготовку начинаем с отрасли, целей и состава участников, а затем собираем маршрут вокруг деловых встреч."
    rows={[
      { title: 'Поиск принимающих организаций', text: 'Определяем профиль компаний, хозяйств, исследовательских центров или профессиональных объединений. Если у вас уже есть контакты и назначенные встречи, включаем их в рабочую программу.' },
      { title: 'Обращение и согласование', text: 'Связываемся с подходящими организациями, уточняем возможность визита и обсуждаем содержание встречи. В окончательную программу включаем посещение после согласия принимающей стороны.' },
      { title: 'Перевод и подготовка', text: 'Согласуем языковую пару и формат перевода. Для подбора сопровождения полезны темы переговоров, профиль участников и ожидаемая продолжительность. Учитываем правила доступа, конфиденциальность и требования принимающей организации.' },
      { title: 'Отраслевая поездка', text: 'В [аграрной программе Аргентины на 11 дней](/argentina/tour/argentina-agricultural-11-days/) собраны хозяйства, исследовательские учреждения и культурная часть. Это основа для отраслевого запроса; конкретные визиты согласуем под цели и даты делегации.' },
    ]} />

  <CommercialCaseGrid id="delegations-case" title="Когда время переговоров менялось по ходу дня"
    intro="В выполненной поездке делегации по Бразилии расписание встреч влияло на весь день: следующий переезд, работу переводчика, питание и свободную программу."
    caseIds={['case_mice_business_delegation_sao_paulo_2026']}
    summaries={{ case_mice_business_delegation_sao_paulo_2026: 'Для 8 участников Ada Tours организовала отели, автомобили и микроавтобусы, русскоязычное сопровождение и перевод на 3 языках. Команда согласовывала изменения транспорта и программы вслед за рабочими встречами.' }} />

  <CommercialDetails id="delegations-logistics" eyebrow="Логистика деловой поездки" title="Каждая встреча связана с остальной программой"
    rows={[
      { title: 'География и размещение', text: 'Смотрим на адреса встреч и порядок посещений. Отель выбираем с учетом рабочих районов, аэропортов и переездов между городами. При длинном маршруте сравниваем варианты ночевок и транспорта.' },
      { title: 'Автомобили и рабочий день', text: 'Подбираем транспорт по числу участников и багажу, согласуем часы работы, ожидание на встречах и межгородские поездки. Учитываем время на посадку, проходные и перемещения внутри принимающих объектов.' },
      { title: 'Общение на месте', text: 'Перед поездкой передаем рабочие контакты. При изменении встречи координатор уточняет варианты с транспортом, переводчиком и следующими поставщиками, затем согласует решение с организатором делегации.' },
      { title: 'Знакомство со страной', text: 'Добавляем рестораны, экскурсии и отдых в свободные части расписания. Для участников с разными задачами можно подготовить отдельные выезды или программу сопровождающих в рамках [корпоративной поездки](/mice/).' },
    ]} />

  <CommercialDetails id="delegations-brief" eyebrow="Что прислать" title="Бриф, который поможет перейти к конкретным организациям"
    rows={[
      { title: 'Деловая цель', text: 'Отрасль, темы обсуждения, желаемый результат, тип принимающей организации и список уже известных контактов. Укажите, нужны ли поиск новых организаций или сопровождение на назначенных встречах.' },
      { title: 'Участники и языки', text: 'Число участников, компании и должности, рабочие языки, потребность в переводе и особенности доступа на объекты. Персональные данные для бронирования передаются на соответствующем этапе подготовки.' },
      { title: 'Даты и условия', text: 'Диапазон дат, длительность, города, известные рейсы, требования к отелям и бюджет. Отметьте встречи с фиксированным временем и желаемую экскурсионную часть.' },
      { title: 'Результат подготовки', text: 'Вы получите маршрут, состав услуг, расчет, условия бронирования и статус запрошенных визитов. Для [агентского запроса](/dmc/travel-agencies/) отдельно согласуем тарифную модель, документы и общение с заказчиком.' },
    ]} />

  <ProcessSteps eyebrow="Подготовка делегации" title="Сначала деловая задача, затем все стыковки" steps={[
    { title: 'Цели', text: 'Определяем темы, профиль организаций и состав участников.' },
    { title: 'Визиты', text: 'Обращаемся к принимающим сторонам и согласуем доступные встречи.' },
    { title: 'Программа', text: 'Связываем подтвержденный график с переездами, переводом и размещением.' },
    { title: 'Сопровождение', text: 'Координируем исполнение и изменения в течение поездки.' },
  ]} />

  <CommercialExpert title="Деловая поездка с принимающей командой в регионе" text="Команда Ada Tours работает из Рио-де-Жанейро и готовит поездки по Бразилии и Латинской Америке. Анна Аванесова руководит компанией и делится практикой на [профессиональных вебинарах](/webinars/). Опыт работы с группами можно оценить по [выполненным кейсам](/cases/)." />

  <DmcFaq title="Вопросы о деловых делегациях" items={[
    { question: 'Вы только сопровождаете группу или помогаете организовать профессиональные визиты?', answer: 'Помогаем с подготовкой визитов: уточняем цель, ищем профильные организации, связываемся с ними и согласуем возможность приема. При необходимости подбираем языковое сопровождение. Встреча подтверждается после согласия принимающей стороны.' },
    { question: 'Можно ли заказать поездку, если все встречи уже назначены?', answer: 'Да. Пришлите даты, адреса и время встреч. Под них подберем размещение, транспорт и переводчиков, рассчитаем переезды и добавим желаемую свободную программу.' },
    { question: 'Как подбирается переводчик?', answer: 'Согласуем языки, тематику, формат встреч и часы работы. В [кейсе делегации по Бразилии](/cases/business-delegation-sao-paulo-campinas-2026/) использовался перевод на русском, португальском и английском. Для новой поездки состав сопровождения определяем по вашему заданию.' },
    { question: 'Что делать, если предприятие переносит встречу?', answer: 'Проверяем, как новый график влияет на транспорт, переводчика, размещение и следующие пункты. Предлагаем доступные варианты и согласуем изменения с организатором. Дополнительные расходы зависят от условий затронутых услуг.' },
    { question: 'Можно ли включить несколько городов или стран?', answer: 'Да. Собираем маршрут вокруг деловых задач, учитываем перелеты и наземные переезды. Сложные стыковки и распределение сопровождения прорабатываем при подготовке предложения.' },
    { question: 'За сколько времени начинать подготовку профессиональных визитов?', answer: 'Обращайтесь, когда определились цель и предполагаемые даты. Для отраслевых визитов требуется время на ответы принимающих организаций, допуски и подбор сопровождения. По вашему запросу определим порядок действий и контрольные сроки.' },
  ]} />
</BaseLayout>

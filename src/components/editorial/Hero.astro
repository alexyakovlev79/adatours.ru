---
import PrimaryCTA from '../global/PrimaryCTA.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  image?: string;
  ctaHref?: string;
  ctaLabel?: string;
  compact?: boolean;
}

const {
  eyebrow,
  title,
  intro,
  image,
  ctaHref = '/contacts/',
  ctaLabel = 'Оставить заявку',
  compact = false,
} = Astro.props;

const style = image ? `--hero-image: url("${image}")` : undefined;
---

<section class:list={['hero', { 'hero--compact': compact, 'hero--image': image }]} style={style}>
  <div class="hero__overlay"></div>
  <div class="hero__content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <div class="hero__bottom">
      {intro && <p>{intro}</p>}
      <PrimaryCTA href={ctaHref} label={ctaLabel} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: var(--hero-height);
    overflow: hidden;
    color: var(--color-bg);
    background:
      radial-gradient(circle at 75% 15%, rgba(242, 204, 103, .22), transparent 32%),
      linear-gradient(135deg, #33342f 0%, var(--color-ink-deep) 62%);
    isolation: isolate;
  }

  .hero--compact {
    min-height: min(78svh, 760px);
  }

  .hero--image {
    background-image: var(--hero-image);
    background-position: center;
    background-size: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(15, 16, 14, .18) 0%,
      rgba(15, 16, 14, .18) 35%,
      rgba(15, 16, 14, .62) 100%
    );
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: min(calc(100% - (var(--gutter) * 2)), 1440px);
    margin-inline: auto;
    padding: calc(var(--header-h) + 72px) 0 clamp(48px, 7vw, 96px);
  }

  .hero h1 {
    max-width: 1100px;
    margin: 12px 0 clamp(36px, 5vw, 70px);
  }

  .hero__bottom {
    display: grid;
    grid-template-columns: minmax(0, 620px) auto;
    align-items: end;
    justify-content: space-between;
    gap: 48px;
  }

  .hero__bottom p {
    max-width: 620px;
    margin: 0;
    color: rgba(255,255,255,.82);
    font-size: var(--text-lg);
  }

  @media (max-width: 720px) {
    .hero__content {
      padding-bottom: 34px;
    }

    .hero__bottom {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>

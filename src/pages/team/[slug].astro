---
import { isActiveEntity } from '../../lib/archive.mjs';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import PersonProfile from '../../components/proof/PersonProfile.astro';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const people = await getCollection('people', ({ data }) =>
    data.locale === 'ru' && isActiveEntity(data)
  );

  return people.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isAnna = entry.data.id === 'person_anna';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: entry.data.name,
  jobTitle: entry.data.role,
  worksFor: {
    '@type': 'Organization',
    name: 'Ada Tours',
    url: SITE.url,
  },
  url: new URL(`/team/${entry.data.slug}/`, Astro.site ?? SITE.url).toString(),
  image: entry.data.photo?.src
    ? new URL(entry.data.photo.src, Astro.site ?? SITE.url).toString()
    : undefined,
  knowsAbout: entry.data.expertise,
  sameAs: entry.data.externalProfiles,
};
---

<BaseLayout leadTitle="Обсудить маршрут с Ada Tours" leadEntityId={entry.data.id}
  title={isAnna ? 'Анна Аванесова - основатель и CEO Ada Tours' : `${entry.data.name} - ${entry.data.role}`}
  description={isAnna
    ? 'Анна Аванесова, основатель и CEO Ada Tours: Бразилия и Латинская Америка, сложные индивидуальные маршруты, VIP, MICE и multi-country.'
    : `${entry.data.name}, ${entry.data.role}. Экспертиза: ${entry.data.expertise.join(', ')}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <Hero
    eyebrow={isAnna ? 'Основатель Ada Tours' : 'Команда Ada Tours'}
    title={entry.data.name}
    intro={isAnna
      ? 'Латинская Америка для Анны началась задолго до Ada Tours: с самостоятельных путешествий, бумажной карты и сложных наземных маршрутов.'
      : entry.data.role}
    compact
    ctaLabel="Обсудить маршрут"
  />

  {isAnna && (
    <EditorialStatement
      eyebrow="Личный опыт"
      text="Анна исследовала Латинскую Америку с рюкзаком и бумажной картой, ездила автостопом, ходила пешком и верхом, ночевала в гамаке и на парусной лодке. Этот опыт стал основой ее подхода к маршрутам Ada Tours."
    />
  )}

  <PersonProfile
    name={entry.data.name}
    role={entry.data.role}
    photo={entry.data.photo}
    expertise={entry.data.expertise}
    eyebrow={isAnna ? 'Чем занимается Анна' : 'Профиль'}
  >
    <Content />
  </PersonProfile>

</BaseLayout>

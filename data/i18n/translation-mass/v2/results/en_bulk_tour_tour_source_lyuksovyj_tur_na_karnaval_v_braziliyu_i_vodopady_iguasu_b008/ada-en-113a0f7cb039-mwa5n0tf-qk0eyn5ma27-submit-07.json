      "sourceTextSha256": "ce8785b0007ced31b753099715149f396e226b261e6913f4f7557ee9f462a137",
      "text": "11 February: The Argentine side of Iguazú Falls",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-113a0f7cb039-mwa5n0tf-qk0eyn5ma27",

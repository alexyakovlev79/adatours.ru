---
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/global.css';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import { SITE } from '../lib/site';
import { withBase } from '../lib/paths';
import { ORG } from '../data/organization/ada-tours';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  lang?: string;
  headerTheme?: 'light' | 'dark';
  noindex?: boolean;
  showBreadcrumbs?: boolean;
  pageSchema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical,
  image,
  lang = SITE.locale,
  headerTheme = 'light',
  noindex = false,
  showBreadcrumbs = true,
  pageSchema,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const fullTitle = title.includes('Ada Tours') ? title : `${title} | Ada Tours`;
const isPreview = import.meta.env.BASE_URL !== '/';
const faviconUrl = withBase('/favicon.png');
const appleTouchIconUrl = withBase('/apple-touch-icon.png');
const ogImageUrl = image ? new URL(withBase(image), Astro.site ?? SITE.url).toString() : undefined;

const base = import.meta.env.BASE_URL || '/';
const normalizedBase = base.endsWith('/') ? base : `${base}/`;
let logicalPath = Astro.url.pathname;
if (normalizedBase !== '/' && logicalPath.startsWith(normalizedBase)) {
  logicalPath = `/${logicalPath.slice(normalizedBase.length)}`;
}
if (!logicalPath.startsWith('/')) logicalPath = `/${logicalPath}`;

const segments = logicalPath.split('/').filter(Boolean);
const breadcrumbLabels: Record<string, string> = {
  strany: 'Страны',
  tury: 'Туры',
  napravleniya: 'Направления',
  'po-interesam': 'По интересам',
  dmc: 'Для агентств',
  'dlya-turagentstv': 'Для турагентств',
  'usloviya-raboty': 'Условия работы',
  mice: 'MICE',
  'delovye-delegacii': 'Деловые делегации',
  vip: 'VIP',
  'multi-country': 'Multi-country',
  about: 'О нас',
  team: 'Команда',
  contacts: 'Контакты',
  cases: 'Кейсы',
  reviews: 'Отзывы',
  articles: 'Статьи',
  braziliya: 'Бразилия',
  argentina: 'Аргентина',
  peru: 'Перу',
  'rio-de-zhanejro': 'Рио-де-Жанейро',
  'foz-do-iguasu': 'Игуасу',
  'manaus-amazonia': 'Амазония',
  pantanal: 'Пантанал',
  'buenos-ajres': 'Буэнос-Айрес',
  'el-kalafate': 'Эль-Калафате',
  mendosa: 'Мендоса',
  kusko: 'Куско',
  'machu-pikchu': 'Мачу-Пикчу',
  lima: 'Лима',
};

const pageTitle = title.replace(/\s*[|–—-]\s*Ada Tours.*$/i, '').trim();
const breadcrumbItems = [
  { name: 'Главная', url: new URL('/', SITE.url).toString() },
  ...segments.map((segment, index) => ({
    name: breadcrumbLabels[segment] ?? (index === segments.length - 1 ? pageTitle : segment.replace(/-/g, ' ')),
    url: new URL(`/${segments.slice(0, index + 1).join('/')}/`, SITE.url).toString(),
  })),
];

const organizationSchema = {
  '@type': ['Organization', 'TravelAgency'],
  '@id': `${SITE.url}/#organization`,
  name: ORG.brand,
  legalName: ORG.legal.name,
  url: SITE.url,
  email: ORG.contacts.email,
  telephone: ORG.contacts.phoneDisplay,
  sameAs: Object.values(ORG.externalProfiles),
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'CNPJ',
    value: ORG.legal.cnpj,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: ORG.legal.streetAddress,
    addressLocality: ORG.legal.addressLocality,
    addressRegion: ORG.legal.addressRegion,
    postalCode: ORG.legal.postalCode,
    addressCountry: ORG.legal.addressCountry,
  },
};

const webSiteSchema = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  inLanguage: lang,
  publisher: { '@id': `${SITE.url}/#organization` },
};

const webPageSchema = {
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: fullTitle,
  description,
  inLanguage: lang,
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#organization` },
};

const breadcrumbSchema = segments.length > 0 ? {
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumb`,
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
} : null;

const extraSchemas = !pageSchema ? [] : (Array.isArray(pageSchema) ? pageSchema : [pageSchema]);
const graph = [
  organizationSchema,
  webSiteSchema,
  webPageSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...extraSchemas,
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="120x120" href={faviconUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
    {(isPreview || noindex) && <meta name="robots" content="noindex,nofollow,noarchive" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="theme-color" content="#131412" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    <SiteHeader theme={headerTheme} />
    {showBreadcrumbs && !noindex && segments.length > 0 && (
      <Breadcrumbs pathname={Astro.url.pathname} title={title} theme={headerTheme} />
    )}
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

---
import { getCollection, render } from 'astro:content';
import ExcursionLayout from '../../layouts/ExcursionLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('excursions', ({ data }) =>
    data.locale === 'ru' && !['draft', 'archived'].includes(data.status)
  );
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ExcursionLayout entry={entry}>
  <Content />
</ExcursionLayout>

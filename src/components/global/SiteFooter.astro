---
import { FOOTER_NAV_LINKS, SITE } from '../../lib/site';
import { withBase } from '../../lib/paths';
import { ORG } from '../../data/organization/ada-tours';
---

<footer class="footer">
  <div class="footer__top">
    <div>
      <p class="eyebrow">Ada Tours</p>
      <h2>Бразилия и Латинская Америка</h2>
    </div>
    <a class="footer__request" href={withBase('/contacts/')} data-lead-modal="true" aria-label="Обсудить поездку — открыть форму заявки">Обсудить поездку <span aria-hidden="true">↗</span></a>
  </div>

  <div class="footer__grid">
    <nav aria-label="Навигация в подвале">
      {FOOTER_NAV_LINKS.map((link) => <a href={withBase(link.href)}>{link.label}</a>)}
    </nav>

    <div class="footer__meta">
      <p>© {new Date().getFullYear()} {SITE.name}</p>
      <a href={ORG.whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a href={ORG.telegramHref} target="_blank" rel="noopener noreferrer">Telegram</a>
      <a href={ORG.phoneHref}>{ORG.phoneDisplay}</a>
      <a href={`mailto:${ORG.email}`}>{ORG.email}</a>
      <a href={withBase('/privacy/')}>Политика конфиденциальности</a>
      <a href={withBase('/personal-data/')}>Обработка персональных данных</a>
    </div>
  </div>

  <div class="footer__credit">
    <a href="https://gaeo.ru" target="_blank" rel="noopener noreferrer">Разработка сайта и продвижение в нейросетях - GAEO.ru</a>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(24px, 3vw, 40px) var(--gutter) 36px;
    color: var(--color-bg);
    background: var(--color-ink-deep);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 48px;
    padding-bottom: var(--section-y-tight);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .footer h2 {
    max-width: 950px;
    margin: 12px 0 0;
  }

  /* Primary conversion action on the dark footer, styled as a real CTA. */
  .footer__request {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-width: 275px;
    min-height: 58px;
    padding: 18px 24px;
    border: 1px solid var(--cta-border);
    border-radius: var(--radius-cta);
    color: var(--color-bg);
    background: var(--cta-fill-dark);
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }

  .footer__request:hover {
    border-color: var(--cta-border-hover);
    background: var(--cta-fill-dark-hover);
  }

  .footer__request:focus-visible {
    outline: 2px solid var(--color-bg);
    outline-offset: 4px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 48px;
    padding-top: var(--section-y-tight);
  }

  .footer nav,
  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    align-items: center;
  }

  .footer nav a,
  .footer__meta {
    font-size: 0.82rem;
  }

  .footer__meta {
    justify-content: flex-end;
    color: rgba(255,255,255,.6);
  }

  .footer__meta p {
    margin: 0;
    font-size: inherit;
  }

  .footer__credit {
    margin-top: clamp(20px, 2.5vw, 32px);
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    text-align: center;
    font-size: 0.76rem;
  }

  .footer__credit a {
    color: rgba(255, 255, 255, 0.65);
  }

  .footer__credit a:hover {
    color: var(--color-bg);
    text-decoration: underline;
  }

  .footer__credit a:focus-visible {
    outline: 2px solid var(--color-bg);
    outline-offset: 4px;
  }

  @media (max-width: 780px) {
    .footer__top,
    .footer__grid {
      grid-template-columns: 1fr;
    }

    .footer__top {
      gap: 32px;
    }

    .footer__request {
      width: 100%;
      min-width: 0;
    }

    .footer__meta {
      justify-content: flex-start;
    }
  }
</style>

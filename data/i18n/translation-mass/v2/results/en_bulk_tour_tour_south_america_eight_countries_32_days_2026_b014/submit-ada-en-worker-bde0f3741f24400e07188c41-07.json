      },
      "text": "Buenos Aires sightseeing tour and tango show with dinner"
    },
    {
      "blockId": "tour:itinerary_text:fb5db666cae6efb7",
      "field": "itinerary.text",
      "sourceTextSha256": "0c1dff61217983815e905b8640de05f7afe9331d884d7237eb2a5abb1c50d9e0",
      "provenance": {
        "kind": "ai_translation",

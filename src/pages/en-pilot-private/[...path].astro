---
/** Non-public Astro output only. EN_PILOT_PREVIEW=1 is necessary and never
 * authorises a public locale deployment. The three frozen JSON inputs are
 * copied from pinned i18n/three-tour-preview into the CI workspace.
 */
import '../../styles/tokens.css';
import '../../styles/typography.css';
import '../../styles/global.css';
import {readFile} from 'node:fs/promises';
import {resolve,join} from 'node:path';
import {
 PILOT_TOURS,privatePilotEnabled,pilotTourUrl,pilotCatalogUrl,
 assertPilotRenderSource,pilotMediaUrl,formatPilotPrice,renderPilotMarkdown
} from '../../lib/i18n/pilot-html.mjs';

export async function getStaticPaths(){
 if(!privatePilotEnabled(process.env))return [];
 const root=resolve(process.cwd(),'data/i18n/pilot-previews/v1');
 const json=async p=>JSON.parse(await readFile(join(root,p),'utf8'));
 const summary=await json('summary.json');
 const records=await Promise.all(PILOT_TOURS.map(t=>json('rendered/'+t.id+'.json')));
 assertPilotRenderSource(records,summary);
 const cards=records.map(record=>{
  const d=record.data;
  return {id:record.id,title:d.title,slug:d.slug,lead:d.lead,
   price:d.priceFrom,currency:d.currency,days:d.durationDays,
   nights:d.durationNights,photo:pilotMediaUrl(d.hero.src),
   alt:d.hero.alt||d.title};
 });
 return [
  {params:{path:'tours'},props:{kind:'catalog',cards}},
  ...records.map(record=>({params:{path:'tour/'+record.data.slug},
   props:{kind:'tour',record,cards}}))
 ];
}

interface TourSummary {
 id:string;title:string;slug:string;lead:string;price:number;currency:string;
 days:number;nights?:number;photo:string;alt:string;
}
interface Props {
 kind:'catalog'|'tour';
 cards:TourSummary[];
 record?:{id:string;locale:string;data:any;body:string};
}
const {kind,cards,record}=Astro.props as Props;
const d=record?.data;
if(kind==='tour'&&!d)throw Error('Private pilot route requires approved EN Tour data');
const days=Array.isArray(d?.itinerary)?d.itinerary.filter(x=>Number.isInteger(x.day)):[];
const media=(item?:{src?:string}|null)=>item?.src?pilotMediaUrl(item.src):null;
const headline=kind==='catalog'?'Three journeys, one Latin America':d.title;
const pageTitle=kind==='catalog'
 ? 'Latin America — Three Journeys | Ada Tours Internal English Preview'
 : headline+' | Ada Tours Internal English Preview';
const pageDescription=kind==='catalog'
 ? 'Three carefully curated Latin American programmes. An internal non-public English language preview from Ada Tours.'
 : String(d.lead).slice(0,160);
const bodyHtml=kind==='tour'?renderPilotMarkdown(record!.body):'';
const messageSubject=kind==='tour'?'Enquiry about '+headline+' — Ada Tours':'Travel enquiry — Ada Tours';
const mailto='mailto:adatours@adatours.com?subject='+encodeURIComponent(messageSubject);
---
<!doctype html>
<html lang="en" data-ada-en-pilot="true" data-public-release="false">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
  <meta name="referrer" content="no-referrer" />
  <meta name="description" content={pageDescription} />
  <meta name="generator" content={Astro.generator} />
  <meta name="color-scheme" content="light" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{pageTitle}</title>
  <!-- No canonical/hreflang/production JSON-LD: this is a closed, unhosted pilot artifact. -->
</head>
<body>
  <a class="pilot-skip" href="#content">Skip to content</a>
  <header class="pilot-header">
    <div class="container pilot-nav">
      <a href={pilotCatalogUrl()} class="pilot-wordmark" aria-label="Ada Tours English pilot home">
        <img src="/brand/adatours-logo-black.svg" width="158" height="36" alt="Ada Tours" />
      </a>
      <nav class="pilot-links" aria-label="Private English pilot navigation">
        <a href={pilotCatalogUrl()} aria-current={kind==='catalog'?'page':undefined}>Journeys</a>
        {kind==='tour' && <a href="#itinerary">Itinerary</a>}
        {kind==='tour' && <a href="#prices">Prices</a>}
        {kind==='tour' && <a href="#included">Inclusions</a>}
      </nav>
      <span class="pilot-pill">Private EN preview</span>
    </div>
  </header>
  <main id="content">
    {kind==='catalog' ? (
      <>
        <section class="pilot-index-hero">
          <div class="container pilot-index-copy">
            <p class="pilot-eyebrow">ADA TOURS · LATIN AMERICA · 2027</p>
            <h1>Three journeys,<br /><em>one Latin America.</em></h1>
            <p>Explore Brazil, Chile and Colombia through three tailor-made programmes. The same trusted routes and shared commercial data, presented in English.</p>
          </div>
        </section>
        <section class="container pilot-index-section" aria-labelledby="pilot-index-title">
          <div class="pilot-section-heading">
            <span class="pilot-kicker">SELECTED JOURNEYS</span>
            <h2 id="pilot-index-title">Discover the programmes</h2>
            <p>Every preview below uses an independently checked English Tour model. Booking and publishing workflows are not active in this pilot.</p>
          </div>
          <div class="pilot-cards" data-pilot-tour-count={cards.length}>
            {cards.map(card=>(
              <article class="pilot-card">
                <a href={pilotTourUrl(card.slug)} class="pilot-card-photo" aria-label={'View '+card.title}>
                  <img src={card.photo} alt={card.alt} width="660" height="470" loading="lazy" decoding="async" />
                  <span class="pilot-card-duration">{card.days} days · {card.nights} nights</span>
                </a>
                <div class="pilot-card-content">
                  <p class="pilot-kicker">TAILOR-MADE JOURNEY</p>
                  <h3><a href={pilotTourUrl(card.slug)}>{card.title}</a></h3>
                  <p>{card.lead}</p>
                  <div class="pilot-card-bottom">
                    <span>From <strong>{formatPilotPrice(card.price,card.currency)}</strong> per person</span>
                    <a href={pilotTourUrl(card.slug)} aria-label={'Explore '+card.title}>Explore journey <span aria-hidden="true">↗</span></a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      </>
    ) : (
      <>
        <section class="pilot-hero" aria-labelledby="tour-title">
          <img class="pilot-hero-photo" src={media(d.hero)} width="1600" height="920"
               alt={d.hero?.alt||d.title} decoding="async" />
          <div class="pilot-hero-overlay"></div>
          <div class="container pilot-hero-content">
            <nav class="pilot-breadcrumb" aria-label="Breadcrumbs">
              <a href={pilotCatalogUrl()}>Journeys</a><span aria-hidden="true">/</span><span>{headline}</span>
            </nav>
            <p class="pilot-eyebrow">ADA TOURS · PRIVATE JOURNEY · 2027</p>
            <h1 id="tour-title">{headline}</h1>
            <p class="pilot-hero-description">{d.lead}</p>
            <div class="pilot-hero-actions">
              <a class="pilot-button" href="#itinerary">Explore itinerary <span aria-hidden="true">↓</span></a>
              <a class="pilot-secondary-action" href="#prices">From {formatPilotPrice(d.priceFrom,d.currency)} per person</a>
            </div>
          </div>
        </section>
        <section class="pilot-stats container" aria-label="Journey at a glance">
          <div><span>Duration</span><strong>{d.durationDays} days</strong></div>
          <div><span>Accommodation</span><strong>{d.durationNights} nights</strong></div>
          <div><span>Route</span><strong>{d.route?.length??0} highlights</strong></div>
          <div><span>Starting at</span><strong>{formatPilotPrice(d.priceFrom,d.currency)}</strong><small>Per person · USD</small></div>
        </section>
        {Array.isArray(d.route)&&d.route.length>0&&(
          <section class="pilot-route container" aria-labelledby="pilot-route-title">
            <p class="pilot-kicker">AT A GLANCE</p>
            <h2 id="pilot-route-title">Places along the way</h2>
            <ul class="pilot-route-tags">{d.route.map((name:string)=><li>{name}</li>)}</ul>
          </section>
        )}
        <section class="pilot-itinerary container" id="itinerary" aria-labelledby="itinerary-title">
          <div class="pilot-section-heading">
            <span class="pilot-kicker">THE JOURNEY</span>
            <h2 id="itinerary-title">Day by day</h2>
            <p>Experiences and services follow the matched English Word 2027 programme. Additional excursions are offered only where specified.</p>
          </div>
          <div class="pilot-days" data-pilot-day-count={days.length}>
            {days.map((day:any)=>(
              <article class="pilot-day" id={'day-'+day.day} data-pilot-day={day.day}>
                {day.images?.[0]?.src ? (
                  <div class="pilot-day-image">
                    <img src={media(day.images[0])} alt={day.images[0].alt||day.title} width="900" height="670" loading="lazy" decoding="async" />
                  </div>
                ) : <div class="pilot-day-image pilot-image-empty" aria-hidden="true"></div>}
                <div class="pilot-day-copy">
                  <p class="pilot-kicker">DAY {String(day.day).padStart(2,'0')}</p>
                  <h3>{day.title}</h3>
                  {day.places?.length>0&&<p class="pilot-day-places">{day.places.join(' · ')}</p>}
                  <div class="pilot-day-description">{day.text}</div>
                </div>
              </article>
            ))}
          </div>
        </section>
        <section class="pilot-prices" id="prices" aria-labelledby="pricing-title">
          <div class="container pilot-prices-grid">
            <div class="pilot-price-aside">
              <span class="pilot-kicker">2027 TARIFFS · USD</span>
              <h2 id="pricing-title">Your journey,<br /><em>thoughtfully priced.</em></h2>
              <p class="pilot-from">From <strong>{formatPilotPrice(d.priceFrom,d.currency)}</strong> per person</p>
              <p>{d.priceNote}</p>
              <a class="pilot-button pilot-button-dark" href="#enquiry">Ask about your dates <span aria-hidden="true">↗</span></a>
            </div>
            <div class="pilot-body-markdown" set:html={bodyHtml} data-pilot-markdown="true"></div>
          </div>
        </section>
        <section class="pilot-services container" id="included" aria-labelledby="services-title">
          <div class="pilot-section-heading">
            <span class="pilot-kicker">TRAVEL DETAILS</span>
            <h2 id="services-title">What is included</h2>
          </div>
          <div class="pilot-services-grid">
            <div><h3>Included in your journey</h3><ul class="pilot-service-list pilot-list-plus">{d.included?.map((s:string)=><li>{s}</li>)}</ul></div>
            <div><h3>Not included</h3><ul class="pilot-service-list pilot-list-minus">{d.notIncluded?.map((s:string)=><li>{s}</li>)}</ul></div>
          </div>
          {d.notes?.length>0&&(
            <div class="pilot-notes"><h3>Important information</h3><ul>{d.notes.map((s:string)=><li>{s}</li>)}</ul></div>
          )}
        </section>
        <section class="pilot-more container" aria-label="Explore other pilot journeys">
          <div><span class="pilot-kicker">KEEP EXPLORING</span><h2>Beyond this journey</h2></div>
          <div class="pilot-other-tours">
            {cards.filter(c=>c.id!==record!.id).map(c=>(
              <a href={pilotTourUrl(c.slug)}>
                <span>{c.title}</span><small>{c.days} days · From {formatPilotPrice(c.price,c.currency)}</small><span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      </>
    )}
    <section class="pilot-contact" id="enquiry" aria-labelledby="enquiry-title">
      <div class="container pilot-contact-grid">
        <div>
          <span class="pilot-kicker">ADA TOURS · HERE FOR YOU</span>
          <h2 id="enquiry-title">A journey shaped around you.</h2>
          <p>Share your dates and preferences to discuss a tailor-made itinerary. Online form submission is not enabled in this private preview.</p>
        </div>
        <a class="pilot-button" href={mailto}>Enquire by email <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
  <footer class="pilot-footer">
    <div class="container">
      <strong>Ada Tours</strong>
      <p>English language pilot · Internal review copy · Not a public booking website</p>
      <a href={pilotCatalogUrl()}>Back to journeys</a>
    </div>
  </footer>
</body>
</html>

<style>
.pilot-skip{position:absolute;transform:translateY(-180%);background:#fff;padding:.7rem 1.4rem;z-index:1000}
.pilot-skip:focus{transform:translateY(0)}
.pilot-header{height:76px;position:relative;z-index:10;background:var(--color-bg);border-bottom:1px solid var(--color-line)}
.pilot-nav{display:flex;align-items:center;justify-content:space-between;gap:1.25rem;height:100%}
.pilot-wordmark{display:flex;align-items:center;flex-shrink:0}
.pilot-wordmark img{object-fit:contain;max-height:40px;width:auto}
.pilot-links{display:flex;align-items:center;gap:clamp(1rem,2.2vw,2rem);font-size:.92rem;font-weight:520}
.pilot-links a{padding:.7rem .1rem;border-bottom:2px solid transparent}
.pilot-links a:hover,.pilot-links a[aria-current="page"]{border-color:var(--color-brand)}
.pilot-pill{font-size:.67rem;letter-spacing:.08em;text-transform:uppercase;color:var(--color-brand-deep);background:var(--color-brand-soft);border-radius:99px;padding:.5rem .8rem;white-space:nowrap}
.pilot-eyebrow,.pilot-kicker{font-size:.73rem;text-transform:uppercase;letter-spacing:.16em;font-weight:650}
.pilot-eyebrow{color:var(--color-brand)}
.pilot-kicker{color:var(--color-brand-deep)}
.pilot-index-hero{background:var(--color-ink-deep);color:var(--color-bg);padding-block:clamp(88px,10vw,160px)}
.pilot-index-copy{max-width:1000px}
.pilot-index-copy h1{font-family:var(--font-display);font-size:clamp(3.4rem,7vw,7.2rem);line-height:.99;font-weight:400;letter-spacing:-.045em;margin:1.1rem 0}
.pilot-index-copy h1 em,.pilot-price-aside h2 em{font-style:normal;color:var(--color-brand)}
.pilot-index-copy>p:last-child{font-size:clamp(1.07rem,2vw,1.4rem);line-height:1.6;max-width:690px;color:#e7e7e7}
.pilot-index-section{padding-block:clamp(65px,7vw,120px)}
.pilot-section-heading{max-width:790px;margin-bottom:clamp(30px,4vw,60px)}
.pilot-section-heading h2,.pilot-route h2,.pilot-more h2{font-size:clamp(2.5rem,4.6vw,4.8rem);font-family:var(--font-display);font-weight:400;letter-spacing:-.035em;line-height:1.07;margin:1rem 0}
.pilot-section-heading p{max-width:680px;color:var(--color-text-muted);line-height:1.65;font-size:1.05rem}
.pilot-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1.2rem,2vw,2rem)}
.pilot-card{min-width:0;background:#fff;border:1px solid var(--color-line);display:flex;flex-direction:column}
.pilot-card-photo{height:clamp(215px,21vw,310px);display:block;overflow:hidden;position:relative;background:var(--color-surface-beige)}
.pilot-card-photo img,.pilot-hero-photo,.pilot-day-image img{width:100%;height:100%;object-fit:cover}
.pilot-card-photo img{transition:transform .5s ease}.pilot-card:hover img{transform:scale(1.04)}
.pilot-card-duration{position:absolute;bottom:14px;left:14px;background:#fff;padding:.5rem .9rem;font-size:.75rem}
.pilot-card-content{padding:1.6rem;display:flex;flex-direction:column;flex:1}
.pilot-card h3{font-family:var(--font-display);font-size:clamp(1.6rem,2.3vw,2.3rem);font-weight:400;margin:1rem 0}
.pilot-card-content>p:not(.pilot-kicker){font-size:.96rem;line-height:1.55;color:var(--color-text-muted);flex:1}
.pilot-card-bottom{border-top:1px solid var(--color-line);display:flex;justify-content:space-between;gap:1rem;padding-top:1.2rem;margin-top:1.25rem;align-items:center;flex-wrap:wrap;font-size:.84rem}
.pilot-card-bottom strong{font-size:1.35rem;font-weight:600}
.pilot-card-bottom a{color:var(--color-brand-deep);font-weight:700}
.pilot-hero{min-height:clamp(580px,49vw,790px);display:flex;align-items:end;position:relative;background:#272e2b;color:#fff;overflow:hidden}
.pilot-hero-photo,.pilot-hero-overlay{position:absolute;inset:0;width:100%;height:100%}
.pilot-hero-overlay{background:linear-gradient(90deg,rgba(3,17,16,.78),rgba(3,17,16,.22)),linear-gradient(0deg,rgba(4,9,8,.44),transparent 60%);z-index:1}
.pilot-hero-content{position:relative;z-index:2;padding-block:100px 80px}
.pilot-breadcrumb{display:flex;align-items:center;gap:.8rem;font-size:.84rem;color:#fff;opacity:.9;margin-bottom:clamp(40px,6vw,75px);flex-wrap:wrap}
.pilot-breadcrumb a{text-decoration:underline;text-underline-offset:4px}
.pilot-hero h1{font-family:var(--font-display);font-weight:400;font-size:clamp(3.3rem,6.8vw,7.2rem);max-width:1050px;letter-spacing:-.045em;line-height:1.01;margin:.9rem 0 1.3rem}
.pilot-hero-description{font-size:clamp(1.06rem,1.45vw,1.22rem);line-height:1.66;max-width:770px;color:#f3f3f3}
.pilot-hero-actions{display:flex;gap:1.3rem;align-items:center;flex-wrap:wrap;margin-top:2rem}
.pilot-button{display:inline-flex;gap:1.3rem;align-items:center;justify-content:space-between;background:var(--color-brand);border:1px solid var(--color-brand);color:#062c2e;font-weight:650;padding:1rem 1.5rem;min-height:52px;border-radius:8px;transition:background .2s}
.pilot-button:hover{background:#79dce1}
.pilot-secondary-action{text-decoration:underline;text-underline-offset:4px;font-weight:650}
.pilot-stats{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--color-line);padding-block:2rem;gap:1.2rem}
.pilot-stats>div{display:flex;flex-direction:column;gap:.4rem;min-width:0}
.pilot-stats span{font-size:.74rem;color:var(--color-text-muted);letter-spacing:.08em;text-transform:uppercase}
.pilot-stats strong{font-size:clamp(1.18rem,2.1vw,1.65rem);font-weight:520}
.pilot-stats small{color:var(--color-text-muted);font-size:.78rem}
.pilot-route{padding-block:clamp(40px,5vw,75px);border-bottom:1px solid var(--color-line)}
.pilot-route h2{font-size:clamp(1.8rem,3vw,3rem)}
.pilot-route-tags{display:flex;flex-wrap:wrap;gap:.75rem;padding:0;margin:1.5rem 0 0;list-style:none}
.pilot-route-tags li{border-radius:99px;border:1px solid var(--color-line);padding:.7rem 1.1rem;font-size:.87rem}
.pilot-itinerary{padding-block:clamp(65px,7vw,110px)}
.pilot-days{display:grid;gap:clamp(1.5rem,5vw,4.5rem)}
.pilot-day{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(1.5rem,5vw,6rem);align-items:center}
.pilot-day:nth-child(even) .pilot-day-image{order:2}
.pilot-day-image{aspect-ratio:1.3;background:var(--color-surface-beige);overflow:hidden}
.pilot-day-copy{padding-block:1rem}
.pilot-day-copy h3{font-family:var(--font-display);font-size:clamp(2rem,3.2vw,3.4rem);font-weight:400;letter-spacing:-.025em;line-height:1.1;margin:.9rem 0 1.2rem}
.pilot-day-places{font-size:.83rem;letter-spacing:.02em;color:var(--color-brand-deep);margin:0 0 1.4rem}
.pilot-day-description{white-space:pre-line;line-height:1.75;max-width:70ch;color:#373737}
.pilot-prices{padding-block:clamp(64px,7vw,115px);background:var(--color-surface-beige)}
.pilot-prices-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);align-items:start;gap:clamp(2rem,6vw,6rem)}
.pilot-price-aside h2{font-family:var(--font-display);font-size:clamp(2.3rem,3.5vw,4.2rem);line-height:1.08;font-weight:400;margin:1rem 0 1.5rem}
.pilot-price-aside>p{line-height:1.6;color:var(--color-text-muted)}
.pilot-from strong{font-size:clamp(1.8rem,3vw,3rem);font-weight:560;color:var(--color-ink);white-space:nowrap}
.pilot-button-dark{background:var(--color-ink);color:white;border-color:var(--color-ink);margin-top:1rem}
.pilot-button-dark:hover{background:#344444;color:white}
.pilot-body-markdown{min-width:0;font-size:.95rem;line-height:1.7}
.pilot-body-markdown :global(h2){font-size:1.9rem;font-family:var(--font-display);font-weight:500;margin:0 0 1.3rem}
.pilot-body-markdown :global(h3){font-size:1.4rem;margin:1.8rem 0 .8rem}
.pilot-body-markdown :global(p){margin:0 0 1.25rem}
.pilot-body-markdown :global(.pilot-table-scroll){overflow-x:auto;margin:1.5rem 0}
.pilot-body-markdown :global(table){width:100%;border-collapse:collapse;text-align:left;min-width:400px;font-size:.9rem}
.pilot-body-markdown :global(th){font-size:.7rem;text-transform:uppercase;letter-spacing:.05em}
.pilot-body-markdown :global(th),.pilot-body-markdown :global(td){padding:.78rem .75rem;border-bottom:1px solid var(--color-line);vertical-align:top}
.pilot-services{padding-block:clamp(65px,7vw,115px)}
.pilot-services-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,5rem)}
.pilot-services h3{font-family:var(--font-display);font-size:clamp(1.7rem,2.5vw,2.35rem);font-weight:500;margin:0 0 1rem}
.pilot-service-list{padding:0;margin:0;list-style:none}
.pilot-service-list li{position:relative;padding:1rem 1rem 1rem 1.7rem;border-top:1px solid var(--color-line);line-height:1.55}
.pilot-service-list li::before{content:'+';position:absolute;left:.2rem;color:var(--color-brand-deep);font-weight:700}
.pilot-list-minus li::before{content:'−'}
.pilot-notes{margin-top:3rem;padding-top:2rem;border-top:1px solid var(--color-line);max-width:820px}
.pilot-notes h3{font-size:1.5rem}.pilot-notes ul{padding-left:1.4rem;line-height:1.75}
.pilot-more{padding-block:clamp(30px,5vw,80px);border-top:1px solid var(--color-line);display:grid;grid-template-columns:.8fr 1.2fr;gap:2rem}
.pilot-more h2{font-size:2rem}
.pilot-other-tours{display:grid;gap:0}
.pilot-other-tours a{display:grid;grid-template-columns:1fr auto;gap:.4rem 1.5rem;padding:1.2rem 0;border-bottom:1px solid var(--color-line)}

---
import AuthorityInline from './AuthorityInline.astro';

interface Props {
  title: string;
  items: Array<{ question: string; answerMarkdown: string }>;
}
const { title, items } = Astro.props;
---

<section id="faq" class="authority-faq section" aria-labelledby="authority-faq-title">
  <div class="container authority-faq__grid">
    <header>
      <p class="eyebrow">Вопросы и ответы</p>
      <h2 id="authority-faq-title">{title}</h2>
    </header>
    <div class="authority-faq__list">
      {items.map((item) => (
        <details>
          <summary><h3>{item.question}</h3><span class="authority-faq__plus" aria-hidden="true"></span></summary>
          <p><AuthorityInline text={item.answerMarkdown} /></p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .authority-faq { scroll-margin-top: calc(var(--header-h) + 24px); }
  .authority-faq__grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.25fr); gap: clamp(28px, 5vw, 72px); }
  .eyebrow { margin: 0 0 14px; color: var(--color-brand-deep); }
  h2 { margin: 0; font-size: clamp(1.9rem, 2.6vw, 2.85rem); line-height: 1.12; }
  .authority-faq__list { border-top: 1px solid var(--color-line); }
  details { border-bottom: 1px solid var(--color-line); }
  summary { display: grid; grid-template-columns: minmax(0, 1fr) 20px; align-items: center; gap: 18px; padding: 22px 0; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: clamp(1.12rem, 1.45vw, 1.4rem); line-height: 1.3; text-wrap: pretty; }
  .authority-faq__plus { position: relative; width: 18px; height: 18px; }
  .authority-faq__plus::before,
  .authority-faq__plus::after { content: ''; position: absolute; inset: 8px 1px auto; height: 1px; background: var(--color-brand-deep); }
  .authority-faq__plus::after { transform: rotate(90deg); transition: transform 180ms var(--ease-out); }
  details[open] .authority-faq__plus::after { transform: rotate(0); }
  details > p { margin: -2px 0 24px; padding-right: 30px; color: var(--color-text-muted); }
  @media (max-width: 820px) { .authority-faq__grid { grid-template-columns: 1fr; gap: 24px; } }
</style>

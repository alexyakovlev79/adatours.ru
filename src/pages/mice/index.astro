---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import MiceNav from '../../components/commercial/MiceNav.astro';
import CommercialDetails from '../../components/commercial/CommercialDetails.astro';
import CommercialCaseGrid from '../../components/commercial/CommercialCaseGrid.astro';
import CommercialExpert from '../../components/commercial/CommercialExpert.astro';
import CommercialSearchRecord from '../../components/commercial/CommercialSearchRecord.astro';
import DmcFaq from '../../components/commercial/DmcFaq.astro';

const hero = '/media/commercial/mice/rio-meeting-generated-20261022.webp';
const title = 'MICE в Бразилии и Латинской Америке | Ada Tours';
const description = 'Корпоративные поездки, incentive и деловые группы с Ada Tours: размещение, транспорт, переводчики и программа на месте. Выполненные кейсы и расчет под вашу задачу.';
---

<BaseLayout leadTitle="Рассчитать MICE или корпоративную поездку" leadEntityId="mice" title={title} description={description} image={hero}>
  <CommercialSearchRecord id="mice" title="MICE и корпоративные поездки" description={description} image={hero} keywords={['MICE', 'МИСЕ', 'корпоративные поездки', 'incentive', 'инсентив', 'конференции', 'деловые группы']} />
  <Hero compact compactCta mobilePhotoLead
    eyebrow="Бразилия и Латинская Америка · MICE"
    title="MICE и корпоративные поездки в Латинской Америке"
    intro="Переговоры в Сан-Паулу, конференция в Буэнос-Айресе или поощрительное путешествие по Бразилии. Ada Tours собирает маршрут, размещение, транспорт и программу, а затем координирует поездку на месте."
    image={hero} ctaHref="#request" ctaLabel="Обсудить поездку команды" />
  <MiceNav active="overview" />

  <FactStrip facts={[
    { value: '30 гостей', label: 'в корпоративном кейсе Рио — Ангра' },
    { value: '8 участников', label: 'в кейсе делегации Сан-Паулу — Кампинас' },
    { value: '7 языков', label: 'коммуникации с командой Ada Tours' },
    { value: 'Рио-де-Жанейро', label: 'офис принимающей компании' },
  ]} />

  <CommercialDetails id="mice-formats" eyebrow="Какую задачу решаем" title="Рабочая программа и впечатления от страны в одной поездке"
    intro="Начинаем с цели: провести встречи, поощрить сотрудников, познакомить партнеров или принять группу на отраслевом событии. Под нее выбираем города, продолжительность и состав услуг."
    rows={[
      { title: 'Конференции и конгрессы', text: 'Привязываем отель, трансферы, питание и экскурсии к расписанию события. Участникам рабочих сессий и сопровождающим можно собрать разные дневные программы. В [примерах MICE-маршрутов](/mice/programmes/) есть конференционная Бразилия и конгрессная поездка в Буэнос-Айрес.' },
      { title: 'Поощрительные поездки', text: 'Прогулка на катамаране, водопады Игуасу, острова Ангры, ужин и знакомство с местной кухней: выбираем впечатления под интересы команды. Продумываем переезды, длительность активностей и свободное время.' },
      { title: 'Деловые делегации', text: 'Для [переговоров и профессиональных визитов](/mice/business-delegations/) связываем график встреч с транспортом и переводчиками. Помогаем найти профильные организации, связаться с ними и согласовать посещение.' },
      { title: 'Корпоративные группы', text: 'Собираем общую программу для гостей с разными рейсами и пожеланиями. Отдельно прорабатываем встречи в аэропорту, расселение, групповые выезды, вечернее мероприятие и возвращение в отель.' },
    ]} />

  <CommercialCaseGrid id="mice-cases" title="Как это было у наших клиентов"
    intro="В этих проектах Ada Tours организовала наземное обслуживание и сопровождение групп. В кейсах показаны задача, состав работ и решения во время поездки."
    caseIds={['case_mice_corporate_group_rio_angra_2026', 'case_mice_business_delegation_sao_paulo_2026']}
    summaries={{
      case_mice_corporate_group_rio_angra_2026: '30 гостей, автобусы и гиды, 6 часов на катамаране с питанием, гала-ужин и ночной трансфер. Все части поездки собраны в общий график.',
      case_mice_business_delegation_sao_paulo_2026: '8 участников, Сан-Паулу, Кампинас и Гуаружа. Транспорт на длинные рабочие дни и перевод на русском, португальском и английском сопровождали меняющееся расписание встреч.',
    }} />

  <CommercialDetails id="mice-operations" eyebrow="Работа принимающей команды" title="Что берем на себя до поездки и на месте"
    rows={[
      { title: 'Расписание и транспорт', text: 'Сопоставляем прилеты, адреса, время встреч и выездов. Подбираем автомобили или автобусы, закладываем время на посадку группы, переезды и возвращение после вечерней программы.' },
      { title: 'Размещение и площадки', text: 'Подбираем отели по географии рабочих встреч, категории и составу номеров. Площадки, оборудование, питание и дополнительные услуги включаем в расчет по вашему заданию; статус каждой позиции отражаем в предложении.' },
      { title: 'Гиды и переводчики', text: 'Для экскурсий подбираем гидов, для переговоров и профессиональных визитов — переводчиков под нужную языковую пару и тематику. Формат сопровождения фиксируем в программе.' },
      { title: 'Координация и изменения', text: 'Назначаем контакт для подготовки и передаем контакты на время поездки. Если меняется расписание, связываемся с поставщиками и предлагаем варианты. Часы связи и порядок срочных обращений согласуем для проекта.' },
    ]} />

  <CommercialDetails id="mice-estimate" eyebrow="Расчет под вашу группу" title="Пришлите цель, даты и ориентир по бюджету"
    intro="Для первого обсуждения достаточно рабочего брифа. Если часть решений еще открыта, укажите варианты: поможем сравнить их по программе и стоимости."
    rows={[
      { title: 'Кто и зачем едет', text: 'Число участников и сопровождающих, цель поездки, отрасль, языки, обязательные встречи и желаемые впечатления. Для корпоративного заказа добавьте требования к размещению и согласованию расходов.' },
      { title: 'Когда и по какому маршруту', text: 'Даты или диапазон, предполагаемые рейсы, города, продолжительность и события с фиксированным временем. В [каталоге программ](/mice/programmes/) можно выбрать отправную точку для маршрута.' },
      { title: 'Что войдет в предложение', text: 'Маршрут, включенные и исключенные услуги, расчет, исходные допущения и условия бронирования. Отдельно обозначаем позиции, которые ждут подтверждения поставщика или принимающей организации.' },
      { title: 'Если вы представляете агентство', text: 'Работаем с нетто-тарифом для вашей наценки или подходящей комиссионной моделью. Сохраняем коммерческую роль партнера и готовим согласованные материалы под его брендом. Подробнее — в [условиях сотрудничества](/dmc/terms/).' },
    ]} />

  <ProcessSteps eyebrow="От идеи до поездки" title="Четыре этапа подготовки" steps={[
    { title: 'Задача', text: 'Обсуждаем цели группы, даты, обязательные события и бюджет.' },
    { title: 'Предложение', text: 'Собираем маршрут и смету, проверяем доступность, согласуем правки.' },
    { title: 'Подтверждение', text: 'Письменно фиксируем услуги, стоимость и условия бронирования.' },
    { title: 'Поездка', text: 'Координируем подрядчиков и расписание, держим связь с организатором.' },
  ]} />

  <CommercialExpert text="Анна Аванесова руководит Ada Tours из Рио-де-Жанейро. Команда работает с корпоративными группами, делегациями и сложными маршрутами по региону. В разделе [партнеров](/partners/) собраны профессиональные профили компании, а на [вебинарах](/webinars/) можно познакомиться с подходом к направлениям до первого запроса." />

  <DmcFaq title="Что обсудить перед корпоративной поездкой" items={[
    { question: 'Можно ли совместить конференцию и поощрительную программу?', answer: 'Да. Рабочие сессии становятся опорными точками расписания, а экскурсии, ужины и выезды размещаем в свободные часы. Для сопровождающих можно подготовить отдельную программу. Продолжительность и состав услуг рассчитываем под вашу группу.' },
    { question: 'Работаете ли вы с небольшими делегациями?', answer: 'Да. Принимаем запросы от небольших делегаций до корпоративных групп. В опубликованном [деловом кейсе](/cases/business-delegation-sao-paulo-campinas-2026/) участвовали 8 человек; состав транспорта и сопровождения подбирали под их рабочий график.' },
    { question: 'За сколько времени отправлять запрос?', answer: 'Присылайте его, как только известны цель и предполагаемые даты. Профессиональные визиты, крупные группы и поездки во время событий требуют больше времени на согласование. После первого обсуждения определим последовательность подготовки и сроки решений.' },
    { question: 'Когда отель, площадка или другая услуга считаются подтвержденными?', answer: 'После письменного подтверждения, в котором зафиксированы соответствующая услуга и условия бронирования. В предложении показываем срок его действия и статус позиций. До подтверждения поставщика доступность и стоимость могут меняться.' },
    { question: 'Что происходит, если меняется число участников или дата поездки?', answer: 'Пересчитываем затронутые услуги. При уменьшении группы стоимость на человека может вырасти; перенос дат зависит от новой доступности. Применимые расходы, возвраты и правила изменений указаны в условиях конкретного бронирования.' },
    { question: 'Можно ли заказать поездку через свое агентство?', answer: 'Да. Ada Tours выступает принимающим партнером, а агентство сохраняет коммерческое общение с заказчиком. Тарифы, документы и контакты с участниками согласуем в рамках [агентской работы](/dmc/travel-agencies/).' },
  ]} />
</BaseLayout>

      "text": "3 Nov · Bolivia’s high-altitude lagoons by 4×4"
    },
    {
      "blockId": "tour:itinerary_text:173cf987634ed90a",
      "field": "itinerary.text",
      "sourceTextSha256": "ab4b71316b19c5fd4938b9b15c5eced5c262af6f73cd29c514cc57fd99f83dc8",

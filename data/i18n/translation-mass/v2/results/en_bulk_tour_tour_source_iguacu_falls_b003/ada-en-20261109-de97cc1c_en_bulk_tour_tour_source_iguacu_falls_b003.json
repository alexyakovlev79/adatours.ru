    {
      "blockId": "tour:contentBlock_text:54298f560222c331",
      "field": "contentBlock.text",
      "sourceTextSha256": "caa89d58487640b491e56b9696fe021e4c1976130f496134766df0f4c61f1eed",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-de97cc1c",
        "model": "gpt-6.1-sol"
      },
      "text": "Early in the morning, a professional makeup artist will come to your room to get the bride ready.\n\nYou’ll then be transferred to the ceremony venue, a viewpoint on the Brazilian side of the falls. After the ceremony, you’ll take a walk through some of the park’s most scenic areas."
    },
    {
      "blockId": "tour:contentBlock_text:eb1b95b07b033f5e",
      "field": "contentBlock.text",
      "sourceTextSha256": "6d16fa89dbe1a3eb7d37ae2d86a833c26f8598f7d3318b6da0e55d3bf16b8546",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-de97cc1c",
        "model": "gpt-6.1-sol"
      },
      "text": "A photo shoot will take place during the walk.\n\nIn the evening, we recommend a romantic dinner at a restaurant overlooking the falls."
    },
    {
      "blockId": "tour:media_alt:b9e3f1546ee0a2cb",
      "field": "media.alt",
      "sourceTextSha256": "3a1d5b493c454ce0c6e86051d0d308e20502f2f161734a91673a698c9e98e041",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-de97cc1c",
        "model": "gpt-6.1-sol"
      },
      "text": "A table set on a terrace overlooking Iguazu Falls at sunset"
    },
    {
      "blockId": "tour:media_hover:dd002863d880af1b",
      "field": "media.hover",
      "sourceTextSha256": "26d754175f2e1db6b2ea1cdc8663374291a4006dbea5403859ac601d892a3524",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-de97cc1c",
        "model": "gpt-6.1-sol"
      },
      "text": "Iguazu Falls: a table with flowers and an evening view of the falls"
    },
    {
      "blockId": "tour:itinerary_label:09e3218e786e0449",
      "field": "itinerary.label",
      "sourceTextSha256": "25c6586a1d4a1e1936bb6c06455c208035612c9ea9ab7f372286d6daa9df6507",
      "provenance": {

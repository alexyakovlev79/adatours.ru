    {
      "blockId": "tour:contentBlock_text:8f4bfecc125543b2",
      "field": "contentBlock.text",
      "sourceTextSha256": "7cfb7ba421a4ab9370867f5ab7305ef498f5b9b94a27d6a05bab03ca18919235",
      "text": "Discover the history of Cartagena de Indias on a city sightseeing tour in a comfortable vehicle.\nLed by a professional bilingual guide, the tour takes in panoramic views of Cartagena Bay, Pegasus Pier, the Clock Tower, the Manga district with its Moorish and Republican architecture, and the impressive San Felipe de Barajas fortress.\nExplore the historic walled centre, with stops to shop for souvenirs and walk through its streets and squares. Highlights include San Pedro Claver Church and the Santo Domingo Bastion.\nReturn to the hotel.\nDuration: 4 hours.\n\nThe tour is led by an English-speaking guide.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-translator-20261109-mw9q1icj-eexlx1dza",
        "model": "GPT-6"
      }
    },

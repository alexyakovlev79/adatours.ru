    {
      "blockId": "tour:itinerary_text:4b5ff9b4a37f43cc",
      "field": "itinerary.text",
      "sourceTextSha256": "06f95c4f8bbe167033a0d1037ffba56cd10c535893bcc2c2037067f54c665c62",
      "text": "Day 3 · After breakfast, transfer to the airport for your flight to Foz do Iguaçu, where a driver meets you for the transfer to your hotel. Discover the Iguazu Falls, a UNESCO World Heritage Site, where the roar of the water and the rising mist announce one of the world’s great natural wonders, surrounded by subtropical rainforest alive with butterflies and exotic birds.\nContinue to the Macuco Safari, through the rainforest to a thrilling boat ride on the Iguazu River that takes you up close to the falls, then to the Bird Park, where you walk among its aviaries close to colourful toucans, parrots and flamingos.\nOptional: helicopter flight over the falls (price on request).",
      "provenance": {
        "kind": "word_exact",
        "fileId": "10dhj-ApZLYe73Yq6Xoxsx-6PXm248EjO",
        "documentSha256": "2f2b71ae65afdb3c0877b46018c75a20a0f5fa5ff288b307e3174ea5e54ce948",

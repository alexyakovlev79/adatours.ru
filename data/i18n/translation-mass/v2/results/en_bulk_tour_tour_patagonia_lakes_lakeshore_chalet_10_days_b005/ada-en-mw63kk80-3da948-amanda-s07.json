    {
      "blockId": "tour:itinerary_text:569e72e117968fcc",
      "field": "itinerary.text",
      "sourceTextSha256": "a77d91e57722c96256376a5afffbe2a0fc2ed0c2e2ace67a0be18422b918e99d",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1C9WW594JL3xCG-3R5St1xKVPOPM8uQJ_",
        "documentSha256": "31aaa792a28dca4313e40dbe1cd054fc1f7fa55083c87c0cb2dbce9eb4fbafb7",
        "paragraphs": [
          {
            "ref": "word/document.xml#p0012",
            "textSha256": "d982d2e1e61fded5825b7fdaf892bd1867fa3021a2f5a0241d2231591804d3ef"
          }
        ]
      },
      "text": "After breakfast, depart with your guides for the first full day of fishing.\n Today focuses on exploring the upper stretches of the Limay River, known for its crystal-clear water and impressive populations of rainbow and brown trout.\n Lunch will be served riverside, followed by an afternoon float through scenic Andean forest.\n Return to the chalet for dinner by the fireplace or in the lakeside quincho."

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {sharedUiLocale} from '../../lib/i18n/shared-ui-locale.mjs';
import {uiText} from '../../lib/i18n/messages.mjs';
const locale=sharedUiLocale();
---

<BaseLayout title={uiText(locale,'footer.privacy')} lang={locale} headerTheme="dark">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Legal</p>
      <h1>{uiText(locale,'footer.privacy')}</h1>
      <p>
        {locale==='en'?'The recipient of personal data submitted through forms on adatours.ru is:':'Получатель персональных данных, передаваемых через формы сайта adatours.ru:'}
        <strong>ADA TOURS 2007 - OPERADORA DE TURISMO LTDA</strong>,
        CNPJ 08.537.782/0001-04, Avenida Nossa Senhora de Copacabana, 680, Sala 916,
        Copacabana, Rio de Janeiro - RJ, CEP 22050-001, Brasil.
      </p>

      <h2>{locale==='en'?'Cookies':'Файлы cookie'}</h2>
      <p>
        {locale==='en'?'The site uses the technical cookie ':'Сайт использует технический cookie '}
        <code>adatours_cookie_notice</code>
        {locale==='en'
          ? ' to remember that you have dismissed the cookie notice. It is retained for up to one year. This cookie is not used for advertising, analytics or profiling.'
          : ', чтобы запомнить, что уведомление об использовании cookie уже было закрыто. Срок хранения — до 1 года. Этот cookie не используется для рекламы, аналитики или профилирования.'}
      </p>
      <p>
        {locale==='en'
          ? 'If analytics services or other external tools are added to the site, details of their cookies and purposes will be added to this policy.'
          : 'Если на сайте будут подключены сервисы аналитики или другие внешние инструменты, информация об их cookie и назначении будет добавлена в эту политику.'}
      </p>
    </div>
  </section>
</BaseLayout>

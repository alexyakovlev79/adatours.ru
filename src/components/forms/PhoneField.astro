---
import { PHONE_COUNTRIES } from '../../data/phone-countries';
import { withBase } from '../../lib/paths';

const DEFAULT_ISO = 'ru';
const defaultCountry = PHONE_COUNTRIES.find((country) => country.iso2 === DEFAULT_ISO) ?? PHONE_COUNTRIES[0];
const flagUrl = (iso2: string) => withBase(`/phone-flags/${iso2 === 'mb' ? 'mx' : iso2}.png`);
const defaultIndex = PHONE_COUNTRIES.findIndex((country) => country.iso2 === DEFAULT_ISO);
const initialFlagIsos = new Set(PHONE_COUNTRIES.slice(Math.max(0, defaultIndex - 8), defaultIndex + 9).map((country) => country.iso2));
const placeholderFromMask = (country: { mask: string; dial: string }) => {
  const rest = country.mask.startsWith(country.dial) ? country.mask.slice(country.dial.length) : country.mask;
  const pattern = rest.replace(/^[\s-]+/, '');
  return pattern.replace(/9/g, '0').trim();
};
---

<div class="phone-field" data-phone-field>
  <div class="phone-field__control">
    <button
      type="button"
      class="phone-field__country-toggle"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label={`Выбрать страну: ${defaultCountry.name} ${defaultCountry.dial}`}
    >
      <span class="phone-field__flag-wrap" aria-hidden="true">
        <span class="phone-field__flag-fallback" data-phone-flag-fallback>🌐</span>
        <img
          class="phone-field__flag"
          src={flagUrl(defaultCountry.iso2)}
          alt=""
          width="24"
          height="18"
          referrerpolicy="no-referrer"
          data-phone-flag
          hidden
        />
      </span>
      <span class="phone-field__dial" data-phone-dial>{defaultCountry.dial}</span>
      <span class="phone-field__chevron" aria-hidden="true"></span>
    </button>

    <input
      class="phone-field__input"
      name="phone"
      type="tel"
      inputmode="tel"
      autocomplete="tel-national"
      placeholder={placeholderFromMask(defaultCountry)}
      data-phone-input
      data-mask={defaultCountry.mask}
      data-dial={defaultCountry.dial}
      data-iso2={defaultCountry.iso2}
    />

    <div class="phone-field__menu" role="listbox" data-phone-menu data-nosnippet>
      {[defaultCountry].map((country) => (
        <button
          type="button"
          class="phone-field__option"
          role="option"
          data-phone-option
          data-name={country.name}
          data-iso2={country.iso2}
          data-dial={country.dial}
          data-mask={country.mask}
        >
          <span class="phone-field__flag-wrap" aria-hidden="true">
            <span class="phone-field__flag-fallback">🌐</span>
            <img
              class="phone-field__flag"
              alt=""
              width="24"
              height="18"
              referrerpolicy="no-referrer"
              data-phone-option-flag
              src={initialFlagIsos.has(country.iso2) ? flagUrl(country.iso2) : undefined}
              data-phone-option-flag-src={flagUrl(country.iso2)}
              hidden
            />
          </span>
          <span class="phone-field__country-name">{country.name}</span>
          <span class="phone-field__option-code">{country.dial}</span>
        </button>
      ))}
    </div>
  </div>

  <input type="hidden" name="phone_country" value={defaultCountry.iso2} data-phone-country />
  <input type="hidden" name="phone_dial" value={defaultCountry.dial} data-phone-dial-hidden />
</div>

<script>
  import { withBase } from '../../lib/paths';
  import { PHONE_COUNTRIES } from '../../data/phone-countries';
  const flagUrl = (iso2) => withBase(`/phone-flags/${iso2 === 'mb' ? 'mx' : iso2}.png`);
  const maskParts = (mask, dial) => {
    const rest = mask.startsWith(dial) ? mask.slice(dial.length) : mask;
    const pattern = rest.replace(/^[\s-]+/, '');
    return {
      pattern,
      digits: (pattern.match(/9/g) || []).length,
    };
  };

  const formatNational = (value, mask, dial) => {
    const meta = maskParts(mask, dial);
    let digits = String(value || '').replace(/\D/g, '');
    const dialDigits = String(dial || '').replace(/\D/g, '');

    if (digits.startsWith(dialDigits) && digits.length > meta.digits) {
      digits = digits.slice(dialDigits.length);
    }

    digits = digits.slice(0, meta.digits);

    let output = '';
    let digitIndex = 0;
    for (const character of meta.pattern) {
      if (character === '9') {
        if (digitIndex >= digits.length) break;
        output += digits[digitIndex++];
      } else if (digitIndex > 0 || digits.length > 0) {
        output += character;
      }
    }

    return output;
  };

  const caretAfterDigitCount = (value, digitCount) => {
    if (digitCount <= 0) return 0;
    let seen = 0;
    for (let index = 0; index < value.length; index += 1) {
      if (/\d/.test(value[index])) {
        seen += 1;
        if (seen === digitCount) return index + 1;
      }
    }
    return value.length;
  };

  const placeholderFromMask = (mask, dial) => {
    return maskParts(mask, dial).pattern.replace(/9/g, '0').trim();
  };

  document.querySelectorAll('[data-phone-field]').forEach((field) => {
    const toggle = field.querySelector('.phone-field__country-toggle');
    const flag = field.querySelector('[data-phone-flag]');
    const flagFallback = field.querySelector('[data-phone-flag-fallback]');
    const dial = field.querySelector('[data-phone-dial]');
    const input = field.querySelector('[data-phone-input]');
    const menu = field.querySelector('[data-phone-menu]');
    const countryHidden = field.querySelector('[data-phone-country]');
    const dialHidden = field.querySelector('[data-phone-dial-hidden]');

    if (!(toggle instanceof HTMLButtonElement) ||
        !(flag instanceof HTMLImageElement) ||
        !(flagFallback instanceof HTMLElement) ||
        !(dial instanceof HTMLElement) ||
        !(input instanceof HTMLInputElement) ||
        !(menu instanceof HTMLElement) ||
        !(countryHidden instanceof HTMLInputElement) ||
        !(dialHidden instanceof HTMLInputElement)) return;

    field.querySelectorAll('.phone-field__flag').forEach((image) => {
      if (!(image instanceof HTMLImageElement)) return;

      const showFallback = () => {
        image.hidden = true;
      };

      const showImage = () => {
        image.hidden = false;
      };

      image.addEventListener('error', showFallback);
      image.addEventListener('load', showImage);

      if (image.complete && image.naturalWidth > 0) showImage();
      else if (image.complete) showFallback();
    });

    const closeMenu = () => {
      menu.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    const applyCountry = (option, focusInput = true) => {
      if (!(option instanceof HTMLButtonElement)) return;
      const { iso2 = 'ru', dial: countryDial = '+7', mask = '+7(999) 999-99-99', name = 'Russia (Россия)' } = option.dataset;

      flagFallback.textContent = '🌐';
      flag.hidden = true;
      flag.src = flagUrl(iso2);
      if (flag.complete && flag.naturalWidth > 0) flag.hidden = false;
      dial.textContent = countryDial;
      input.dataset.iso2 = iso2;
      input.dataset.dial = countryDial;
      input.dataset.mask = mask;
      input.placeholder = placeholderFromMask(mask, countryDial);
      input.value = formatNational(input.value, mask, countryDial);
      countryHidden.value = iso2;
      dialHidden.value = countryDial;
      toggle.setAttribute('aria-label', `Выбрать страну: ${name} ${countryDial}`);
      closeMenu();

      if (focusInput) input.focus();
    };

    let flagObserver;
    const loadOptionFlag = (image) => {
      if (!(image instanceof HTMLImageElement) || image.hasAttribute('src')) return;
      const source = image.dataset.phoneOptionFlagSrc;
      if (!source) return;
      image.src = source;
      if (image.complete && image.naturalWidth > 0) image.hidden = false;
    };
    const loadNearbyFlags = () => {
      if (!menu.classList.contains('is-open') || 'IntersectionObserver' in window) return;
      const bounds = menu.getBoundingClientRect();
      menu.querySelectorAll('[data-phone-option-flag]:not([src])').forEach((image) => {
        const rect = image.parentElement.getBoundingClientRect();
        if (rect.bottom >= bounds.top - 320 && rect.top <= bounds.bottom + 320) loadOptionFlag(image);
      });
    };
    const observeOptionFlags = () => {
      if (!menu.classList.contains('is-open')) return;
      if (flagObserver) flagObserver.disconnect();
      if ('IntersectionObserver' in window) {
        flagObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || !menu.classList.contains('is-open')) return;
            loadOptionFlag(entry.target.querySelector('[data-phone-option-flag]'));
            flagObserver.unobserve(entry.target);
          });
        }, { root: menu, rootMargin: '320px 0px' });
        menu.querySelectorAll('[data-phone-option-flag]:not([src])').forEach((image) => {
          // Images are hidden while pending; observe their visible-sized wrappers.
          flagObserver.observe(image.parentElement);
        });
      } else {
        loadNearbyFlags();
      }
    };
    menu.addEventListener('scroll', loadNearbyFlags, { passive: true });

    // The original SSR rendered every country option on every page (thousands
    // of identical large menus). Keep the default option in HTML as fallback;
    // populate the full accessible list only on the first user interaction.
    let optionsReady = false;
    const ensureOptions = () => {
      if (optionsReady) return;
      const fragment = document.createDocumentFragment();
      for (const country of PHONE_COUNTRIES) {
        const option = document.createElement('button');
        option.type = 'button';
        option.className = 'phone-field__option';
        option.setAttribute('role', 'option');
        option.dataset.phoneOption = '';
        option.dataset.name = country.name;
        option.dataset.iso2 = country.iso2;
        option.dataset.dial = country.dial;
        option.dataset.mask = country.mask;

        const flagWrap = document.createElement('span');
        flagWrap.className = 'phone-field__flag-wrap';
        flagWrap.setAttribute('aria-hidden', 'true');
        const fallback = document.createElement('span');
        fallback.className = 'phone-field__flag-fallback';
        fallback.textContent = '🌐';
        const countryFlag = document.createElement('img');
        countryFlag.className = 'phone-field__flag';
        countryFlag.alt = '';
        countryFlag.width = 24;
        countryFlag.height = 18;
        countryFlag.hidden = true;
        countryFlag.dataset.phoneOptionFlag = '';
        countryFlag.dataset.phoneOptionFlagSrc = flagUrl(country.iso2);
        countryFlag.referrerPolicy = 'no-referrer';
        countryFlag.addEventListener('load', () => { countryFlag.hidden = false; });
        countryFlag.addEventListener('error', () => { countryFlag.hidden = true; });
        flagWrap.append(fallback, countryFlag);

        const label = document.createElement('span');
        label.className = 'phone-field__country-name';
        label.textContent = country.name;
        const dialText = document.createElement('span');
        dialText.className = 'phone-field__option-code';
        dialText.textContent = country.dial;
        option.append(flagWrap, label, dialText);
        fragment.append(option);
      }
      menu.replaceChildren(fragment);
      optionsReady = true;
    };

    toggle.addEventListener('click', () => {
      const open = !menu.classList.contains('is-open');
      if (open) ensureOptions();
      menu.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');

      if (open) {
        const selected = menu.querySelector(`[data-phone-option][data-iso2="${input.dataset.iso2}"]`);
        if (selected instanceof HTMLElement) {
          setTimeout(() => {
            if (!menu.classList.contains('is-open')) return;
            menu.scrollTop = Math.max(0, selected.offsetTop - (menu.clientHeight - selected.offsetHeight) / 2);
            observeOptionFlags();
          }, 0);
        }
      }
    });

    menu.addEventListener('click', (event) => {
      const target = event.target;
      const option = target instanceof Element ? target.closest('[data-phone-option]') : null;
      if (option instanceof HTMLButtonElement && menu.contains(option)) applyCountry(option);
    });

    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Backspace') return;

      const start = input.selectionStart == null ? 0 : input.selectionStart;
      const end = input.selectionEnd == null ? start : input.selectionEnd;
      if (start !== end || start <= 0) return;
      if (/\d/.test(input.value.charAt(start - 1))) return;

      let previousDigitPosition = start - 1;
      while (previousDigitPosition >= 0 && !/\d/.test(input.value.charAt(previousDigitPosition))) {
        previousDigitPosition -= 1;
      }
      if (previousDigitPosition < 0) return;

      event.preventDefault();
      const digitsBefore = (input.value.slice(0, previousDigitPosition + 1).match(/\d/g) || []).length;
      let digits = input.value.replace(/\D/g, '');
      const removeAt = digitsBefore - 1;
      digits = digits.slice(0, removeAt) + digits.slice(removeAt + 1);

      const mask = input.dataset.mask || '+7(999) 999-99-99';
      const countryDial = input.dataset.dial || '+7';
      const formatted = formatNational(digits, mask, countryDial);
      input.value = formatted;

      const caret = caretAfterDigitCount(formatted, digitsBefore - 1);
      input.setSelectionRange(caret, caret);
    });

    input.addEventListener('input', () => {
      const mask = input.dataset.mask || '+7(999) 999-99-99';
      const countryDial = input.dataset.dial || '+7';
      const raw = input.value;
      const currentCaret = input.selectionStart == null ? raw.length : input.selectionStart;
      const digitsBeforeCaret = (raw.slice(0, currentCaret).match(/\d/g) || []).length;
      const formatted = formatNational(raw, mask, countryDial);
      if (input.value !== formatted) input.value = formatted;

      const nextCaret = caretAfterDigitCount(formatted, digitsBeforeCaret);
      try {
        input.setSelectionRange(nextCaret, nextCaret);
      } catch (_) {
        // Some browser/input states do not expose a mutable selection.
      }
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !field.contains(event.target)) closeMenu();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.classList.contains('is-open')) {
        closeMenu();
        toggle.focus();
      }
    });
  });
</script>

<style>
  .phone-field {
    min-width: 0;
  }

  .phone-field__control {
    position: relative;
    display: flex;
    align-items: stretch;
    min-height: 48px;
    border-bottom: 1px solid rgb(26 26 26 / 45%);
  }

  .phone-field__control:focus-within {
    border-bottom-color: var(--color-gold);
  }

  .phone-field__country-toggle {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
    min-width: 92px;
    padding: 0 14px 0 0;
    border: 0;
    border-right: 1px solid var(--color-line);
    color: var(--color-ink);
    background: transparent;
    cursor: pointer;
  }

  /* Flags inside the country list are inserted by JS without Astro scope attributes.
     Anchor their styles to the server-rendered field instead. */
  .phone-field :global(.phone-field__flag-wrap) {
    position: relative;
    display: grid;
    width: 24px;
    height: 18px;
    flex: 0 0 24px;
    place-items: center;
    overflow: hidden;
  }

  .phone-field :global(.phone-field__flag-fallback),
  .phone-field :global(.phone-field__flag) {
    grid-area: 1 / 1;
  }

  .phone-field :global(.phone-field__flag-fallback) {
    font-family: "Noto Color Emoji", "Apple Color Emoji", "Segoe UI Emoji", sans-serif;
    font-size: 18px;
    line-height: 1;
  }

  .phone-field :global(.phone-field__flag) {
    display: block;
    width: 24px;
    height: 18px;
    object-fit: cover;
    border: 1px solid var(--color-line);
    background: #fff;
  }

  .phone-field :global(.phone-field__flag[hidden]) {
    display: none;
  }

  .phone-field__dial {
    white-space: nowrap;
    font-size: .95rem;
  }

  .phone-field__chevron {
    width: 0;
    height: 0;
    flex: 0 0 auto;
    border-right: 4px solid transparent;
    border-left: 4px solid transparent;
    border-top: 5px solid var(--color-text-muted);
  }

  .phone-field__input {
    width: 100%;
    min-width: 0;
    padding: 12px 0 12px 14px;
    border: 0;
    outline: 0;
    color: var(--color-ink);
    background: transparent;
  }

  .phone-field__input::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }

  .phone-field__menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 50;
    display: none;
    width: min(430px, calc(100vw - 32px));
    max-height: 310px;
    overflow: auto;
    border: 1px solid #c9c9c9;
    color: #1a1a1a;
    background: #fff;
    box-shadow: 0 18px 40px rgba(0,0,0,.24);
  }

  .phone-field__menu.is-open {
    display: block;
  }

  /* Keep dynamic <button> options styled as full-width list rows (also in the modal). */
  .phone-field__menu :global(.phone-field__option) {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    gap: 11px;
    align-items: center;
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-bottom: 1px solid #ece8e1;
    color: #1a1a1a;
    background: #fff;
    cursor: pointer;
    text-align: left;
    font: inherit;
    font-size: .82rem;
    line-height: 1.35;
  }

  .phone-field__menu :global(.phone-field__option:last-child) {
    border-bottom: 0;
  }

  .phone-field__menu :global(.phone-field__option:hover),
  .phone-field__menu :global(.phone-field__option:focus-visible) {
    background: #f7f3ec;
  }

  .phone-field__menu :global(.phone-field__option .phone-field__flag) {
    border-color: rgba(0,0,0,.1);
  }

  .phone-field__menu :global(.phone-field__country-name) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .phone-field__menu :global(.phone-field__option-code) {
    color: #6f6a62;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .phone-field__menu {
      position: fixed;
      top: 50%;
      right: 16px;
      left: 16px;
      width: auto;
      max-height: min(440px, 70dvh);
      transform: translateY(-50%);
    }
  }
</style>

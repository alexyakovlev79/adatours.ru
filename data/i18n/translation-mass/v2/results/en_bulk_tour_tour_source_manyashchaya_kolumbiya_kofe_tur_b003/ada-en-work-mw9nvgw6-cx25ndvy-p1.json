      },
      "text": "Arrival in Bogotá"
    },
    {
      "blockId": "tour:itinerary_text:5a4836cca1208c95",
      "field": "itinerary.text",
      "sourceTextSha256": "da872d9c9de6aea32955b22809534ef2781942ae696321d58df0dcfe98ef351f",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-work-mw9nvgw6-cx25ndvy",
        "model": "GPT-6.1"
      },
      "text": "Arrive at El Dorado International Airport in Bogotá. Meet your English-speaking guide, transfer to the hotel and check in.\n\nThe rest of the day is free. You can rest after your flight or explore the city on your own. The day is kept free of scheduled sightseeing ahead of the full programme over the coming days. The main sightseeing programme starts tomorrow."
    },
    {
      "blockId": "tour:itinerary_label:2b7a8bc5ae06d536",
      "field": "itinerary.label",
      "sourceTextSha256": "f657d29235b71e006b9fb621ea50e703abe60f5c68b531a6b9b8fb865ae63e1c",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-work-mw9nvgw6-cx25ndvy",
        "model": "GPT-6.1"
      },
      "text": "Bogotá"
    },
    {
      "blockId": "tour:media_alt:4bc539be5b9697fd",
      "field": "media.alt",

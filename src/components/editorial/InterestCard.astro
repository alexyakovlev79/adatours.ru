---
import { withBase } from '../../lib/paths';
import VipBadge from '../tour/VipBadge.astro';
import { getVipTourPaths } from '../../lib/vip-catalog';
interface Props {
  entityId: string; title: string; text?: string; href: string; image?: string;
  eyebrow?: string; meta?: string; imageTextAlign?: 'left' | 'right'; large?: boolean;
}
const { entityId, title, text, href, image, eyebrow, meta, imageTextAlign = 'left', large = false } = Astro.props;
const vip = (await getVipTourPaths()).has(href);
---
<article class:list={['interest-card', { 'interest-card--large': large }]} data-interest-item={entityId}>
  <a href={withBase(href)} class="interest-card__link">
    {image && <div class="interest-card__image"><img src={withBase(image)} alt="" loading="lazy" decoding="async" />{vip && <VipBadge overlay />}</div>}
    <div class="interest-card__copy" data-text-align={imageTextAlign}>
      {eyebrow && eyebrow !== 'По интересам' && <p class="eyebrow">{eyebrow}</p>}
      <h3>{title}<span aria-hidden="true"> ↗</span></h3>
      {meta && <p class="interest-card__meta">{meta}</p>}
      {text && <p class="interest-card__text">{text}</p>}
    </div>
  </a>
</article>
<style>
  .interest-card { min-width: 0; }
  .interest-card--large { grid-column: 1 / -1; }
  .interest-card__link {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 100%;
    min-height: clamp(340px, 34vw, 530px);
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background: #171815;
    text-decoration: none;
  }
  .interest-card__link:focus-visible { outline: 2px solid currentColor; outline-offset: -4px; }
  .interest-card__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(10,10,9,.1) 12%, rgba(10,10,9,.82) 100%);
  }
  .interest-card__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    width: 100%;
    height: 100%;
  }
  .interest-card__image :global(.vip-badge--overlay) { top: 16px; left: 16px; }
  .interest-card__image img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  @media (prefers-reduced-motion: no-preference) {
    .interest-card__link:hover img { transform: scale(1.025); }
  }
  .interest-card__copy {
    position: relative;
    z-index: 1;
    width: 100%;
    min-width: 0;
    padding: clamp(25px, 3.5vw, 55px);
  }
  .interest-card__copy .eyebrow { margin: 0 0 10px; }
  h3 { max-width: 900px; font: 400 clamp(1.65rem, 2.4vw, 3rem)/1.1 var(--font-display); margin: 0; overflow-wrap: anywhere; }
  h3 span { font-size: .62em; white-space: nowrap; }
  .interest-card__meta { font-size: .9rem; line-height: 1.5; color: rgba(255,255,255,.88); margin: 12px 0 0; }
  .interest-card__text { max-width: 700px; font-size: .98rem; line-height: 1.6; margin: 12px 0 0; color: rgba(255,255,255,.9); }
  .interest-card__copy[data-text-align="right"] { text-align: right; }
  .interest-card__copy[data-text-align="right"] h3,
  .interest-card__copy[data-text-align="right"] .interest-card__text { margin-left: auto; }
  .interest-card--large .interest-card__link { min-height: clamp(440px, 55vw, 680px); }
  .interest-card--large .interest-card__copy { padding: clamp(36px, 6vw, 72px) var(--gutter); }
  .interest-card--large h3 { max-width: 920px; font-size: clamp(2.15rem, 4vw, 4rem); }
  @media (max-width: 759px) {
    .interest-card__link { min-height: clamp(360px, 105vw, 500px); }
    .interest-card__copy { padding: 24px var(--gutter) 30px; }
    h3 { font-size: clamp(1.85rem, 7vw, 2.55rem); }
    .interest-card--large .interest-card__link { min-height: clamp(360px, 105vw, 500px); }
  }
</style>

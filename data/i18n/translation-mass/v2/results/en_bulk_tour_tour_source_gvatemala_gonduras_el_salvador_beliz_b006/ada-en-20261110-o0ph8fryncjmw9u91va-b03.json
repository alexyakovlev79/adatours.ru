    },
    {
      "blockId": "tour:itinerary_text:4b5ff9b4a37f43cc",
      "field": "itinerary.text",
      "sourceTextSha256": "e1c7f1e61a7e3bdfb2bdea537604de0fc61477ee4022b227157cc5a55df90e1c",

      "text": "Buenos Aires – Colonia del Sacramento – Montevideo"
    },
    {
      "blockId": "tour:itinerary_text:2e780f63f4172747",
      "field": "itinerary.text",
      "sourceTextSha256": "4a9d9a7d2c1431e70210e6d3a92f199ab4d5b8124bad0318062d5d811c81f010",

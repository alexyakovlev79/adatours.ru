    {
      "blockId": "tour:itinerary_text:b9ad3e14216c2f08",
      "field": "itinerary.text",
      "sourceTextSha256": "f0811d326833c03dbcfa9f5879e2644fa3b34932fa16eaa1fd0d0902da273ecb",
      "text": "Today after the breakfast in your Hotel, you will visit the Brazilian side of the magnificent Iguaçu Falls . Following the walkways which border the canyon of the Iguassu River, you will enjoy the sight of hundreds of small waterfalls. At the end of this Trail you will arrive right in front of the huge and impressing Devils Throat, the strongest and most powerful of all waterfalls. You will feel the waterfalls with the splashing water around you and the whole area around is full of beautiful rainbows.\n\nAt the end of the tour your guide will drop you off at your Hotel.\n\nOptional excursions: Bird Park — USD 50 per person; Macuco Safari — USD 130 per person.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw3dke6z-amanda",
        "model": "GPT-6",
        "wordAbsenceReason": "Core description is retained verbatim from Word paragraphs 58–59. Word lacks the assigned Bird Park USD 50 and Macuco Safari USD 130 supplements; translate that RU-only supplement without changing amounts.",
        "wordFragments": {
          "fileId": "1_2CgalLCI_e-m5DrGzaGrwAEVyfOj-ZB",
          "documentSha256": "df6ba762bd199c041d682fd4e499d6a38c7af3af7cc6f87818fbd8d7122f93f0",
          "paragraphs": [
            {
              "ref": "word/document.xml:p:58",
              "textSha256": "c5f9c8d14bf1594c13a2641f34cd4e6931b589b7266efdb677f1cf8205e6616e",
              "text": "Today after the breakfast in your Hotel, you will visit the Brazilian side of the magnificent Iguaçu Falls . Following the walkways which border the canyon of the Iguassu River, you will enjoy the sight of hundreds of small waterfalls. At the end of this Trail you will arrive right in front of the huge and impressing Devils Throat, the strongest and most powerful of all waterfalls. You will feel the waterfalls with the splashing water around you and the whole area around is full of beautiful rainbows."
            },
            {
              "ref": "word/document.xml:p:59",
              "textSha256": "92dbeedf644b3f016ca044a1001b92e9f277c0aea8f73a2ea9321d3a1cb96a67",
              "text": "At the end of the tour your guide will drop you off at your Hotel."
            }
          ]
        }
      }

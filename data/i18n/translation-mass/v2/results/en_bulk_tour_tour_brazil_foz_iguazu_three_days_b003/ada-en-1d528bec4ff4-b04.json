      "text": "Brazilian Falls & Bird Park",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1f-s5PVE55Y7O2HVcliOid_NuetKLc8Bi",
        "documentSha256": "e5f2b52b7f03c7e3a1266f09c3dc742fe8ee71a85520bbe560d2be148588f3cd",

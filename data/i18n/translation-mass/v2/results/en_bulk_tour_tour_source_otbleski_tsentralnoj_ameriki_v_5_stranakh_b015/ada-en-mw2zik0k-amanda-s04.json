    {
      "blockId": "tour:itinerary_text:99d4ebb0270da8fa",
      "field": "itinerary.text",
      "sourceTextSha256": "54f5132085a69bd4e1fe0d40d1c12ffb972992426bc1781e3464c5eb0260998d",
      "text": "Visit the Monteverde cloud forest in the Cordillera de Tilarán in northwestern Costa Rica, at an altitude of almost 5,000 feet. The biological reserve was created to protect the flora and fauna of this complex ecosystem and covers about 10,000 hectares.\n\nContinue by boat across Lake Arenal. A rural community of Quakers and Ticos also lives in the Monteverde area.\n\n**Overnight:** Arenal Paraíso Resort & Spa.  \n**Meals:** breakfast.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw2zik0k-amanda",
        "model": "GPT-6",
        "wordAbsenceReason": "The checked Word Monteverde day omits the assigned RU geography, 5000-foot altitude, 10000-hectare area and Quaker/Tico community; translate these RU-only passages while preserving the hotel and breakfast.",

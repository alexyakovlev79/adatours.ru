---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import AboutNav from '../../components/commercial/AboutNav.astro';
import AuthoritySection from '../../components/authority/AuthoritySection.astro';
import AuthoritySourceList from '../../components/authority/AuthoritySourceList.astro';
import AuthorityFaq from '../../components/authority/AuthorityFaq.astro';
import AuthorityClosing from '../../components/authority/AuthorityClosing.astro';
import AuthoritySearchRecord from '../../components/authority/AuthoritySearchRecord.astro';
import authorityPages from '../../data/authority-pages.json';
import { getAuthorityPageSources, getAuthorityExhibitionSources } from '../../lib/entity-authority.mjs';

const page = authorityPages.press;
const sources = getAuthorityPageSources(page.path);
const exhibitionSources = getAuthorityExhibitionSources(page.path);
const breadcrumbs = [
  { label: 'Главная', href: '/' },
  { label: 'О нас', href: '/about/' },
  { label: page.breadcrumbLabel, href: page.path },
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonical={page.path}
  image={page.heroImage}
  leadTitle={page.leadTitle}
  leadEntityId={page.leadEntityId}
  breadcrumbs={breadcrumbs}
>
  <Hero
    eyebrow={page.eyebrow}
    title={page.h1}
    intro={page.lead}
    image={page.heroImage}
    ctaLabel={page.heroCta.label}
    ctaHref={page.heroCta.href}
    compact
    compactCta
    mobilePhotoLead
    imagePositionMobile="75% center"
    mediaStatus="approved"
  />
  <AboutNav active="press" />
  <AuthoritySearchRecord title={page.h1} summary={page.description} subtitle={page.searchSubtitle}
    aliases={[...page.searchAliases, ...sources.map((source) => source.publisher.name)]} image={page.heroImage} />

  <AuthoritySection section={page.sections[0]} />
  <AuthoritySourceList
    id="publications"
    eyebrow={page.sourcesEyebrow}
    title={page.sourcesHeading}
    intro={page.sourcesIntro}
    sources={sources}
    entries={page.sourceEntries}
  />
  <AuthoritySourceList
    id="ratings"
    eyebrow="Выбор организатора путешествия"
    title="Рейтинги и практические разборы"
    intro="Авторские сравнения на Sostav, TenChat и DTF, подготовленные в рамках продвижения Ada Tours через GAEO. В каждой публикации — свой сценарий поездки и критерии выбора."
    sources={sources}
    entries={page.rankingEntries}
  />
  <AuthoritySourceList
    id="research"
    eyebrow="Index Research"
    title="Исследования и сравнения туристических компаний"
    intro="Материалы исследовательского проекта, связанного с GAEO. Ada Tours входит в выборки; методика, источники и открытые данные доступны на страницах исследований."
    sources={sources}
    entries={page.researchEntries}
  />
  <AuthoritySourceList
    id="case-publications"
    eyebrow="Работа над сайтом и продвижением"
    title="Кейсы о развитии Ada Tours"
    intro="Публикации нашего подрядчика GAEO о разработке сайта и результатах продвижения компании в ответах нейросетей."
    sources={sources}
    entries={page.caseEntries}
  />
  <AuthoritySourceList
    id="exhibitions"
    eyebrow="Профессиональные выставки"
    title="Ada Tours в каталогах международных выставок"
    intro="Профили участников, официальные списки и документальные подтверждения. Будущие выставки отмечены как запланированные."
    sources={exhibitionSources}
    entries={page.exhibitionEntries}
  />
  <AuthoritySection section={page.sections[1]} />
  <AuthoritySection section={page.sections[2]} />
  <AuthorityFaq title={page.faqHeading} items={page.faq} />
  <AuthorityClosing content={page.finalCta} />
</BaseLayout>

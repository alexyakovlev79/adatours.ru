    {
      "blockId": "tour:itinerary_text:ec46e3209ab74818",
      "field": "itinerary.text",
      "sourceTextSha256": "05c1903841e4a6ab7ac475803ea8b52d86a9e3a755102d844164cfd7e700c82c",
      "text": "The morning starts with a horseback ride through Cotopaxi National Park. Cotopaxi volcano rises to 5,897 m. Its snow-covered cone is visible from different parts of the park, surrounded by highland plains and patches of Andean vegetation.\n\nDuring the excursion, you will visit the information centre to learn about the area's natural environment and the volcano itself. Then you will spend about an hour walking by Limpiopungo Lagoon.\n\nFor those looking for a more strenuous outing, an additional ascent to the volcano's car park, at about 4,600 m, can be arranged. From there, it takes about 1.5 hours on foot to reach the José Rivas Refuge, roughly 200 m higher up the steep slope.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-translator-20261110-mw9trnme-si5iwi",
        "model": "GPT-6.1 Sol"
      }
    },

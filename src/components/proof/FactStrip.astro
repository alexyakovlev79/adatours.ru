---
interface Fact { value: string; label: string; }
interface Props { facts: Fact[]; dark?: boolean; }
const { facts, dark = false } = Astro.props;
---

<section class:list={['fact-strip', { 'fact-strip--dark': dark }]}>
  <div class="fact-strip__inner">
    {facts.map((fact) => (
      <div class="fact">
        <strong>{fact.value}</strong>
        <span>{fact.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .fact-strip {
    background: var(--color-bg);
  }

  .fact-strip--dark {
    color: var(--color-bg);
    background: var(--color-ink-deep);
  }

  .fact-strip__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
  }

  .fact {
    min-height: 180px;
    padding: 38px 28px;
  }

  .fact + .fact {
    border-left: 1px solid var(--color-line);
  }

  .fact-strip--dark .fact + .fact {
    border-color: rgba(255,255,255,.18);
  }

  .fact strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.4vw, 4.8rem);
    font-weight: 500;
    line-height: .95;
    letter-spacing: -.045em;
  }

  .fact span {
    display: block;
    margin-top: 12px;
    color: var(--color-muted);
    font-size: .76rem;
    line-height: 1.35;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .fact-strip--dark .fact span {
    color: rgba(255,255,255,.56);
  }

  @media (max-width: 680px) {
    .fact-strip__inner {
      grid-template-columns: repeat(2, minmax(0,1fr));
    }

    .fact {
      min-height: 132px;
      padding: 26px 16px;
      border-left: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .fact:nth-child(even) {
      border-left: 1px solid var(--color-line);
    }

    .fact-strip--dark .fact:nth-child(even),
    .fact-strip--dark .fact {
      border-color: rgba(255,255,255,.18);
    }
  }
</style>

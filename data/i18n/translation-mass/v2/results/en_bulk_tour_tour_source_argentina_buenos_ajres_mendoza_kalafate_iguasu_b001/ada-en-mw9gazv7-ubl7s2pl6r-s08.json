      "text": "Argentina Tour: El Calafate, Mendoza and Iguazú Falls"
    },
    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "95b355a8be4133d4c75a6dba320561500291a716c8c4ec7681f22dd68e1bd93c",

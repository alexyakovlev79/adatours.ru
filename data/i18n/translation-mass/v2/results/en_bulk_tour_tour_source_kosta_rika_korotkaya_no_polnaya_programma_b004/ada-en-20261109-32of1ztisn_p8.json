    {
      "blockId": "tour:itinerary_text:569e72e117968fcc",
      "field": "itinerary.text",
      "sourceTextSha256": "a373ff72aa4d1b32a5840208f89d560fe8fd60ee246ff638e410c2779a7c5ad6",
      "text": "After breakfast, set off for Caño Negro Wildlife Refuge.\n\nMost of the excursion takes place on a boat on the Frío River.\n\nThe route starts in Los Chiles, a small town about 4 km from the Nicaraguan border.\n\nThe Frío River is part of Caño Negro Wildlife Refuge, a Ramsar site with some of the country's most diverse habitats.\n\nOn the boat trip you can see many birds, including herons and cormorants, as well as water striders.\n\nYou may also spot monkeys, spiders, sloths, caimans, lizards and turtles.\n\nThis excursion is especially suited to travellers who want to explore from the water and see animals in their natural habitat.\n\nAfter lunch, return to the Arenal area.\n\nOvernight at Arenal Paraiso Resort & Spa.\n\nBreakfast and lunch are included.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-32of1ztisn",
        "model": "ChatGPT"
      }

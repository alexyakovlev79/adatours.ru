    {
      "blockId": "tour:itinerary_text:b04d5d61d358e759",
      "field": "itinerary.text",
      "sourceTextSha256": "949dbb41b26f244a57bdb4260d87210740f154cea125680b03462ef82e378d3b",
      "text": "Breakfast and tourist bus to Puno (shared, with an English-speaking guide) across the Peruvian highlands: the small but beautiful church of Andahuaylillas; Raqchi, the temple of the god Wiracocha, with its high walls and passageways; a buffet lunch; the La Raya pass, the natural border between Cusco and Puno; and the museum of Pucará, famous for its clay bull figures. Arrival in Puno (about 3,830 m) in the evening, after a journey of about 10 hours, and transfer to the hotel.",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1t7h2_7VUtM7VWovMtTNnF828V4XGmhh0",
        "documentSha256": "66bd2b4964978bc597a4a080aa8a66d093695ce29dec7e2dae35b01323a5973b",

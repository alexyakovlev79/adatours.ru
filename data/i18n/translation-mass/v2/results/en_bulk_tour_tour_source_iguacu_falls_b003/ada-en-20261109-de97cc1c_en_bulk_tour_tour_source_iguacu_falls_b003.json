        "runId": "ada-en-20261109-de97cc1c",
        "model": "gpt-6.1-sol"
      },
      "text": "Foz do Iguaçu"
    },
    {
      "blockId": "tour:itinerary_title:8fa505c430bf2bb8",
      "field": "itinerary.title",
      "sourceTextSha256": "04c887ff5d7c723b4b7d134261ba1a77ed6298d1c12ec0e62442d8d0a52dd900",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-de97cc1c",
        "model": "gpt-6.1-sol"
      },
      "text": "Airport transfer"
    },
    {
      "blockId": "tour:itinerary_text:4b5ff9b4a37f43cc",
      "field": "itinerary.text",
      "sourceTextSha256": "5a0f8f72d7b61a13cbb2b60b09c9b05bc2ab6618ecb9da456ba4102fa86059e3",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-de97cc1c",
        "model": "gpt-6.1-sol"
      },
      "text": "On your departure day, you’ll be transferred to the airport.\n\nIf you like, you can continue your trip in Rio de Janeiro, Buenos Aires, one of Brazil’s beach resorts, the Amazon or another destination."
    },

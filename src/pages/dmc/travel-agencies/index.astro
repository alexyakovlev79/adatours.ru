---
import {commercialText} from '../../../lib/i18n/commercial-copy.mjs';
import {sharedUiLocale} from '../../../lib/i18n/shared-ui-locale.mjs';
const uiLocale=sharedUiLocale();
const tr=(value:string)=>commercialText(value,uiLocale);
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/editorial/Hero.astro';
import FactStrip from '../../../components/proof/FactStrip.astro';
import ProcessSteps from '../../../components/proof/ProcessSteps.astro';
import DmcNav from '../../../components/commercial/DmcNav.astro';
import DmcFaq from '../../../components/commercial/DmcFaq.astro';
import CommercialDetails from '../../../components/commercial/CommercialDetails.astro';
import CommercialCaseGrid from '../../../components/commercial/CommercialCaseGrid.astro';
import CommercialQuote from '../../../components/commercial/CommercialQuote.astro';
import CommercialExpert from '../../../components/commercial/CommercialExpert.astro';
import CommercialSearchRecord from '../../../components/commercial/CommercialSearchRecord.astro';

const title = tr('DMC для турагентств: Бразилия и Латинская Америка | Ada Tours');
const description = tr('Поездки для клиентов вашего агентства с Ada Tours: нетто или комиссия, документы под ваш бренд, маршруты по Латинской Америке и координация на месте.');
const heroImage = '/media/commercial/dmc/agency-planning-generated-20261022.webp';
---

<BaseLayout lang={uiLocale}
  leadTitle={tr("Запросить предложение для клиента")}
  leadEntityId="dmc_for_agencies"
  title={title}
  description={description}
  image={heroImage}
>
  <Hero
    eyebrow={tr("DMC · Партнерство с агентствами")}
    title={tr("DMC для турагентств и туроператоров")}
    intro={tr("Вы остаетесь основным коммерческим контактом своего клиента. Мы готовим маршрут и расчет, адаптируем материалы под ваш бренд и организуем обслуживание по Бразилии и Латинской Америке.")}
    image={heroImage}
    ctaHref="#request"
    ctaLabel={tr("Запросить предложение")}
    compact
    compactCta
    mobilePhotoLead
  />

  <DmcNav active="agencies" />

  <CommercialSearchRecord
    id="dmc-agencies-search-record"
    title={title}
    description={description}
    image={heroImage}
    typeLabel={tr("Для агентств")}
    keywords={[tr('турагентствам'), tr('туроператорам'), 'DMC', 'B2B', tr('нетто'), tr('комиссия'), tr('бренд агентства'), 'white label', tr('ваучеры'), tr('клиент агентства'), tr('трансферы'), tr('Латинская Америка')]}
  />

  <FactStrip
    facts={[
      { value: tr('Нетто'), label: tr('или комиссионный тариф под задачу') },
      { value: tr('Ваш бренд'), label: tr('программы и практические документы') },
      { value: 'FIT', label: tr('индивидуальные поездки ваших клиентов') },
      { value: tr('Группы'), label: tr('делегации и корпоративные программы') },
    ]}
  />

  <CommercialDetails
    id="agency-client"
    eyebrow={tr("Клиент остается с вами")}
    title={tr("Согласуем, что увидит гость и кто принимает решения")}
    rows={[
      {
        title: tr('Коммерческое общение'),
        text: tr('Агентство ведет клиента по цене и продаже поездки. Ada Tours решает операционные вопросы в координации с партнером. Порядок согласования изменений, конфиденциальность и работу с последующими прямыми обращениями определяем между сторонами.'),
      },
      {
        title: tr('Программа под вашим брендом'),
        text: tr('Адаптируем маршруты, программы поездок и практические документы к оформлению агентства с учетом доступных инструментов. Ваучеры и подтверждения готовим в согласованном формате, сохраняя обязательные сведения о поставщиках.'),
      },
      {
        title: tr('Встреча и работа на маршруте'),
        text: tr('До приезда определяем, какое название будет на встречающей табличке и как представятся гид или водитель. Для трансферов, встреч и оперативных вопросов связываемся с гостями напрямую по согласованной схеме; агентство сохраняет свою коммерческую роль.'),
      },
      {
        title: tr('Связь до выезда и в поездке'),
        text: tr('Для группового проекта назначаем контактное лицо на этапе подготовки. Перед выездом передаем партнеру и участникам необходимые контакты. Часы доступности, порядок экстренной связи и включенные услуги фиксируем в предложении.'),
        href: '/dmc/terms/',
        linkLabel: tr('Как фиксируем условия сотрудничества'),
      },
    ]}
  />

  <CommercialCaseGrid
    id="agency-completed-projects"
    eyebrow={tr("Опыт в конкретных поездках")}
    title={tr("От длинного частного маршрута до рабочих визитов")}
    intro={tr("Посмотрите, как мы связываем транспорт, гидов, размещение и программу в выполненных проектах.")}
    caseIds={[
      'case_fit_peru_bolivia_complex_trip',
      'case_mice_business_delegation_sao_paulo_2026',
    ]}
    summaries={{
      case_fit_peru_bolivia_complex_trip: tr('Перу и Боливия: амазонский лодж с дополнительным русскоязычным гидом, разные поезда к Мачу-Пикчу, отдельная доставка багажа и продолжение маршрута через границу.'),
      case_mice_business_delegation_sao_paulo_2026: tr('Делегация из 8 человек: поездки к поставщикам, автомобили и микроавтобусы на рабочие дни, перевод на трех языках и свободная программа между встречами.'),
    }}
  />

  <CommercialQuote
    caseId="case_fit_peru_bolivia_complex_trip"
    title={tr("Отзыв гостей о времени, организации и гидах")}
  />

  <CommercialDetails
    id="agency-proposal"
    eyebrow={tr("Что получает агентство")}
    title={tr("Материалы, с которыми можно обсуждать поездку с клиентом")}
    rows={[
      {
        title: tr('Маршрут и состав услуг'),
        text: tr('По подробному запросу готовим программу, описание включенных и не включенных услуг, предварительную смету или коммерческое предложение. Указываем исходные условия расчета и бронирования, затем вносим согласованные правки.'),
      },
      {
        title: tr('Нетто или комиссия'),
        text: tr('При нетто-тарифе агентство самостоятельно устанавливает наценку. Для подходящих проектов предлагаем комиссионный тариф. Модель определяем с самого начала и отражаем в предложении.'),
        href: '/dmc/terms/',
        linkLabel: tr('Расчет, оплата и изменения'),
      },
      {
        title: tr('Статус каждого бронирования'),
        text: tr('В предложении указываем срок действия расчета и отделяем предлагаемые услуги от подтвержденных. После проверки доступности фиксируем условия цены и состав заказа письменно.'),
      },
      {
        title: tr('Полная поездка или отдельная услуга'),
        text: tr('Собираем весь маршрут и принимаем отдельные запросы на размещение, трансферы, гидов и устный перевод. Для [деловых поездок](/mice/business-delegations/) готовим профессиональные визиты; прием группы подтверждается принимающей организацией.'),
      },
      {
        title: tr('Знакомство с направлениями'),
        text: tr('Используйте [вебинары Ada Tours](/webinars/) для подготовки к разговору с клиентом. Наши [профессиональные профили и партнеры](/partners/) помогут познакомиться с компанией, а [MICE-программы](/mice/programmes/) дадут примеры для корпоративного запроса.'),
      },
    ]}
  />

  <ProcessSteps
    eyebrow={tr("Первое письмо")}
    title={tr("4 части брифа для содержательного предложения")}
    steps={[
      { title: tr('Даты и рейсы'), text: tr('Даты или диапазон, длительность поездки, города прилета и вылета. Если билеты куплены, приложите расписание.') },
      { title: tr('Гости и задача'), text: tr('Количество и состав путешественников, язык сопровождения, интересы. Для делегации добавьте цели визитов.') },
      { title: tr('Маршрут'), text: tr('Страны и города, обязательные посещения, предпочтения по транспорту. Отметьте уже забронированные услуги.') },
      { title: tr('Бюджет и формат'), text: tr('Ориентир бюджета, категория размещения, пожелания к программе и оформлению материалов для клиента.') },
    ]}
    dark
  />

  <CommercialExpert
    title={tr("Познакомьтесь с Анной Аванесовой и нашей командой")}
    text={tr("Работаем с турагентствами, туроператорами, консультантами по индивидуальным путешествиям и MICE-агентствами. Расскажите, что нужно вашему клиенту: подготовим предложение с распределением задач между вами и Ada Tours.")}
  />

  <DmcFaq
    title={tr("Вопросы агентств перед первым бронированием")}
    items={[
      {
        question: tr('Можно получить нетто-тариф и добавить свою наценку?'),
        answer: tr('Да. Предлагаем нетто-тариф, а для подходящих проектов — комиссионную модель. Выбранную схему указываем в предложении с самого начала. Размер вознаграждения и условия расчетов определяем для конкретного заказа.'),
      },
      {
        question: tr('Какие документы оформляете под брендом агентства?'),
        answer: tr('Программы поездок, подробные маршруты и практические документы. Формат ваучеров и подтверждений согласуем отдельно с сохранением обязательных данных поставщиков. До подготовки материалов определяем нужное оформление и доступные инструменты.'),
      },
      {
        question: tr('Что происходит, если турист обращается к Ada Tours напрямую?'),
        answer: tr('Во время поездки прямой контакт помогает организовать встречу, трансфер или решить оперативный вопрос. Основным коммерческим контактом остается агентство. Порядок обработки последующих обращений и правила конфиденциальности согласуем между сторонами.'),
      },
      {
        question: tr('Какой минимальный размер группы?'),
        answer: tr('Принимаем индивидуальные поездки, небольшие делегации и группы. Минимальный объем заказа, бюджет и срок подготовки определяем для конкретного запроса. Профессиональным программам и крупным группам требуется больше времени на согласования.'),
      },
      {
        question: tr('Сколько стоит первоначальная разработка программы?'),
        answer: tr('Стоимость разработки, минимальный объем заказа и условия бесплатного расчета согласуем до значительной подготовительной работы. В [условиях сотрудничества](/dmc/terms/) описано, что входит в предложение и как подтверждаются услуги.'),
      },
      {
        question: tr('Можно ли использовать ваши фотографии и тексты в наших материалах?'),
        answer: tr('Повторное использование возможно при наличии необходимых прав и разрешений. При подготовке программы под вашим брендом согласуем, какие конкретные фотографии, тексты и документы вы будете использовать.'),
      },
      {
        question: tr('Можно прислать запрос сразу на несколько стран?'),
        answer: tr('Да. Связываем обслуживание по странам в одну программу. В [выполненной поездке по Перу и Боливии](/cases/peru-bolivia-complex-trip/) собрали лодж, железнодорожную часть, частные переезды, переход границы и русскоязычное сопровождение.'),
      },
    ]}
  />
</BaseLayout>

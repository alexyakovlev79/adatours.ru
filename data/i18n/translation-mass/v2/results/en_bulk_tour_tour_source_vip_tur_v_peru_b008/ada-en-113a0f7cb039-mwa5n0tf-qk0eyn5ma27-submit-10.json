      "sourceTextSha256": "c9f4f3525b84790c03bf6d9904cc0a0e4c60995281a2e32fd38bd17c30ac5cc0",
      "text": "Puno to Lake Titicaca and back",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-113a0f7cb039-mwa5n0tf-qk0eyn5ma27",
        "model": "ChatGPT"

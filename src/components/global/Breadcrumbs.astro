---
import { withBase } from '../../lib/paths';
import type { BreadcrumbItem } from '../../lib/routes';

interface Props {
  pathname: string;
  title: string;
  theme?: 'light' | 'dark';
  items?: BreadcrumbItem[];
  hideCurrentLabel?: boolean;
  inline?: boolean;
}

const { pathname, title, theme = 'light', items, hideCurrentLabel = false, inline = false } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
const normalizedBase = base.endsWith('/') ? base : `${base}/`;
let cleanPath = pathname;

if (normalizedBase !== '/' && cleanPath.startsWith(normalizedBase)) {
  cleanPath = `/${cleanPath.slice(normalizedBase.length)}`;
}

const segments = cleanPath.split('/').filter(Boolean);

const labels: Record<string, string> = {
  country: 'Страны',
  tours: 'Туры',
  excursions: 'Экскурсии',
  places: 'Направления',
  'interests': 'По интересам',
  dmc: 'Для агентств',
  'travel-agencies': 'Для турагентств',
  'terms': 'Условия работы',
  mice: 'MICE',
  'business-delegations': 'Деловые делегации',
  vip: 'VIP',
  'multi-country': 'Multi-country',
  about: 'О нас',
  team: 'Команда',
  contacts: 'Контакты',
  cases: 'Кейсы',
  reviews: 'Отзывы',
  articles: 'Статьи',
  brazil: 'Бразилия',
  argentina: 'Аргентина',
  peru: 'Перу',
  'rio-de-janeiro': 'Рио-де-Жанейро',
  'foz-do-iguacu': 'Игуасу',
  'manaus-amazon': 'Амазония',
  pantanal: 'Пантанал',
  'buenos-aires': 'Буэнос-Айрес',
  'el-calafate': 'Эль-Калафате',
  mendoza: 'Мендоса',
  cusco: 'Куско',
  'machu-picchu': 'Мачу-Пикчу',
  lima: 'Лима',
  fishing: 'Рыболовные туры',
  'motorcycle-tours': 'Мото-туры',
  'food-and-wine': 'Гастрономия и вино',
  'family-tours': 'Семейные туры',
  spa: 'SPA',
  diving: 'Дайвинг',
  adventure: 'Приключения',
  'beach-holidays': 'Пляжный отдых',
  'weddings-and-romance': 'Свадьбы и романтика',
};

const pageTitle = title
  .replace(/\s*[|–—-]\s*Ada Tours.*$/i, '')
  .trim();

const defaultCrumbs = [
  { label: 'Главная', href: withBase('/') },
  ...segments.map((segment, index) => ({
    label: labels[segment] ?? (index === segments.length - 1 ? pageTitle : segment.replace(/-/g, ' ')),
    href: withBase(`/${segments.slice(0, index + 1).join('/')}/`),
  })),
];

const crumbs: BreadcrumbItem[] = items?.length
  ? items.map((item) => 'links' in item
    ? { links: item.links.map((link) => ({ ...link, href: withBase(link.href) })) }
    : { ...item, href: withBase(item.href) })
  : defaultCrumbs;
const isCustomTrail = Boolean(items?.length);

// Entity trails explicitly include the current title and parallel country links.
const visibleCrumbs = isCustomTrail
  ? (hideCurrentLabel && crumbs.length > 1 ? crumbs.slice(0, -1) : crumbs)
  : crumbs.length > 1 ? crumbs.slice(0, -1) : crumbs;
---

<nav class:list={['breadcrumbs', `breadcrumbs--${theme}`, isCustomTrail && 'breadcrumbs--custom', { 'breadcrumbs--inline': inline }]} aria-label="Хлебные крошки">
  <ol>
    {visibleCrumbs.map((crumb, index) => (
      <li class:list={{ 'breadcrumbs__group': 'links' in crumb }}>
        {'links' in crumb ? crumb.links.map((link, linkIndex) => (
          <span class="breadcrumbs__country">
            {linkIndex > 0 && <span class="breadcrumbs__dot" aria-hidden="true">·</span>}
            <a href={link.href}>{link.label}</a>
          </span>
        )) : isCustomTrail && index === visibleCrumbs.length - 1 ? (
          <span aria-current="page">{crumb.label}</span>
        ) : (
          <a href={crumb.href}>{crumb.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    position: absolute;
    z-index: 45;
    top: calc(var(--header-h) + 6px);
    left: var(--gutter);
    right: var(--gutter);
    pointer-events: none;
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    pointer-events: auto;
  }

  .breadcrumbs li + li::before {
    content: '/';
    margin: 0 9px;
    opacity: .8;
  }

  .breadcrumbs a,
  .breadcrumbs span {
    color: inherit;
  }

  .breadcrumbs a {
    opacity: 1;
  }

  .breadcrumbs a:hover {
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .breadcrumbs__group { flex-wrap: wrap; }
  .breadcrumbs__dot { margin-inline: .45em; }

  .breadcrumbs--light {
    color: #fff;
    text-shadow: 0 1px 3px rgb(0 0 0 / 60%);
  }

  .breadcrumbs--dark {
    color: var(--color-ink);
  }

  @media (max-width: 680px) {
    .breadcrumbs {
      top: calc(var(--header-h) - 4px);
    }

    .breadcrumbs ol {
      flex-wrap: nowrap;
      overflow: hidden;
      font-size: var(--text-xs);
      letter-spacing: .06em;
    }

    .breadcrumbs li {
      min-width: 0;
    }

    .breadcrumbs:not(.breadcrumbs--custom) li:not(:first-child):not(:last-child) {
      display: none;
    }

    .breadcrumbs li:first-child {
      flex: 0 0 auto;
    }

    .breadcrumbs li:last-child {
      flex: 1 1 auto;
      overflow: hidden;
    }

    .breadcrumbs li:last-child a,
    .breadcrumbs li:last-child span {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .breadcrumbs li + li::before {
      margin-inline: 7px;
    }

    .breadcrumbs--custom li:nth-child(2) {
      flex: 1 1 auto;
      min-width: 0;
      overflow: hidden;
    }

    .breadcrumbs--custom li:nth-child(2) a {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .breadcrumbs--custom li:last-child {
      flex: 0 0 auto;
      overflow: visible;
    }

    .breadcrumbs--custom li:last-child a {
      overflow: visible;
      text-overflow: clip;
    }

    .breadcrumbs--custom ol { flex-wrap: wrap; overflow: visible; }
    .breadcrumbs--custom li:nth-child(2),
    .breadcrumbs--custom li:last-child { flex: 0 1 auto; overflow: visible; }
    .breadcrumbs--custom li:nth-child(2) a,
    .breadcrumbs--custom li:last-child span { white-space: normal; overflow: visible; }
  }

  .breadcrumbs--inline { position: static; pointer-events: auto; }

  .breadcrumbs .breadcrumbs__group .breadcrumbs__country {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .breadcrumbs .breadcrumbs__group .breadcrumbs__country a { white-space: nowrap; }

  @media (max-width: 720px) {
    .breadcrumbs--inline ol { flex-wrap: wrap; gap: 8px 0; overflow: visible; }
    .breadcrumbs--inline li.breadcrumbs__group { flex: 1 1 100%; }
    .breadcrumbs--inline .breadcrumbs__group::before { display: none; }
  }
</style>

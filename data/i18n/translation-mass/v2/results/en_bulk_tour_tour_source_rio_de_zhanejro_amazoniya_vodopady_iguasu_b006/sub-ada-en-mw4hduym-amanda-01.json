    {
      "blockId": "tour:itinerary_text:b9ad3e14216c2f08",
      "field": "itinerary.text",
      "sourceTextSha256": "3f8d3d6d36e49a15fdb6bc3de2b7c5a4366eb1f68dd2bb4c56ee8efa928ab9f1",
      "text": "After breakfast, the Argentine side of the falls, which is different from the Brazilian one: paths lead you through the falls, giving you the chance to look at them from below and feel the strength of the falling water up close, in a natural park of some 55,500 hectares. Within the park, take the train to the Devil’s Throat, the most powerful of all the falls, and stand directly above the falling water. Optional: the Gran Aventura boat tour.\n\nOptional\n\nAbout 3 km through the jungle by open jeep with a guide, then on foot to the Iguazu River and by motorboat close to the falls, among spray and rainbows.",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1YPIJivG5ng3A6_Mj3-k1JvCcvcum977i",
        "documentSha256": "3df5264bf3145f91aa1d7bddc661e7bc002604bc171f91955e9591fcfe9c0f72",

        "kind": "ai_translation",
        "model": "ChatGPT",
        "runId": "ada-en-1d528bec4ff4",
        "wordAbsenceReason": "Word 2027 paragraph 101 specifies the Day 8 overland crossing, while the commercial table separately lists a Flores–Belize City flight in paragraphs 204–205. No Word passage contains the RU caution against treating that supplement as mandatory; translate the current RU reconciliation note.",
        "fileId": "1SFMrsSLCcDQDvsSHBzcvrKK1-cw12VzD",
        "documentSha256": "55ef96ebf9b9225892c082f7ee196d5ae52f75a35b2b2d5b895188eb6c7bd4e6"
      }
    },
    {

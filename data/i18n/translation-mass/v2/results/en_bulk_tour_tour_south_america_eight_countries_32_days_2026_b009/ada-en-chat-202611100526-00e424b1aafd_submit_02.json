    {
      "blockId": "tour:contentBlock_text:80bec0264076a40c",
      "field": "contentBlock.text",
      "sourceTextSha256": "c70f00b41e256a9f7356ff8173b0218af3694f388e1fd791037256320ac6cedb",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-chat-202611100526-00e424b1aafd",
        "model": "GPT-6"
      },
      "text": "Breakfast. Meet your guide in the hotel lobby.\nTake a four-hour group tour to the Christ the Redeemer statue on Corcovado Mountain with an English-speaking guide.\nAt the station, board a special open-air, eco-friendly train that takes you through the jungle to the summit of Corcovado. The journey offers sweeping views of Tijuca Forest on both sides of the tracks. At the summit, 710 m above sea level, stands Rio's symbol, the 38 m Christ the Redeemer statue, erected in 1931. The viewing platform offers a panoramic view of the city and its surroundings, including the bridge to Niterói, Guanabara Bay, the Botanical Garden, Maracanã Stadium, described in the itinerary as the world's largest, and Sugarloaf Mountain."

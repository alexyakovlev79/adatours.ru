---
import BorrowedHero from './BorrowedHero.astro';
import { withBase } from '../../lib/paths';
import InlineMarkdown from '../global/InlineMarkdown.astro';

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  image?: string;
  reverse?: boolean;
  imageTextAlign?: 'left' | 'right';
  mediaStatus?: 'approved' | 'needs_replacement' | 'replaced';
  replacementReason?: string;
  imagePosition?: string;
  imagePositionMobile?: string;
}

const { eyebrow, title, text, image, reverse = false, imageTextAlign, mediaStatus, replacementReason, imagePosition, imagePositionMobile } = Astro.props;
const align = imageTextAlign ?? (reverse ? 'right' : 'left');
const resolvedImage = image ? withBase(image) : undefined;
---

<section
  class:list={['story', `story--${align}`]}
  data-video-surface
  data-image-text-align={imageTextAlign}
  data-media-status={mediaStatus ?? (image ? 'legacy' : undefined)}
  data-replacement-reason={replacementReason}
>
  <BorrowedHero image={image}><div
    class="story__media"
    style={[
      resolvedImage ? `background-image:url("${resolvedImage}")` : "",
      imagePosition ? `--story-image-position:${imagePosition}` : "",
      imagePositionMobile ? `--story-image-position-mobile:${imagePositionMobile}` : "",
    ].filter(Boolean).join(";") || undefined}
  ></div></BorrowedHero>
  <div class="story__copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p><InlineMarkdown text={text} /></p>
  </div>
</section>

<style>
  .story {
    position: relative;
    display: grid;
    min-height: clamp(440px, 55vw, 680px);
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background: #171815;
  }
  .story__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-position: var(--story-image-position, center);
    background-size: cover;
  }
  .story::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(10,10,9,.72), rgba(10,10,9,.16) 85%);
  }
  .story__copy {
    align-self: end;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    min-width: 0;
    margin-inline: auto;
    padding-block: clamp(48px, 6vw, 86px);
  }
  .story h2 {
    max-width: 920px;
    margin: 10px 0 18px;
    color: inherit;
    font-size: var(--text-h2);
    line-height: 1.04;
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .story__copy > p:last-child {
    max-width: 700px;
    margin-bottom: 0;
    color: rgba(255,255,255,.9);
  }
  .story--right .story__copy { text-align: right; }
  .story--right h2,
  .story--right .story__copy > p:last-child { margin-left: auto; }
  .story--right::before {
    background: linear-gradient(270deg, rgba(10,10,9,.72), rgba(10,10,9,.16) 85%);
  }
  @media (max-width: 820px) {
    .story__media { background-position: var(--story-image-position-mobile, var(--story-image-position, center)); }
    .story::before { background: linear-gradient(180deg, rgba(10,10,9,.15), rgba(10,10,9,.82)); }
  }
</style>

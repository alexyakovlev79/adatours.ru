---
import {commercialText} from '../../lib/i18n/commercial-copy.mjs';
import {sharedUiLocale} from '../../lib/i18n/shared-ui-locale.mjs';
const commercialLocale=sharedUiLocale();
const commercialTr=(value:string)=>commercialText(value,commercialLocale);
import AuthoritySpeaker from '../authority/AuthoritySpeaker.astro';
interface Props { title?: string; text?: string; }
const { title = 'Обсудите задачу с командой, которая работает на месте', text = 'Ada Tours работает из Рио-де-Жанейро. Основатель компании Анна Аванесова знакомит партнеров с направлениями и практикой организации поездок на [вебинарах для турагентств](/webinars/). Пришлите вашу задачу: команда свяжет пожелания гостей с маршрутом и условиями местных поставщиков.' } = Astro.props;
---
<AuthoritySpeaker
  section={{ id: 'commercial-expert', eyebrow: commercialTr('Экспертиза Ada Tours'), heading: commercialTr(title), paragraphsMarkdown: [commercialTr(text)] }}
  speaker={{ name: commercialTr('Анна Аванесова'), role: commercialTr('Основатель и руководитель Ada Tours'), photo: '/media/people/anna-avanesova/photo-enhanced-20261022-v2.webp', photoAlt: commercialTr('Анна Аванесова, основатель Ada Tours'), href: '/team/anna-avanesova/', linkLabel: commercialTr('Опыт и выступления Анны') }}
/>

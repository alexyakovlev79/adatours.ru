        "model": "gpt-6.1-sol"
      },
      "text": "San Blas Archipelago"
    },
    {
      "blockId": "tour:itinerary_text:ec46e3209ab74818",
      "field": "itinerary.text",
      "sourceTextSha256": "86108e617d348876bf1ebe172b1da090e576ad62a92162381606199d14c71fb9",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-63081f33d4c840e99362579a12d8b39a",
        "model": "gpt-6.1-sol"
      },
      "text": "Leave your hotel at 05:00 for San Blas, an archipelago of 365 islands in the Caribbean Sea. Spend the day amid white sand beaches and turquoise waters, then return to your hotel in the evening."
    },

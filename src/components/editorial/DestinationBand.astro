---
import { withBase } from '../../lib/paths';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  href: string;
  image?: string;
  align?: 'left' | 'right';
  mediaStatus?: 'approved' | 'needs_replacement' | 'replaced';
  replacementReason?: string;
  descriptionBelow?: boolean;
}

const {
  eyebrow,
  title,
  text,
  href,
  image,
  align = 'left',
  mediaStatus,
  replacementReason,
  descriptionBelow = false,
} = Astro.props;

const resolvedImage = image ? withBase(image) : undefined;
const style = resolvedImage ? `--band-image: url("${resolvedImage}")` : undefined;
const resolvedHref = withBase(href);
---

{descriptionBelow ? (
  <a
    class:list={['band-card', `band-card--${align}`]}
    href={resolvedHref}
    data-media-status={mediaStatus ?? (image ? 'legacy' : undefined)}
    data-replacement-reason={replacementReason}
  >
    <div class:list={['band', `band--${align}`, { 'band--image': image }]} style={style}>
      <div class="band__overlay"></div>
      <div class="band__content">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2>{title}</h2>
        <span class="band__link">Смотреть <span aria-hidden="true">↗</span></span>
      </div>
    </div>
    {text && (
      <div class="band-card__below">
        <div class="band-card__below-inner">
          <p>{text}</p>
        </div>
      </div>
    )}
  </a>
) : (
  <a class:list={['band', `band--${align}`, { 'band--image': image }]} href={resolvedHref} style={style}
    data-media-status={mediaStatus ?? (image ? 'legacy' : undefined)}
    data-replacement-reason={replacementReason}
  >
    <div class="band__overlay"></div>
    <div class="band__content">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      {text && <p class="band__text">{text}</p>}
      <span class="band__link">Смотреть <span aria-hidden="true">↗</span></span>
    </div>
  </a>
)}

<style>
  .band-card {
    display: block;
    background: var(--color-bg);
  }

  .band-card__below {
    background: var(--color-bg);
  }

  .band-card__below-inner {
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
    padding-block: clamp(24px, 3vw, 38px);
  }

  .band-card__below p {
    max-width: 760px;
    margin: 0;
    color: color-mix(in srgb, var(--color-ink) 76%, transparent);
    font-size: clamp(1rem, 1.25vw, 1.14rem);
    line-height: 1.55;
  }

  .band-card--right .band-card__below-inner {
    text-align: right;
  }

  .band-card--right .band-card__below p {
    margin-left: auto;
  }

  .band {
    position: relative;
    display: grid;
    min-height: clamp(440px, 55vw, 680px);
    overflow: hidden;
    color: var(--color-bg);
    background:
      radial-gradient(circle at 75% 25%, rgba(242, 204, 103, .2), transparent 28%),
      linear-gradient(135deg, #45463e, #171815);
    isolation: isolate;
  }

  .band--image {
    background-image: var(--band-image);
    background-size: cover;
    background-position: center;
  }

  .band__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(10,10,9,.7), rgba(10,10,9,.08) 72%);
    transition: background 350ms var(--ease-out);
  }

  .band:hover .band__overlay {
    background: linear-gradient(90deg, rgba(10,10,9,.78), rgba(10,10,9,.14) 72%);
  }

  .band__content {
    align-self: end;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
    padding-block: clamp(48px, 6vw, 86px);
  }

  .band--right .band__content {
    text-align: right;
  }

  .band h2 {
    max-width: 920px;
    margin: 10px 0 18px;
  }

  .band--right h2,
  .band--right .band__text {
    margin-left: auto;
  }

  .band__text {
    max-width: 580px;
    margin-bottom: 26px;
    color: rgba(255,255,255,.84);
  }

  .band__link {
    display: inline-flex;
    gap: 28px;
    align-items: center;
    padding-bottom: 7px;
    border-bottom: 1px solid currentColor;
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  @media (max-width: 720px) {
    .band-card--right .band-card__below-inner {
      text-align: left;
    }

    .band-card--right .band-card__below p {
      margin-left: 0;
    }

    .band-card__below-inner {
      padding-block: 18px 24px;
    }
  }
</style>

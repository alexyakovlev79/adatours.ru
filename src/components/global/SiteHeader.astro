---
import PrimaryCTA from './PrimaryCTA.astro';
import SearchTrigger from './SearchTrigger.astro';
import { NAV_LINKS } from '../../lib/site';
import { withBase } from '../../lib/paths';
import ContactActions from './ContactActions.astro';

interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
const logoWhite = withBase('/brand/adatours-logo-white.svg');
const logoBlack = withBase('/brand/adatours-logo-black.svg');
---

<header class:list={['site-header', `site-header--${theme}`]} data-site-header>
  <div class="site-header__inner">
    <a class="brand" href={withBase('/')} aria-label="Ada Tours, на главную">
      <img class="brand__logo brand__logo--white" src={logoWhite} width="553" height="184" alt="" aria-hidden="true" />
      <img class="brand__logo brand__logo--black" src={logoBlack} width="553" height="184" alt="" aria-hidden="true" />
    </a>

    <nav class="desktop-nav" aria-label="Основная навигация">
      {NAV_LINKS.map((link) => <a href={withBase(link.href)}>{link.label}</a>)}
    </nav>

    <div class="desktop-cta">
      <SearchTrigger />
      <div class="desktop-cta__links">
        <ContactActions compact />
      </div>
      <PrimaryCTA href="/contacts/" label="Оставить заявку" />
    </div>

    <div class="mobile-search">
      <SearchTrigger compact />
    </div>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Открыть меню"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true" data-mobile-menu>
    <nav aria-label="Мобильная навигация">
      {NAV_LINKS.map((link) => <a href={withBase(link.href)}>{link.label}</a>)}
    </nav>
    <div class="mobile-menu__contact">
      <PrimaryCTA href="/contacts/" label="Оставить заявку" />
      <ContactActions light />
    </div>
  </div>
</header>
<div class:list={['site-header-spacer', theme === 'dark' && 'site-header-spacer--active']} aria-hidden="true"></div>

<script>
  const header = document.querySelector('[data-site-header]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');

  if (header instanceof HTMLElement) {
    const setScrolled = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 12);
    };

    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });
  }

  if (header && toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
      menu.setAttribute('aria-hidden', String(!open));
      document.body.classList.toggle('menu-open', open);
      header.classList.toggle('is-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    window.addEventListener('ada:search-open', () => setOpen(false));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--color-bg);
    background: transparent;
    transition:
      color 220ms var(--ease-out),
      background-color 220ms var(--ease-out),
      backdrop-filter 220ms var(--ease-out);
  }

  .site-header--dark,
  .site-header.is-scrolled {
    color: var(--color-ink);
    background: rgb(255 252 248 / 92%);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .site-header.is-open {
    color: var(--color-bg);
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .site-header-spacer {
    display: none;
  }

  .site-header-spacer--active {
    display: block;
    height: var(--header-h);
  }

  .site-header__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(24px, 3vw, 48px);
    min-height: var(--header-h);
    padding-inline: var(--gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    width: clamp(116px, 8.6vw, 138px);
    line-height: 0;
  }

  .brand__logo {
    display: block;
    width: 100%;
    height: auto;
  }

  .brand__logo--black {
    display: none;
  }

  .site-header--dark .brand__logo--white,
  .site-header.is-scrolled .brand__logo--white {
    display: none;
  }

  .site-header--dark .brand__logo--black,
  .site-header.is-scrolled .brand__logo--black {
    display: block;
  }

  .site-header.is-open .brand__logo--white {
    display: block;
  }

  .site-header.is-open .brand__logo--black {
    display: none;
  }

  .desktop-nav {
    display: flex;
    justify-content: center;
    gap: clamp(16px, 2vw, 30px);
  }

  .desktop-nav a {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    opacity: 0.95;
  }

  .desktop-nav a:hover {
    opacity: 0.62;
  }

  .desktop-cta {
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .desktop-cta__links {
    display: none;
  }

  .desktop-cta :global(.cta) {
    min-width: auto;
    padding: 12px 15px;
  }

  @media (min-width: 1320px) {
    .desktop-cta__links {
      display: block;
    }
  }

  .mobile-search,
  .menu-toggle,
  .mobile-menu {
    display: none;
  }

  @media (max-width: 1080px) {
    .brand {
      width: 108px;
    }

    .site-header__inner {
      grid-template-columns: 1fr auto auto;
      gap: 4px;
    }

    .desktop-nav,
    .desktop-cta {
      display: none;
    }

    .mobile-search {
      display: block;
    }

    .menu-toggle {
      display: grid;
      width: 44px;
      height: 44px;
      padding: 10px;
      place-content: center;
      gap: 7px;
      border: 0;
      color: inherit;
      background: transparent;
      cursor: pointer;
    }

    .menu-toggle span {
      display: block;
      width: 24px;
      height: 1px;
      background: currentColor;
      transition: transform 250ms var(--ease-out);
    }

    .is-open .menu-toggle span:first-child {
      transform: translateY(8px) rotate(45deg);
    }

    .is-open .menu-toggle span:nth-child(2) {
      opacity: 0;
      transform: scaleX(.4);
    }

    .is-open .menu-toggle span:last-child {
      transform: translateY(-8px) rotate(-45deg);
    }

    .mobile-menu {
      position: fixed;
      inset: 0;
      display: grid;
      align-content: end;
      gap: 48px;
      padding: calc(var(--header-h) + 48px) var(--gutter) 48px;
      color: var(--color-bg);
      background: var(--color-ink-deep);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition:
        opacity 260ms var(--ease-out),
        transform 260ms var(--ease-out),
        visibility 260ms;
    }

    .is-open .mobile-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .mobile-menu nav {
      display: grid;
      gap: 7px;
    }

    .mobile-menu nav a {
      font-family: var(--font-display);
      font-size: clamp(2rem, 10vw, 4.5rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .mobile-menu__contact {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 18px 26px;
      font-size: 0.88rem;
    }
  }
</style>

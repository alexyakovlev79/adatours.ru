---
import InlineMarkdown from '../global/InlineMarkdown.astro';
interface Props {
  included: string[];
  notIncluded: string[];
  notes?: string[];
}
const { included = [], notIncluded = [], notes = [] } = Astro.props;
const includedItems = included.map((item) => item.trim()).filter(Boolean);
const notIncludedItems = notIncluded.map((item) => item.trim()).filter(Boolean);
const noteItems = notes.map((item) => item.trim()).filter(Boolean);
const hasServices = includedItems.length > 0 || notIncludedItems.length > 0;
const hasContent = hasServices || noteItems.length > 0;
---

{hasContent && (
<section class="included section">
  <div class="container">
    {hasServices && <p class="eyebrow">Условия программы</p>}
    {hasServices && (
      <div class="included__grid">
        {includedItems.length > 0 && <div class="included__column included__column--included">
          <h2>Включено</h2>
          <ul>
            {includedItems.map((item) => <li><InlineMarkdown text={item} /></li>)}
          </ul>
        </div>}
        {notIncludedItems.length > 0 && <div class="included__column included__column--extra">
          <h2>Оплачивается отдельно</h2>
          <ul>
            {notIncludedItems.map((item) => <li><InlineMarkdown text={item} /></li>)}
          </ul>
        </div>}
      </div>
    )}

    {noteItems.length > 0 && (
      <div class:list={["included__notes", { "included__notes--standalone": !hasServices }]}>
        <h3>Важные условия</h3>
        <ul>
          {noteItems.map((item) => <li><InlineMarkdown text={item} /></li>)}
        </ul>
      </div>
    )}
  </div>
</section>
)}

<style>
  .included {
    background: var(--color-bg);
  }

  .included__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(52px,8vw,120px);
    row-gap: var(--heading-gap);
    margin-top: 18px;
  }

  .included h2 {
    width: 100%;
    box-sizing: border-box;
    margin: 18px 0 0;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 2.7vw, 3.25rem);
    line-height: 1.08;
    font-weight: 400;
  }

  .included__column--extra h2 {
    white-space: nowrap;
  }

  .included ul {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 0;
  }

  .included li {
    position: relative;
    padding: 17px 0 17px 28px;
    border-bottom: 1px solid var(--color-line);
    font-size: .98rem;
  }

  .included li:last-child {
    border-bottom: 0;
  }

  .included li::before {
    position: absolute;
    left: 0;
    color: var(--color-gold-deep);
    font-family: var(--font-display);
  }

  .included__column--included li::before {
    content: '+';
    font-size: .9rem;
  }

  .included__column--extra li::before {
    content: '−';
    font-size: 1rem;
  }

  .included__notes {
    margin-top: clamp(28px, 4vw, 48px);
    max-width: 980px;
  }

  .included__notes--standalone {
    margin-top: 0;
  }

  .included__notes h3 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2vw, 2.2rem);
  }

  .included__notes ul {
    display: grid;
    gap: 10px;
    border: 0;
  }

  .included__notes li {
    padding: 0 0 0 20px;
    border: 0;
  }

  .included__notes li::before {
    content: '•';
    top: 0;
    font-size: 1rem;
    line-height: inherit;
  }

  @media (max-width: 760px) {
    .included__grid {
      grid-template-columns: 1fr;
    }

    .included__column--extra h2 {
      font-size: clamp(2.2rem, 10vw, 3.25rem);
      white-space: normal;
    }
  }
</style>

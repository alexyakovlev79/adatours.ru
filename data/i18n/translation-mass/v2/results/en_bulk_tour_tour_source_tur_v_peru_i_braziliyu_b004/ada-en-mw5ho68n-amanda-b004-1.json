      "sourceTextSha256": "cfd20d17c36fc074d9868070ff3cd9dfd9284f55e9e3404f56d33dee541d5dd0",
      "text": "Lima: historic centre, Miraflores and the Larco Museum",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw5ho68n-amanda",
        "model": "GPT-6",
        "wordAbsenceReason": "Word groups days 1–2 under City of Kings; the separate RU day-two heading is absent."

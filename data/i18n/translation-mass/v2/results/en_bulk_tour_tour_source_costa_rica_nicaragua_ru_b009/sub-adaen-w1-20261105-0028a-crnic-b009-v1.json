    {
      "blockId": "tour:itinerary_text:c3205ac1e20a266d",
      "field": "itinerary.text",
      "sourceTextSha256": "72efd9525611f72e830e780d602b9ec3c80431241e7dce0f657efe5892a775aa",
      "text": "Transfer to the port for a boat ride among the Isletas of Granada on Lake Nicaragua, some 365 islets formed by an ancient eruption of Mombacho Volcano. Enjoy the local flora, fauna and tranquil lakeside scenery, with a chance to see monkeys.\n\nArrive at the private island of Zopango, facing Mombacho Volcano. Swim, explore the island, watch birds or relax in a hammock with views of the volcano.\n\nFor lunch, enjoy freshly grilled local fish. After lunch, return to your hotel.\n\nOvernight: Hotel Real La Merced.\nMeals: breakfast and lunch.",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1gaudgT06al-sUxmQcsvu7pghRG1gPpwt",
        "documentSha256": "e284b6756b5fe364ffe2476b42fb1cefd466ca2e3b645d9af46f8d2fd1120e41",
        "paragraphs": [
          {

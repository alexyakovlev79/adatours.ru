    {
      "blockId": "tour:itinerary_text:b04d5d61d358e759",
      "field": "itinerary.text",
      "sourceTextSha256": "59e7261d2ed95648b353a0c898171811f3f18651de7be64ef93da9dcba3c9985",
      "text": "Take in the rare and breathtaking beauty of the Perito Moreno Glacier, one of UNESCO’s jewels. Your guide picks you up at the hotel in the morning for a full-day tour, sharing details about the glacier and the national park on the way. The first stop is a series of walkways with views of the glacier, ideal for photos; the bus then continues through the park’s natural scenery, and you walk along the walkways to watch chunks of ice break off and crash into the water.\n\nThen enjoy a one-hour navigation in front of the glacier, the Safari Náutico (shared boat). At the end of the day, the bus takes you back to your hotel.",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1ZGWvI0Qr65nWVX5SI85UAm2W6vLpWCaW",
        "documentSha256": "0baf25fe5c92a21392ac70cc09009cb07ab1e7fd0ad5032d8a0e93d1b93aad13",

      "field": "itinerary.text",
      "sourceTextSha256": "a7fe77059d7b5d3ebc5e293dc4bca068dbbe319fb7e38ab8b4d1348a8b38c64f",
      "text": "You spend days 9–10 crossing the Drake Passage on the return journey. Look out for the seabirds you may have seen on the way south. Sea conditions determine when you leave Antarctica and how the crossing progresses.",
      "provenance": {
        "kind": "ai_translation",

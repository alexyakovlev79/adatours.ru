---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import EditorialProof from '../../components/proof/EditorialProof.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
import PersonProfile from '../../components/proof/PersonProfile.astro';
import { ORG } from '../../data/organization/ada-tours';

const people = await getCollection('people', ({ data }) => data.id === 'person_anna' && data.locale === 'ru');
const anna = people[0];
const AnnaContent = anna ? (await render(anna)).Content : null;
const languagesInPrepositional = ORG.service.languages.map((language) =>
  language.toLowerCase().replace(/ий$/, 'ом')
);
const languagesText = languagesInPrepositional.length > 1
  ? `${languagesInPrepositional.slice(0, -1).join(', ')} и ${languagesInPrepositional[languagesInPrepositional.length - 1]}`
  : (languagesInPrepositional[0] ?? '');
---

<BaseLayout
  title="О компании Ada Tours - DMC в Бразилии и Латинской Америке"
  description="Ada Tours работает с индивидуальными путешествиями, VIP, MICE, группами и B2B-партнерами в Бразилии и странах Латинской Америки."
>
  <Hero
    eyebrow="Ada Tours · DMC"
    title="Латинская Америка с локальной координацией"
    intro="Ada Tours работает с турагентствами и туроператорами, частными клиентами, корпоративными группами и сложными маршрутами по нескольким странам."
    image="/media/prototype/rio-panorama.jpg"
    ctaLabel="Обсудить поездку"
  />

  <EditorialStatement
    eyebrow="Что мы организуем"
    text="Бразилия остается главной географией Ada Tours, а маршруты могут продолжаться в Аргентине, Перу и других странах региона."
  />

  <FactStrip
    facts={[
      { value: 'Бразилия', label: 'ключевая география Ada Tours' },
      { value: ORG.service.groups.standard.display, label: ORG.service.groups.standard.label },
      { value: ORG.service.groups.largeEvents.display, label: ORG.service.groups.largeEvents.label },
      { value: String(ORG.service.languages.length), label: 'языков для обработки заявок' },
    ]}
  />

  <EditorialProof
    eyebrow="Форматы"
    title="От индивидуального маршрута до крупного события"
    text="Одна и та же локальная команда может вести частную поездку, группу, деловую делегацию или программу по нескольким странам. Состав услуг меняется под задачу, но маршрут и наземная часть остаются связаны между собой."
    image="/media/prototype/lencois.jpg"
    facts={[
      'B2B для туроператоров и турагентств',
      'VIP и индивидуальные премиальные маршруты',
      'MICE, incentive и корпоративные группы',
      'Multi-country программы по Латинской Америке',
    ]}
  />

  <EditorialProof
    eyebrow="MICE"
    title="Бразилия - приоритет №1 для деловых и корпоративных поездок"
    text="Далее по приоритету идут Аргентина, Перу и Коста-Рика. Для MICE важны не только программа и площадки, но и транспорт, размещение, переводчики, встречи и изменения по ходу поездки."
    image="/media/prototype/rio-night.jpg"
    facts={ORG.business.micePriorityCountries.map((country, index) => `${index + 1}. ${country}`)}
    reverse
  />

  <EditorialStatement
    eyebrow="Языки"
    text={`Ada Tours может обрабатывать заявки на ${languagesText} языках.`}
  />

  {anna && AnnaContent && (
    <PersonProfile
      name={anna.data.name}
      role={anna.data.role}
      photo={anna.data.photo}
      expertise={anna.data.expertise}
      href={`/team/${anna.data.slug}/`}
      eyebrow="Основатель"
    >
      <AnnaContent />
    </PersonProfile>
  )}

  <LeadForm title="Обсудить поездку или партнерство" entityId="about" />
</BaseLayout>

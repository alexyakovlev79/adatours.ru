---
import { ABOUT_NAV_LINKS, DMC_NAV_LINKS, MICE_NAV_LINKS, NAV_LINKS, SITE } from '../../lib/site';
import { withBase } from '../../lib/paths';
import { ORG } from '../../data/organization/ada-tours';

const columns = [
  { id: 'travel', rail: 'left', title: 'Путешествия', primary: NAV_LINKS.slice(0, 5), children: [], trailing: [] },
  { id: 'mice', rail: 'right', title: 'Деловые поездки', primary: [NAV_LINKS[5]], children: MICE_NAV_LINKS.slice(1), trailing: [] },
  { id: 'agencies', rail: 'left', title: 'Для партнеров', primary: [NAV_LINKS[6]], children: DMC_NAV_LINKS.slice(1), trailing: [] },
  { id: 'about', rail: 'right', title: 'Ada Tours', primary: [NAV_LINKS[8], NAV_LINKS[7]], children: ABOUT_NAV_LINKS.slice(1), trailing: [] },
];
const footerRails = ['left', 'right'] as const;
---

<footer class="footer">
  <div class="footer__top">
    <div>
      <p class="eyebrow">Ada Tours</p>
      <h2>Бразилия и Латинская Америка</h2>
    </div>
    <a class="footer__request" href={withBase('/contacts/')} data-lead-modal="true" aria-label="Обсудить поездку — открыть форму заявки">
      Обсудить поездку <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="footer__navigation">
    {footerRails.map((rail) => (
      <div class:list={['footer__rail', `footer__rail--${rail}`]}>
        {columns.filter((column) => column.rail === rail).map((column) => (
          <div class:list={['footer__column', `footer__column--${column.id}`]}>
            <p class="footer__heading">{column.title}</p>
            <nav aria-label={column.title}>
              {column.primary.map((link) => (
                <a class="footer__primary-link" href={withBase(link.href)}>{link.label}</a>
              ))}
              {column.children.length > 0 && (
                <div class="footer__subnav">
                  {column.children.map((link) => (
                    <a href={withBase(link.href)}>{link.label}</a>
                  ))}
                </div>
              )}
              {column.trailing?.map((link) => (
                <a class="footer__primary-link" href={withBase(link.href)}>{link.label}</a>
              ))}
            </nav>
          </div>
        ))}
      </div>
    ))}
  </div>

  <div class="footer__contact">
    <div class="footer__contact-main">
      <span class="footer__caption">Свяжитесь с нами</span>
      <a href={ORG.phoneHref}>{ORG.phoneDisplay}</a>
      <a href={`mailto:${ORG.email}`}>{ORG.email}</a>
    </div>
    <div class="footer__messengers" role="group" aria-label="Мессенджеры">
      <a href={ORG.whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" title="WhatsApp">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M20.52 3.48A11.86 11.86 0 0 0 12.06 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.6 5.96L0 24l6.33-1.67a11.86 11.86 0 0 0 5.73 1.46h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.45-8.4ZM12.07 21.8a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.76.99 1-3.66-.24-.38a9.86 9.86 0 1 1 8.39 4.64Zm5.41-7.38c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.96 1.18-.18.2-.35.23-.65.08-.3-.15-1.28-.47-2.43-1.49-.9-.8-1.5-1.79-1.67-2.09-.18-.3-.02-.47.13-.62.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.94-2.24-.25-.6-.5-.52-.68-.53h-.58c-.2 0-.53.08-.8.38-.28.3-1.05 1.03-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.12 3.23 5.14 4.53.72.31 1.29.5 1.73.64.73.23 1.4.2 1.93.12.59-.09 1.78-.73 2.03-1.44.25-.7.25-1.31.18-1.44-.08-.13-.28-.2-.58-.35Z" />
        </svg>
      </a>
      <a href={ORG.telegramHref} target="_blank" rel="noopener noreferrer" aria-label="Telegram" title="Telegram">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0Zm5.89 8.22-1.97 9.3c-.15.66-.54.82-1.09.51l-3.02-2.23-1.46 1.4c-.16.16-.3.3-.6.3l.21-3 5.47-4.94c.24-.21-.05-.33-.37-.12l-6.76 4.26-2.91-.91c-.63-.2-.64-.63.13-.93l11.37-4.38c.53-.19.99.13.82.94Z" />
        </svg>
      </a>
    </div>
  </div>

  <div class="footer__legal">
    <p>© {new Date().getFullYear()} {SITE.name}</p>
    <nav aria-label="Юридическая информация">
      <a href={withBase('/privacy/')}>Политика конфиденциальности</a>
      <a href={withBase('/personal-data/')}>Обработка персональных данных</a>
    </nav>
  </div>

  <div class="footer__credit">
    <a href="https://gaeo.ru" target="_blank" rel="noopener noreferrer">Разработка сайта и продвижение в нейросетях - GAEO.ru</a>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(24px, 3vw, 40px) var(--gutter) 0;
    color: var(--color-ink);
    background: var(--color-surface);
  }
  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 48px;
    padding-bottom: clamp(36px, 5vw, 70px);
    border-bottom: 1px solid var(--color-line);
  }
  .footer h2 { max-width: 950px; margin: 12px 0 0; }
  .footer__request {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-width: 275px;
    min-height: 58px;
    padding: 18px 24px;
    border: 1px solid var(--cta-border);
    border-radius: var(--radius-cta);
    color: var(--color-ink);
    background: var(--cta-fill-light);
    font-family: var(--font-display);
    font-size: .86rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: background 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  .footer__request:hover {
    border-color: var(--cta-border-hover);
    background: var(--cta-fill-light-hover);
  }
  .footer a:focus-visible {
    outline: 2px solid var(--color-brand-deep);
    outline-offset: 4px;
  }
  .footer__navigation {
    display: grid;
    grid-template-columns: 1.03fr 1fr 1fr 1.24fr;
    gap: clamp(26px, 4vw, 72px);
    padding-block: clamp(34px, 4.5vw, 68px);
    align-items: start;
  }
  /* Four usual columns on desktop; each independent rail stacks its
     own groups at tablet/mobile sizes without shared grid-row whitespace. */
  .footer__rail { display: contents; }
  .footer__column { min-width: 0; }
  .footer__column--travel { order: 1; }
  .footer__column--mice { order: 2; }
  .footer__column--agencies { order: 3; }
  .footer__column--about { order: 4; }
  .footer__heading {
    margin: 0 0 22px;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: .73rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .footer__column nav,
  .footer__subnav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .footer__column nav { gap: 15px; }
  .footer__column a {
    display: inline-block;
    max-width: 100%;
    color: var(--color-ink);
    font-family: var(--font-display);
    line-height: 1.36;
    text-decoration: none;
    overflow-wrap: break-word;
    transition: color 180ms ease;
  }
  .footer__column a:hover,
  .footer__contact a:hover,
  .footer__legal a:hover { color: var(--color-brand-deep); }
  .footer__primary-link { font-size: clamp(.9rem, 1.1vw, 1.06rem); font-weight: 500; }
  .footer__subnav {
    gap: 12px;
    padding-left: 16px;
    margin-left: 2px;
    border-left: 1px solid color-mix(in srgb, var(--color-brand-deep) 34%, var(--color-line));
  }
  .footer__subnav a { font-size: clamp(.83rem, 1vw, .93rem); color: var(--color-text-muted); }
  .footer__contact {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 30px 48px;
    padding-block: 26px 30px;
    border-top: 1px solid var(--color-line);
  }
  .footer__contact-main {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px 30px;
  }
  .footer__caption {
    flex-basis: 100%;
    color: var(--color-text-muted);
    font-size: .74rem;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .footer__contact-main a {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    overflow-wrap: anywhere;
  }
  .footer__messengers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .footer__messengers a {
    display: grid;
    place-items: center;
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-ink);
    background: transparent;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }
  .footer__messengers a svg {
    display: block;
    width: 22px;
    height: 22px;
  }
  .footer__messengers a:hover {
    color: var(--color-brand-deep);
    border-color: var(--color-brand-deep);
    background: color-mix(in srgb, var(--color-brand-deep) 6%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .footer__messengers a { transition: none; }
  }
  .footer__legal {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px 30px;
    padding: 20px 0 26px;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-line);
    font-size: .8rem;
  }
  .footer__legal p { margin: 0; }
  .footer__legal nav { display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .footer__legal a { color: inherit; }
  /* Equal air above and below the credit line: exactly centred within this strip. */
  .footer__credit {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(72px, 7vw, 92px);
    padding: 18px 0;
    border-top: 1px solid var(--color-line);
    text-align: center;
    font-size: .76rem;
  }
  .footer__credit a { color: var(--color-text-muted); }
  .footer__credit a:hover { color: var(--color-ink); text-decoration: underline; }
  @media (max-width: 1060px) {
    .footer__navigation {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(22px, 5vw, 60px);
    }
    .footer__rail {
      display: flex;
      flex-direction: column;
      min-width: 0;
      gap: clamp(22px, 3vw, 36px);
    }
  }
  @media (max-width: 780px) {
    .footer__top { grid-template-columns: 1fr; gap: 32px; }
    .footer__request { width: 100%; min-width: 0; }
    .footer__contact { align-items: flex-start; }
  }
  @media (max-width: 480px) {
    .footer__navigation {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(12px, 4vw, 24px);
      row-gap: 32px;
    }
    .footer__heading { display: none; }
    .footer__rail { gap: 17px; }
    .footer__column nav { gap: 11px; }
    .footer__primary-link {
      font-size: clamp(.84rem, 3.7vw, 1rem);
      line-height: 1.32;
    }
    .footer__subnav {
      gap: 10px;
      padding-left: 10px;
    }
    .footer__subnav a {
      font-size: clamp(.77rem, 3.2vw, .9rem);
      line-height: 1.34;
    }
    .footer__contact-main { display: grid; gap: 8px; }
    .footer__caption { margin-bottom: 4px; }
    .footer__legal nav { flex-direction: column; gap: 8px; }
    .footer__credit { min-height: 76px; font-size: .72rem; }
  }
</style>

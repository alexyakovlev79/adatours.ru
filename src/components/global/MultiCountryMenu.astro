---
import { withBase } from '../../lib/paths';
import { formatMultiCountryNames } from '../../lib/multi-country-combinations.mjs';

interface MenuCountry { slug: string; name: string; }
interface MenuCombination { slugs: string[]; path: string; count: number; }
interface Props {
  countries: MenuCountry[];
  combinations: MenuCombination[];
  serverLinks?: boolean;
}
const { countries, combinations, serverLinks = true } = Astro.props;
const bySlug = new Map(countries.map((country) => [country.slug, country]));
const existing = new Set(combinations.map((row) => row.slugs.join('_')));
const items = (serverLinks ? combinations : []).map((row) => ({
  ...row,
  names: row.slugs.map((slug) => bySlug.get(slug)?.name ?? slug),
  hasMore: row.slugs.length < 4 && countries.some((country) =>
    !row.slugs.includes(country.slug)
    && existing.has([...row.slugs, country.slug].sort().join('_'))),
}));
---

<div class="mc-menu" data-mc-menu data-pagefind-ignore="all">
  <a class="mc-menu__all" href={withBase('/multi-country/')}>Все Multi-country туры</a>
  <button class="mc-menu__back" type="button" data-mc-menu-back hidden>‹ Назад</button>
  <p class="mc-menu__heading" data-mc-menu-heading hidden></p>

  <div class="mc-menu__countries" data-mc-menu-countries>
    {countries.map((country) => (
      <button
        class="mc-menu__country"
        type="button"
        data-mc-menu-country={country.slug}
        data-mc-menu-country-name={country.name}
        aria-label={'Сочетания с ' + country.name}
      >
        <span class="mc-menu__country-name">
          {country.name === 'Французская Гвиана'
            ? <>Французская<br />Гвиана</>
            : country.name}
        </span>
        <span class="mc-menu__arrow" aria-hidden="true">›</span>
      </button>
    ))}
  </div>

  <template data-mc-menu-expand-template>
    <button type="button" class="mc-menu__expand" aria-label="Добавить страну">›</button>
  </template>

  <nav class="mc-menu__combinations" data-mc-menu-combinations aria-label="Сочетания стран" data-mc-menu-source={serverLinks ? 'true' : undefined}>
    {items.map((row) => (
      <div
        class="mcc"
      >
        <a href={withBase(row.path)}>{formatMultiCountryNames(row.names)}</a>

      </div>
    ))}
  </nav>
</div>

<script>
  import '../../scripts/multi-country-menu';
</script>

<style is:global>
  .mc-menu {
    --mc-item-size: .72rem;
    --mc-item-weight: 600;
    --mc-item-tracking: .055em;
    min-width: 0;
    font-family: var(--font-display);
    line-height: 1.2;
    color: inherit;
  }
  .mc-menu__all {
    display: inline-block;
    padding-block: 10px;
    color: inherit;
    font-size: var(--mc-item-size);
    font-weight: var(--mc-item-weight);
    letter-spacing: var(--mc-item-tracking);
    text-transform: uppercase;
    text-decoration: none;
  }
  .mc-menu__back {
    display: block;
    padding: 8px 0;
    margin-top: 8px;
    color: inherit;
    background: transparent;
    border: none;
    font: inherit;
    font-size: var(--mc-item-size);
    font-weight: var(--mc-item-weight);
    letter-spacing: var(--mc-item-tracking);
    text-transform: uppercase;
    cursor: pointer;
  }
  .mc-menu__back[hidden],
  .mc-menu__heading[hidden],
  .mc-menu__countries[hidden],
  .mcc[hidden],
  .mc-menu__combinations[hidden] {
    display: none;
  }
  .mc-menu__heading {
    margin: 18px 0 12px;
    font-size: .93rem;
    font-weight: 500;
    opacity: .8;
  }
  .mc-menu__countries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(14px, 3vw, 26px);
  }
  .mc-menu__country {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    min-width: 0;
    min-height: 52px;
    gap: 8px;
    padding: 10px 0;
    border: 0;
    color: inherit;
    background: transparent;
    font-family: inherit;
    font-size: var(--mc-item-size);
    font-weight: var(--mc-item-weight);
    letter-spacing: var(--mc-item-tracking);
    text-transform: uppercase;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
  }
  /* The entire country row, including its label and chevron, is clickable. */
  .mc-menu__country,
  .mc-menu__country * {
    cursor: pointer;
  }
  .mc-menu__country-name {
    flex: 1 1 auto;
    min-width: 0;
    white-space: normal;
    overflow-wrap: normal;
  }
  .mc-menu__arrow {
    flex: 0 0 16px;
    font-size: 1.6rem;
    font-weight: 300;
    line-height: 1;
    text-align: right;
    opacity: .7;
  }
  .mc-menu__combinations {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0 0 12px;
  }
  .mc-menu[data-mc-ready]:not([data-mc-selected]) .mc-menu__combinations {
    display: none;
  }
  .mcc {
    display: flex;
    min-width: 0;
    align-items: stretch;
    gap: 8px;
  }
  .mcc a {
    /* A link only covers its label, never the empty space leading to the arrow. */
    flex: 0 1 auto;
    min-width: 0;
    padding: 13px 0;
    color: inherit;
    font-family: inherit;
    font-size: var(--mc-item-size);
    line-height: 1.3;
    font-weight: var(--mc-item-weight);
    text-transform: uppercase;
    letter-spacing: var(--mc-item-tracking);
    white-space: normal;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  .mc-menu__expand {
    /* Invisible expansion hit-area starts just beyond the country label. */
    display: flex;
    flex: 1 0 104px;
    min-width: 104px;
    align-items: center;
    justify-content: flex-end;
    padding: 4px 5px 4px 8px;
    color: inherit;
    background: transparent;
    border: 0;
    font: inherit;
    font-size: 1.5rem;
    opacity: .8;
    cursor: pointer;
  }
  /* Use the same full-row brand-color hover as the other desktop dropdowns.
     The parent row owns the background, covering both link and expand button. */
  .mc-menu__country:hover,
  .mcc:hover,
  .mc-menu__country:focus-visible,
  .mcc:focus-within,
  .mc-menu__all:hover,
  .mc-menu__all:focus-visible,
  .mc-menu__back:hover,
  .mc-menu__back:focus-visible {
    color: inherit;
    background: color-mix(in srgb, var(--color-brand) 18%, transparent);
  }
  .mc-menu__country,
  .mcc {
    transition: background-color 180ms var(--ease-out);
  }
  .mc-menu :is(a, button):focus-visible {
    outline: 2px solid var(--color-brand-deep);
    outline-offset: 3px;
  }
  @media (min-width: 1241px) {
    /* Match the desktop "Страны" dropdown row rhythm (12px / 1.3).
       The former 52px minimum caused needless scrolling on short laptops. */
    .mc-menu__country {
      min-height: 0;
      padding-block: 12px;
      line-height: 1.3;
    }
    .mcc a {
      padding-block: 12px;
      line-height: 1.3;
    }
    .mc-menu__all,
    .mc-menu__back {
      padding-block: 6px;
    }
    .mc-menu__back {
      margin-top: 0;
    }
    .mc-menu__heading {
      margin: 8px 0 6px;
    }
    .mc-menu__combinations {
      padding-bottom: 0;
    }
    /* Highlight the whole half-panel: left column reaches the outer left edge,
       right column reaches the outer right edge, with a shared midpoint. */
    .mc-menu__countries {
      margin-inline: -22px;
      column-gap: 0;
    }
    .mc-menu__country {
      padding-inline: 22px 14px;
    }
    .mc-menu__country:nth-child(2n) {
      padding-inline: 15px 22px;
    }
    /* Let every highlighted row cover the entire wider level 2+ panel. */
    .mc-menu[data-mc-selected] .mc-menu__combinations {
      width: 100%;
      max-width: 100%;
    }
  }
  /* Short desktop viewports: keep every country/combination accessible
     without consuming the available height with blank row padding. */
  @media (min-width: 1241px) and (max-height: 760px) {
    .mc-menu__country,
    .mcc a {
      padding-block: 9px;
    }
  }
  @media (max-width: 1240px) {
    .mc-menu {
      --mc-item-size: clamp(1.08rem, 4vw, 1.55rem);
      --mc-item-weight: 400;
      --mc-item-tracking: normal;
    }
    /* Same compact row spacing and type scale as the mobile VIP submenu. */
    .mc-menu__country {
      min-height: 0;
      padding: 13px 0;
      font-size: var(--mc-item-size);
      text-transform: none;
      line-height: 1.15;
    }
    .mcc a {
      padding: 13px 0;
      font-size: var(--mc-item-size);
      text-transform: none;
      line-height: 1.15;
    }
    .mc-menu__heading { margin: 10px 0 6px; }
    .mc-menu__all { padding-block: 6px; }
    .mc-menu__arrow { flex-basis: 16px; font-size: 1.35rem; }
    .mc-menu__expand { flex-basis: 76px; min-width: 76px; }
    .mc-menu__all { font-size: 1.04rem; text-transform: none; }
    .mc-menu__back { font-size: .92rem; }
  }
</style>

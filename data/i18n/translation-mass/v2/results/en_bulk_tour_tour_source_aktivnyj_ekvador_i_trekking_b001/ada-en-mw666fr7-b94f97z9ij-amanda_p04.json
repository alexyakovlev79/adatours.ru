      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw666fr7-b94f97z9ij-amanda",
        "model": "GPT-6.1 Sol",
        "wordAbsenceReason": "The pinned Word introduction at paragraph 12 describes the programme in general terms, but has no equivalent of this ordered route overview."
      },
      "text": "This trip is designed for travellers who want to explore Ecuador on the move. It starts in Quito and the Mindo Cloud Forest before heading into the mountains for Rucu Pichincha, Pasochoa, Rumiñahui, the Illinizas, Quilotoa and Chimborazo. After several days of trekking, the route descends to the Papallacta hot springs, continues with rafting on the Quijos River and finishes in Baños, among waterfalls and green slopes where the Andes meet the Amazon."
    },

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import EditorialProof from '../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
---

<BaseLayout
  title="VIP и Luxury путешествия по Бразилии и Латинской Америке"
  description="Индивидуальные VIP и luxury маршруты по Бразилии и Латинской Америке с персональной сборкой программы."
>
  <Hero
    eyebrow="VIP / Luxury"
    title="Не больше услуг. Больше контроля над поездкой"
    intro="VIP-формат - это персональный маршрут, гибкий график и команда, которая решает детали без участия гостя."
    image="/media/prototype/rio-night.jpg"
    ctaLabel="Собрать VIP-маршрут"
  />

  <EditorialStatement
    eyebrow="Private travel"
    text="Приватность, запас по времени и возможность менять программу без лишних согласований."
  />

  <EditorialProof
    eyebrow="Бразилия"
    title="Рио, Игуасу и побережье без ощущения пакетного тура"
    text="Уровень поездки задают размещение, частные трансферы, сильные гиды, рестораны и свободное время."
    image="/media/prototype/iguazu.jpg"
    facts={[
      'Индивидуальная логистика',
      'Частные гиды и трансферы',
      'Подбор размещения под маршрут',
      'Дополнительные активности под запрос',
    ]}
  />

  <EditorialProof
    eyebrow="Персонализация"
    title="Не перегружать программу только потому, что бюджет это позволяет"
    text="В дорогой поездке свободный день иногда ценнее еще одной экскурсии. Программа должна держать ритм гостя."
    image="/media/prototype/patagonia.jpg"
    reverse
  />

  <ProcessSteps
    eyebrow="Как собирается VIP-маршрут"
    title="Сначала образ поездки, потом список услуг"
    steps={[
      { title: 'Пожелания', text: 'Ритм, интересы, приватность и обязательные условия.' },
      { title: 'Маршрут', text: '2-4 сильные точки вместо попытки увидеть все.' },
      { title: 'Детали', text: 'Размещение, транспорт, гиды, рестораны и активности.' },
      { title: 'Гибкость', text: 'Свободное время и запас для изменений уже заложены в программу.' },
    ]}
    dark
  />

  <LeadForm title="Собрать индивидуальный VIP-маршрут" entityId="vip" />
</BaseLayout>

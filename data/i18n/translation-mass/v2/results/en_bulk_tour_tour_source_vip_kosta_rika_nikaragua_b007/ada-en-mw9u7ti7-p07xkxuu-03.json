      "sourceTextSha256": "a2646f566eaa2c029fa4fa3422e9f92ff4d86f63cac3df0db91a357cf08f4711",
      "text": "Arenal and Caño Negro Wildlife Refuge",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw9u7ti7-p07xkxuu",
        "model": "GPT-6.1 Sol"
      }
    },
    {
      "blockId": "tour:itinerary_text:569e72e117968fcc",
      "field": "itinerary.text",
      "sourceTextSha256": "d5f9bad5f1204cfe7b4d4d568754d9ee08df9b6c8f5a9ed4e7346e8979252831",
      "text": "After breakfast, you set off for Caño Negro Wildlife Refuge. The drive takes about 2 hours.\n\nOn arrival, enjoy a welcome drink before boarding a cruise on the Río Frío, which flows through the refuge.\n\nFrom the water, you may spot cattle egrets, cormorants, howler monkeys, white-faced capuchins, three-toed sloths, caimans, lizards and turtles.\n\nThe boat trip lasts about 3 hours.\n\nAfter the tour, have lunch and return to the hotel.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw9u7ti7-p07xkxuu",
        "model": "GPT-6.1 Sol"
      }

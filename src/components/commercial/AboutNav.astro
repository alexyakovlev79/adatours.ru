---
import { ABOUT_NAV_LINKS } from '../../lib/site';
import { withBase } from '../../lib/paths';

interface Props {
  active: (typeof ABOUT_NAV_LINKS)[number]['id'];
}

const { active } = Astro.props;
const current = ABOUT_NAV_LINKS.find((link) => link.id === active) ?? ABOUT_NAV_LINKS[0];
---

<div class="about-nav-shell" data-pagefind-ignore>
  <nav class="about-nav" aria-label="Раздел о компании">
    {ABOUT_NAV_LINKS.map((link) => (
      <a href={withBase(link.href)} aria-current={active === link.id ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </nav>

  <!-- At narrow widths show the current section instead of a row of clipped tabs.
       Native details works without JavaScript or horizontal scrolling. -->
  <nav class="about-nav-mobile" aria-label="Переходы по разделу о компании">
    <details>
      <summary>
        <span class="about-nav-mobile__current">
          <span class="about-nav-mobile__eyebrow">О компании · Разделы</span>
          <strong>{current.label}</strong>
        </span>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <div class="about-nav-mobile__links">
        {ABOUT_NAV_LINKS.map((link) => (
          <a href={withBase(link.href)} aria-current={active === link.id ? 'page' : undefined}>
            {link.label}
            {active === link.id && <span class="about-nav-mobile__check" aria-hidden="true">✓</span>}
          </a>
        ))}
      </div>
    </details>
  </nav>
</div>

<style>
  .about-nav-shell { background: var(--color-bg); }
  .about-nav {
    display: flex;
    flex-wrap: wrap;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
    padding: 0 clamp(4px, 1vw, 16px);
    justify-content: center;
    gap: 0 clamp(16px, 2.5vw, 40px);
    border-bottom: 1px solid var(--color-line);
  }
  .about-nav a {
    position: relative;
    display: inline-flex;
    min-height: 68px;
    padding: 0 2px;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
    font-family: var(--font-display);
    font-size: .78rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: .06em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 180ms ease;
  }
  .about-nav a:hover,
  .about-nav a:focus-visible,
  .about-nav a[aria-current='page'] { color: var(--color-ink); }
  .about-nav a:focus-visible { outline-offset: -4px; }
  .about-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 3px;
    background: var(--color-brand-deep);
  }
  .about-nav-mobile { display: none; }
  @media (max-width: 1100px) {
    .about-nav-shell { border-bottom: 1px solid var(--color-line); }
    .about-nav { display: none; }
    .about-nav-mobile {
      display: block;
      width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
      margin-inline: auto;
    }
    .about-nav-mobile details { width: 100%; }
    .about-nav-mobile summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      min-height: 74px;
      padding-block: 12px;
      cursor: pointer;
      list-style: none;
    }
    .about-nav-mobile summary::-webkit-details-marker { display: none; }
    .about-nav-mobile__current { display: grid; gap: 5px; min-width: 0; }
    .about-nav-mobile__eyebrow {
      color: var(--color-text-muted);
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .09em;
      text-transform: uppercase;
    }
    .about-nav-mobile strong {
      color: var(--color-ink);
      font-family: var(--font-display);
      font-size: clamp(1.15rem, 2.8vw, 1.45rem);
      font-weight: 500;
      line-height: 1.2;
    }
    .about-nav-mobile svg { flex: 0 0 auto; transition: transform 180ms ease; }
    .about-nav-mobile details[open] summary svg { transform: rotate(180deg); }
    .about-nav-mobile__links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 22px;
      padding: 4px 0 20px;
      border-top: 1px solid var(--color-line);
    }
    .about-nav-mobile__links a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      min-height: 50px;
      padding: 11px 0;
      border-bottom: 1px solid var(--color-line);
      font-family: var(--font-display);
      font-size: clamp(.87rem, 2vw, 1rem);
      line-height: 1.25;
      color: var(--color-ink);
    }
    .about-nav-mobile__links a[aria-current='page'] {
      color: var(--color-brand-deep);
      font-weight: 600;
    }
    .about-nav-mobile__check { font-size: .95rem; }
    .about-nav-mobile summary:focus-visible,
    .about-nav-mobile__links a:focus-visible {
      outline: 2px solid var(--color-brand-deep);
      outline-offset: 3px;
    }
  }
  @media (max-width: 420px) {
    .about-nav-mobile__links { grid-template-columns: 1fr; }
    .about-nav-mobile summary { min-height: 68px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-nav-mobile svg { transition: none; }
  }
</style>

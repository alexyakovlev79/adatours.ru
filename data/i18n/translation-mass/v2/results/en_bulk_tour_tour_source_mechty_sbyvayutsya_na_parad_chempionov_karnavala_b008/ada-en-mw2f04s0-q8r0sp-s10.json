    {
      "blockId": "tour:itinerary_text:b04d5d61d358e759",
      "field": "itinerary.text",
      "sourceTextSha256": "037b986ec5cb54b6ee7a430d297133161689f4b9f9880d4fa94418d90f9962dc",
      "text": "Breakfast, then a tour of the Brazilian side of the falls, in a national park of unique flora and fauna: “big water” in the Guaraní language, some 275 cascades, each with its own name, thunder into the Devil’s Throat gorge, a spectacle you could contemplate for hours. Optional: the Macuco Safari (USD 135 per person), about 3 km through the jungle in an open jeep, then on foot to the river and by motorboat close to the falls; the Bird Park (USD 65 per person); or a helicopter flight over the falls (USD 170 per person).",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1WQ9hmvd6yPaclFGuRY0AOAPFkR26fubw",
        "documentSha256": "5015022105a731c0333d27fdec22c27bb6af589770ebd0859f6a75c989a5b3f4",

      "sourceTextSha256": "3433f4e74b518cf5a5c6a73ae3cdf53e2b3d93aa01d7219d8829a55c8c1f222c",
      "text": "The Best Birding Tour Suriname",
      "provenance": {
        "kind": "word_exact",
        "fileId": "10rEu3o1Ap7c8jmAmzo8yB8XGaEPnvpVq",
        "documentSha256": "dbde3da714ceada5078e1349a1727d90d462f0562177edde7abc9a51363e7f51",

    },
    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "d617c015bf99b827f51f422c9d0aaff90ad7ddf6988b16327851ceec61cc3e5c",
      "text": "From Lima’s colonial squares and the stone terraces of Machu Picchu to Lake Titicaca and the white expanse of Uyuni. This 12-day, 11-night group tour has fixed departure dates in 2027 and a choice of three- or four-star hotels. On the salt flats, you’ll visit Incahuasi Island, have lunch amid the salt desert and enjoy tea at sunset.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6m9wxh-cczxw4dr6hs0t03up1hi6je",
        "model": "GPT-6.1-sol"
      }
    },
    {

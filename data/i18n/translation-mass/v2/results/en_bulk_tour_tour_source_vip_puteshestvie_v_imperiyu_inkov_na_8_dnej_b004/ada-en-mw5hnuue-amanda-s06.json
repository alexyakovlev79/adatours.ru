    {
      "blockId": "tour:contentBlock_text:71fbc10cec6918db",
      "field": "contentBlock.text",
      "sourceTextSha256": "db061f820077c54ab06416feb15c23a9cb905cf458b80f61cb0f71768cc0f1b9",
      "text": "Breakfast at the hotel. \n\nDiscover the original city of Lima on this private tour. You will be picked  up from your hotel, then go to Miraflores which is the biggest tourist district where we can walk around the Love´s park and you can enjoy a beautiful view of the Pacific Ocean. Then, we will go to the HuacaPucllana, an archaeological precinct build in the IV century A.C., where we will have a panoramic view of this. After that, we will have a stop in San Isidro to visit the Olive Grove Park. Later, we will go to the historical center where we shall visit one of its most beautiful buildings and attractions like, San Martin Square, the Main Square, the Government Palace, the Archbishop's Palace, the Cathedral, the City Hall, the train station Desamparado and the first bar of Lima (Cordano Bar). ",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1ZKk6YevQ1wiUzBQfDwExNWW9qX9QhIWw",
        "documentSha256": "1a8efa56c9e3f829b6247a56c90c86639469c8cc8b3af76ade3b6a727aab9ee9",

    },
    {
      "blockId": "tour:itinerary_text:b04d5d61d358e759",
      "field": "itinerary.text",
      "sourceTextSha256": "24fe78b18fb556c4cc25b141848a2e6d07b3e676d3e3b3c7ceff79e58b025eb3",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261110-mwa5muwazo597oeipo",
        "model": "GPT-6.1"
      },
      "text": "After breakfast, take a boat trip along the Río Frío in Caño Negro Wildlife Refuge.\n\nThe trip starts in Los Chiles, a small town about 4 km from the Nicaraguan border.\n\nThe Río Frío is part of the Caño Negro wetland system, a Ramsar site.\n\nThe refuge is known for its wide variety of birds and other wildlife.\n\nOn the boat trip, you may see herons and cormorants, as well as spider monkeys, white-faced capuchins, sloths and other animals.\n\nReptiles found here include caimans, lizards and turtles.\n\nReturn to the Arenal area after lunch.\n\nBreakfast and lunch are included."
    },

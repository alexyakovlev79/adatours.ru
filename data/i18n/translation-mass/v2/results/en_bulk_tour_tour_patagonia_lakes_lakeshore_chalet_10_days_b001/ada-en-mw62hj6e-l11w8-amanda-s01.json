    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "7039e932e4baea78c6eb7e09eebb32786c35db6962b3102e0dc21e784f4be32f",
      "text": "Spend ten days in the lake district of Argentine Patagonia at Lakeshore Chalet on Lake Nahuel Huapi. The trip includes five full days of fly fishing on the Limay River and a day aboard a private boat. Meals, wine, transfers, fishing guides, gear and licences are included. The price is USD 39,780 for a group of up to six guests.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw62hj6e-l11w8-amanda",
        "model": "ChatGPT",
        "wordAbsenceReason": "The Word opening overview omits the Limay River, transfers, gear, licences and group price. They appear separately in the itinerary, inclusions and price line. There is no complete Word counterpart for the current RU lead."
      }
    },
    {
      "blockId": "tour:priceNote:9b6b7f5cf7b1e557",
      "field": "priceNote",
      "sourceTextSha256": "01e4214c1b7cb0a3bc69e40b651ac8fa2448ceab6ad1d3cafc4f1cca76088146",
      "text": "USD 39,780 for the entire group of up to six guests. The number of nights charged will be confirmed at booking.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw62hj6e-l11w8-amanda",
        "model": "ChatGPT",
        "wordAbsenceReason": "The Word group price matches, but the duration line says nine nights and the included accommodation says ten. Word has no booking-confirmation wording for the number of nights charged. The current RU note resolves the wording without changing the tariff."
      }
    },

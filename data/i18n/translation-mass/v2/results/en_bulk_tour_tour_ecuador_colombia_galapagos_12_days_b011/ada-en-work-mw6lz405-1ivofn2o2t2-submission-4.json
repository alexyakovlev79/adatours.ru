      "sourceTextSha256": "015a4525b4f28353756e100d43f1349b97bf84f10374bca23479b0b3d3f963e7",
      "text": "Breakfast at the hotel. An 8-hour excursion with an English-speaking guide.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-work-mw6lz405-1ivofn2o2t2",
        "model": "GPT-6.1"

  "sourceFingerprint": "96c648f99ceee6da8a10e2f481ba719641b6d5acad530d9aa082dd90ececf28b",
  "blocks": [
    {
      "blockId": "tour:note:526adaf7e55c9d0b",
      "field": "note",
      "sourceTextSha256": "d8dc4a0f4fe77f23a29977b0f9d1b72bddd58ba4037c9341256584cb377228b2",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-worker-mw6mah5i-b5sxublmwl",
        "model": "GPT-6.1"
      },
      "text": "The rates apply to the 2027 programme and may change without notice before booking."
    },
    {
      "blockId": "tour:note:8f123630be33d2d2",
      "field": "note",
      "sourceTextSha256": "d737815a6c6ce2e70973e01ea2880bead3ffa859aea0ac51f7fe6ab9a35990dd",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-worker-mw6mah5i-b5sxublmwl",
        "model": "GPT-6.1"
      },
      "text": "The itinerary is subject to change based on national park decisions and circumstances beyond the dive centre's control. All dive sites listed are possible options."
    },
    {
      "blockId": "tour:note:1df7a2ce26d895dc",
      "field": "note",
      "sourceTextSha256": "24a3f575435bf5ebcd6dba3a3169bd96dbcf19288e113f8a0c1151b8bfb2d9e2",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-worker-mw6mah5i-b5sxublmwl",
        "model": "GPT-6.1"
      },
      "text": "The minimum age is 12. To dive, you need a PADI, NAUI, CMAS or equivalent certification and a completed application form."
    },
    {
      "blockId": "tour:note:76d5957bea09c1b4",
      "field": "note",
      "sourceTextSha256": "85fd9fd34967053bfb903f5d646e90dcb25570be846e33772ea978a8852b307f",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-worker-mw6mah5i-b5sxublmwl",
        "model": "GPT-6.1"
      },
      "text": "A medical certificate is required if you have a listed medical condition and/or if you are over 60 and have not dived in the last 8 months."
    },
    {
      "blockId": "tour:note:074289981b2776ae",
      "field": "note",
      "sourceTextSha256": "65487446d3263fad10f81e60644bba77ffc019f355e1b5d0cd211c3b9047da87",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-worker-mw6mah5i-b5sxublmwl",
        "model": "GPT-6.1"
      },
      "text": "Tell the dive centre if you experienced dehydration in the days before the dive or have a history of decompression sickness."
    },
    {
      "blockId": "tour:note:9f7d758d2e6906c8",
      "field": "note",
      "sourceTextSha256": "5a8019d6c52eb68c6c0c843a8f09472015a1d81e7770bc8fc7c57d8278072987",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-worker-mw6mah5i-b5sxublmwl",
        "model": "GPT-6.1"
      },
      "text": "The dive centre will confirm the minimum experience required for Gordon Rocks and the guide's assessment. The conditions are worded differently in different sections of the programme."
    },
    {
      "blockId": "tour:note:3e13158f1643fd7a",
      "field": "note",
      "sourceTextSha256": "7c0a6301c00821fcdfb992639516c3cd613a43def59bd58859a1febe7c760390",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-worker-mw6mah5i-b5sxublmwl",
        "model": "GPT-6.1"
      },
      "text": "Discover Scuba Diving and PADI courses are available to participants without certification. Check the programme and conditions separately."
    },
    {
      "blockId": "tour:note:f1f6c4dfcf6975c5",
      "field": "note",
      "sourceTextSha256": "64cffc66f1046c036393e82e0ea6e026c33cb42e0a452c296c1bcffeb40a1d42",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-worker-mw6mah5i-b5sxublmwl",
        "model": "GPT-6.1"
      },
      "text": "Accompanying guests and uncertified snorkellers may join if they pay the full price of the diving day."
    }
  ]
}

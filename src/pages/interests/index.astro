---
import { isActiveEntity } from '../../lib/archive.mjs';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { themePath } from '../../lib/routes';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import DestinationBand from '../../components/editorial/DestinationBand.astro';

const themes = (await getCollection('themes', ({ data }) =>
  data.locale === 'ru' && isActiveEntity(data)
)).sort((a, b) => (a.data.slug > b.data.slug ? 1 : -1));

const spaIndex = themes.findIndex((theme) => theme.data.slug === 'spa');
const weddingsIndex = themes.findIndex((theme) => theme.data.slug === 'svadby-i-romantika');

if (spaIndex !== -1 && weddingsIndex !== -1) {
  [themes[spaIndex], themes[weddingsIndex]] = [themes[weddingsIndex], themes[spaIndex]];
}

const adventuresIndex = themes.findIndex((theme) => theme.data.slug === 'priklyucheniya');
const fishingIndex = themes.findIndex((theme) => theme.data.slug === 'rybalka');

if (adventuresIndex !== -1 && fishingIndex !== -1) {
  [themes[adventuresIndex], themes[fishingIndex]] = [themes[fishingIndex], themes[adventuresIndex]];
}
---

<BaseLayout
  title="Туры по интересам в Бразилию и Латинскую Америку"
  description="Рыбалка, мото-туры, гастрономия и вино, семейные поездки, пляжи, приключения, дайвинг, SPA, свадьбы и романтические путешествия."
>
  <Hero
    eyebrow="По интересам"
    title="Начните с того, ради чего едете"
    intro="Рыбалка, вино, пляжи, дайвинг, семейная поездка или путешествие вдвоем. Мы подберем географию и программу под ваш интерес."
    image="/media/pages/po-interesam/hero-enhanced-20261001.webp"
  />

  <EditorialStatement
    eyebrow="9 направлений"
    text="Одна тема может задать всю поездку или стать ее лучшей частью."
  />

  {themes.map((theme, index) => (
    <DestinationBand
      eyebrow="По интересам"
      title={theme.data.name}
      text={theme.data.summary}
      image={theme.data.hero?.src}
      imageTextAlign={theme.data.imageTextAlign}
      href={themePath(theme.data)}
      align={index % 3 === 1 ? 'right' : 'left'}
    />
  ))}
</BaseLayout>

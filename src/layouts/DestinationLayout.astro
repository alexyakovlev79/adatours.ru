---
import { isActiveEntity } from '../lib/archive.mjs';
import { seoDestinationTitle, seoRelatedToursDescription } from '../lib/seo-page.mjs';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import EntityLinks from '../components/editorial/EntityLinks.astro';
import Hero from '../components/editorial/Hero.astro';
import InlineMarkdown from '../components/global/InlineMarkdown.astro';
import EditorialStatement from '../components/editorial/EditorialStatement.astro';
import StoryPair from '../components/editorial/StoryPair.astro';
import TripStats from '../components/tour/TripStats.astro';
import DestinationBand from '../components/editorial/DestinationBand.astro';
import CatalogMoreLink from '../components/editorial/CatalogMoreLink.astro';
import MediaGallery from '../components/editorial/MediaGallery.astro';
import SearchIndexRecord from '../components/global/SearchIndexRecord.astro';
import { withBase } from '../lib/paths';
import {
  countryPath, destinationBreadcrumbs as buildDestinationBreadcrumbs, destinationPath, destinationRoute,
  excursionDestinationPath, excursionPath, optionalTourDestinationPath, tourDestinationPath, tourPath,
} from '../lib/routes';
import { excursionHasDestination } from '../lib/destination-links.mjs';
import { buildExcursionTourCounts, compareExcursionsByPopularity } from '../lib/excursion-popularity';
import { buildDestinationTourCounts, compareDestinationsByPopularity } from '../lib/destination-popularity';
import { compareToursForCountry } from '../lib/tour-ranking';
import { tourHasMainDestination, tourHasOptionalDestination } from '../lib/tour-relations';

const { entry } = Astro.props;
const d = entry.data;
// Keep the complete sorted collections for relations and counts; cap only the previews.
const previewLimits = { tours: 10, optionalTours: 5, excursions: 5 } as const;
const [allTourEntries, countryEntries, excursionEntries, destinationEntries] = await Promise.all([
  getCollection('tours', ({ data }) =>
    data.locale === 'ru' &&
    isActiveEntity(data)
  ),
  getCollection('countries', ({ data }) => data.locale === 'ru' && isActiveEntity(data)),
  getCollection('excursions', ({ data }) =>
    data.locale === 'ru' &&
    isActiveEntity(data) &&
    excursionHasDestination(data, d.id)
  ),
  getCollection('destinations', ({ data }) =>
    data.locale === 'ru' &&
    isActiveEntity(data)
  ),
]);

const allRelatedTourEntries = allTourEntries.filter((item) =>
  item.data.destinations.includes(d.id)
);
const mainTourEntries = allRelatedTourEntries.filter((item) =>
  tourHasMainDestination(item.data, d.id)
);
const optionalTourEntries = allRelatedTourEntries.filter((item) =>
  tourHasOptionalDestination(item.data, d.id)
);
const excursionTourCounts = buildExcursionTourCounts(allTourEntries);
const destinationTourCounts = buildDestinationTourCounts(allTourEntries);
const relatedTours = mainTourEntries.sort(compareToursForCountry(d.countryId));
const optionalTours = optionalTourEntries.sort(compareToursForCountry(d.countryId));
const relatedExcursions = excursionEntries
  .sort(compareExcursionsByPopularity(excursionTourCounts));
const destinationTourOverlap = new Map<string, number>();

for (const tour of allRelatedTourEntries) {
  const uniqueDestinationIds = new Set(
    tour.data.destinations.filter((destinationId) => destinationId !== d.id)
  );

  for (const destinationId of uniqueDestinationIds) {
    destinationTourOverlap.set(
      destinationId,
      (destinationTourOverlap.get(destinationId) ?? 0) + 1
    );
  }
}

const relatedDestinations = destinationEntries
  .filter((item) => item.data.id !== d.id && destinationTourOverlap.has(item.data.id))
  .sort((a, b) =>
    (destinationTourOverlap.get(b.data.id) ?? 0) - (destinationTourOverlap.get(a.data.id) ?? 0) ||
    a.data.name.localeCompare(b.data.name, 'ru')
  )
  .slice(0, 10);
const featureBandImages = new Set(d.featureBands.map((band) => band.image));
const visibleGallery = d.gallery.filter(
  (item) => item.src !== d.hero?.src && !featureBandImages.has(item.src)
);
const countryById = new Map(countryEntries.map((item) => [item.data.id, item]));
const country = countryById.get(d.countryId);
const countryName = country?.data.name ?? '';

const pageUrl = new URL(withBase(destinationPath(d)), Astro.site ?? 'https://adatours.ru/').toString();
const countryUrl = country
  ? new URL(withBase(countryPath(country.data)), Astro.site ?? 'https://adatours.ru/').toString()
  : undefined;

const destinationBreadcrumbs = buildDestinationBreadcrumbs(d);

const destinationSchema = {
  '@type': 'TouristDestination',
  '@id': `${pageUrl}#destination`,
  name: d.name,
  description: d.summary,
  url: pageUrl,
  ...(d.hero?.src ? { image: d.hero.src } : {}),
  ...(country && countryUrl ? {
    containedInPlace: {
      '@type': 'Country',
      '@id': `${countryUrl}#country`,
      name: country.data.name,
      url: countryUrl,
    },
  } : {}),
};

// Match the tour description: keep its opening heading, then show the lead in prose.
const descriptionHtml = await Astro.slots.render('default');
const firstHeadingMatch = descriptionHtml.match(/^(\s*(?:<!--[\s\S]*?-->\s*)*<h2\b[^>]*>[\s\S]*?<\/h2>)/i);
const firstHeadingHtml = firstHeadingMatch?.[1] ?? '';
const remainingDescriptionHtml = firstHeadingHtml ? descriptionHtml.slice(firstHeadingHtml.length) : descriptionHtml;
---

<BaseLayout leadTitle={`Собрать поездку: ${d.name}`} leadEntityId={d.id}
  title={seoDestinationTitle(d.name,d.countryId,relatedExcursions.length,allRelatedTourEntries.length)}
  description={seoRelatedToursDescription(d.summary,allRelatedTourEntries.length,'destination')}
  image={d.hero?.src}
  canonical={destinationPath(d)}
  pageSchema={destinationSchema}
  breadcrumbs={destinationBreadcrumbs}
>
  <SearchIndexRecord
    title={d.name}
    summary={d.summary}
    entityType="destination"
    typeLabel="Место"
    subtitle={countryName}
    aliases={d.searchAliases}
    geography={[d.name, countryName].filter(Boolean)}
    themes={d.themes}
    image={d.hero?.src}
    tourCount={destinationTourCounts.get(d.id) ?? 0}
  />

  <Hero
    contentSized
    compactCta
    eyebrow="Направление"
    title={d.name}
    image={d.hero?.src}
    imageTextAlign={d.imageTextAlign}
    mediaStatus={d.hero?.status}
    replacementReason={d.hero?.replacementReason}
    ctaLabel="Хочу сюда"
  />

  {d.facts.length > 0 && <TripStats stats={d.facts} />}

  <EntityLinks
    entity={d}
    groups={country ? [{ label: 'Страна', entries: [{ name: countryName, href: countryPath(country.data) }] }] : []}
  />

  <section class="destination-copy section--tight">
    <div class="container prose">
      {firstHeadingHtml && <Fragment set:html={firstHeadingHtml} />}
      {d.summary?.trim() && <p class="destination-lead"><InlineMarkdown text={d.summary} /></p>}
      {remainingDescriptionHtml && <Fragment set:html={remainingDescriptionHtml} />}
    </div>
  </section>

  {d.featureBands.map((band, index) => (
    <StoryPair
      eyebrow={band.eyebrow}
      title={band.title}
      text={band.text}
      image={band.image}
      mediaStatus={band.imageStatus}
      replacementReason={band.imageReplacementReason}
      imageTextAlign={d.imageTextAlign}
      reverse={index % 2 === 1}
    />
  ))}

  {visibleGallery.length > 0 && (
    <MediaGallery
      items={visibleGallery}
      imageTextAlign={d.imageTextAlign}
      eyebrow="Фотографии"
      title={`${d.name} в фотографиях`}
      layout="orientation"
    />
  )}

  {relatedTours.length > 0 && (
    <>
      <EditorialStatement eyebrow="Маршруты" text={`Туры через ${d.name}`} />
      {relatedTours.slice(0, previewLimits.tours).map((tour, index) => (
        <DestinationBand
          eyebrow={[tour.data.durationDays ? `${tour.data.durationDays} дней` : '', tour.data.format ?? ''].filter(Boolean).join(' · ')}
          title={tour.data.title}
          image={tour.data.hero?.src}
          imageTextAlign={tour.data.imageTextAlign}
          mediaStatus={tour.data.hero?.status}
          replacementReason={tour.data.hero?.replacementReason}
          href={tourPath(tour.data)}
          align={index % 2 === 1 ? 'right' : 'left'}
        />
      ))}
      {relatedTours.length > previewLimits.tours && (
        <CatalogMoreLink href={tourDestinationPath(d)} label={`${d.name}: все туры`} />
      )}
    </>
  )}

  {optionalTours.length > 0 && (
    <>
      <EditorialStatement eyebrow="Можно добавить" text={`К этим турам можно добавить экскурсию в ${d.name}`} />
      {optionalTours.slice(0, previewLimits.optionalTours).map((tour, index) => (
        <DestinationBand
          eyebrow={[tour.data.durationDays ? `${tour.data.durationDays} дней` : '', tour.data.format ?? ''].filter(Boolean).join(' · ')}
          title={tour.data.title}
          image={tour.data.hero?.src}
          imageTextAlign={tour.data.imageTextAlign}
          mediaStatus={tour.data.hero?.status}
          replacementReason={tour.data.hero?.replacementReason}
          href={tourPath(tour.data)}
          align={index % 2 === 1 ? 'right' : 'left'}
        />
      ))}
      {optionalTours.length > previewLimits.optionalTours && (
        <CatalogMoreLink
          href={optionalTourDestinationPath(d)}
          label="Все туры с возможностью посетить это место"
        />
      )}
    </>
  )}

  {relatedExcursions.length > 0 && (
    <>
      <EditorialStatement eyebrow="Экскурсии" text={`Экскурсии: ${d.name}`} />
      {relatedExcursions.slice(0, previewLimits.excursions).map((excursion, index) => (
        <DestinationBand
          eyebrow={[excursion.data.duration ?? '', excursion.data.format ?? ''].filter(Boolean).join(' · ')}
          title={excursion.data.title}
          text={excursion.data.lead}
          image={excursion.data.hero?.src}
          imageTextAlign={excursion.data.imageTextAlign}
          mediaStatus={excursion.data.hero?.status}
          replacementReason={excursion.data.hero?.replacementReason}
          href={excursionPath(excursion.data)}
          align={index % 2 === 1 ? 'right' : 'left'}
        />
      ))}
      {relatedExcursions.length > previewLimits.excursions && (
        <CatalogMoreLink
          href={excursionDestinationPath(destinationRoute(d.id))}
          label={`${d.name}: все экскурсии`}
        />
      )}
    </>
  )}

  {relatedDestinations.length > 0 && (
    <>
      <EditorialStatement eyebrow="Продолжить маршрут" text="Куда поехать дальше" />
      {relatedDestinations.map((item, index) => {
        const relatedCountry = countryById.get(item.data.countryId);
        const relatedCountryName = relatedCountry?.data.name ?? '';
        const relatedHref = relatedCountry
          ? destinationPath(item.data)
          : '/places/';

        return (
          <DestinationBand
            eyebrow={relatedCountryName}
            title={item.data.name}
            text={item.data.summary}
            image={item.data.hero?.src}
            imageTextAlign={item.data.imageTextAlign}
            mediaStatus={item.data.hero?.status}
            replacementReason={item.data.hero?.replacementReason}
            href={relatedHref}
            align={index % 2 === 1 ? 'right' : 'left'}
          />
        );
      })}
    </>
  )}

</BaseLayout>

<style>
  .destination-copy {
    padding-block: 16px clamp(28px, 3vw, 40px);
  }
  .destination-copy :global(.prose) { display: flow-root; }
  .destination-copy :global(.prose > :first-child) { margin-top: 0; }
  .destination-copy :global(.prose > :last-child) { margin-bottom: 0; }
  .destination-copy :global(.prose) .destination-lead {
    font-weight: 600;
    color: var(--color-ink);
  }
</style>





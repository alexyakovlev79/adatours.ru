        "runId": "ada-en-f8804ba1-147d-4106-9470-50bbc2568386",
        "model": "ChatGPT"
      },
      "text": "Talampaya National Park"
    },
    {
      "blockId": "tour:media_alt:2d54ce8ae38028ee",

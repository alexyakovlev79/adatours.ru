---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/editorial/Hero.astro';
import StoryPair from '../components/editorial/StoryPair.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import SearchIndexRecord from '../components/global/SearchIndexRecord.astro';
import DestinationBand from '../components/editorial/DestinationBand.astro';
import { withBase } from '../lib/paths';
import {
  countryBreadcrumbs, countryPath, destinationCountryPath, destinationPath,
  excursionCountryPath, excursionGeography, excursionPath, themePath, tourCountryPath, tourPath,
} from '../lib/routes';
import { buildExcursionTourCounts, compareExcursionsByPopularity } from '../lib/excursion-popularity';
import { buildDestinationTourCounts, compareDestinationsByPopularity } from '../lib/destination-popularity';
import { tourHasMainCountry } from '../lib/tour-relations';

const { entry } = Astro.props;
// Country page: linked destination/tour catalogue for internal linking and discovery.
const d = entry.data;

// Limit only the rendered previews. Full collections remain available to counts,
// editorial image settings and the separate, unabridged country catalogues.
const previewLimits = { destinations: 15, tours: 10, excursions: 5 } as const;

const countryTourTarget = ({
  country_brazil: 'Бразилию',
  country_argentina: 'Аргентину',
  country_peru: 'Перу',
  country_antarctica: 'Антарктиду',
  country_bolivia: 'Боливию',
  country_venezuela: 'Венесуэлу',
  country_guatemala: 'Гватемалу',
  country_guyana: 'Гайану',
  country_dominican_republic: 'Доминикану',
  country_costa_rica: 'Коста-Рику',
  country_cuba: 'Кубу',
  country_mexico: 'Мексику',
  country_nicaragua: 'Никарагуа',
  country_panama: 'Панаму',
  country_paraguay: 'Парагвай',
  country_suriname: 'Суринам',
  country_uruguay: 'Уругвай',
  country_french_guiana: 'Французскую Гвиану',
  country_chile: 'Чили',
  country_el_salvador: 'Эль-Сальвадор',
} as Record<string, string>)[d.id] ?? d.name;

const countryTourPreposition = d.id === 'country_french_guiana' ? 'во' : 'в';

const [destinationEntries, allTourEntries, excursionEntries, themeEntries] = await Promise.all([
  getCollection('destinations', ({ data }) =>
    data.locale === 'ru' &&
    !['draft', 'archived'].includes(data.status) &&
    data.countryId === d.id
  ),
  getCollection('tours', ({ data }) =>
    data.locale === 'ru' &&
    !['draft', 'archived'].includes(data.status)
  ),
  getCollection('excursions', ({ data }) =>
    data.locale === 'ru' &&
    !['draft', 'archived'].includes(data.status) &&
    excursionGeography(data).country.id === d.id
  ),
  getCollection('themes', ({ data }) =>
    data.locale === 'ru' &&
    !['draft', 'archived'].includes(data.status) &&
    d.relatedThemes.includes(data.id)
  ),
]);

const tourEntries = allTourEntries.filter((item) => tourHasMainCountry(item.data, d.id));
const excursionTourCounts = buildExcursionTourCounts(allTourEntries);
const destinationTourCounts = buildDestinationTourCounts(allTourEntries);

destinationEntries.sort(compareDestinationsByPopularity(destinationTourCounts));

tourEntries.sort((a, b) =>
  (b.data.priority ?? 0) - (a.data.priority ?? 0) ||
  a.data.title.localeCompare(b.data.title, 'ru')
);

excursionEntries.sort(compareExcursionsByPopularity(excursionTourCounts));

const preferredThemes = new Map(
  d.relatedThemes.map((id, index) => [id, index])
);

themeEntries.sort((a, b) =>
  (preferredThemes.get(a.data.id) ?? 999) - (preferredThemes.get(b.data.id) ?? 999)
);

const destinationTypeLabel = {
  city: 'Город',
  region: 'Регион',
  island: 'Остров',
  national_park: 'Национальный парк',
  resort: 'Курорт',
  natural_area: 'Природная территория',
  route_cluster: 'Маршрут',
};

// A linked place banner represents that place; other editorial bands belong
// to this country. An unset property keeps the banner's original alternation.
const featureBandImageTextAlign = (href: string) => {
  const destination = destinationEntries.find((item) =>
    href === destinationPath(item.data)
  );
  return destination ? destination.data.imageTextAlign : d.imageTextAlign;
};
---

<BaseLayout
  title={`${d.name}: туры и путешествия`}
  description={d.summary}
  image={d.hero?.src}
  canonical={countryPath(d)}
  breadcrumbs={countryBreadcrumbs(d)}
>
  <SearchIndexRecord
    title={d.name}
    summary={d.summary}
    entityType="country"
    typeLabel="Страна"
    subtitle=""
    aliases={d.searchAliases}
    geography={[d.name, ...d.regions]}
    themes={d.relatedThemes}
    image={d.hero?.src}
    tourCount={tourEntries.length}
  />

  <Hero
    eyebrow="Страна"
    title={d.name}
    intro={d.summary}
    image={d.hero?.src}
    imageTextAlign={d.imageTextAlign}
    mediaStatus={d.hero?.status}
    replacementReason={d.hero?.replacementReason}
    ctaLabel="Подобрать маршрут"
  />

  <section class="country-copy section--tight">
    <div class="container prose country-copy__prose">
      <slot />
    </div>
  </section>

  {d.featureBands.map((band, index) =>
    band.href ? (
      <DestinationBand
        eyebrow={band.eyebrow}
        title={band.title}
        text={band.text}
        image={band.image}
        mediaStatus={band.imageStatus}
        replacementReason={band.imageReplacementReason}
        href={band.href}
        imageTextAlign={featureBandImageTextAlign(band.href)}
        align={index % 2 === 1 ? 'right' : 'left'}
      />
    ) : (
      <StoryPair
        eyebrow={band.eyebrow}
        title={band.title}
        text={band.text}
        image={band.image}
        mediaStatus={band.imageStatus}
        replacementReason={band.imageReplacementReason}
        imagePosition={band.imagePosition}
        imagePositionMobile={band.imagePositionMobile}
        reverse={index % 2 === 1}
      />
    )
  )}

  {destinationEntries.length > 0 && (
    <section class="country-linked country-linked--destinations section" aria-label={`Направления: ${d.name}`}>
      <div class="container">
        <div class="country-linked__grid">
          {destinationEntries.slice(0, previewLimits.destinations).map((item, index) => {
            const image = item.data.hero?.src ? withBase(item.data.hero.src) : undefined;
            const href = withBase(destinationPath(item.data));
            return (
              <a
                class:list={['destination-card', { 'destination-card--wide': index % 5 === 0 }]}
                data-image-text-align={item.data.imageTextAlign}
                href={href}
              >
                <span
                  class="destination-card__media"
                  style={image ? `--entity-image: url("${image}")` : undefined}
                  aria-hidden="true"
                ></span>
                <span class="destination-card__shade" aria-hidden="true"></span>
                <span class="destination-card__meta">
                  {destinationTypeLabel[item.data.destinationType]}
                </span>
                <strong class="destination-card__title">{item.data.name}</strong>
                <span class="destination-card__description">{item.data.summary}</span>
                <span class="destination-card__link">Смотреть <span aria-hidden="true">↗</span></span>
              </a>
            );
          })}
        </div>
        {destinationEntries.length > previewLimits.destinations && (
          <div class="country-linked__more">
            <a class="country-catalog-link" href={withBase(destinationCountryPath(d))}>
              <span>{d.name}: все красоты</span>
              <span class="country-catalog-link__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  {tourEntries.length > 0 && (
    <section class="country-tours" aria-labelledby="country-tours-title">
      <div class="country-tours__heading section">
        <div class="container">
          <div class="country-linked__heading country-linked__heading--tours">
            <p class="eyebrow">Туры</p>
            <h2 id="country-tours-title">Туры {countryTourPreposition} {countryTourTarget}</h2>
            <p>Готовый маршрут можно взять за основу и адаптировать под ваши даты, темп и интересы.</p>
          </div>
        </div>
      </div>

      <div class="country-tours__bands">
        {tourEntries.slice(0, previewLimits.tours).map((item, index) => (
          <DestinationBand
            eyebrow={[
              item.data.durationDays ? `${item.data.durationDays} дней` : '',
              item.data.format ?? '',
            ].filter(Boolean).join(' · ')}
            title={item.data.title}
            text={item.data.lead}
            image={item.data.hero?.src}
            imageTextAlign={item.data.imageTextAlign}
            mediaStatus={item.data.hero?.status}
            replacementReason={item.data.hero?.replacementReason}
            href={tourPath(item.data)}
            align={index % 2 === 1 ? 'right' : 'left'}
            descriptionBelow={true}
          />
        ))}
      </div>
      {tourEntries.length > previewLimits.tours && (
        <div class="container country-tours__more">
          <a class="country-catalog-link" href={withBase(tourCountryPath(d))}>
            <span>{d.name}: все туры</span>
            <span class="country-catalog-link__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      )}
    </section>
  )}

  {excursionEntries.length > 0 && (
    <section class="country-linked section" aria-labelledby="country-excursions-title">
      <div class="container">
        <div class="country-linked__heading">
          <p class="eyebrow">Экскурсии</p>
          <h2 id="country-excursions-title">{d.name}: экскурсии</h2>
        </div>

        <div class="country-linked__grid">
          {excursionEntries.slice(0, previewLimits.excursions).map((item, index) => {
            const image = item.data.hero?.src ? withBase(item.data.hero.src) : undefined;
            const meta = [item.data.duration ?? '', item.data.format ?? ''].filter(Boolean).join(' · ');
            return (
              <a
                class:list={['entity-poster', { 'entity-poster--wide': index % 5 === 0 }]}
                data-image-text-align={item.data.imageTextAlign}
                href={withBase(excursionPath(item.data))}
                style={image ? `--entity-image: url("${image}")` : undefined}
              >
                <span class="entity-poster__shade" aria-hidden="true"></span>
                <span class="entity-poster__content">
                  {meta && <span class="entity-poster__meta">{meta}</span>}
                  <strong>{item.data.title}</strong>
                  <span class="entity-poster__link">Смотреть <span aria-hidden="true">↗</span></span>
                </span>
              </a>
            );
          })}
        </div>
        {excursionEntries.length > previewLimits.excursions && (
          <div class="country-linked__more">
            <a class="country-catalog-link" href={withBase(excursionCountryPath(d))}>
              <span>{d.name}: все экскурсии</span>
              <span class="country-catalog-link__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  {themeEntries.length > 0 && (
    <section class="country-themes" aria-labelledby="country-themes-title">
      <div class="country-themes__heading section">
        <div class="container">
          <div class="country-linked__heading country-linked__heading--themes">
            <p class="eyebrow">Форматы поездки</p>
            <h2 id="country-themes-title">Путешествия по интересам</h2>
            <p>Выберите тему поездки и посмотрите связанные с ней направления и программы.</p>
          </div>
        </div>
      </div>

      <div class="country-themes__bands">
        {themeEntries.map((item, index) => (
          <DestinationBand
            eyebrow="По интересам"
            title={item.data.name}
            text={item.data.summary}
            image={item.data.hero?.src}
            imageTextAlign={item.data.imageTextAlign}
            mediaStatus={item.data.hero?.status}
            replacementReason={item.data.hero?.replacementReason}
            href={themePath(item.data)}
            align={index % 2 === 1 ? 'right' : 'left'}
          />
        ))}
      </div>
    </section>
  )}

  <LeadForm title={`Собрать путешествие по стране: ${d.name}`} entityId={d.id} />
</BaseLayout>

<style>
  .country-copy {
    padding-block: clamp(58px, 5.5vw, 82px);
    background: var(--color-bg);
  }

  .country-copy__prose {
    max-width: 900px;
  }

  .country-copy__prose :global(p) {
    margin-block: 0 1.25em;
    color: color-mix(in srgb, var(--color-ink) 82%, transparent);
    font-size: clamp(1.18rem, 1.45vw, 1.48rem);
    line-height: 1.55;
  }

  .country-copy__prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .country-linked {
    background: var(--color-bg);
  }

  .country-linked--destinations {
    padding-top: 0;
  }

  .country-tours {
    background: #f5f0e8;
  }

  .country-tours__heading {
    padding-block: clamp(68px, 7vw, 108px);
    background: #f5f0e8;
  }

  .country-tours__bands {
    display: block;
  }

  .country-linked__more,
  .country-tours__more {
    display: flex;
    justify-content: flex-end;
    padding-top: clamp(28px, 4vw, 52px);
  }

  .country-tours__more {
    padding-bottom: clamp(40px, 5vw, 72px);
  }

  .country-catalog-link {
    display: inline-flex;
    align-items: center;
    gap: clamp(20px, 3vw, 40px);
    max-width: 100%;
    min-height: 48px;
    padding-block: 10px;
    border-bottom: 1px solid var(--color-gold-deep, #c89a20);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.8vw, 1.65rem);
    line-height: 1.25;
    text-decoration: none;
    transition: border-color 180ms ease;
  }

  .country-catalog-link > span:first-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .country-catalog-link__arrow {
    flex-shrink: 0;
    font-size: 1.3em;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .country-catalog-link:hover {
    border-color: var(--color-ink);
  }

  .country-catalog-link:hover .country-catalog-link__arrow {
    transform: translate(2px, -2px);
  }

  .country-catalog-link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 7px;
  }

  .country-themes {
    background: var(--color-bg);
  }

  .country-themes__heading {
    padding-block: clamp(68px, 7vw, 108px);
    background: var(--color-bg);
  }

  .country-themes__bands {
    display: block;
  }

  .country-linked__heading {
    display: grid;
    grid-template-columns: minmax(150px, .34fr) minmax(0, 1fr);
    column-gap: clamp(30px, 6vw, 92px);
    row-gap: 18px;
    align-items: start;
    margin-bottom: clamp(48px, 7vw, 92px);
  }

  .country-linked__heading .eyebrow {
    margin: 8px 0 0;
  }

  .country-linked__heading h2 {
    max-width: 900px;
    margin: 0;
  }

  .country-linked__heading > p:last-child {
    grid-column: 2;
    max-width: 700px;
    margin: 0;
    color: color-mix(in srgb, var(--color-ink) 68%, transparent);
    font-size: var(--text-lg);
  }

  .country-linked__heading--tours {
    margin-bottom: 0;
  }

  .country-linked__heading--tours > p:last-child {
    max-width: 650px;
  }

  .country-linked__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 2.3vw, 34px);
  }

  .destination-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto auto auto auto;
    min-height: clamp(400px, 38vw, 560px);
    overflow: hidden;
    color: #fff;
    isolation: isolate;
  }

  .destination-card--wide {
    grid-column: 1 / -1;
    min-height: clamp(480px, 52vw, 660px);
  }

  .destination-card__media,
  .destination-card__shade {
    grid-column: 1;
    grid-row: 1 / -1;
  }

  .destination-card__media {
    z-index: -2;
    background:
      var(--entity-image, linear-gradient(145deg, #5a5b54, #191a17)),
      linear-gradient(145deg, #5a5b54, #191a17);
    background-position: center;
    background-size: cover;
  }

  .destination-card__shade {
    z-index: -1;
    background: linear-gradient(180deg, rgba(8, 9, 8, .06) 18%, rgba(8, 9, 8, .78) 100%);
    transition: background 250ms ease;
  }

  .destination-card__meta,
  .destination-card__title,
  .destination-card__description,
  .destination-card__link {
    grid-column: 1;
    z-index: 1;
    margin-inline: clamp(30px, 4vw, 56px);
  }

  .destination-card__meta {
    grid-row: 2;
    margin-bottom: 10px;
    font-family: var(--font-display);
    font-size: .76rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .destination-card__title {
    grid-row: 3;
    max-width: 960px;
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 2.65vw, 3rem);
    font-weight: 400;
    line-height: 1.04;
  }

  .destination-card--wide .destination-card__title {
    font-size: clamp(2rem, 3.4vw, 4rem);
  }

  .destination-card__description {
    grid-row: 4;
    max-width: 700px;
    margin-bottom: 22px;
    color: rgba(255,255,255,.84);
    font-size: clamp(.98rem, 1.2vw, 1.12rem);
    line-height: 1.5;
  }

  .destination-card__link {
    grid-row: 5;
    justify-self: start;
    display: inline-flex;
    gap: 24px;
    align-items: center;
    margin-bottom: clamp(30px, 4vw, 56px);
    padding-bottom: 7px;
    border-bottom: 1px solid currentColor;
    font-family: var(--font-display);
    font-size: .76rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .entity-poster {
    --entity-image: linear-gradient(145deg, #5a5b54, #191a17);
    position: relative;
    display: grid;
    min-height: clamp(400px, 38vw, 560px);
    overflow: hidden;
    color: #fff;
    background:
      var(--entity-image),
      linear-gradient(145deg, #5a5b54, #191a17);
    background-position: center;
    background-size: cover;
    isolation: isolate;
  }

  .entity-poster--wide {
    grid-column: 1 / -1;
    min-height: clamp(480px, 52vw, 660px);
  }

  .entity-poster__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(8, 9, 8, .06) 18%, rgba(8, 9, 8, .78) 100%);
    transition: background 250ms ease;
  }

  .entity-poster__content {
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: clamp(30px, 4vw, 56px);
  }

  .entity-poster__meta,
  .entity-poster__link {
    font-family: var(--font-display);
    font-size: .76rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .entity-poster strong {
    max-width: 960px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 4rem);
    font-weight: 400;
    line-height: 1.04;
  }

  .entity-poster:not(.entity-poster--wide) strong {
    font-size: clamp(1.8rem, 2.65vw, 3rem);
  }

  .entity-poster__text {
    max-width: 700px;
    color: rgba(255,255,255,.84);
    font-size: clamp(.98rem, 1.2vw, 1.12rem);
    line-height: 1.5;
  }

  .entity-poster__link {
    display: inline-flex;
    gap: 24px;
    align-items: center;
    margin-top: 8px;
    padding-bottom: 7px;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 820px) {
    :global(.story__media) {
      width: 100vw;
      max-width: none;
      margin-left: calc(-1 * var(--gutter));
    }

    .country-copy {
      padding-block: 42px;
    }

    .country-catalog-link {
      width: 100%;
      justify-content: space-between;
    }

    .country-tours__heading,
    .country-themes__heading {
      padding-block: 50px;
    }

    .country-linked__heading--tours {
      gap: 10px;
    }

    .country-linked__heading--tours h2 {
      font-size: clamp(2.45rem, 12vw, 3.5rem);
      line-height: 1.02;
    }

    .country-linked__heading--tours > p:last-child {
      font-size: 1rem;
      line-height: 1.5;
    }

    .destination-card,
    .destination-card--wide {
      grid-column: 1;
      grid-template-rows: 320px auto;
      min-height: 0;
      overflow: visible;
      color: var(--color-ink);
    }

    .destination-card__media,
    .destination-card__shade {
      grid-column: 1;
      grid-row: 1;
    }

    .destination-card__media {
      z-index: 0;
    }

    .destination-card__shade {
      z-index: 1;
      background: linear-gradient(180deg, rgba(8, 9, 8, .04) 20%, rgba(8, 9, 8, .72) 100%);
    }

    .destination-card__meta {
      display: none;
    }

    .destination-card__title,
    .destination-card__link {
      grid-column: 1;
      grid-row: 1;
      z-index: 2;
      color: #fff;
      margin-inline: 24px;
    }

    .destination-card__title,
    .destination-card--wide .destination-card__title {
      align-self: end;
      margin-bottom: 74px;
      font-size: clamp(2rem, 9vw, 3rem);
    }

    .destination-card__link {
      align-self: end;
      justify-self: start;
      margin-bottom: 24px;
    }

    .destination-card__description {
      grid-column: 1;
      grid-row: 2;
      z-index: 0;
      max-width: none;
      margin: 0;
      padding: 18px var(--gutter) 6px;
      color: color-mix(in srgb, var(--color-ink) 76%, transparent);
      font-size: 1rem;
      line-height: 1.5;
      background: var(--color-bg);
    }

    .country-linked__heading {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .country-linked__heading > p:last-child {
      grid-column: 1;
    }

    .country-linked__grid {
      grid-template-columns: 1fr;
      width: calc(100% + (var(--gutter) * 2));
      margin-inline: calc(-1 * var(--gutter));
    }

    .entity-poster,
    .entity-poster--wide {
      grid-column: 1;
      min-height: 430px;
    }


      "sourceTextSha256": "1cd630bc4d820daf353935f25e5b288d9266fb6d7ff39cb07b3546917b2f4d95",
      "text": "Peru and Bolivia with the Uyuni Salt Flats: 12 days in the Andes",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6m9wxh-cczxw4dr6hs0t03up1hi6je",
        "model": "GPT-6.1-sol"

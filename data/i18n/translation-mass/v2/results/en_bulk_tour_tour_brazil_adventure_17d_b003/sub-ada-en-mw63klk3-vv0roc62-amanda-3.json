    {
      "blockId": "tour:note:d2671de82ca0dc90",
      "field": "note",
      "sourceTextSha256": "b726f5d67da2f3e1a69f9d6b933775133dcc865413b20bdf2ac8754022e3eb6a",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw63klk3-vv0roc62-amanda",
        "model": "GPT-6.1",
        "wordAbsenceReason": "The Word accommodation line allows similar hotels, but the document has no corresponding note covering both replacement by category and excursion order."
      },
      "text": "If necessary, Ada Tours may replace a hotel with another of the same category. The order of excursions may change while the tour programme stays the same."
    },
    {
      "blockId": "tour:note:6f8a7a9da006f0cf",
      "field": "note",
      "sourceTextSha256": "723a9a817a894faf33f03c321428ccd53106bea033b9d3f40e5dd552e2c275d9",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw63klk3-vv0roc62-amanda",
        "model": "GPT-6.1",
        "wordAbsenceReason": "The Word programme contains no missed-breakfast policy tied to early checkout for flights or excursions."
      },
      "text": "If an early flight or excursion requires you to check out before breakfast, Ada Tours is not responsible for the missed breakfast."
    },
    {
      "blockId": "tour:highlight_title:997e839e6a21ae92",
      "field": "highlight.title",
      "sourceTextSha256": "b4f32fc1cecf1c6bd813da09b0d77594a22315551879b17a8f1ba966dca7f5d2",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw63klk3-vv0roc62-amanda",
        "model": "GPT-6.1",
        "wordAbsenceReason": "The Word excursion programme has no standalone headline pairing the Corcovado and Sugarloaf viewpoints."
      },
      "text": "Rio from two viewpoints"
    },
    {
      "blockId": "tour:highlight_text:62849fe7b205a15f",
      "field": "highlight.text",
      "sourceTextSha256": "a906e671bf0acb8da989f90f5c9976acd4f4dd862c56d38e3201d023c980b0bd",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw63klk3-vv0roc62-amanda",
        "model": "GPT-6.1",
        "wordAbsenceReason": "Word describes the excursions individually and has no standalone comparison of the two views matching this highlight."
      },
      "text": "From Corcovado you can take in Rio as a whole. You can pick out the ocean, bays, beaches, the bridge to Niterói, Maracanã Stadium and the granite peaks. Sugarloaf gives you a different perspective. The sea feels closer, islands and boats stand out in the bay, and you can trace almost the entire shoreline. Together, the two viewpoints help you see how the city fits together."
    }

    {
      "blockId": "tour:itinerary_text:569e72e117968fcc",
      "field": "itinerary.text",
      "sourceTextSha256": "b171dcfb84a1f06eed7b64117dbe75c845547febe4cdbfb13b57b25ef4f3cc2d",
      "text": "Day 2 · Breakfast at the hotel. City tour of Santiago’s most interesting sights, beginning with the historic downtown: the Main Square, the Cathedral, the Central Post Office and City Hall. In the Plaza de Armas, see the monument to the city’s founder, Pedro de Valdivia, the monument to American Liberty and the monument to Chile’s first cardinal, José María Caro. Continue to La Moneda, the seat of government, and Santa Lucía Hill, the remnant of a 15-million-year-old volcano, then East Santiago, with its modern offices, apartments, shopping centres and restaurants.\n\nOptional: tour and wine tasting at the wineries of the Maipo Valley (USD 260 per person, minimum 2 people).",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1VVb19fhYM4uGHIUqj8Vb14ySVdLL-qs9",
        "documentSha256": "9fdbbd3080671e41cc722fff470a09cba94d9e99405241b2901cd1f0c38e2079",

---
import { isActiveEntity, isArchivedEntity } from '../lib/archive.mjs';
import { seoExcursionTitle, seoRelatedToursDescription } from '../lib/seo-page.mjs';
import ArchiveNotice from '../components/global/ArchiveNotice.astro';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import EntityLinks from '../components/editorial/EntityLinks.astro';
import SearchIndexRecord from '../components/global/SearchIndexRecord.astro';
import Hero from '../components/editorial/Hero.astro';
import InlineMarkdown from '../components/global/InlineMarkdown.astro';
import TripStats from '../components/tour/TripStats.astro';
import MediaGallery from '../components/editorial/MediaGallery.astro';
import GeoRouteMap from '../components/maps/GeoRouteMap.astro';
import TourPricing from '../components/tour/TourPricing.astro';
import IncludedExcluded from '../components/tour/IncludedExcluded.astro';
import EditorialStatement from '../components/editorial/EditorialStatement.astro';
import DestinationBand from '../components/editorial/DestinationBand.astro';
import CatalogMoreLink from '../components/editorial/CatalogMoreLink.astro';
import { withBase } from '../lib/paths';
import { destinationCatalogById } from '../lib/content-validation';
import { countryPath, destinationPath, excursionBreadcrumbs as buildExcursionBreadcrumbs, excursionGeography, excursionPath, tourExcursionPath, tourPath } from '../lib/routes';
import { excursionDestinationIds } from '../lib/destination-links.mjs';
import { buildExcursionTourCounts, compareExcursionsByPopularity, excursionIdsForTour } from '../lib/excursion-popularity';
import { buildDestinationTourCounts, compareDestinationsByPopularity } from '../lib/destination-popularity';
import { compareToursForCountry } from '../lib/tour-ranking';

const { entry } = Astro.props;
const d = entry.data;
// One shared map component for every active excursion with verified GEO places.
const geoMapData = await (await import('../lib/geo-map-astro')).buildPageGeoMap('excursion', d);
const archived = isArchivedEntity(d);
const linkedDestinationIds = excursionDestinationIds(d);
const relatedTourLimit = 10;

const [countryEntries, destinationEntries, tourEntries, excursionEntries] = await Promise.all([
  getCollection('countries', ({ data }) => data.locale === 'ru' && isActiveEntity(data)),
  getCollection('destinations', ({ data }) => data.locale === 'ru' && isActiveEntity(data) && linkedDestinationIds.includes(data.id)),
  getCollection('tours', ({ data }) =>
    data.locale === 'ru' &&
    isActiveEntity(data)
  ),
  getCollection('excursions', ({ data }) =>
    data.locale === 'ru' &&
    isActiveEntity(data)
  ),
]);

const geography = excursionGeography(d);
const country = countryEntries.find((item) => item.data.id === geography.country.id);
const destinationById = new Map(destinationEntries.map((item) => [item.data.id, item]));
const destination = d.destination ? destinationById.get(d.destination) : undefined;
const destinationTourCounts = buildDestinationTourCounts(tourEntries);
const visibleDestinations = linkedDestinationIds
  .map((id) => destinationById.get(id))
  .filter((item) => item !== undefined)
  .sort(compareDestinationsByPopularity(destinationTourCounts));

const excursionTourCounts = buildExcursionTourCounts(tourEntries);
const relatedExcursionTourOverlap = new Map<string, number>();
const relatedTours = tourEntries.filter((tour) => excursionIdsForTour(tour).has(d.id))
  .sort(compareToursForCountry(geography.country.id));

for (const tour of relatedTours) {
  const tourExcursionIds = excursionIdsForTour(tour);

  tourExcursionIds.delete(d.id);

  for (const excursionId of tourExcursionIds) {
    relatedExcursionTourOverlap.set(
      excursionId,
      (relatedExcursionTourOverlap.get(excursionId) ?? 0) + 1
    );
  }
}

const relatedExcursions = excursionEntries
  .filter((item) => item.data.id !== d.id && relatedExcursionTourOverlap.has(item.data.id))
  .sort((a, b) =>
    (relatedExcursionTourOverlap.get(b.data.id) ?? 0) - (relatedExcursionTourOverlap.get(a.data.id) ?? 0) ||
    a.data.title.localeCompare(b.data.title, 'ru')
  )
  .slice(0, 10);

const destinationName =
  destination?.data.name ??
  (d.destination ? destinationCatalogById.get(d.destination)?.name : undefined) ??
  d.destinationName;

const excursionBreadcrumbs = buildExcursionBreadcrumbs(d);

const roundedPrice = typeof d.priceFrom === 'number' ? Math.round(d.priceFrom) : null;
const currencyPrefix = d.currency === 'USD' ? String.fromCharCode(36) : '';
const money = roundedPrice && d.currency
  ? 'от ' + currencyPrefix + roundedPrice.toLocaleString('ru-RU', { maximumFractionDigits: 0 })
  : 'По запросу';

const stats = [
  d.duration ? { value: d.duration, label: 'продолжительность' } : null,
  destinationName ? { value: destinationName, label: 'место' } : null,
  !archived && country ? { value: country.data.name, label: 'страна', href: countryPath(country.data) } : null,
  d.format ? { value: d.format, label: 'формат' } : null,
].filter(Boolean);

const pageUrl = new URL(withBase(excursionPath(d)), Astro.site ?? 'https://adatours.ru/').toString();
const excursionSchema = {
  '@type': 'TouristTrip',
  '@id': `${pageUrl}#excursion`,
  name: d.title,
  description: d.lead,
  url: pageUrl,
  ...(d.hero?.src ? { image: d.hero.src } : {}),
  ...(d.route.length > 0 ? {
    itinerary: {
      '@type': 'ItemList',
      itemListElement: d.route.map((name, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: { '@type': 'Place', name },
      })),
    },
  } : {}),
  ...(roundedPrice && d.currency ? {
    offers: {
      '@type': 'Offer',
      price: roundedPrice,
      priceCurrency: d.currency,
      url: pageUrl,
    },
  } : {}),
};

// Match the tour description: keep its opening heading, then show the lead in prose.
const descriptionHtml = await Astro.slots.render('default');
const firstHeadingMatch = descriptionHtml.match(/^(\s*(?:<!--[\s\S]*?-->\s*)*<h2\b[^>]*>[\s\S]*?<\/h2>)/i);
const firstHeadingHtml = firstHeadingMatch?.[1] ?? '';
const remainingDescriptionHtml = firstHeadingHtml ? descriptionHtml.slice(firstHeadingHtml.length) : descriptionHtml;
---

<BaseLayout leadTitle={archived ? "Подобрать другую поездку" : `Заказать экскурсию: ${d.title}`} leadEntityId={archived ? "" : d.id}
  headerTheme={archived ? 'dark' : 'light'}
  noindex={archived}
  title={seoExcursionTitle(d,geography.country.id,d.destination,destinationName,archived ? undefined : relatedTours.length)}
  description={archived ? d.lead : seoRelatedToursDescription(d.lead,relatedTours.length,'excursion')}
  image={d.hero?.src}
  canonical={excursionPath(d)}
  pageSchema={archived ? undefined : excursionSchema}
  breadcrumbs={excursionBreadcrumbs}
>
  {!archived && <SearchIndexRecord
    title={d.title}
    summary={d.lead}
    entityType="excursion"
    typeLabel="Экскурсия"
    subtitle={[d.duration, destinationName, country?.data.name].filter(Boolean).join(' · ')}
    aliases={d.searchAliases}
    geography={[destinationName, country?.data.name, ...d.route].filter(Boolean)}
    themes={d.themes}
    image={d.hero?.src}
    tourCount={excursionTourCounts.get(d.id) ?? 0}
  />}
  {archived && <ArchiveNotice id={d.id} kind="excursion" />}

  <Hero
    contentSized
    compactCta
    eyebrow={archived ? "Архивная экскурсия" : "Экскурсия"}
    title={d.title}
    image={d.hero?.src} video={d.heroVideo}
    imageTextAlign={d.imageTextAlign}
    mediaStatus={d.hero?.status}
    replacementReason={d.hero?.replacementReason}
    meta={[d.duration ?? '', d.route.join(' · ')].filter(Boolean).join(' · ')}
    ctaLabel={archived ? "Все экскурсии" : "Хочу сюда"}
    ctaHref={archived ? "/excursions/" : "/contacts/"}
  />

  {stats.length > 0 && <TripStats stats={stats} variant="excursion" />}

  <EntityLinks entity={d} groups={archived ? [] : [
    { label: 'Места экскурсии', entries: visibleDestinations.map((place) => ({
      name: place.data.name, href: destinationPath(place.data),
    })) },
  ]} />

  {(d.lead?.trim() || descriptionHtml.trim()) && (
    <section class="excursion-copy section--tight">
      <div class="container prose" data-excursion-description>
        {firstHeadingHtml && <Fragment set:html={firstHeadingHtml} />}
        <div class="excursion-copy__text" id={'excursion-description-' + d.id} data-excursion-description-text>
          {d.lead?.trim() && <p class="excursion-lead"><InlineMarkdown text={d.lead} /></p>}
          {remainingDescriptionHtml && <Fragment set:html={remainingDescriptionHtml} />}
        </div>
        <button class="excursion-copy__toggle" type="button" aria-expanded="false"
          aria-controls={'excursion-description-' + d.id} data-excursion-description-toggle hidden>
          <span data-excursion-description-label>Подробнее об экскурсии</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </section>
  )}

  {visibleDestinations.map((place) => (
    <DestinationBand
      eyebrow="Место"
      title={place.data.name}
      text={place.data.summary}
      image={place.data.hero?.src}
      imageTextAlign={place.data.imageTextAlign}
      mediaStatus={place.data.hero?.status}
      replacementReason={place.data.hero?.replacementReason}
      href={destinationPath(place.data)}
      descriptionBelow={true}
    />
  ))}

  {geoMapData && <GeoRouteMap data={geoMapData} title="Экскурсия на карте" locale="ru" entityType="excursion" />}

  {d.gallery.length > 0 && (
    <MediaGallery
      items={d.gallery}
      imageTextAlign={d.imageTextAlign}
      eyebrow="Фотографии"
      title="Экскурсия в кадрах"
      layout="orientation"
    />
  )}

  {!archived && <TourPricing price={money} ctaLabel="Заказать экскурсию" />}

  {(d.included.length > 0 || d.notIncluded.length > 0 || d.notes.length > 0) && (
    <IncludedExcluded included={d.included} notIncluded={d.notIncluded} notes={d.notes} />
  )}

  {!archived && relatedTours.length > 0 && (
    <>
      <EditorialStatement eyebrow="Туры" text="Туры с этой экскурсией" />
      {relatedTours.slice(0, relatedTourLimit).map((tour, index) => (
        <DestinationBand
          eyebrow={[tour.data.durationDays ? `${tour.data.durationDays} дней` : '', tour.data.format ?? ''].filter(Boolean).join(' · ')}
          title={tour.data.title}
          image={tour.data.hero?.src}
          imageTextAlign={tour.data.imageTextAlign}
          mediaStatus={tour.data.hero?.status}
          replacementReason={tour.data.hero?.replacementReason}
          href={tourPath(tour.data)}
          align={index % 2 === 1 ? 'right' : 'left'}
        />
      ))}
      {relatedTours.length > relatedTourLimit && (
        <CatalogMoreLink href={tourExcursionPath(d)} label="Все туры с этой экскурсией" />
      )}
    </>
  )}

  {relatedExcursions.length > 0 && (
    <>
      <EditorialStatement eyebrow="Рядом" text="Другие экскурсии, которые можно добавить к поездке" />
      {relatedExcursions.map((item, index) => (
        <DestinationBand
          eyebrow={[item.data.duration ?? '', item.data.format ?? ''].filter(Boolean).join(' · ')}
          title={item.data.title}
          text={item.data.lead}
          image={item.data.hero?.src}
          imageTextAlign={item.data.imageTextAlign}
          mediaStatus={item.data.hero?.status}
          replacementReason={item.data.hero?.replacementReason}
          href={excursionPath(item.data)}
          align={index % 2 === 1 ? 'right' : 'left'}
        />
      ))}
    </>
  )}

</BaseLayout>

<script>
  const initExcursionDescriptions = () => {
    document.querySelectorAll<HTMLElement>('[data-excursion-description]').forEach((section) => {
      if (section.dataset.descriptionReady) return;
      const text = section.querySelector<HTMLElement>('[data-excursion-description-text]');
      const toggle = section.querySelector<HTMLButtonElement>('[data-excursion-description-toggle]');
      const label = section.querySelector<HTMLElement>('[data-excursion-description-label]');
      if (!text || !toggle || !label) return;
      section.dataset.descriptionReady = 'true';
      let expanded = false;

      const update = () => {
        const firstParagraph = text.querySelector<HTMLElement>('p');
        const lead = text.querySelector<HTMLElement>('.excursion-lead');
        const lineHeight = parseFloat(getComputedStyle(firstParagraph ?? text).lineHeight) || 30;
        // Match Tour/Destination: show the complete lead or seven lines, whichever is longer.
        const leadHeight = lead
          ? lead.getBoundingClientRect().bottom - text.getBoundingClientRect().top
          : 0;
        const previewHeight = Math.ceil(Math.max(leadHeight, lineHeight * 7));
        const long = text.scrollHeight > previewHeight + lineHeight;
        text.style.setProperty('--excursion-copy-preview-height', previewHeight + 'px');
        text.style.setProperty('--excursion-copy-fade-height', lineHeight * 2 + 'px');
        text.classList.toggle('is-collapsed', long && !expanded);
        toggle.hidden = !long;
        toggle.setAttribute('aria-expanded', String(!long || expanded));
        label.textContent = expanded ? 'Свернуть' : 'Подробнее об экскурсии';
      };

      toggle.addEventListener('click', () => {
        expanded = !expanded;
        update();
        if (!expanded && text.getBoundingClientRect().top < 0) {
          window.scrollTo({
            top: Math.max(0, window.scrollY + text.getBoundingClientRect().top - 120),
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        }
      });

      // Make links or controls in the clipped text visible before keyboard navigation.
      text.addEventListener('focusin', () => {
        if (!expanded && !toggle.hidden) {
          expanded = true;
          update();
        }
      });

      update();
      if ('ResizeObserver' in window) new ResizeObserver(update).observe(text);
      else window.addEventListener('resize', update);
      document.fonts.ready.then(update);
    });
  };

  initExcursionDescriptions();
  document.addEventListener('astro:page-load', initExcursionDescriptions);
</script>

<style>
  .excursion-copy {
    background: var(--color-bg);
    padding-block: clamp(18px, 2vw, 28px) clamp(28px, 3vw, 44px);
  }

  .excursion-copy :global(.prose) {
    max-width: 900px;
    display: flow-root;
  }

  .excursion-copy :global(.prose > :first-child) {
    margin-top: 0;
  }

  .excursion-copy :global(.prose > :last-child) {
    margin-bottom: 0;
  }

  .excursion-copy :global(.prose p) {
    margin-block: 0 1.3em;
    color: color-mix(in srgb, var(--color-ink) 82%, transparent);
    font-size: clamp(1.12rem, 1.4vw, 1.42rem);
    line-height: 1.58;
  }

  .excursion-copy :global(.prose p:last-child) {
    margin-bottom: 0;
  }
  .excursion-copy :global(.prose) .excursion-lead {
    font-weight: 600;
    color: var(--color-ink);
  }
  .excursion-copy__text { display: flow-root; }
  .excursion-copy__text.is-collapsed {
    max-height: var(--excursion-copy-preview-height);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - var(--excursion-copy-fade-height)), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - var(--excursion-copy-fade-height)), transparent);
  }
  .excursion-copy__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: fit-content;
    max-width: 100%;
    min-height: 44px;
    margin: 12px auto 0;
    padding: 8px 16px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-champagne) 12%, var(--color-bg));
    color: var(--color-ink);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
    cursor: pointer;
    transition: background-color .15s ease, border-color .15s ease;
  }
  .excursion-copy__toggle[hidden] { display: none; }
  .excursion-copy__toggle:hover, .excursion-copy__toggle:focus-visible {
    border-color: var(--color-gold-deep);
    background: color-mix(in srgb, var(--color-champagne) 35%, var(--color-bg));
  }
  .excursion-copy__toggle svg { flex: none; transition: transform .2s ease; }
  .excursion-copy__toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  @media print {
    .excursion-copy__text.is-collapsed {
      max-height: none;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .excursion-copy__toggle { display: none; }
  }
</style>


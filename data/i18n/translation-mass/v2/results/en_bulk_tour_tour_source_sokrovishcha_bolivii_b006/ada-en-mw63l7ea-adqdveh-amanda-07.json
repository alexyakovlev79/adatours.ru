      "blockId": "tour:itinerary_text:b04d5d61d358e759",
      "field": "itinerary.text",
      "sourceTextSha256": "7d2b0660eab1b7aaa097ffbe2f8d9571d2d65db0a7c5e265d1730b8991ed2c15",
      "provenance": {

    {
      "blockId": "tour:lead:e3456bc1f4d270f4",
      "field": "lead",
      "sourceTextSha256": "b131dac04e6aa67b29acb5364f18a8ba83baf6c5c2c58b0ebb62d53f75abdfe7",
      "text": "Santiago dazzles with the glass-and-steel skyline of a modern metropolis, framed by the endless sweep of the Andes. From there, the journey leads into the Atacama, the driest non-polar desert on Earth, then south into Chilean Patagonia, where the San Rafael Glacier calves icebergs into turquoise waters and the Marble Caves reveal swirling chambers of blue-and-white stone sculpted by Lago General Carrera. It culminates at Torres del Paine, where glaciers, rivers, lakes and forests unfold beneath the three granite towers that give the park its name.",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1JhUcfwm8nluzG9BG57eKadVF8jagmfmU",
        "documentSha256": "7a87775c7dacf8099a1e26805ff24af33c179cd8f269efc62f31b996d820adb0",

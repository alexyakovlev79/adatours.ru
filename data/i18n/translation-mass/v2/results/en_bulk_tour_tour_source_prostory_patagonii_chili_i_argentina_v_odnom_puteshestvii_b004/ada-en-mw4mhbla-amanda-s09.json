    {
      "blockId": "tour:itinerary_text:569e72e117968fcc",
      "field": "itinerary.text",
      "sourceTextSha256": "6bd77119aebe3d04c4f8d8e9c8889af6b85d3ab81a1382641afa80b20d6c4ce8",
      "text": "Half-day city tour of Buenos Aires, which will show you why it is called the “Paris of South America”. Begin along Avenida 9 de Julio, one of the widest avenues in the world, with the Obelisk, symbol of the city, and stop at Plaza de Mayo to visit the Casa Rosada, the presidential palace, and the Metropolitan Cathedral, with its neoclassical façade and the mausoleum of the national hero, General San Martín. The tour also takes in Plaza San Martín, the Alvear area and Plaza del Congreso, Avenida Corrientes and Avenida de Mayo, and the neighbourhoods of La Boca, San Telmo, Palermo, Recoleta and modern Puerto Madero.",
      "provenance": {
        "kind": "word_aligned",
        "fileId": "1QGXADnMW2i8PU8akKxx6rgJZyJ8p9hDG",
        "documentSha256": "982fc7a252d62bc0da9b970c3ca9bd619624bd35da98a0ffd9e8aa793919b3e4",

    {
      "blockId": "tour:itinerary_text:ec46e3209ab74818",
      "field": "itinerary.text",
      "sourceTextSha256": "485641ec085dafb208192b392be0f99475ad852ed2bda278ea6b16d603317271",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-f7d28995258f43d8b02d73d0103556dd",
        "model": "GPT-6.1"
      },
      "text": "After breakfast, you’ll visit Mistico Park.\n\nThis nature park near Arenal Volcano has trails and bridges that lead through primary tropical forest.\n\nThe route is about 2 miles long.\n\nThe walk takes around 2.5 hours and suits people with different levels of fitness.\n\nAlong the way, you may see birds, flowers and dense tropical vegetation.\n\nThe route crosses 15 bridges, including 6 suspension bridges.\n\nSeveral points offer views of Arenal Volcano and the forest canopy.\n\nBreakfast is included."
    },

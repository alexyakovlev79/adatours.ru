      "sourceTextSha256": "7c83625f84f2f0f469053f90d03c6014cc2c0158cbec44b8cf5af136ff6109cc",
      "text": "Arenal — Tortuguero",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-483534e9353b46a8be6f54221df32d47",
        "model": "GPT-6.1 Sol"

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/editorial/Hero.astro';
import EditorialStatement from '../../../components/editorial/EditorialStatement.astro';
import FactStrip from '../../../components/proof/FactStrip.astro';
import EditorialProof from '../../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../../components/proof/ProcessSteps.astro';
import DmcNav from '../../../components/commercial/DmcNav.astro';
import { ORG } from '../../../data/organization/ada-tours';
---

<BaseLayout
  leadTitle="Отправить B2B-запрос"
  leadEntityId="dmc_terms"
  title="Условия работы с DMC Ada Tours для турагентств и туроператоров"
  description="Договор, вознаграждение, состав предложения и порядок подтверждения B2B-запросов Ada Tours по Бразилии и Латинской Америке."
  image="/media/home/buenos-aires-enhanced-20260930.webp"
>
  <Hero
    eyebrow="DMC · Условия работы"
    title="B2B-условия под конкретную поездку"
    intro="Сначала фиксируем маршрут и состав услуг. Затем согласуем коммерческие условия и подтверждаем их для конкретного бронирования."
    image="/media/home/buenos-aires-enhanced-20260930.webp"
    ctaHref="#request"
    ctaLabel="Отправить B2B-запрос"
  />

  <DmcNav active="terms" />

  <EditorialStatement
    eyebrow="Принцип"
    text="Партнер получает конкретное предложение по датам, программе и составу услуг, а договорные условия закрепляются для этой поездки."
  />

  <FactStrip
    facts={[
      { value: 'Договор', label: 'для работы с туроператорами' },
      { value: '%', label: 'вознаграждение обычно согласуется как процент' },
      { value: 'По поездке', label: 'коммерческие условия фиксируются под бронирование' },
      { value: 'Партнерство', label: 'возможны повторные договоры' },
    ]}
  />

  <EditorialProof
    eyebrow="Предложение"
    title="Что фиксируем до подтверждения"
    text="Первое предложение собирается по датам и брифу. В нем видны маршрут, состав услуг, стоимость и позиции, которые еще требуют подтверждения."
    image="/media/home/patagonia-enhanced-20260930.webp"
    facts={[
      'Даты и география поездки',
      'Состав включенных услуг',
      'Стоимость под выбранные даты',
      'Позиции, которые требуют подтверждения',
    ]}
  />

  <EditorialProof
    eyebrow="Договор и вознаграждение"
    title="Коммерческая модель согласуется с партнером"
    text={ORG.b2b.commissionModel}
    image="/media/home/lencois-enhanced-20260930.webp"
    facts={[
      'Финальные коммерческие условия фиксируются по конкретному бронированию',
      'Состав и стоимость услуг подтверждаются под даты',
      'Условия оплаты закрепляются для конкретной поездки',
      'С постоянными партнерами возможны повторные договоры',
    ]}
    reverse
  />

  <ProcessSteps
    eyebrow="От запроса до подтверждения"
    title="4 этапа B2B-работы"
    steps={[
      {
        title: 'Бриф',
        text: 'Даты, количество гостей, география, бюджет, уровень размещения и обязательные элементы.',
      },
      {
        title: 'Предложение',
        text: 'Ada Tours собирает маршрут, наземную логистику, состав услуг и расчет.',
      },
      {
        title: 'Согласование',
        text: 'После правок фиксируем рабочую версию программы и проверяем доступность выбранных услуг.',
      },
      {
        title: 'Подтверждение',
        text: 'Закрепляем финальные условия и состав конкретного бронирования.',
      },
    ]}
    dark
  />
</BaseLayout>

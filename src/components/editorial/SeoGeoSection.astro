---
interface SeoGeoArticle {
  targetPath: string;
  buttonLabel: string;
  lead: string;
  headingHtml: string;
  bodyHtml: string;
}
interface Props { article: SeoGeoArticle; }

const { article } = Astro.props;
const controlId = 'seo-geo-content-' + article.targetPath.split('/').filter(Boolean).join('-');
---

<section class="seo-geo section--tight" data-seo-geo data-seo-geo-target={article.targetPath} aria-label={article.buttonLabel}>
  <div class="container prose seo-geo__container">
    <Fragment set:html={article.headingHtml} />
    <div class="seo-geo__content" id={controlId} data-seo-geo-content>
      <p class="seo-geo__lead">{article.lead}</p>
      <Fragment set:html={article.bodyHtml} />
    </div>
    <button class="seo-geo__toggle" type="button" aria-controls={controlId} aria-expanded="false"
      data-seo-geo-toggle hidden>
      <span data-seo-geo-label>{article.buttonLabel}</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</section>

<script>
  function initSeoGeoSections() {
    document.querySelectorAll<HTMLElement>('[data-seo-geo]').forEach((root) => {
      if (root.dataset.seoReady === 'true') return;
      const content = root.querySelector<HTMLElement>('[data-seo-geo-content]');
      const button = root.querySelector<HTMLButtonElement>('[data-seo-geo-toggle]');
      const label = root.querySelector<HTMLElement>('[data-seo-geo-label]');
      const lead = root.querySelector<HTMLElement>('.seo-geo__lead');
      if (!content || !button || !label) return;
      root.dataset.seoReady = 'true';
      const originalLabel = label.textContent ?? '';
      let expanded = false;

      const refresh = () => {
        const lineHeight = parseFloat(getComputedStyle(lead ?? content).lineHeight) || 28;
        const leadHeight = lead ? lead.getBoundingClientRect().bottom - content.getBoundingClientRect().top : 0;
        const previewHeight = Math.ceil(Math.max(leadHeight, 7 * lineHeight));
        const long = content.scrollHeight > previewHeight + lineHeight;
        content.style.setProperty('--seo-geo-preview-height', previewHeight + 'px');
        content.style.setProperty('--seo-geo-fade-height', 2 * lineHeight + 'px');
        content.classList.toggle('is-collapsed', long && !expanded);
        button.hidden = !long;
        button.setAttribute('aria-expanded', String(!long || expanded));
        label.textContent = expanded ? 'Свернуть' : originalLabel;
      };

      button.addEventListener('click', () => {
        expanded = !expanded;
        refresh();
        if (!expanded && content.getBoundingClientRect().top < 0) {
          window.scrollTo({
            top: Math.max(0, window.scrollY + content.getBoundingClientRect().top - 110),
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        }
      });
      // A keyboard user must never tab into clipped, invisible article links.
      content.addEventListener('focusin', () => {
        if (!expanded && !button.hidden) {
          expanded = true;
          refresh();
        }
      });
      refresh();
      if ('ResizeObserver' in window) new ResizeObserver(refresh).observe(root);
      else window.addEventListener('resize', refresh);
      document.fonts.ready.then(refresh);
    });
  }

  initSeoGeoSections();
  document.addEventListener('astro:page-load', initSeoGeoSections);
</script>

<style>
  .seo-geo {
    padding-block: var(--section-y-tight);
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
  }
  .seo-geo__container { max-width: 940px; }
  .seo-geo__container :global(h2) {
    margin: 0 0 clamp(24px, 3vw, 40px);
    max-width: 900px;
    overflow-wrap: anywhere;
  }
  .seo-geo__content { display: flow-root; }
  .seo-geo__content.is-collapsed {
    max-height: var(--seo-geo-preview-height);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - var(--seo-geo-fade-height)), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - var(--seo-geo-fade-height)), transparent);
  }
  .seo-geo__lead {
    font-weight: 600;
    line-height: 1.65;
    margin: 0 0 20px;
  }
  .seo-geo__content :global(p),
  .seo-geo__content :global(li) { line-height: 1.65; }
  .seo-geo__content :global(h3) { margin-block: 34px 16px; }
  .seo-geo__content :global(h4) { margin-block: 24px 12px; }
  .seo-geo__content :global(ul),
  .seo-geo__content :global(ol) { margin-block: 14px 26px; padding-left: 26px; }
  .seo-geo__content :global(a) {
    color: var(--color-ink);
    font-weight: 400;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .2em;
    text-decoration-skip-ink: auto;
  }
  .seo-geo__content :global(a:focus-visible) {
    outline: 2px solid var(--color-gold-deep);
    outline-offset: 3px;
  }
  .seo-geo__content :global(a:hover) { color: var(--color-gold-deep); }
  .seo-geo__content :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin-block: 25px;
    font-size: .95rem;
  }
  .seo-geo__content :global(th),
  .seo-geo__content :global(td) {
    padding: 12px 16px;
    text-align: left;
    vertical-align: top;
    border: 1px solid var(--color-line);
  }
  .seo-geo__content :global(th) {
    background: color-mix(in srgb, var(--color-champagne) 22%, var(--color-bg));
    font-weight: 600;
  }
  .seo-geo__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 44px;
    width: fit-content;
    max-width: 100%;
    margin: 16px auto 0;
    padding: 10px 20px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 17%, transparent);
    border-radius: 6px;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-champagne) 12%, var(--color-bg));
    font: inherit;
    line-height: 1.35;
    cursor: pointer;
  }
  .seo-geo__toggle[hidden] { display: none; }
  .seo-geo__toggle:hover { background: color-mix(in srgb, var(--color-champagne) 35%, var(--color-bg)); }
  .seo-geo__toggle:focus-visible { outline: 2px solid var(--color-gold-deep); outline-offset: 3px; }
  .seo-geo__toggle svg { flex-shrink: 0; transition: transform .2s ease; }
  .seo-geo__toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  @media (max-width: 600px) {
    .seo-geo { padding-block: var(--section-y-tight); }
    .seo-geo__container { max-width: 100%; }
    /* Compact editorial tables should fit the article width without side scrolling. */
    .seo-geo__content :global(table) {
      display: table;
      width: 100%;
      max-width: 100%;
      table-layout: fixed;
      overflow-wrap: anywhere;
    }
    .seo-geo__content :global(th), .seo-geo__content :global(td) {
      padding: 9px 10px;
      overflow-wrap: anywhere;
      hyphens: auto;
    }
    /* Wide datasets retain horizontal scrolling instead of unreadable thin cells. */
    .seo-geo__content :global(table:has(tr > :nth-child(4))) {
      display: block;
      width: max-content;
      max-width: 100%;
      table-layout: auto;
      overflow-x: auto;
    }
  }
  @media print {
    .seo-geo__content.is-collapsed {
      max-height: none; overflow: visible; -webkit-mask-image: none; mask-image: none;
    }
    .seo-geo__toggle { display: none; }
  }
</style>

      "text": "Rio de Janeiro, Brazil: city and coastline from the mountain"
    },
    {
      "blockId": "tour:itinerary_title:ce8fa4f4df9e3974",
      "field": "itinerary.title",
      "sourceTextSha256": "077bd6b88de66c51c19c2513a842a9fffa9c30c51cccc6eb75ae256be7855c1f",

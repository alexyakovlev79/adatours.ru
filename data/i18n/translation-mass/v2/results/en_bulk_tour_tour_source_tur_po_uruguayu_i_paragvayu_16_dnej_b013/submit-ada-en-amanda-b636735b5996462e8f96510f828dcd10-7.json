    {
      "blockId": "tour:itinerary_text:c3205ac1e20a266d",
      "field": "itinerary.text",
      "sourceTextSha256": "d434cf92575fa3d06ea477c40ba825d48c798b7d9eed5a0d360248a4dcb0d4a7",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-b636735b5996462e8f96510f828dcd10",
        "model": "GPT-6.1",
        "wordAbsenceReason": "Word 2026 paragraphs 0045–0046 cover the lagoon and the Mennonite colonies but do not contain the full RU block with pale shores, shallows, water scarcity, religious tradition or the details about roads, schools and cooperatives."
      },
      "text": "After breakfast, head to the lagoons of the Chaco. At Laguna Capitán, salt water laps at the pale shores, and waterbirds and shorebirds gather in the shallows, including flamingos and swans. Then get to know the region’s Mennonite communities. The first settlers arrived in the Chaco in 1927. They were German Mennonites of a strict Protestant tradition who had to make a living on dry land with little water. You’ll learn how they built roads and established farms, schools and cooperatives, gradually developing settlements in the harsh Chaco landscape. Return to Filadelfia in the evening."
    },

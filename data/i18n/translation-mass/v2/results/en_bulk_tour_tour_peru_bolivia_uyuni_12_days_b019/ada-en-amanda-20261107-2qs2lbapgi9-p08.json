      },
      "text": "Witches’ Market"
    },
    {
      "blockId": "tour:itinerary_label:d0f6a58c14cf5c25",
      "field": "itinerary.label",
      "sourceTextSha256": "1bcd88b7e871fcce59ae466293591325d9a23a0fc9c375f45d9d7681c5e9ed8b",

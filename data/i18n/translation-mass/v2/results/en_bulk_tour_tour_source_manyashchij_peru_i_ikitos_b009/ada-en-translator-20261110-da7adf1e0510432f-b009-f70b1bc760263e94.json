        "model": "GPT-6.1"
      },
      "text": "Iquitos, Peru: boats beside thatched houses"
    },
    {
      "blockId": "tour:itinerary_title:ab3fd6cac362f6b0",
      "field": "itinerary.title",
      "sourceTextSha256": "197e8fb8e8dc4c65e11a05ec59a904a4f5afb687cdbdfa6084ffceecb3c9aa4a",
      "provenance": {

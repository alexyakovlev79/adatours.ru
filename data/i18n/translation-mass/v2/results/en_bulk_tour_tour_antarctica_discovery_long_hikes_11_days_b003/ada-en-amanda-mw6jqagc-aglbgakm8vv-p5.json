  "sourceFingerprint": "8daded9f7538a6a7444899ef1a74f5024f843e2c21e3fa520b3d2a5f68a8cb9e",
  "blocks": [
    {
      "blockId": "tour:note:053e6649ee6d2fa2",
      "field": "note",
      "sourceTextSha256": "274c9da2b7ecd773247dc8e6d60cf53e96c6f39331079247d42e760736506e49",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-mw6jqagc-aglbgakm8vv",
        "model": "GPT-6"
      },
      "text": "The expedition lasts 11 days. There are 10 nights between the departure and return dates."
    },
    {
      "blockId": "tour:note:d058441d961e09a5",
      "field": "note",
      "sourceTextSha256": "539ca51a15061fd46bcc3016e504b4f50b7befc7d9653d6ef9dc0633a29a9cba",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-mw6jqagc-aglbgakm8vv",
        "model": "GPT-6"
      },
      "text": "Visits to Danco Island, Neko Harbour, Paradise Bay, Port Lockroy and Jougla Point, as well as a walk near Damoy Point, are possible. On day 8, the ship may visit Deception Island or Half Moon Island. A visit to both islands is not guaranteed."
    },
    {
      "blockId": "tour:note:5fe7f674551be2ad",
      "field": "note",
      "sourceTextSha256": "107aab7457c76cf3eb59347f561b15d6093d38f06be501d0f75fa2081352ba62",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-mw6jqagc-aglbgakm8vv",
        "model": "GPT-6"
      },
      "text": "Special requests are considered individually. Availability and any applicable conditions are confirmed before booking."
    },
    {
      "blockId": "tour:note:3fd61814ae6915bb",
      "field": "note",
      "sourceTextSha256": "2b4a573586e82d8bb94d57b04e814b0aac9ad2b950f503da0afb06c9fb948dac",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-mw6jqagc-aglbgakm8vv",
        "model": "GPT-6"
      },
      "text": "Hikes and snowshoe outings depend on local conditions. Duration, difficulty, equipment and participation are confirmed before booking."
    },
    {
      "blockId": "tour:itinerary_title:5cd7a3d146d31311",
      "field": "itinerary.title",
      "sourceTextSha256": "666c55bfe1f26495a74e160ef87891bbb681b30052c390b7a51782439a9525bd",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-mw6jqagc-aglbgakm8vv",
        "model": "GPT-6"
      },
      "text": "Ushuaia and the Beagle Channel"
    },
    {
      "blockId": "tour:itinerary_text:5a4836cca1208c95",
      "field": "itinerary.text",
      "sourceTextSha256": "3733ae519b143ebede64feee2829c4b64ea3bc74b38a0425771dcaa71af5dd6f",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-mw6jqagc-aglbgakm8vv",
        "model": "GPT-6"
      },
      "text": "The ship departs from Ushuaia in Tierra del Fuego in the afternoon. Until late in the evening, it sails through the Beagle Channel between mountains and islands, beginning the sea crossing to Antarctica."
    },
    {
      "blockId": "tour:itinerary_label:540a508e8a789df1",
      "field": "itinerary.label",

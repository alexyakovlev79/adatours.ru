    {
      "blockId": "tour:itinerary_text:c3205ac1e20a266d",
      "field": "itinerary.text",
      "sourceTextSha256": "39b32feaae97358f4b9e1eb35861e5c26fdde432046f5a8bdfdcb2ed2c29b9c6",
      "text": "Spend the day getting to know how local people live.\n\nYou will fish and catch crabs, talk with villagers, learn how to weave fishing gear and help prepare a meal. You will spend the whole day away from the usual city sightseeing route.\n\nLunch will be prepared in a local fisher’s home with whatever you manage to catch: fish, crabs or snails.\n\n**Duration:** 7 hours.\n\n**Included:** A bilingual guide, private transport, a traditional lunch in a local fisher’s home and a local medical assistance card.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw8xmc1z-c3czq7aboap843vk2r4442",
        "model": "ChatGPT"
      }
    },

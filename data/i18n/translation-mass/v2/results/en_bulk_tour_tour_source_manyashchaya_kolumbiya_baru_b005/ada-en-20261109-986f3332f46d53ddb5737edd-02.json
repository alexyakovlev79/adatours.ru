      "sourceTextSha256": "e4808fd029b2fc9d800d5dc7d534913fc3e97dd7e9bcaebdf8efad51b0ed9786",
      "text": "Bogotá — Medellín — El Peñón — Guatapé",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-20261109-986f3332f46d53ddb5737edd",

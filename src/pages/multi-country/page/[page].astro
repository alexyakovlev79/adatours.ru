---
import { createHash } from 'node:crypto';
import { getCollection } from 'astro:content';
import { isActiveEntity } from '../../../lib/archive.mjs';
import EntityCatalogLayout from '../../../layouts/EntityCatalogLayout.astro';
import { paginateCatalog } from '../../../lib/catalog-pagination';
import { compareToursBySalesFit } from '../../../lib/tour-ranking';
import { mainTourCountries } from '../../../lib/routes';

export async function getStaticPaths() {
  const tours = (await getCollection('tours', ({ data }) => data.locale === 'ru' && isActiveEntity(data)))
    .filter((entry) => mainTourCountries(entry.data).length > 1)
    .sort(compareToursBySalesFit);
  const pages = paginateCatalog(tours, '/multi-country/');
  const catalogVersion = createHash('sha256')
    .update(JSON.stringify(tours.map((entry) => entry.data.id)))
    .digest('hex')
    .slice(0, 20);
  return pages.slice(1).map((page) => {
    const pageImages = new Set(page.entries.map((entry) => entry.data.hero?.src).filter(Boolean));
    const afterPage = tours.slice(page.pagination.to);
    const beforePage = tours.slice(0, page.pagination.offset);
    const coverTour = [...afterPage, ...beforePage].find((entry) =>
      Boolean(entry.data.hero?.src) && !pageImages.has(entry.data.hero?.src)
    );
    if (!coverTour?.data.hero?.src) {
      throw new Error(`No off-page hero available for multi-country page ${page.pagination.currentPage}`);
    }

    return {
      params: { page: String(page.pagination.currentPage) },
      props: {
        entries: page.entries,
        pagination: page.pagination,
        catalogVersion,
        hero: coverTour.data.hero.src,
      },
    };
  });
}

const { entries, pagination, catalogVersion, hero } = Astro.props;
---

<EntityCatalogLayout
  leadTitle="Собрать маршрут по нескольким странам"
  leadEntityId="multi_country"
  kind="tour"
  entries={entries}
  title="Multi-country туры по Латинской Америке"
  description="Готовые маршруты Ada Tours по нескольким странам Латинской Америки. Выберите программу и адаптируйте даты, длительность, отели и состав поездки."
  canonical={pagination.canonical}
  breadcrumbs={[
    { label: 'Главная', href: '/' },
    { label: 'Multi-country', href: '/multi-country/' },
  ]}
  hero={hero}
  pagination={pagination}
  catalogVersion={catalogVersion}
  variant="multi-country-tours"
/>

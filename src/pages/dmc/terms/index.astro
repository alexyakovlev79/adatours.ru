---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/editorial/Hero.astro';
import EditorialStatement from '../../../components/editorial/EditorialStatement.astro';
import FactStrip from '../../../components/proof/FactStrip.astro';
import EditorialProof from '../../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../../components/proof/ProcessSteps.astro';
import DmcNav from '../../../components/commercial/DmcNav.astro';
import DmcFaq from '../../../components/commercial/DmcFaq.astro';
import CommercialDetails from '../../../components/commercial/CommercialDetails.astro';
---

<BaseLayout
  leadTitle="Отправить B2B-запрос"
  leadEntityId="dmc_terms"
  title="Условия работы с DMC Ada Tours для турагентств"
  description="Как согласовать B2B-поездку с Ada Tours: состав предложения, тарифную модель, подтверждение услуг, оплату, изменения, отмены и сопровождение."
  image="/media/home/buenos-aires-enhanced-20260930.webp"
>
  <Hero
    eyebrow="DMC · Условия работы"
    title="Условия работы с DMC Ada Tours"
    intro="Программа, тариф, договор, сроки и правила изменений обсуждаются для каждой поездки. Здесь собраны вопросы, которые стоит закрыть до подтверждения услуг."
    image="/media/home/buenos-aires-enhanced-20260930.webp"
    ctaHref="#request"
    ctaLabel="Отправить B2B-запрос"
  />

  <DmcNav active="terms" />

  <EditorialStatement
    eyebrow="Принцип"
    text="Отдельно согласуем маршрут и включенные услуги, коммерческую модель и документальные подтверждения. Предварительный расчет не равен уже забронированной поездке."
  />

  <FactStrip
    facts={[
      { value: 'Маршрут', label: 'программа и ее состав' },
      { value: 'Расчет', label: 'стоимость для выбранных дат' },
      { value: 'Договор', label: 'условия работы с партнером' },
      { value: 'Подтверждение', label: 'статус услуг и бронирований' },
    ]}
  />

  <EditorialProof
    eyebrow="Предложение"
    title="Что фиксируем до подтверждения"
    text="Первое предложение собирается по датам и брифу. В нем видны маршрут, состав услуг, стоимость и позиции, которые еще требуют подтверждения."
    image="/media/home/patagonia-enhanced-20260930.webp"
    facts={[
      'Даты и география поездки',
      'Состав включенных услуг',
      'Стоимость под выбранные даты',
      'Позиции, которые требуют подтверждения',
    ]}
  />

  <EditorialProof
    eyebrow="Тариф и расчеты"
    title="Какие коммерческие условия нужно согласовать"
    text="До подтверждения поездки следует зафиксировать выбранную тарифную модель, порядок расчетов, состав услуг и ответственность сторон. Конкретная схема расчетов, условия подготовки программы и документы обсуждаются при согласовании проекта."
    image="/media/home/lencois-enhanced-20260930.webp"
    facts={[
      'Условия тарифа и вознаграждения для этого запроса',
      'Плательщик, договорная сторона и валюта расчетов',
      'Срок действия предложения и момент подтверждения мест',
      'Условия изменений, отмен и операционного сопровождения',
    ]}
    reverse
  />

  <CommercialDetails
    id="b2b-responsibility"
    eyebrow="Границы ответственности"
    title="Что фиксируем между сторонами"
    intro="Состав ролей и услуг нужно закрепить для выбранного бронирования: это особенно важно при работе через агентство и при деловых мероприятиях."
    rows={[
      { title: 'Коммерческий контакт', text: 'Кто общается с туристом по цене и изменениям, кто согласует решения и как обрабатываются прямые обращения гостя после поездки.' },
      { title: 'Работа на месте', text: 'Какие трансферы, гиды, переводчики, площадки и координация входят в предложение; кому сообщать об изменении расписания и в какие часы доступна помощь.' },
      { title: 'Поставщики', text: 'Какие отели, транспорт и визиты подтверждены, какие еще ожидают ответа и когда партнер получает окончательные документы.' },
      { title: 'Финансовые условия', text: 'Кто выставляет счет, сроки оплаты, валюта, возможные дополнительные расходы, порядок корректировки численности группы и отмен.' },
    ]}
  />

  <ProcessSteps
    eyebrow="От запроса до подтверждения"
    title="4 этапа B2B-работы"
    steps={[
      {
        title: 'Бриф',
        text: 'Даты, количество гостей, география, бюджет, уровень размещения и обязательные элементы.',
      },
      {
        title: 'Предложение',
        text: 'Ada Tours собирает маршрут, наземную логистику, состав услуг и расчет.',
      },
      {
        title: 'Согласование',
        text: 'После правок фиксируем рабочую версию программы и проверяем доступность выбранных услуг.',
      },
      {
        title: 'Подтверждение',
        text: 'Закрепляем финальные условия и состав конкретного бронирования.',
      },
    ]}
    dark
  />

  <DmcFaq
    title="Условия B2B-сотрудничества: вопросы партнеров"
    items={[
      { question: 'Какая тарифная модель действует для агентств?', answer: 'Выбранную модель тарифа и условия вознаграждения согласуем для конкретной поездки. Они зависят от программы и формата партнерства.' },
      { question: 'Что можно получить после первого запроса?', answer: 'Состав первоначальных материалов определяется задачей. Для содержательного расчета нужны даты, маршрут, число гостей, желаемые услуги и бюджет. Уточните отдельно, входят ли подробная разработка программы и дополнительные варианты в первоначальное предложение.' },
      { question: 'Когда цена и услуги считаются подтвержденными?', answer: 'В предложении нужно различать рассчитанные позиции и уже подтвержденные бронирования. Срок действия цены и порядок окончательного подтверждения фиксируются для выбранной поездки.' },
      { question: 'Можно ли оформить маршрут или ваучеры под брендом агентства?', answer: 'Формат документов и возможность фирменного оформления обсуждаются отдельно до подготовки материалов. Формат и возможность использования фирменного оформления обсуждаются до подготовки документов.' },
      { question: 'Как регулируется контакт Ada Tours с туристом?', answer: 'Коммерческую роль агентства и порядок оперативной связи с гостями нужно согласовать заранее. Контакт с участниками на месте может понадобиться для трансферов и изменений.' },
      { question: 'Что происходит при изменении дат или размера группы?', answer: 'Изменения могут повлиять на наличие мест, тарифы и стоимость на человека. Применимые правила поставщиков и условия перерасчета согласуются в рамках конкретного бронирования.' },
      { question: 'Какие штрафы действуют при отмене?', answer: 'Правила отмены, сроки, возможные удержания и возвраты согласуются для конкретного бронирования с учетом условий поставщиков.' },
      { question: 'Предусмотрена ли помощь во время поездки?', answer: 'Состав сопровождения, контакт ответственного лица, часы доступности и порядок экстренной связи обсуждаются при подготовке предложения.' },
    ]}
  />
</BaseLayout>

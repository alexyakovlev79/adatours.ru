    {
      "blockId": "tour:itinerary_text:1e1fcafafd438aa8",
      "field": "itinerary.text",
      "sourceTextSha256": "291510597b6ab83e81a4788bd45826e3423f8001903f841b98120b8125f835a5",
      "text": "Breakfast at the hotel. Full-day excursion to Machu Picchu - the \"lost city of the Incas\" in a group with an English-speaking guide. The most enlightened priests retreated to Machu Picchu after the fall of the Inca Empire, a city that the Spaniards never found. Machu Picchu was built from huge limestone blocks without mortar on top of a mountain surrounded by impenetrable jungle. It was discovered by American archaeologist Hiram Bingham only in 1911. Lunch included. Return to Cusco by train. Arrival and transfer to the hotel.",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1cf7wueRDIZK0ocnEAfXaDl1_yBCdjFNh",
        "documentSha256": "41f369baf395231c6d90ef1b3b1f76b6222a6a8eda59a301c61a48727be5e51a",

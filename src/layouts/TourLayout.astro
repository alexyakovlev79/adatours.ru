---
import { themeIds } from '../lib/interest-model.mjs';
import { getVipTourPaths } from '../lib/vip-catalog';
import { seoTourTitle, seoAttractionsDescription } from '../lib/seo-page.mjs';
import { isActiveEntity, isArchivedEntity } from '../lib/archive.mjs';
import ArchiveNotice from '../components/global/ArchiveNotice.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/editorial/Hero.astro';
import TripStats from '../components/tour/TripStats.astro';
import HighlightsEditorial from '../components/tour/HighlightsEditorial.astro';
import Itinerary from '../components/tour/Itinerary.astro';
import GeoRouteMap from '../components/maps/GeoRouteMap.astro';
import TourPricing from '../components/tour/TourPricing.astro';
import IncludedExcluded from '../components/tour/IncludedExcluded.astro';
import StoryPair from '../components/editorial/StoryPair.astro';
import SearchIndexRecord from '../components/global/SearchIndexRecord.astro';
import InlineMarkdown from '../components/global/InlineMarkdown.astro';
import { withBase } from '../lib/paths';
import { destinationCatalogById } from '../lib/content-validation';
import { countryPath, destinationPath, themePath, tourBreadcrumbs, tourPath } from '../lib/routes';
import { mainTourCountryIds, mainTourDestinationIds, optionalTourDestinationIds } from '../lib/tour-relations';

const { entry } = Astro.props;
const d = entry.data;
// One shared map component for every active tour with verified published GEO points.
const geoMapData = await (await import('../lib/geo-map-astro')).buildPageGeoMap('tour', d);
const archived = isArchivedEntity(d);
const vip = !archived && (await getVipTourPaths()).has(tourPath(d));
const roundedPrice = typeof d.priceFrom === 'number' ? Math.round(d.priceFrom) : null;
const currencyPrefix = d.currency === 'USD' ? String.fromCharCode(36) : '';
const money = roundedPrice && d.currency
  ? 'от ' + currencyPrefix + roundedPrice.toLocaleString('ru-RU', { maximumFractionDigits: 0 })
  : 'По запросу';

const pluralRu = (value: number, one: string, few: string, many: string) => {
  const n = Math.abs(value) % 100;
  const n1 = n % 10;
  if (n >= 11 && n <= 19) return many;
  if (n1 === 1) return one;
  if (n1 >= 2 && n1 <= 4) return few;
  return many;
};

const routePointCount = mainTourDestinationIds(d).length || d.route.length;
const stats = [
  d.durationDays ? {
    value: String(d.durationDays),
    label: pluralRu(d.durationDays, 'день', 'дня', 'дней'),
  } : null,
  d.durationNights !== undefined ? {
    value: String(d.durationNights),
    label: pluralRu(d.durationNights, 'ночь', 'ночи', 'ночей'),
  } : null,
  {
    value: String(routePointCount),
    label: pluralRu(routePointCount, 'точка маршрута', 'точки маршрута', 'точек маршрута'),
  },
  d.format ? { value: d.format, label: 'формат', kind: 'format' as const } : null,
].filter(Boolean);

// Media QA status must never silently remove a source image from the page.
const usableGallery = d.gallery;
const firstStory = usableGallery[0] && d.highlights[0]
  ? { item: d.highlights[0], image: usableGallery[0] }
  : null;
const lastStory = usableGallery[1] && d.highlights.length > 1
  ? { item: d.highlights[d.highlights.length - 1], image: usableGallery[1] }
  : null;
const editorialHighlights = d.highlights.filter((_, index) => {
  if (firstStory && index === 0) return false;
  if (lastStory && index === d.highlights.length - 1) return false;
  return true;
});

const interestIds = isActiveEntity(d) ? themeIds(d) : [];
const [countryEntries, destinationEntries, themeEntries] = await Promise.all([
  getCollection('countries', ({ data }) => data.locale === 'ru' && isActiveEntity(data)),
  getCollection('destinations', ({ data }) => data.locale === 'ru' && isActiveEntity(data) && d.destinations.includes(data.id)),
  interestIds.length ? getCollection('themes', ({ data }) => data.locale === 'ru' && isActiveEntity(data) && interestIds.includes(data.id)) : Promise.resolve([]),
]);

const themeById = new Map(themeEntries.map((item) => [item.data.id, item.data]));
const linkedInterests = interestIds.map((id) => themeById.get(id)).filter(Boolean);
const countryById = new Map(countryEntries.map((item) => [item.data.id, item]));
const destinationById = new Map(destinationEntries.map((item) => [item.data.id, item]));
const countryNames = d.countries.map((id) => countryById.get(id)?.data.name).filter(Boolean) as string[];
const routeDestinations = d.destinations.map((id) => {
  const destination = destinationById.get(id);
  const planned = destinationCatalogById.get(id);
  const country = destination ? countryById.get(destination.data.countryId) : undefined;
  return {
    id,
    name: destination?.data.name ?? planned?.name ?? '',
    // Keep a future place as text; its link activates when the page is published.
    href: destination && country ? destinationPath(destination.data) : undefined,
  };
}).filter((item) => item.name);
const destinationNames = routeDestinations.map((item) => item.name);
const mainPlaces = routeDestinations.filter((item) => mainTourDestinationIds(d).includes(item.id));
const optionalPlaces = routeDestinations.filter((item) => optionalTourDestinationIds(d).includes(item.id));
const metaDescription = /достопримечательност/iu.test(d.title)
  ? seoAttractionsDescription(d.lead,mainPlaces.filter((place) => place.href).length,'в маршруте')
  : d.lead;
const mainCountryEntries = mainTourCountryIds(d).map((id) => countryById.get(id)).filter(Boolean);
const placeGroups = [
  { label: 'Места маршрута', entries: mainPlaces, collapsible: true },
  { label: 'Места дополнительных экскурсий', entries: optionalPlaces, collapsible: false },
];
const durationLabel = d.durationDays
  ? `${d.durationDays} ${pluralRu(d.durationDays, 'день', 'дня', 'дней')}`
  : '';
const subtitleParts = [
  durationLabel,
  countryNames.join(', '),
].filter(Boolean);
// Keep the full itinerary in tour data; hero shows only the trip duration.
const heroMeta = durationLabel || undefined;

// Treat the lead as the opening paragraph of the description, not hero text.
// Only move its display position; do not edit the authored body or deduplicate.
const tourBodyHtml = await Astro.slots.render('default');
const firstHeadingMatch = tourBodyHtml.match(/^(\s*(?:<!--[\s\S]*?-->\s*)*<h2\b[^>]*>[\s\S]*?<\/h2>)/i);
const firstHeadingHtml = firstHeadingMatch?.[1] ?? '';
const remainingBodyHtml = firstHeadingHtml ? tourBodyHtml.slice(firstHeadingHtml.length) : tourBodyHtml;
const hasTourDescription = Boolean(d.lead?.trim() || tourBodyHtml.trim());
---

<BaseLayout breadcrumbsInHero leadTourId={archived ? undefined : d.id} leadTitle={archived ? "Подобрать другую поездку" : "Получить расчет и адаптировать маршрут под ваши даты"} leadEntityId={archived ? "" : d.id} headerTheme={archived ? 'dark' : 'light'} noindex={archived} title={seoTourTitle(d)} description={metaDescription} image={d.hero?.src} canonical={tourPath(d)} breadcrumbs={tourBreadcrumbs(d)}>
  {!archived && <SearchIndexRecord
    title={d.title}
    summary={d.lead}
    entityType="tour"
    typeLabel="Тур"
    subtitle={subtitleParts.join(' · ')}
    aliases={d.searchAliases}
    geography={[...countryNames, ...destinationNames, ...d.route]}
    themes={themeIds(d)}
    image={d.hero?.src}
    tourCountryCount={new Set(mainTourCountryIds(d)).size}
    tourDurationDays={d.durationDays}
  />}
  {archived && <ArchiveNotice id={d.id} kind="tour" />}

  <Hero
    tour
    vip={vip}
    eyebrow={archived ? "Архивный тур" : d.format === "Сборный" ? "Сборный тур" : "Индивидуальный тур"}
    title={d.title}
    image={d.hero?.src}
    imageTextAlign={d.imageTextAlign}
    mediaStatus={d.hero?.status}
    replacementReason={d.hero?.replacementReason}
    meta={heroMeta}
    ctaLabel={archived ? "Актуальные туры" : "Получить программу"}
    ctaHref={archived ? "/tours/" : "/contacts/"}
  >
    {!archived && <Breadcrumbs slot="breadcrumbs" inline pathname={Astro.url.pathname} title={d.title} items={tourBreadcrumbs(d)} />}
  </Hero>

  {d.durationDays && <TripStats stats={stats} />}

  {hasTourDescription && (
    <section class="tour-copy">
      <div class="container prose" data-tour-description>
        {firstHeadingHtml && <Fragment set:html={firstHeadingHtml} />}
        <div class="tour-copy__text" id={`tour-description-${d.id}`} data-tour-description-text>
          {d.lead?.trim() && <p class="tour-lead"><InlineMarkdown text={d.lead} /></p>}
          {remainingBodyHtml && <Fragment set:html={remainingBodyHtml} />}
        </div>
        <button class="tour-copy__toggle" type="button" aria-expanded="false" aria-controls={`tour-description-${d.id}`} data-tour-description-toggle hidden>
          <span data-tour-description-label>Подробнее о путешествии</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </section>
  )}

  {(mainCountryEntries.length > 0 || placeGroups.some((group) => group.entries.length) || linkedInterests.length > 0) && (
    <div class="tour-links container">
      {mainCountryEntries.length > 0 && (
        <nav class="tour-links__group" aria-label="Страны маршрута">
          <p class="tour-links__label">Страны маршрута</p>
          <ul>
            {mainCountryEntries.map((country) => (
              <li><a href={withBase(countryPath(country.data))}>{country.data.name}</a></li>
            ))}
          </ul>
        </nav>
      )}
      {placeGroups.filter((group) => group.entries.length).map((group) => (
        <nav class="tour-links__group" aria-label={group.label} data-tour-places={group.collapsible ? '' : undefined}>
          <p class="tour-links__label">{group.label}</p>
          <ul id={group.collapsible ? 'tour-places-' + d.id : undefined} data-tour-places-list={group.collapsible ? '' : undefined}>
            {group.entries.map((item) => (
              <li>{item.href ? <a href={withBase(item.href)}>{item.name}</a> : <span>{item.name}</span>}</li>
            ))}
          </ul>
          {group.collapsible && (
            <button class="tour-links__more" type="button" aria-expanded="false" aria-controls={'tour-places-' + d.id} data-tour-places-toggle hidden>
              <span data-tour-places-label>Все достопримечательности</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          )}
        </nav>
      ))}
      {linkedInterests.length > 0 && (
        <nav class="tour-links__group tour-links__group--interests" aria-label="Интересы поездки">
          <p class="tour-links__label">По интересам</p>
          <ul>
            {linkedInterests.map((theme) => (
              <li><a href={withBase(themePath(theme))}>{theme.name}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  )}

  {firstStory && (
    <StoryPair
      eyebrow="Акцент маршрута"
      title={firstStory.item.title}
      text={firstStory.item.text}
      image={firstStory.image.src}
      imageTextAlign={d.imageTextAlign}
      mediaStatus={firstStory.image.status}
      replacementReason={firstStory.image.replacementReason}
    />
  )}

  {editorialHighlights.length > 0 && <HighlightsEditorial items={editorialHighlights} />}


  {d.itinerary.length > 0 && <Itinerary days={d.itinerary} />}
  {geoMapData && <GeoRouteMap data={geoMapData} title="Маршрут путешествия" locale="ru" />}

  {lastStory && (
    <StoryPair
      eyebrow="Еще один акцент"
      title={lastStory.item.title}
      text={lastStory.item.text}
      image={lastStory.image.src}
      imageTextAlign={d.imageTextAlign}
      mediaStatus={lastStory.image.status}
      replacementReason={lastStory.image.replacementReason}
      reverse
    />
  )}

  {!archived && <TourPricing price={money} />}
  {(d.included.length > 0 || d.notIncluded.length > 0 || d.notes.length > 0) && (
    <IncludedExcluded included={d.included} notIncluded={d.notIncluded} notes={d.notes} />
  )}
</BaseLayout>

<script>
  const initTourDescriptions = () => {
    document.querySelectorAll<HTMLElement>('[data-tour-description]').forEach((section) => {
      if (section.dataset.descriptionReady) return;
      const text = section.querySelector<HTMLElement>('[data-tour-description-text]');
      const toggle = section.querySelector<HTMLButtonElement>('[data-tour-description-toggle]');
      const label = section.querySelector<HTMLElement>('[data-tour-description-label]');
      if (!text || !toggle || !label) return;
      section.dataset.descriptionReady = 'true';
      let expanded = false;

      const update = () => {
        const firstParagraph = text.querySelector<HTMLElement>('p');
        const lead = text.querySelector<HTMLElement>('.tour-lead');
        const lineHeight = parseFloat(getComputedStyle(firstParagraph ?? text).lineHeight) || 30;
        // Show the full lead or seven lines, whichever is longer.
        // Fade the last two visible lines before the expand button.
        const leadHeight = lead
          ? lead.getBoundingClientRect().bottom - text.getBoundingClientRect().top
          : 0;
        const previewHeight = Math.ceil(Math.max(leadHeight, lineHeight * 7));
        const fadeHeight = lineHeight * 2;
        const long = text.scrollHeight > previewHeight + lineHeight;
        text.style.setProperty('--tour-copy-preview-height', `${previewHeight}px`);
        text.style.setProperty('--tour-copy-fade-height', `${fadeHeight}px`);
        text.classList.toggle('is-collapsed', long && !expanded);
        toggle.hidden = !long;
        toggle.setAttribute('aria-expanded', String(expanded));
        label.textContent = expanded ? 'Свернуть' : 'Подробнее о путешествии';
      };

      toggle.addEventListener('click', () => {
        expanded = !expanded;
        update();
        // Keep the control and beginning in view when closing a long description.
        if (!expanded && text.getBoundingClientRect().top < 0) {
          window.scrollTo({
            top: Math.max(0, window.scrollY + text.getBoundingClientRect().top - 120),
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        }
      });
      // A keyboard user reaching a link inside the clipped text sees it immediately.
      text.addEventListener('focusin', () => {
        if (!expanded && !toggle.hidden) {
          expanded = true;
          update();
        }
      });

      update();
      if ('ResizeObserver' in window) new ResizeObserver(update).observe(text);
      else window.addEventListener('resize', update);
      document.fonts.ready.then(update);
    });
  };
  const initTourPlaces = () => {
    document.querySelectorAll<HTMLElement>('[data-tour-places]').forEach((group) => {
      if (group.dataset.placesReady) return;
      const list = group.querySelector<HTMLUListElement>('[data-tour-places-list]');
      const toggle = group.querySelector<HTMLButtonElement>('[data-tour-places-toggle]');
      const label = group.querySelector<HTMLElement>('[data-tour-places-label]');
      if (!list || !toggle || !label) return;
      group.dataset.placesReady = 'true';
      let expanded = false;

      const update = () => {
        const items = Array.from(list.children) as HTMLLIElement[];
        // Count actual flex rows, not places: the number varies with screen width.
        const rowTops = [...new Set(items.map((item) => item.offsetTop))].sort((a, b) => a - b);
        const hasMore = matchMedia('(max-width: 760px)').matches && rowTops.length >= 5;

        if (hasMore) {
          const thirdRow = items.filter((item) => item.offsetTop === rowTops[2]);
          const listTop = list.getBoundingClientRect().top;
          const fadeStart = Math.max(0, Math.floor(thirdRow[0].getBoundingClientRect().top - listTop));
          const previewHeight = Math.ceil(Math.max(...thirdRow.map((item) => item.getBoundingClientRect().bottom)) - listTop);
          list.style.setProperty('--tour-places-fade-start', fadeStart + 'px');
          list.style.setProperty('--tour-places-preview-height', previewHeight + 'px');
        }

        const collapsed = hasMore && !expanded;
        list.classList.toggle('is-collapsed', collapsed);
        const fourthRowTop = hasMore ? rowTops[3] : Infinity;
        // Clipped links should not receive keyboard focus until the list is expanded.
        items.forEach((item) => { item.inert = collapsed && item.offsetTop >= fourthRowTop; });
        toggle.hidden = !hasMore;
        toggle.setAttribute('aria-expanded', String(hasMore && expanded));
        label.textContent = expanded ? 'Свернуть' : 'Все достопримечательности';
      };

      toggle.addEventListener('click', () => {
        expanded = !expanded;
        update();
        if (!expanded && group.getBoundingClientRect().top < 0) {
          window.scrollTo({
            top: Math.max(0, window.scrollY + group.getBoundingClientRect().top - 20),
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        }
      });

      update();
      window.addEventListener('resize', update);
      document.fonts.ready.then(update);
    });
  };

  initTourDescriptions();
  initTourPlaces();
  document.addEventListener('astro:page-load', initTourDescriptions);
  document.addEventListener('astro:page-load', initTourPlaces);
</script>

<style>
  .tour-copy { background: var(--color-bg); padding: 0 0 var(--section-y-tight); }
  .tour-copy :global(.prose) { padding-top: 0; padding-bottom: 0; }
  .tour-copy :global(.prose:empty) { display: none; }
  .tour-copy .tour-lead {
    font-weight: 600;
  }

  .tour-copy__text { display: flow-root; }
  .tour-copy__text.is-collapsed {
    max-height: var(--tour-copy-preview-height);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - var(--tour-copy-fade-height)), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - var(--tour-copy-fade-height)), transparent);
  }
  .tour-copy__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: fit-content;
    max-width: 100%;
    min-height: 44px;
    margin: 12px auto 0;
    padding: 8px 16px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-champagne) 12%, var(--color-bg));
    color: var(--color-ink);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
    cursor: pointer;
    transition: background-color .15s ease, border-color .15s ease;
  }
  .tour-copy__toggle[hidden] { display: none; }
  .tour-copy__toggle:hover, .tour-copy__toggle:focus-visible {
    border-color: var(--color-gold-deep);
    background: color-mix(in srgb, var(--color-champagne) 35%, var(--color-bg));
  }
  .tour-copy__toggle svg { flex: none; transition: transform .2s ease; }
  .tour-copy__toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  @media print {
    .tour-copy__text.is-collapsed { max-height: none; overflow: visible; -webkit-mask-image: none; mask-image: none; }
    .tour-copy__toggle { display: none; }
  }

  .tour-links { padding-bottom: clamp(12px, 1.5vw, 20px); }
  /* Avoid adding the next section's full editorial inset to the compact links. */
  .tour-links + :global(.highlights) { padding-top: clamp(12px, 2vw, 24px); }
  .tour-links + :global(.highlights) :global(.eyebrow) { margin-top: 0; }
  .tour-links + :global(.highlights) :global(.highlights__list) { margin-top: 16px; }
  .tour-links__group {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    align-items: start;
    gap: 12px 24px;
    padding-block: 12px;
    border-top: 1px solid var(--color-line);
  }
  .tour-links__label {
    margin: 7px 0 0;
    font-family: var(--font-display);
    font-size: .7rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }
  .tour-links ul { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .tour-links li { max-width: 100%; font-size: clamp(.875rem, .85rem + .15vw, 1rem); line-height: 1.4; }
  .tour-links a, .tour-links li > span {
    display: block;
    padding: 6px 10px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-champagne) 12%, var(--color-bg));
    overflow-wrap: anywhere;
    text-decoration: none;
    transition: background-color .15s ease, border-color .15s ease;
  }
  .tour-links__group--interests a {
    border-color: color-mix(in srgb, var(--color-gold-deep) 25%, transparent);
    background: color-mix(in srgb, var(--color-champagne) 22%, var(--color-bg));
  }
  .tour-links a:hover, .tour-links a:focus-visible {
    border-color: var(--color-gold-deep);
    background: color-mix(in srgb, var(--color-champagne) 40%, var(--color-bg));
  }
  .tour-links li > span { border-style: dashed; background: transparent; }
  .tour-links__more {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 10px;
    justify-self: center;
    min-height: 44px;
    max-width: 100%;
    margin-top: 4px;
    padding: 8px 16px;
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-champagne) 12%, var(--color-bg));
    color: var(--color-ink);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
    cursor: pointer;
  }
  .tour-links__more:hover, .tour-links__more:focus-visible {
    border-color: var(--color-gold-deep);
    background: color-mix(in srgb, var(--color-champagne) 35%, var(--color-bg));
  }
  .tour-links__more svg { flex: none; transition: transform .2s ease; }
  .tour-links__more[aria-expanded="true"] svg { transform: rotate(180deg); }
  @media (max-width: 760px) {
    .tour-links__group { grid-template-columns: minmax(0, 1fr); gap: 8px; padding-block: 12px; }
    .tour-links__label { margin: 0; }
    .tour-links [data-tour-places-list].is-collapsed {
      max-height: var(--tour-places-preview-height);
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 var(--tour-places-fade-start), transparent var(--tour-places-preview-height));
      mask-image: linear-gradient(to bottom, #000 0, #000 var(--tour-places-fade-start), transparent var(--tour-places-preview-height));
    }
    .tour-links__more:not([hidden]) { display: flex; }
  }
  @media print {
    .tour-links [data-tour-places-list].is-collapsed {
      max-height: none;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .tour-links__more { display: none !important; }
  }
</style>


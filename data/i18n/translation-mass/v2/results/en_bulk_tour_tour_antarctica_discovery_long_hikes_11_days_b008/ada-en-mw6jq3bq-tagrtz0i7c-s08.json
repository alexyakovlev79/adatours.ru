    {
      "blockId": "tour:itinerary_text:2e780f63f4172747",
      "field": "itinerary.text",
      "sourceTextSha256": "154ec28541cc9c4240c5bff2aca579afe2fc1a258f57b380d799a646b1543121",
      "text": "The shared programme for Days 4–7 comes to a close. The ship may sail through the Neumayer Channel to Port Lockroy on Goudier Island, with possible activities near Jougla Point. A visit could take in the museum and post office and offer a chance to see gentoo penguins and blue-eyed shags. The expedition team decides on the exact day and whether each site is accessible. Conditions permitting, the team may offer a snowshoe walk along the shore to the former skiway at Damoy Point. This outing is an option during Days 4–7 and is not scheduled specifically for Day 7.",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-mw6jq3bq-tagrtz0i7c",
        "model": "GPT-6.1"
      }
    },

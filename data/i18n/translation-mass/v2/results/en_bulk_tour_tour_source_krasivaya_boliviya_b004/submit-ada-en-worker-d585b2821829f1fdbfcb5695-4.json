        "model": "gpt-6.1-sol"
      },
      "text": "La Paz, Bolivia: city neighbourhoods in a mountain basin"
    },
    {
      "blockId": "tour:itinerary_title:ca0a4d6daf445776",
      "field": "itinerary.title",
      "sourceTextSha256": "240837ec74f44f647d6a09023b6cea963d71fb33a0e7ab6c2ce2e960cf575e65",

        "runId": "ada-en-14e358aa-5c7e-4f7d-99e1-c711351eb01b",
        "model": "gpt-6.1-sol"
      },
      "text": "Historic pale church façade with columns in Guatemala City"
    },
    {
      "blockId": "tour:media_hover:36b675e8a1aa8614",
      "field": "media.hover",
      "sourceTextSha256": "55f0c0b92651c6ba897b87d7ee6906fc2ed13b8b435aa11a91a7b5175fed4ec1",

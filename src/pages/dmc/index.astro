---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/editorial/Hero.astro';
import EditorialStatement from '../../components/editorial/EditorialStatement.astro';
import FactStrip from '../../components/proof/FactStrip.astro';
import EditorialProof from '../../components/proof/EditorialProof.astro';
import ProcessSteps from '../../components/proof/ProcessSteps.astro';
import LeadForm from '../../components/forms/LeadForm.astro';
---

<BaseLayout
  title="DMC по Бразилии и Латинской Америке"
  description="Ada Tours как принимающий партнер для турагентств и туроператоров по Бразилии и странам Латинской Америки."
>
  <Hero
    eyebrow="DMC / B2B"
    title="Принимающий партнер в Латинской Америке"
    intro="Ada Tours собирает наземную часть поездки: маршрут, размещение, трансферы, гидов и координацию на месте."
    image="/media/prototype/rio-night.jpg"
    ctaLabel="Запросить предложение"
  />

  <EditorialStatement
    eyebrow="Для агентств"
    text="Одна команда вместо цепочки подрядчиков: маршрут, логистика и контроль на месте."
  />

  <FactStrip
    facts={[
      { value: 'FIT', label: 'индивидуальные путешествия' },
      { value: 'Groups', label: 'групповые программы' },
      { value: 'MICE', label: 'деловые и корпоративные поездки' },
      { value: 'VIP', label: 'сложные частные запросы' },
    ]}
  />

  <EditorialProof
    eyebrow="География"
    title="Бразилия как база, Латинская Америка как маршрут"
    text="Бразилия - ключевая база Ada Tours. Для маршрутов по региону мы связываем перелеты, наземную часть и локальных подрядчиков в одну программу."
    image="/media/prototype/lencois.jpg"
    facts={[
      'Наземная программа и логистика',
      'Локальные гиды и транспорт',
      'Размещение и специальные запросы',
      'Координация multi-country маршрутов',
    ]}
  />

  <ProcessSteps
    eyebrow="Как строится запрос"
    title="От брифа до программы без лишних звеньев"
    steps={[
      { title: 'Запрос', text: 'Даты, география, состав группы, бюджет и обязательные элементы.' },
      { title: 'Маршрут', text: 'Города, перелеты, трансферы и наземная часть в одной схеме.' },
      { title: 'Предложение', text: 'Программа и расчет с четкими включениями после сверки доступности.' },
      { title: 'На месте', text: 'Одна команда координирует подрядчиков и изменения по ходу поездки.' },
    ]}
    dark
  />

  <LeadForm title="Запросить B2B-предложение" entityId="dmc" />
</BaseLayout>

    {
      "blockId": "tour:itinerary_text:b9ad3e14216c2f08",
      "field": "itinerary.text",
      "sourceTextSha256": "52c904abdff1a5c4a12fc57c80b29867f220dd6530c899d45ddadc0a3c7ab4fb",
      "provenance": {
        "kind": "word_exact",
        "fileId": "1jgHNRDGUx9imoBuqYXFJ87xPUwHxZIsY",
        "documentSha256": "c8ebdd8c617fd65a257104b3da99ffbbbb8d7205cf16ffebfb5cdc209a27853a",
        "paragraphs": [
          {
            "ref": "word/document.xml#p0059",
            "textSha256": "93c5ca94c2cbeda4cf72524bb181442f59f870c4cfa00d68a3313cd9f7b3e233"
          }
        ]
      },
      "text": "The Falls are one of the great natural wonders of the world and located in the National Park with its unique flora and fauna, on the borders of Brazil, Argentina and Paraguay. The area is on the UNESCO World Heritage List, which consists of 275 separate falls; the highest fall, which is called “Devil's Throat”, reaches 70m, which is 1,5x the height of the Niagara Falls. It represents one of the most beautiful tourist destinations on the planet and it has unrivalled natural richness. You will start your tour to the Brazilian site of the magnificent Falls. The splashes coming from the falling water make you feel the falls' grandeur and cover the sky with thousands of rainbows. "
    },

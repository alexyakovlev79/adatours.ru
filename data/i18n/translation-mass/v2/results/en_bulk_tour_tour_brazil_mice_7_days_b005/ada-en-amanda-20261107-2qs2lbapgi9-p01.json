      },
      "text": "São Paulo"
    },
    {
      "blockId": "tour:contentBlock_text:afacf65f69583498",
      "field": "contentBlock.text",
      "sourceTextSha256": "abe041d17f26bd8a1136e28b7166ac04eca2272836975efcd4871667b880af9b",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-20261107-2qs2lbapgi9",
        "model": "gpt-6.1-sol"
      },
      "text": "Our English-speaking guide will meet you at São Paulo airport, and we will arrange your transfer to the hotel. Your introduction to Brazil begins with a city tour."
    },
    {
      "blockId": "tour:contentBlock_text:a2ee672ddf211e5b",
      "field": "contentBlock.text",
      "sourceTextSha256": "b0b71990e36e68ab643313c28028f7958d3558312ed699a01bb0a1da8840cf42",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-20261107-2qs2lbapgi9",
        "model": "gpt-6.1-sol"
      },
      "text": "Your group will take a half-day sightseeing tour of São Paulo with an English-speaking guide, getting to know the city before travelling onwards through Brazil."
    },
    {
      "blockId": "tour:contentBlock_text:04a7a45a0b22e7b4",
      "field": "contentBlock.text",
      "sourceTextSha256": "73491163949b0b7ba18b35802f71fa1d920ff476a7e56930e038d6921e44f3ba",
      "provenance": {
        "kind": "ai_translation",
        "runId": "ada-en-amanda-20261107-2qs2lbapgi9",
        "model": "gpt-6.1-sol"
      },
      "text": "In the evening, join us for dinner at Bovinus Ipiranga. Both dinner and the sightseeing tour are included in the first day’s programme."
    },
    {
      "blockId": "tour:media_alt:4a252e44da45c55d",

---
import { DMC_NAV_LINKS } from '../../lib/site';
import { withBase } from '../../lib/paths';

interface Props {
  active: (typeof DMC_NAV_LINKS)[number]['id'];
}

const { active } = Astro.props;
---

<div class="dmc-nav-shell" data-pagefind-ignore>
  <nav class="dmc-nav" aria-label="Раздел для агентств">
    {DMC_NAV_LINKS.map((link) => (
      <a
        href={withBase(link.href)}
        aria-current={active === link.id ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))}
  </nav>
</div>

<style>
  .dmc-nav-shell {
    padding: 22px 0;
    background: var(--color-bg);
  }

  .dmc-nav {
    display: flex;
    width: min(calc(100% - (var(--gutter) * 2)), var(--container-max));
    margin-inline: auto;
    padding: 0 clamp(4px, 1vw, 16px);
    justify-content: center;
    gap: clamp(42px, 7vw, 120px);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .dmc-nav a {
    position: relative;
    display: inline-flex;
    min-height: 68px;
    padding: 0 2px;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
    font-family: var(--font-display);
    font-size: .78rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: .06em;
    text-align: center;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .dmc-nav a:hover,
  .dmc-nav a[aria-current='page'] {
    color: var(--color-ink);
  }

  .dmc-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 3px;
    background: var(--color-gold);
  }

  @media (max-width: 620px) {
    .dmc-nav-shell {
      padding: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .dmc-nav {
      width: 100%;
      padding: 0;
      gap: 0;
      border: 0;
    }

    .dmc-nav a {
      flex: 1 1 0;
      min-height: 64px;
      padding: 14px 8px;
      font-size: .69rem;
      letter-spacing: .035em;
    }

    .dmc-nav a + a {
      border-left: 1px solid var(--color-line);
    }

    .dmc-nav a[aria-current='page']::after {
      right: 10px;
      left: 10px;
    }
  }
</style>

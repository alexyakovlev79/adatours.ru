        "kind": "ai_translation",
        "runId": "amanda-ada-en-translator-20261107",
        "model": "GPT-6.1",
        "wordAbsenceReason": "The matched 2026 Word document has a route line and separate destination descriptions, but no corresponding concise overview that follows the activities and duration in this website lead."

    {
      "blockId": "tour:itinerary_text:fb5db666cae6efb7",
      "field": "itinerary.text",
      "sourceTextSha256": "06e406259fd27a4d8c3e19c81d7f1b26e61bebfa401d2743feac2ac711bf5708",
      "text": "After breakfast, begin the journey back to Quito. On the way, stop in Papallacta, a small Andean town at about 3,250 m near the eastern mountain range leading to the Amazon rainforest.\n\nPapallacta is home to the Termas Papallacta hot springs complex. The pools sit amid high mountain scenery, making this a quiet stop after several active days and before returning to the capital.\n\nContinue to Quito.",
      "provenance": {
        "kind": "ai_translation",
